{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3-coder-next-q8-256k:latest",
  "small_model": "ollama/qwen3-coder-next-q8-256k:latest",
  "instructions": [
    ".github/copilot-instructions.md"
  ],
  "tool_output": {
    "max_lines": 600,
    "max_bytes": 24576
  },
  "compaction": {
    "auto": true,
    "tail_turns": 6,
    "preserve_recent_tokens": 32000
  },
  "provider": {
    "ollama": {
      "name": "Ollama",
      "npm": "@ai-sdk/openai-compatible",
      "whitelist": [
        "qwen3-coder-next-q8-256k:latest"
      ],
      "options": {
        "baseURL": "http://192.168.2.145:11434/v1",
        "apiKey": "ollama"
      },
      "models": {
        "qwen3-coder-next-q8-256k:latest": {
          "name": "Qwen3 Coder Next",
          "tool_call": true,
          "temperature": true,
          "limit": {
            "context": 262144,
            "input": 262144,
            "output": 32768
          }
        }
      }
    },
    "opencode-go": {
      "name": "OpenCode Go",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1"
      },
      "models": {
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        },
        "qwen3.7-plus": {
          "name": "Qwen3.7 Plus"
        },
        "minimax-m3": {
          "name": "MiniMax M3"
        }
      }
    }
  }
}
