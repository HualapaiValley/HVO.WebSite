# Copy values into the target host environment or a local untracked .env file.
# Do not commit real secrets.

RABBITMQ_DEFAULT_USER=hvo-rabbitmq
RABBITMQ_DEFAULT_PASS=replace-with-strong-password
RABBITMQ_ERLANG_COOKIE=replace-with-long-random-cookie

# RabbitMQ dynamic shovel setup uses these values.
# URI values must be URL encoded when they contain reserved characters.
RABBITMQ_SHOVEL_SOURCE_URI='amqp://hvo-rabbitmq:replace-with-url-encoded-password@localhost/%2f'
SERVICEBUS_RABBITMQ_AMQP_URI='amqps://rabbitmq-shovel-send:replace-with-url-encoded-key@hvoobs.servicebus.windows.net:5671/?sasl=plain&verify=verify_none'
