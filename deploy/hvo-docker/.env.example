# HVO Website deployment on hvo-docker
# Copy to .env and fill the values for the deployment host.

# ── Container Registry ────────────────────────────────────────────────────────
# Self-hosted registry on hvo-docker (registry:2 container on port 5000).
# These are used by scripts/publish-image.sh to push images.
HVO_CONTAINER_REGISTRY_LOGIN_SERVER=registry.hualapaivalleyobservatory.org
HVO_CONTAINER_REGISTRY_USERNAME=admin
HVO_CONTAINER_REGISTRY_PASSWORD=

# ── Website Image ────────────────────────────────────────────────────────────
# Tag used by scripts/publish-image.sh and deploy-hvo-website.sh.
# Bump this to a new unique value (e.g., git hash or timestamp) for each deploy.
HVO_WEBSITE_IMAGE_VERSION=e2d11c79530f

# ── Database ─────────────────────────────────────────────────────────────────
# SQL Server connection string. Server=mssql uses the Docker network alias.
# The database is auto-created by EF Core on first run.
ConnectionStrings__HualapaiValleyObservatory=Server=mssql,1433;Database=HualapaiValleyObservatory;User Id=sa;Password=REPLACE_ME;Encrypt=True;TrustServerCertificate=True;

# ── API Keys ──────────────────────────────────────────────────────────────────
# These are seeded into the database on first run. Rotate via Key Vault secrets
# and restart the container to refresh from Key Vault.
Seeding__DavisApiKey=
Seeding__WeatherReadApiKey=
Seeding__BmsApiKey=
Seeding__PowerApiKey=
Seeding__PowerReadApiKey=

# ── Azure Key Vault (secrets at runtime) ──────────────────────────────────────
# The website reads API keys and connection strings from Key Vault on startup.
# AZURE_CLIENT_ID / AZURE_CLIENT_SECRET / AZURE_TENANT_ID are the dedicated
# website runtime identity credentials. Materialize them from hvo-central-kv;
# do not reuse the development service principal.
KeyVault__Uri=https://hvo-central-kv.vault.azure.net/
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# ── Gateway health URLs ──────────────────────────────────────────────────────
PowerStatus__SolarAssistantGatewayUrl=http://devpi5:5300
PowerStatus__Eg4InverterSourceId=eg4-6500ex-a
PowerStatus__Eg4MpptSourceId=eg4-mppt100-48hv-a
PowerStatus__HistoryHours=6

# ── ASP.NET Core Data Protection ─────────────────────────────────────────────
# The self-hosted website persists keys in its named Docker volume and encrypts
# each key with this Azure Key Vault key. Keep the application name stable so
# existing protected payloads remain compatible across container replacement.
DataProtection__ApplicationName=HVO.WebSite.v9
DataProtection__BlobUri=
DataProtection__KeyIdentifier=https://hvoobs-kv.vault.azure.net/keys/hvo-website-dp

# ── Networking ────────────────────────────────────────────────────────────────
# HTTP only inside the Docker network. TLS is handled by an external reverse
# proxy or Tailscale funnel.
ASPNETCORE_URLS=http://+:8080
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
EnableHttpsRedirect=false
HealthChecks__ExposeDetailed=false

# ── Optional OTEL collector endpoint. Leave blank to disable OTLP export.
OTEL_COLLECTOR_ENDPOINT=
