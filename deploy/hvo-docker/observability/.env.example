# Use the hvo-docker LAN address when edge gateways must export OTLP directly.
HVO_OBSERVABILITY_BIND_ADDRESS=127.0.0.1

OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:latest
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133

PROMETHEUS_IMAGE=prom/prometheus:latest
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=365d

LOKI_IMAGE=grafana/loki:latest
LOKI_PORT=3100
PROMTAIL_IMAGE=grafana/promtail:latest

TEMPO_IMAGE=grafana/tempo:latest
TEMPO_PORT=3200

GRAFANA_IMAGE=grafana/grafana:latest
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD