# Use the hvo-docker LAN address when edge gateways must export OTLP directly.
HVO_OBSERVABILITY_BIND_ADDRESS=127.0.0.1
# Must be an existing directory on the tank-backed /var/lib/docker XFS mount.
HVO_OBSERVABILITY_DATA_ROOT=/var/lib/docker/hvo-observability
# Source device for the required Docker data-root mount on hvo-docker.
HVO_OBSERVABILITY_STORAGE_DEVICE=/dev/sdb1

OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.152.0
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133

PROMETHEUS_IMAGE=prom/prometheus:v3.11.3
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=365d

LOKI_IMAGE=grafana/loki:3.7.2
LOKI_PORT=3100
PROMTAIL_IMAGE=grafana/promtail:3.6.8

TEMPO_IMAGE=grafana/tempo:3.0.0-rc.1
TEMPO_PORT=3200

NODE_EXPORTER_IMAGE=prom/node-exporter:v1.9.1

GRAFANA_IMAGE=grafana/grafana:13.0.1-security-01
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
