# Keep services loopback-only unless an external listener is explicitly required.
HVO_INFRA_BIND_ADDRESS=127.0.0.1

MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
MSSQL_SA_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
MSSQL_PID=Developer
MSSQL_MEMORY_LIMIT_MB=4096
MSSQL_PORT=1433

REDIS_IMAGE=redis:7.4-alpine
REDIS_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
REDIS_PORT=6379

MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
MINIO_ROOT_USER=REPLACE_WITH_ADMIN_USERNAME
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

REGISTRY_IMAGE=registry:2
REGISTRY_PORT=5000

RABBITMQ_IMAGE=rabbitmq:4.1-management
RABBITMQ_DEFAULT_USER=REPLACE_WITH_ADMIN_USERNAME
RABBITMQ_DEFAULT_PASS=REPLACE_WITH_A_STRONG_PASSWORD
RABBITMQ_ERLANG_COOKIE=REPLACE_WITH_A_LONG_RANDOM_VALUE
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_MQTT_PORT=1883