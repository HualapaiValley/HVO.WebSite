# EG4 6500EX and MPPT100-48HV read-only telemetry gateway settings.
HVO_WEBSITE_PUBLIC_BASE_URL=https://www.hualapaivalleyobservatory.org
EG4_POWER_API_KEY=REPLACE_ME
EG4_HTTP_PORT=5600
EG4_DEFAULT_POLL_INTERVAL_SECONDS=60

# Stable identities are tied to source/device IDs and fixed physical USB paths,
# never /dev/hidrawN enumeration. Device 0 is the one-device commissioning profile.
EG4_DEVICE_0_ENABLED=true
EG4_DEVICE_0_SOURCE_ID=eg4-6500ex-a
EG4_DEVICE_0_DEVICE_ID=inverter-a
EG4_DEVICE_0_ALIAS=6500EX Inverter A
EG4_DEVICE_0_PORT=/dev/hvo/eg4-6500ex-a
EG4_DEVICE_0_POLL_INTERVAL_SECONDS=60

# Enable only after verifying the stable serial path. The deploy script then adds the
# MPPT overlay; production permits only unit-1 function-0x03 registers 200-217.
EG4_MPPT_0_ENABLED=false
EG4_MPPT_0_SOURCE_ID=eg4-mppt100-48hv-a
EG4_MPPT_0_DEVICE_ID=controller-a
EG4_MPPT_0_ALIAS=MPPT100-48HV Controller A
EG4_MPPT_0_PORT=/dev/serial/by-id/REPLACE_WITH_MPPT_ADAPTER
EG4_MPPT_0_POLL_INTERVAL_SECONDS=60

# The deploy script adds docker-compose.two-device.yml only when this is true.
# Keep false until a second 6500EX HID endpoint and physical USB topology are verified.
EG4_DEVICE_1_ENABLED=false
EG4_DEVICE_1_SOURCE_ID=eg4-6500ex-b
EG4_DEVICE_1_DEVICE_ID=inverter-b
EG4_DEVICE_1_ALIAS=6500EX Inverter B
EG4_DEVICE_1_PORT=/dev/hvo/eg4-6500ex-b
EG4_DEVICE_1_POLL_INTERVAL_SECONDS=60

# Durable outbox retention and forwarding behavior.
EG4_OUTBOX_MAX_RETRY_ATTEMPTS=10
EG4_OUTBOX_MAX_BACKOFF_SECONDS=300
EG4_OUTBOX_SWEEP_INTERVAL_SECONDS=1
EG4_OUTBOX_BATCH_SIZE=500
EG4_OUTBOX_SENT_RETENTION_DAYS=7
EG4_OUTBOX_FAILED_RETENTION_DAYS=30
EG4_OUTBOX_PENDING_WARNING_COUNT=10
EG4_OUTBOX_FAILED_CRITICAL_COUNT=1

# Optional OTLP collector endpoint reachable from the Pi.
OTEL_COLLECTOR_ENDPOINT=
