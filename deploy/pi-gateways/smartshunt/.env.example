# SmartShunt gateway deployment settings
# Copy to .env on the deployment host and fill in site-specific values.

# Required BLE device address for the Victron SmartShunt.
SMARTSHUNT_ADDRESS=AA:BB:CC:DD:EE:FF

# Gateway identity and polling behavior.
SMARTSHUNT_ADAPTER=hci0
SMARTSHUNT_SOURCE_ID=smartshunt-main
SMARTSHUNT_DEVICE_ID=smartshunt-lifepo4
SMARTSHUNT_PUBLIC_ONLY=true
SMARTSHUNT_ENABLE_PRIVATE_ENRICHMENT=false
SMARTSHUNT_SAMPLE_INTERVAL_SECONDS=5
SMARTSHUNT_SNAPSHOT_INTERVAL_SECONDS=15
SMARTSHUNT_PUBLIC_KEEPALIVE_INTERVAL_SECONDS=10
SMARTSHUNT_PRIVATE_REFRESH_INTERVAL_SECONDS=900
SMARTSHUNT_HISTORY_CAPACITY=240
SMARTSHUNT_CONNECTION_TIMEOUT_SECONDS=20
SMARTSHUNT_SAMPLE_STALE_AFTER_SECONDS=60
SMARTSHUNT_OUTBOX_PENDING_WARNING_COUNT=10
SMARTSHUNT_OUTBOX_FAILED_CRITICAL_COUNT=1
SMARTSHUNT_LOW_BATTERY_WARNING_PERCENT=30
SMARTSHUNT_CRITICAL_BATTERY_PERCENT=15

# Azure forwarding. POWER_API_KEY is a secret and must not be committed with a real value.
HVO_WEBSITE_PUBLIC_BASE_URL=https://example.invalid
POWER_API_KEY=replace-with-power-ingest-api-key

# Diagnostics and telemetry.
SMARTSHUNT_EXPOSE_DETAILED_ENDPOINTS=false
OTEL_COLLECTOR_ENDPOINT=
