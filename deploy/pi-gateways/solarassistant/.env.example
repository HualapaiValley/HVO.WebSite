# SolarAssistant gateway deployment on Pi-class edge hosts
# Copy to .env and fill the values for the target Pi.

# SolarAssistant REST endpoint and credentials
SOLAR_ASSISTANT_IP=
SOLAR_ASSISTANT_REST_PORT=80
SOLAR_ASSISTANT_REST_USERNAME=admin
SOLAR_ASSISTANT_REST_PASSWORD=

# Optional MQTT discovery credentials
SOLAR_ASSISTANT_ENABLE_MQTT_DISCOVERY=true
SOLAR_ASSISTANT_MQTT_PORT=1883
SOLAR_ASSISTANT_MQTT_USERNAME=
SOLAR_ASSISTANT_MQTT_PASSWORD=

# Website ingest target and API key
# Default deployed Pi behavior should point at the Azure-hosted website/API.
# Use a local host such as hvo-docker only for intentional development/integration testing.
HVO_WEBSITE_PUBLIC_BASE_URL=https://hvo-website.calmsand-72a6c5ac.westus.azurecontainerapps.io
POWER_API_KEY=

# Optional tuning overrides
SOLAR_ASSISTANT_SNAPSHOT_INTERVAL_SECONDS=30
SOLAR_ASSISTANT_HISTORY_CAPACITY=240
SOLAR_ASSISTANT_REST_STALE_AFTER_SECONDS=120
SOLAR_ASSISTANT_MQTT_STALE_AFTER_SECONDS=120
SOLAR_ASSISTANT_EXPOSE_DETAILED_ENDPOINTS=false
