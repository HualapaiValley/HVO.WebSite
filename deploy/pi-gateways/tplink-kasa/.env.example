# TP-Link/Kasa read-only gateway deployment on Pi-class edge hosts
# Copy to .env and fill values on the target Pi. Do not commit .env.

# Local read-only API. This protects /status and /inventory on the Pi.
KASA_LOCAL_API_KEY=REPLACE_ME
KASA_GATEWAY_ID=hvo-tplink-kasa
KASA_HTTP_PORT=5500

# Runtime defaults
KASA_DEFAULT_PORT=9999
KASA_SOCKET_TIMEOUT_SECONDS=3
KASA_POLL_INTERVAL_SECONDS=60
KASA_MAX_SCAN_HOSTS=256
KASA_MAX_SCAN_CONCURRENCY=64

# Network metadata for operator-initiated setup scans only.
# Normal gateway operation does not scan for new devices.
KASA_NETWORK_0_NAME=observatory
KASA_NETWORK_0_CIDR=192.0.2.0/24
KASA_NETWORK_0_DISCOVERY_ENABLED=false

KASA_NETWORK_1_NAME=home-primary
KASA_NETWORK_1_CIDR=198.51.100.0/24
KASA_NETWORK_1_DISCOVERY_ENABLED=false

KASA_NETWORK_2_NAME=home-secondary
KASA_NETWORK_2_CIDR=203.0.113.0/24
KASA_NETWORK_2_DISCOVERY_ENABLED=false

# Read-only pilot devices. Start with one known non-critical device.
# DeviceId is the vendor deviceId from sysinfo and is the primary identity.
# Host is only the current locator. MAC is a secondary validation hint.
# Keep all command capabilities unset; this deployment is telemetry/status only.
KASA_DEVICE_0_ENABLED=false
KASA_DEVICE_0_DEVICE_ID=
KASA_DEVICE_0_SOURCE_ID=tplink-kasa:pilot-0
KASA_DEVICE_0_HOST=
KASA_DEVICE_0_PORT=9999
KASA_DEVICE_0_MAC_ADDRESS=
KASA_DEVICE_0_NETWORK_NAME=observatory
KASA_DEVICE_0_EXPECTED_MODEL=
KASA_DEVICE_0_EXPECTED_HARDWARE_VERSION=
KASA_DEVICE_0_EXPECTED_SOFTWARE_VERSION=
KASA_DEVICE_0_EXPECTED_CHILD_COUNT=
KASA_DEVICE_0_DEVICE_KIND=Auto

KASA_DEVICE_1_ENABLED=false
KASA_DEVICE_1_DEVICE_ID=
KASA_DEVICE_1_SOURCE_ID=tplink-kasa:pilot-1
KASA_DEVICE_1_HOST=
KASA_DEVICE_1_PORT=9999
KASA_DEVICE_1_MAC_ADDRESS=
KASA_DEVICE_1_NETWORK_NAME=
KASA_DEVICE_1_EXPECTED_MODEL=
KASA_DEVICE_1_EXPECTED_HARDWARE_VERSION=
KASA_DEVICE_1_EXPECTED_SOFTWARE_VERSION=
KASA_DEVICE_1_EXPECTED_CHILD_COUNT=
KASA_DEVICE_1_DEVICE_KIND=Auto

KASA_DEVICE_2_ENABLED=false
KASA_DEVICE_2_DEVICE_ID=
KASA_DEVICE_2_SOURCE_ID=tplink-kasa:pilot-2
KASA_DEVICE_2_HOST=
KASA_DEVICE_2_PORT=9999
KASA_DEVICE_2_MAC_ADDRESS=
KASA_DEVICE_2_NETWORK_NAME=
KASA_DEVICE_2_EXPECTED_MODEL=
KASA_DEVICE_2_EXPECTED_HARDWARE_VERSION=
KASA_DEVICE_2_EXPECTED_SOFTWARE_VERSION=
KASA_DEVICE_2_EXPECTED_CHILD_COUNT=
KASA_DEVICE_2_DEVICE_KIND=Auto
