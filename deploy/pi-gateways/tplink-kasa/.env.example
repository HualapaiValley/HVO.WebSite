# TP-Link/Kasa read-only gateway deployment on Pi-class edge hosts
# Copy to .env and fill values on the target Pi. Do not commit .env.

# Local read-only API. This protects /status and /inventory on the Pi.
KASA_LOCAL_API_KEY=REPLACE_ME
KASA_GATEWAY_ID=hvo-tplink-kasa
KASA_HTTP_PORT=5500

# Runtime defaults
KASA_DEFAULT_PORT=9999
KASA_SOCKET_TIMEOUT_SECONDS=3
KASA_POLL_INTERVAL_SECONDS=5
KASA_MAX_POLL_CONCURRENCY=8
KASA_DASHBOARD_REFRESH_SECONDS=5
KASA_DISPLAY_TIME_ZONE_ID=America/Phoenix
KASA_DEVICE_REGISTRY_PATH=/app/data/kasa-devices.json
KASA_MAX_SCAN_HOSTS=256
KASA_MAX_SCAN_CONCURRENCY=64

# Outbox forwarding to HVO website API.
# Can also be changed at runtime via the Settings page or
# PUT /diagnostics/outbox/settings without restarting the container.
HVO_WEBSITE_PUBLIC_BASE_URL=https://www.hualapaivalleyobservatory.org
KASA_OUTBOX_APIENDPOINT=https://www.hualapaivalleyobservatory.org/api/v1/power/readings
KASA_OUTBOX_APIKEY=
KASA_OUTBOX_MAXRETRYATTEMPTS=10
KASA_OUTBOX_MAXBACKOFFSECONDS=300
KASA_OUTBOX_SWEEPINTERVALSECONDS=1
KASA_OUTBOX_BATCHSIZE=500
KASA_OUTBOX_SENTRETENTIONDAYS=7
KASA_OUTBOX_FAILEDRETENTIONDAYS=30
KASA_OUTBOX_PENDINGWARNINGCOUNT=10
KASA_OUTBOX_FAILEDCRITICALCOUNT=1
KASA_OUTBOX_DBPATH=/app/data/outbox.db

# Optional OTEL collector endpoint reachable from the Pi.
OTEL_COLLECTOR_ENDPOINT=

# Network metadata for operator-initiated setup scans only.
# Normal gateway operation does not scan for new devices.
KASA_NETWORK_0_NAME=Observatory Lan 1
KASA_NETWORK_0_CIDR=192.168.1.0/24
KASA_NETWORK_0_DISCOVERY_ENABLED=true

KASA_NETWORK_1_NAME=Home Lan 1
KASA_NETWORK_1_CIDR=192.168.2.0/24
KASA_NETWORK_1_DISCOVERY_ENABLED=true

KASA_NETWORK_2_NAME=Home Lan 2
KASA_NETWORK_2_CIDR=192.168.9.0/24
KASA_NETWORK_2_DISCOVERY_ENABLED=true

# Read-only pilot devices. Start with one known non-critical device.
# DeviceId is the vendor deviceId from sysinfo and is the primary identity.
# Host is only the current locator. MAC is a secondary validation hint.
# Keep all command capabilities unset; this deployment is telemetry/status only.
KASA_DEVICE_0_ENABLED=false
KASA_DEVICE_0_DEVICE_ID=
KASA_DEVICE_0_SOURCE_ID=tplink-kasa:pilot-0
KASA_DEVICE_0_DISPLAY_NAME=
KASA_DEVICE_0_HOST=
KASA_DEVICE_0_PORT=9999
KASA_DEVICE_0_MAC_ADDRESS=
KASA_DEVICE_0_NETWORK_NAME=Observatory Lan 1
KASA_DEVICE_0_DISPLAY_TIME_ZONE_ID=
KASA_DEVICE_0_EXPECTED_MODEL=
KASA_DEVICE_0_EXPECTED_HARDWARE_VERSION=
KASA_DEVICE_0_EXPECTED_SOFTWARE_VERSION=
KASA_DEVICE_0_EXPECTED_CHILD_COUNT=
KASA_DEVICE_0_DEVICE_KIND=Auto

KASA_DEVICE_1_ENABLED=false
KASA_DEVICE_1_DEVICE_ID=
KASA_DEVICE_1_SOURCE_ID=tplink-kasa:pilot-1
KASA_DEVICE_1_DISPLAY_NAME=
KASA_DEVICE_1_HOST=
KASA_DEVICE_1_PORT=9999
KASA_DEVICE_1_MAC_ADDRESS=
KASA_DEVICE_1_NETWORK_NAME=
KASA_DEVICE_1_DISPLAY_TIME_ZONE_ID=
KASA_DEVICE_1_EXPECTED_MODEL=
KASA_DEVICE_1_EXPECTED_HARDWARE_VERSION=
KASA_DEVICE_1_EXPECTED_SOFTWARE_VERSION=
KASA_DEVICE_1_EXPECTED_CHILD_COUNT=
KASA_DEVICE_1_DEVICE_KIND=Auto

KASA_DEVICE_2_ENABLED=false
KASA_DEVICE_2_DEVICE_ID=
KASA_DEVICE_2_SOURCE_ID=tplink-kasa:pilot-2
KASA_DEVICE_2_DISPLAY_NAME=
KASA_DEVICE_2_HOST=
KASA_DEVICE_2_PORT=9999
KASA_DEVICE_2_MAC_ADDRESS=
KASA_DEVICE_2_NETWORK_NAME=
KASA_DEVICE_2_DISPLAY_TIME_ZONE_ID=
KASA_DEVICE_2_EXPECTED_MODEL=
KASA_DEVICE_2_EXPECTED_HARDWARE_VERSION=
KASA_DEVICE_2_EXPECTED_SOFTWARE_VERSION=
KASA_DEVICE_2_EXPECTED_CHILD_COUNT=
KASA_DEVICE_2_DEVICE_KIND=Auto

KASA_DEVICE_3_ENABLED=false
KASA_DEVICE_3_DEVICE_ID=
KASA_DEVICE_3_SOURCE_ID=tplink-kasa:pilot-3
KASA_DEVICE_3_DISPLAY_NAME=
KASA_DEVICE_3_HOST=
KASA_DEVICE_3_PORT=9999
KASA_DEVICE_3_MAC_ADDRESS=
KASA_DEVICE_3_NETWORK_NAME=
KASA_DEVICE_3_DISPLAY_TIME_ZONE_ID=
KASA_DEVICE_3_EXPECTED_MODEL=
KASA_DEVICE_3_EXPECTED_HARDWARE_VERSION=
KASA_DEVICE_3_EXPECTED_SOFTWARE_VERSION=
KASA_DEVICE_3_EXPECTED_CHILD_COUNT=
KASA_DEVICE_3_DEVICE_KIND=Auto
