# Davis gateway deployment on Pi-class edge hosts
# Copy to .env and fill the values for the target Pi.

# Davis console TCP endpoint
DAVIS_STATION_HOST=192.168.1.210
DAVIS_STATION_PORT=22222

# Website ingest target and API key.
# The website is hosted on hvo-docker behind a Tailscale funnel via the
# Azure proxy VM. Use the public domain for all deployed gateways.
HVO_WEBSITE_PUBLIC_BASE_URL=https://www.hualapaivalleyobservatory.org
DAVIS_API_KEY=

# Outbox forwarding throughput. Increase temporarily during outage backfill.
# These can also be changed at runtime via the Application Settings page or
# PUT /diagnostics/outbox/settings without restarting the container.
OUTBOX_BATCH_SIZE=500
OUTBOX_SWEEP_INTERVAL_SECONDS=1

# Optional OTEL collector endpoint. Leave blank to disable OTLP export.
OTEL_COLLECTOR_ENDPOINT=
