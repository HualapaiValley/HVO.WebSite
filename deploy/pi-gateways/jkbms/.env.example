HVO_WEBSITE_PUBLIC_BASE_URL=https://hvo-website.calmsand-72a6c5ac.westus.azurecontainerapps.io
BMS_API_KEY=REPLACE_ME

# Optional OTEL collector endpoint reachable from the Pi.
OTEL_COLLECTOR_ENDPOINT=

# JK runtime defaults for the Pi deployment.
JKBMS_HCI_ADAPTER=hci0
JKBMS_CONNECT_TIMEOUT_SECONDS=20
JKBMS_EXCHANGE_TIMEOUT_SECONDS=10
JKBMS_DEFAULT_POLL_INTERVAL_SECONDS=30

# Device list. Add, remove, or reindex entries to match the deployed bank set.
JKBMS_DEVICE_0_ADDRESS=C8:47:8C:E4:58:37
JKBMS_DEVICE_0_ALIAS=bank-1a
JKBMS_DEVICE_0_ADAPTER=
JKBMS_DEVICE_0_ENABLED=true

