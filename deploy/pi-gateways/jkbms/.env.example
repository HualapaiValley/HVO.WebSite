# JK BMS: non-secret configuration only. Credentials remain mounted secret files.
# Each comment states purpose, default and whether the setting is required.
# NON-SECRET ONLY: Password/Token/Secret/ApiKey/ConnectionString keys are rejected
# case/separator-insensitively with a generic error. Keep secret-file references
# in gateway.json. Compose *_SECRETS_DIRECTORY paths are ignored app metadata.
# Required pins have no usable default; replace placeholders from a successful CI run.

# Optional; host HTTP port. Default: 5200. Container/probe port stays 8080.
JKBMS_HTTP_PORT=5200

# Required; published semver tag (without 'jkbms-v'). Default: none.
HVO_JKBMS_IMAGE_VERSION=REPLACE_WITH_PUBLISHED_SEMVER
# Required; immutable multi-arch index digest, not a child digest. Default: none.
HVO_JKBMS_IMAGE_DIGEST=sha256:REPLACE_WITH_PUBLISHED_INDEX_DIGEST

# Optional; workstation JSON for deployment preflight/sync. Default: ./gateway.json.
JKBMS_CONFIG_FILE=./gateway.json
# Optional; workstation secret directory for preflight/sync. Default: ./secrets.
JKBMS_SECRETS_DIRECTORY=./secrets
# Required; absolute JSON path on the Docker daemon host. Default: none;
# example below follows the existing host convention. Mount: /app/config/gateway.json.
JKBMS_REMOTE_CONFIG_FILE=/home/roys/.local/share/hvo-edge/jkbms/gateway.json
# Required; absolute daemon-host secret directory beside gateway.json. Default: none;
# example below follows the existing host convention. Mount: /run/secrets (read-only).
JKBMS_REMOTE_SECRETS_DIRECTORY=/home/roys/.local/share/hvo-edge/jkbms/secrets

# Optional; daemon-host runtime directory. Default below; must be beside gateway.json.
# Its .env is read at process startup. A directory mount permits atomic file replacement.
JKBMS_REMOTE_RUNTIME_DIRECTORY=/home/roys/.local/share/hvo-edge/jkbms/runtime

# Optional; OTLP base URL. Compose default below; the runtime loader has no fallback.
# A missing runtime key inherits creation-time env; an explicit empty endpoint disables export.
OTEL_EXPORTER_OTLP_ENDPOINT=http://192.168.1.238:4318
# Optional; OTLP transport. Default: http/protobuf. Also supported: grpc (use its port).
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Optional; telemetry service identity. Default: hvo-jkbms.
OTEL_SERVICE_NAME=hvo-jkbms

# Optional app overrides use Section__Key (including indexed arrays), read at startup.
# Runtime file > real creation-time env > gateway.json > app defaults (intentional).
# Omitted keys inherit existing env/JSON; explicit values, including empty, override it.
# Never put credential values or secret-file reference keys here.
# Example: Outbox__BatchSize=50 (optional; delivery batch size; shared default: 50).
