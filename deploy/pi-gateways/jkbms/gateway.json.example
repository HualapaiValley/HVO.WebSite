{
  "Edge": {
    "Runtime": {
      "ServiceName": "hvo-jkbms",
      "GatewayId": "jkbms",
      "GatewayType": "jk-bms-direct",
      "Domain": "Power",
      "SourceId": "jkbms-fleet",
      "SiteId": "hvo",
      "DisplayName": "JK BMS Direct Collector",
      "DiagnosticsApiKeySecret": "diagnostics-api-key"
    }
  },
  "JkBms": {
    "HciAdapter": "hci0",
    "ConnectTimeoutSeconds": 20,
    "ExchangeTimeoutSeconds": 10,
    "DefaultPollIntervalSeconds": 30,
    "CentralIngestEndpoint": "http://hvo-docker.hvo.lan/api/v1/bms/readings",
    "AllowInsecureCentralIngest": true,
    "CentralApiKeySecret": "central-ingest-api-key",
    "RetryExhaustedRequeueMinutes": 15,
    "Devices": [
      { "Address": "C8:47:8C:E4:58:37", "DeviceId": "bank-1a", "Alias": "bank-1a", "Enabled": true },
      { "Address": "C8:47:8C:E4:56:B0", "DeviceId": "bank-1b", "Alias": "bank-1b", "Enabled": true },
      { "Address": "C8:47:8C:E4:55:71", "DeviceId": "bank-1c", "Alias": "bank-1c", "Enabled": true },
      { "Address": "C8:47:8C:E4:54:B1", "DeviceId": "bank-1d", "Alias": "bank-1d", "Enabled": true },
      { "Address": "C8:47:8C:EC:1B:0F", "DeviceId": "bank-2a", "Alias": "bank-2a", "SettingsPasswordSecret": "jkbms-bank-2a-settings-password", "Enabled": true },
      { "Address": "C8:47:8C:EC:1E:B5", "DeviceId": "bank-2b", "Alias": "bank-2b", "SettingsPasswordSecret": "jkbms-bank-2b-settings-password", "Enabled": true },
      { "Address": "C8:47:8C:EA:FF:2F", "DeviceId": "bank-2c", "Alias": "bank-2c", "SettingsPasswordSecret": "jkbms-bank-2c-settings-password", "Enabled": true }
    ]
  },
  "HomeAssistant": {
    "Mqtt": {
      "Enabled": true,
      "Host": "192.168.1.113",
      "Port": 1883,
      "UsernameSecret": "mqtt-username",
      "PasswordSecret": "mqtt-password",
      "DiscoveryPrefix": "homeassistant",
      "TopicPrefix": "hvo"
    }
  },
  "Outbox": {
    "DatabasePath": "/app/data/outbox.db",
    "PayloadType": "com.hvo.bms.reading.v1",
    "PayloadVersion": "1",
    "BatchSize": 50,
    "SweepIntervalSeconds": 5,
    "MaxRetryAttempts": 10,
    "MaxBackoffSeconds": 300,
    "SentRetentionDays": 1,
    "FailedRetentionDays": 30
  }
}
