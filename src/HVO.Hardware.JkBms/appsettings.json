{
  "JkBms": {
    "ConnectTimeoutSeconds": 20,
    "ExchangeTimeoutSeconds": 10,
    "DefaultPollIntervalSeconds": 30,
    "HciAdapter": "hci0",
    "CentralApiKeySecret": "central-ingest-api-key",
    "RetryExhaustedRequeueMinutes": 15,
    "Devices": []
  },
  "Outbox": {
    "DatabasePath": "/app/data/outbox.db",
    "PayloadType": "com.hvo.bms.reading.v1",
    "PayloadVersion": "1",
    "MaxRetryAttempts": 10,
    "MaxBackoffSeconds": 300,
    "SweepIntervalSeconds": 5,
    "BatchSize": 50,
    "SentRetentionDays": 1,
    "FailedRetentionDays": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
