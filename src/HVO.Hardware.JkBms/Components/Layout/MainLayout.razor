@inherits LayoutComponentBase

<HvoGatewayLayout Subtitle="JK BMS DASHBOARD"
                  FooterSlot1="@_footer1"
                  FooterSlot2="@_footer2"
                  FooterSlot3="@_footer3"
                  FooterSlot4="@_footer4"
                  FooterSlot5="@_footer5"
                  IsDarkMode="@_shellState.IsDarkMode"
                  IsDarkModeChanged="@OnThemeModeChanged">
    <NavItems>
        <MudButton Href="/devices" Variant="@GetNavLinkVariant("Device details")" Color="Color.Inherit" Class="@GetNavLinkClass("Device details")">Device details</MudButton>
        <MudButton Href="/charts" Variant="@GetNavLinkVariant("Full history")" Color="Color.Inherit" Class="@GetNavLinkClass("Full history")">Full history</MudButton>
    </NavItems>
    <AppBarActions>
        <MudIconButton Icon="@ThemeSelectorIcon" Color="Color.Inherit" Size="Size.Medium" aria-label="@ThemeSelectorLabel" OnClick="ToggleTheme" />
    </AppBarActions>
    <Body>@Body</Body>
</HvoGatewayLayout>
