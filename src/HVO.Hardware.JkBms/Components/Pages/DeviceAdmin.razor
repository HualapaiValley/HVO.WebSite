@page "/device/{address}/admin"
@rendermode InteractiveServer
@using HVO.Hardware.JkBms.Configuration
@using HVO.Hardware.JkBms.Workers
@using HVO.WebSite.Themes.Components.Format
@inject JkBmsDisplayTimeZoneResolver DisplayTimeZoneResolver

<div class="shell-page-stack">
    <a class="back-link" href="@($"/device/{Address}")">Back to device stats</a>

    @if (Config is null)
    {
        <section class="jk-card">
            <h1 class="jk-hero-title">Device not found</h1>
            <p class="placeholder-message">No configured BMS device matches <span class="monospace">@Address</span>.</p>
        </section>
    }
    else
    {
        <section class="jk-hero" aria-label="Device administration header">
            <div>
                <div class="jk-eyebrow">Device administration</div>
                <h1 class="jk-hero-title">@Config.Alias</h1>
                <p class="jk-hero-summary">Runtime configuration and operational status for this JK BMS bank.</p>
                <div class="text-secondary monospace">@Config.Address</div>
            </div>
            <div class="jk-hero-meta">
                <div class="jk-stat-chip"><span>Enabled</span><strong>@(Config.Enabled ? "Yes" : "No")</strong></div>
                <div class="jk-stat-chip"><span>Adapter</span><strong>@(string.IsNullOrWhiteSpace(Config.HciAdapter) ? Options.Value.HciAdapter : Config.HciAdapter)</strong></div>
                <div class="jk-stat-chip"><span>Poll interval</span><strong>@EffectivePollIntervalSeconds s</strong></div>
            </div>
        </section>

        <section class="jk-card" aria-label="Device configuration">
            <div class="jk-card-head">
                <div>
                    <div class="jk-card-kicker">Configuration</div>
                    <h2>Polling and hardware identity</h2>
                </div>
                <span class="jk-chart-note">Deployment-managed</span>
            </div>
            <div class="jk-config-grid jk-admin-config-grid">
                <div class="jk-detail-block"><span class="jk-detail-label">Alias</span><strong class="jk-detail-value">@Config.Alias</strong></div>
                <div class="jk-detail-block"><span class="jk-detail-label">Bluetooth address</span><strong class="jk-detail-value monospace">@Config.Address</strong></div>
                <div class="jk-detail-block"><span class="jk-detail-label">HCI adapter</span><strong class="jk-detail-value">@(string.IsNullOrWhiteSpace(Config.HciAdapter) ? Options.Value.HciAdapter : Config.HciAdapter)</strong></div>
                <div class="jk-detail-block"><span class="jk-detail-label">Poll interval</span><strong class="jk-detail-value">@EffectivePollIntervalSeconds seconds</strong></div>
                <div class="jk-detail-block"><span class="jk-detail-label">Session</span><strong class="jk-detail-value">@(State?.IsSessionConnected == true ? "Connected" : "Disconnected")</strong></div>
                <div class="jk-detail-block"><span class="jk-detail-label">Last poll</span><strong class="jk-detail-value">@HvoFormat.Timestamp(State?.LastPollAt, DisplayTimeZoneResolver.TimeZone, "MMM d, HH:mm:ss")</strong></div>
            </div>
        </section>

        <section class="jk-card" aria-label="Device administration links">
            <div class="jk-card-head">
                <div>
                    <div class="jk-card-kicker">Operations</div>
                    <h2>Device tools</h2>
                </div>
            </div>
            <div class="jk-admin-actions">
                <a class="hvo-button hvo-button-primary" href="@($"/device/{Config.Address}")">Open live stats</a>
                <a class="hvo-button" href="/devices">All banks</a>
            </div>
            <p class="text-secondary jk-admin-note">Configuration changes are applied through the gateway deployment environment and require a controlled redeploy.</p>
        </section>
    }
</div>