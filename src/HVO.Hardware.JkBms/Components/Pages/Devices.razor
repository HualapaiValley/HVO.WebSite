@page "/devices"
@rendermode InteractiveServer
@using HVO.Hardware.JkBms.Configuration
@using HVO.Hardware.JkBms.Workers
@using HVO.WebSite.Themes.Components.Format
@inject BmsPollerWorker Poller
@inject Microsoft.Extensions.Options.IOptions<JkBmsOptions> Options

<MudPaper Class="layout-canvas shell-page" Elevation="0" aria-label="JK BMS banks content area">
    <div class="shell-page-stack">
        <section class="jk-hero" aria-label="Configured banks header">
            <div>
                <div class="jk-eyebrow">Banks</div>
                <h1 class="jk-hero-title">Configured JK BMS banks</h1>
                <p class="jk-hero-summary">Deployment inventory and per-bank polling configuration, with quick links into each bank detail page.</p>
            </div>

            <div class="jk-hero-meta">
                <div class="jk-stat-chip">
                    <span>Total banks</span>
                    <strong>@ConfiguredDevices.Count</strong>
                </div>
                <div class="jk-stat-chip">
                    <span>Enabled</span>
                    <strong>@ConfiguredDevices.Count(d => d.Enabled)</strong>
                </div>
                <div class="jk-stat-chip">
                    <span>Default poll</span>
                    <strong>@Options.Value.DefaultPollIntervalSeconds s</strong>
                </div>
            </div>
        </section>

        <section class="jk-table-shell" aria-label="Configured banks table">
            <div class="jk-card-head jk-card">
                <div>
                    <div class="jk-card-kicker">Configuration</div>
                    <h2>Poller device inventory</h2>
                </div>
            </div>
            <div class="jk-table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Alias</th>
                            <th>Address</th>
                            <th>Enabled</th>
                            <th>Poll Interval</th>
                            <th>Consecutive Errors</th>
                            <th>Last Poll</th>
                            <th>Last Error</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cfg in ConfiguredDevices)
                        {
                            var state = Poller.DeviceStates.FirstOrDefault(d => d.Address == cfg.Address);
                            var interval = cfg.PollIntervalSeconds > 0
                                ? cfg.PollIntervalSeconds
                                : Options.Value.DefaultPollIntervalSeconds;

                            <tr class="@(!cfg.Enabled ? "row-disabled" : string.Empty)">
                                <td><a href="/device/@cfg.Address">@cfg.Alias</a></td>
                                <td class="monospace">@cfg.Address</td>
                                <td>@(cfg.Enabled ? "Yes" : "No")</td>
                                <td>@interval s</td>
                                <td>@(state?.ConsecutiveErrors ?? 0)</td>
                                <td>@HvoFormat.Timestamp(state?.LastPollAt, "MMM d, HH:mm:ss")</td>
                                <td>@(state?.LastError ?? "--")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</MudPaper>
