@page "/device/{address}"
@rendermode InteractiveServer
@using HVO.Hardware.JkBms.Protocol.Packets
@using HVO.Hardware.JkBms.Workers
@using HVO.Hardware.JkBms.Configuration
@using HVO.WebSite.Themes.Components.Format
@inject BmsPollerWorker Poller
@inject JkBmsDisplayTimeZoneResolver DisplayTimeZoneResolver

    <div class="shell-page-stack">
        <a class="back-link" href="/">Back to fleet overview</a>

        @if (_state is null)
        {
            <p class="placeholder-message">Device '@Address' not found in configured devices.</p>
        }
        else
        {
            <section class="jk-hero" aria-label="Bank detail header">
                <div>
                    <div class="jk-eyebrow">Bank detail</div>
                    <h1 class="jk-hero-title">@_state.Alias</h1>
                    <p class="jk-hero-summary">Dedicated bank diagnostics, alarms, and configuration details for this battery bank.</p>
                    <div class="text-secondary monospace">@_state.Address</div>
                </div>

                <div class="jk-hero-meta">
                    <div class="jk-stat-chip">
                        <span>Adapter</span>
                        <strong>@_state.AdapterName</strong>
                    </div>
                    <div class="jk-stat-chip">
                        <span>Session</span>
                        <strong>@(_state.IsSessionConnected ? "Connected" : "Disconnected")</strong>
                    </div>
                    <div class="jk-stat-chip">
                        <span>Last poll</span>
                        <strong>@HvoFormat.Timestamp(_state.LastPollAt, DisplayTimeZoneResolver.TimeZone, "MMM d, HH:mm:ss")</strong>
                    </div>
                    <a class="hvo-button" href="@($"/device/{_state.Address}/admin")">Device admin</a>
                </div>
            </section>

            @if (_state.LatestReading is null)
            {
                <p class="placeholder-message">Waiting for first reading…</p>
            }
            else
            {
                var r = _state.LatestReading;
                var ageSeconds = (int)(DateTime.UtcNow - r.RecordedAtUtc).TotalSeconds;
                var currentA = BmsDisplayFormatting.IntoPackCurrentAmps(r.CurrentMa);
                var packVoltageV = r.TotalVoltageMv / 1000.0;
                var packPowerW = BmsDisplayFormatting.IntoPackPowerWatts(r.TotalVoltageMv, r.CurrentMa);

                <section class="jk-card" aria-label="Bank summary">
                    <div class="jk-card-head">
                        <div>
                            <div class="jk-card-kicker">Live bank summary</div>
                            <h2>Pack summary</h2>
                        </div>
                    </div>

                    <div class="jk-gauge-grid">
                        <div class="jk-gauge" style="@BuildGaugeStyle(r.StateOfChargePercent, 0, 100, "var(--hvo-accent-success)")">
                            <div class="jk-gauge-inner">
                                <span>SoC</span>
                                <strong>@r.StateOfChargePercent%</strong>
                            </div>
                        </div>
                        <div class="jk-gauge" style="@BuildGaugeStyle(packVoltageV, 48, 58, "var(--hvo-accent-blue)")">
                            <div class="jk-gauge-inner">
                                <span>Voltage</span>
                                <strong>@HvoFormat.Voltage(packVoltageV)</strong>
                            </div>
                        </div>
                        <div class="jk-gauge" style="@BuildGaugeStyle(Math.Abs(currentA), 0, 300, "var(--hvo-accent-amber)")">
                            <div class="jk-gauge-inner">
                                <span>Current</span>
                                <strong>@HvoFormat.Current(currentA)</strong>
                            </div>
                        </div>
                    </div>

                    <div class="jk-metric-grid">
                        <div class="jk-metric"><span>State of charge</span><strong>@r.StateOfChargePercent%</strong></div>
                        <div class="jk-metric"><span>Pack voltage</span><strong>@HvoFormat.Voltage(packVoltageV)</strong></div>
                        <div class="jk-metric"><span>Pack current</span><strong>@BmsDisplayFormatting.CurrentLabel(r.CurrentMa)</strong></div>
                        <div class="jk-metric"><span>Pack power</span><strong>@BmsDisplayFormatting.PowerLabel(packPowerW)</strong><small class="jk-flow-label">@BmsDisplayFormatting.FlowLabel(packPowerW)</small></div>
                        <div class="jk-metric"><span>Delta cell</span><strong>@r.DeltaCellVoltageMv mV</strong></div>
                        <div class="jk-metric"><span>Remaining</span><strong>@HvoFormat.EnergyAh(r.RemainingCapacityMah / 1000.0)</strong></div>
                        <div class="jk-metric"><span>State of health</span><strong>@r.StateOfHealthPercent%</strong></div>
                    </div>
                </section>

                <section class="jk-detail-grid" aria-label="Bank detail groups">
                    <article class="jk-card">
                        <div class="jk-card-head">
                            <div>
                                <div class="jk-card-kicker">Cells</div>
                            <h2>Cell voltage map</h2>
                            </div>
                        </div>
                        <div class="cell-grid">
                            @for (int i = 0; i < r.CellVoltagesMv.Count; i++)
                            {
                                var mv = r.CellVoltagesMv[i];
                                var cellNum = i + 1;
                                var isHigh = cellNum == r.MaxVoltageCellIndex;
                                var isLow = cellNum == r.MinVoltageCellIndex;
                                <div class="cell-tile @(isHigh ? "cell-highest" : isLow ? "cell-lowest" : string.Empty)">
                                    <div class="cell-num">C@(cellNum)</div>
                                    <div class="cell-mv">@mv</div>
                                    <div class="cell-v">@HvoFormat.Voltage(mv / 1000.0, 3)</div>
                                </div>
                            }
                        </div>
                    </article>

                    @if (r.CellVoltagesMv.Count > 0)
                    {
                        <article class="jk-card">
                            <div class="jk-card-head">
                                <div>
                                    <div class="jk-card-kicker">Chart</div>
                                    <h2>Cell voltage profile</h2>
                                </div>
                            </div>
                            <HvoChart @ref="_cellChart"
                                      ChartId="jk-cell-chart"
                                      Type="HvoChartType.Bar"
                                      Title="Cell Voltages"
                                      YAxisLabel="Voltage (V)"
                                      ShowLegend="false"
                                      Height="220"
                                      EnableAnimations="false"
                                      Labels="@_cellLabels"
                                      Datasets="@_cellDatasets" />
                        </article>
                    }

                    <article class="jk-card">
                        <div class="jk-card-head">
                            <div>
                                <div class="jk-card-kicker">Thermals</div>
                                <h2>Temperatures and balancing</h2>
                            </div>
                        </div>
                        <dl class="jk-detail-list">
                            <div><dt>Battery Temp 1</dt><dd>@HvoFormat.Temperature(r.BatteryTemperature1C)</dd></div>
                            <div><dt>Battery Temp 2</dt><dd>@HvoFormat.Temperature(r.BatteryTemperature2C)</dd></div>
                            <div><dt>Power Tube Temp</dt><dd>@HvoFormat.Temperature(r.PowerTubeTemperatureC)</dd></div>
                            <div><dt>Balancing</dt><dd>@(r.BalancingActive ? $"Active {r.BalancingCurrentMa:F0} mA" : "Inactive")</dd></div>
                        </dl>
                    </article>

                    <article class="jk-card">
                        <div class="jk-card-head">
                            <div>
                                <div class="jk-card-kicker">Electrical flow</div>
                                <h2>Pack power direction</h2>
                            </div>
                            <span class="jk-chart-note">+ into / - out</span>
                        </div>
                        <HvoChart @ref="_powerChart"
                                  ChartId="jk-device-power-chart"
                                  Type="HvoChartType.Bar"
                                  Height="220"
                                  ShowLegend="false"
                                  EnableAnimations="false"
                                  Labels="@_powerLabels"
                                  Datasets="@_powerDatasets" />
                    </article>

                    <article class="jk-card">
                        <div class="jk-card-head">
                            <div>
                                <div class="jk-card-kicker">Capacity</div>
                                <h2>Capacity and cycles</h2>
                            </div>
                        </div>
                        <dl class="jk-detail-list">
                            <div><dt>Remaining</dt><dd>@r.RemainingCapacityMah mAh</dd></div>
                            <div><dt>Nominal</dt><dd>@r.NominalCapacityMah mAh</dd></div>
                            <div><dt>Cycle Count</dt><dd>@r.CycleCount</dd></div>
                            <div><dt>Cycle Capacity</dt><dd>@HvoFormat.EnergyAh(r.CycleCapacityMah / 1000.0)</dd></div>
                        </dl>
                    </article>

                    <article class="jk-card">
                        <div class="jk-card-head">
                            <div>
                                <div class="jk-card-kicker">Connectivity</div>
                            <h2>Connection and poll health</h2>
                            </div>
                        </div>
                        <dl class="jk-detail-list">
                            <div><dt>Reading age</dt><dd>@ageSeconds s</dd></div>
                            <div><dt>Poll interval</dt><dd>@_state.PollIntervalSeconds s</dd></div>
                            <div><dt>Session establishes</dt><dd>@_state.SessionEstablishedCount</dd></div>
                            <div><dt>Session disconnects</dt><dd>@_state.SessionDisconnectedCount</dd></div>
                            <div><dt>Connect failures</dt><dd>@_state.SessionRequestFailureCount</dd></div>
                            <div><dt>Consecutive errors</dt><dd>@_state.ConsecutiveErrors</dd></div>
                            <div><dt>Last connected</dt><dd>@HvoFormat.Timestamp(_state.LastConnectedAt, DisplayTimeZoneResolver.TimeZone, "yyyy-MM-dd HH:mm:ss") @DisplayTimeZoneResolver.Label</dd></div>
                            <div><dt>Last disconnected</dt><dd>@HvoFormat.Timestamp(_state.LastDisconnectedAt, DisplayTimeZoneResolver.TimeZone, "yyyy-MM-dd HH:mm:ss") @DisplayTimeZoneResolver.Label</dd></div>
                        </dl>
                    </article>
                </section>

                <section class="jk-card" aria-label="Alarms">
                    <div class="jk-card-head">
                        <div>
                            <div class="jk-card-kicker">Alarms</div>
                            <h2>Current alarm state</h2>
                        </div>
                    </div>
                    @if (r.AlarmBitmask == 0)
                    {
                        <ul class="alarm-list no-alarms"><li>No alarms active</li></ul>
                    }
                    else
                    {
                        <ul class="alarm-list">
                            @foreach (var name in DecodeAlarms(r.AlarmBitmask))
                            {
                                <li>@name</li>
                            }
                        </ul>
                    }
                </section>

                @if (_state.LatestDeviceInfo is { } info)
                {
                    <section class="jk-card" aria-label="Device information">
                        <div class="jk-card-head">
                            <div>
                                <div class="jk-card-kicker">Identity</div>
                                <h2>Device information</h2>
                            </div>
                        </div>
                        <dl class="jk-detail-list">
                            <div><dt>Manufacturer</dt><dd>@info.ManufacturerName</dd></div>
                            <div><dt>Hardware</dt><dd>@info.HardwareName</dd></div>
                            <div><dt>Firmware</dt><dd>@info.FirmwareVersion</dd></div>
                            @if (!string.IsNullOrEmpty(info.DeviceName))
                            {
                                <div><dt>Device Name</dt><dd>@info.DeviceName</dd></div>
                            }
                            @if (!string.IsNullOrEmpty(info.SerialNumber))
                            {
                                <div><dt>Serial Number</dt><dd>@info.SerialNumber</dd></div>
                            }
                        </dl>
                    </section>
                }

                @if (_state.LatestSettings is { } cfg)
                {
                    <section class="jk-card" aria-label="Configuration summary">
                        <div class="jk-card-head">
                            <div>
                                <div class="jk-card-kicker">Configuration</div>
                            <h2>Configuration summary</h2>
                            </div>
                        </div>
                        <div class="jk-config-grid">
                            <div class="jk-detail-block"><span class="jk-detail-label">Cell Count</span><strong class="jk-detail-value">@cfg.CellCount</strong></div>
                            <div class="jk-detail-block"><span class="jk-detail-label">Nominal Capacity</span><strong class="jk-detail-value">@HvoFormat.EnergyAh(cfg.NominalCapacityMah / 1000.0)</strong></div>
                            <div class="jk-detail-block"><span class="jk-detail-label">Charging</span><strong class="jk-detail-value">@(cfg.ChargingEnabled ? "Enabled" : "Disabled")</strong></div>
                            <div class="jk-detail-block"><span class="jk-detail-label">Discharging</span><strong class="jk-detail-value">@(cfg.DischargingEnabled ? "Enabled" : "Disabled")</strong></div>
                            <div class="jk-detail-block"><span class="jk-detail-label">Balancing</span><strong class="jk-detail-value">@(cfg.BalancingEnabled ? "Enabled" : "Disabled")</strong></div>
                            <div class="jk-detail-block"><span class="jk-detail-label">Balance Start Voltage</span><strong class="jk-detail-value">@HvoFormat.Voltage(cfg.BalanceStartingVoltageMv / 1000.0, 3)</strong></div>
                        </div>
                    </section>
                }
            }
        }
    </div>
