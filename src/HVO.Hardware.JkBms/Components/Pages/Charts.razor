@page "/charts"
@rendermode InteractiveServer
@using HVO.WebSite.Themes.Components.Charts
@using HVO.WebSite.Themes.Components.Format

<div class="shell-page-stack">
    <section class="jk-hero" aria-label="BMS charts header">
        <div>
            <div class="jk-eyebrow">Charts</div>
            <h1 class="jk-hero-title">Battery performance</h1>
            <p class="jk-hero-summary">Compare the fleet over time, then use a bank detail page for cell-level diagnostics.</p>
        </div>
        <div class="jk-chart-toolbar" aria-label="Chart range">
            <span class="jk-chart-note">@DisplayTimeZoneLabel</span>
            @foreach (var option in RangeOptions)
            {
                <button class="hvo-button @(option.Hours == _rangeHours ? "hvo-button-primary" : string.Empty)"
                        type="button"
                        aria-pressed="@(option.Hours == _rangeHours)"
                        @onclick="() => SetRangeAsync(option.Hours)">@option.Label</button>
            }
        </div>
    </section>

    <section class="jk-card" aria-label="BMS chart summary">
        <div class="jk-card-head">
            <div>
                <div class="jk-card-kicker">Today</div>
                <h2>Energy and forecast</h2>
            </div>
            <span class="jk-chart-note">@History.Points.Count.ToString("N0") stored samples</span>
        </div>
        <div class="jk-history-summary">
            <div class="jk-metric"><span>Into pack</span><strong>@DisplayKwh(History.Today.ChargeEnergyKwh)</strong><small>@DisplayAh(History.Today.ChargeAmpHours)</small></div>
            <div class="jk-metric"><span>Out of pack</span><strong>@DisplayKwh(History.Today.DischargeEnergyKwh)</strong><small>@DisplayAh(History.Today.DischargeAmpHours)</small></div>
            <div class="jk-metric"><span>SoC trend</span><strong>@DisplayRate(History.Today.SocRatePercentPerHour)</strong><small>@TrendDescription</small></div>
            <div class="jk-metric"><span>Forecast</span><strong>@DisplayEta(History.Today.TimeToFull ?? History.Today.TimeToEmpty)</strong><small>@ForecastLabel</small></div>
        </div>
    </section>

    @if (History.Points.Count == 0)
    {
        <section class="jk-card"><p class="placeholder-message">No persisted BMS history is available for this range.</p></section>
    }
    else
    {
        <section class="jk-chart-dashboard" aria-label="BMS charts">
            <article class="jk-card jk-chart-panel-wide">
                <div class="jk-card-head"><div><div class="jk-card-kicker">Trend</div><h2>Fleet state of charge</h2></div><span class="jk-chart-note">Average with bank lines</span></div>
                <HvoChart ChartId="jk-history-soc" Type="HvoChartType.Line" Height="320" EnableAnimations="false" DataRevision="@_revision" YAxisSuggestedMin="0" YAxisSuggestedMax="100" Labels="@Labels" Datasets="@SocDatasets" />
            </article>

            <article class="jk-card jk-chart-panel-wide">
                <div class="jk-card-head"><div><div class="jk-card-kicker">Power flow</div><h2>Combined pack power</h2></div><span class="jk-chart-note">+ into / - out</span></div>
                <HvoChart ChartId="jk-history-power" Type="HvoChartType.Line" Height="320" EnableAnimations="false" DataRevision="@_revision" XAxisLabel="@($"Local time ({DisplayTimeZoneLabel})")" YAxisLabel="Watts" Labels="@Labels" Datasets="@PowerDatasets" />
            </article>

            <article class="jk-card">
                <div class="jk-card-head"><div><div class="jk-card-kicker">Current state</div><h2>Bank SoC</h2></div></div>
                <HvoChart ChartId="jk-current-soc" Type="HvoChartType.Bar" Height="260" EnableAnimations="false" DataRevision="@_revision" YAxisSuggestedMin="0" YAxisSuggestedMax="100" Labels="@CurrentSocLabels" Datasets="@CurrentSocDatasets" />
            </article>

            <article class="jk-card">
                <div class="jk-card-head"><div><div class="jk-card-kicker">Today</div><h2>Energy direction</h2></div></div>
                <HvoChart ChartId="jk-today-energy" Type="HvoChartType.Doughnut" Height="260" EnableAnimations="false" DataRevision="@_revision" Labels="@EnergyLabels" Datasets="@EnergyDatasets" />
            </article>

            <article class="jk-card jk-chart-panel-wide">
                <div class="jk-card-head"><div><div class="jk-card-kicker">Thermals</div><h2>Fleet temperature</h2></div><span class="jk-chart-note">Average battery temperature</span></div>
                <HvoChart ChartId="jk-history-temperature" Type="HvoChartType.Line" Height="280" EnableAnimations="false" DataRevision="@_revision" YAxisLabel="°C" Labels="@Labels" Datasets="@TemperatureDatasets" />
            </article>

            <article class="jk-card jk-chart-panel-wide">
                <div class="jk-card-head"><div><div class="jk-card-kicker">Balance</div><h2>Cell imbalance</h2></div><span class="jk-chart-note">Maximum cell delta</span></div>
                <HvoChart ChartId="jk-history-delta" Type="HvoChartType.Line" Height="280" EnableAnimations="false" DataRevision="@_revision" YAxisLabel="mV" Labels="@Labels" Datasets="@DeltaDatasets" />
            </article>
        </section>
    }
</div>