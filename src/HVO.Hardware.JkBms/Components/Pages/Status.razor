@page "/"
@rendermode InteractiveServer
@using HVO.WebSite.Themes.Components.Format

<div class="shell-page-stack jk-dashboard-shell">
    <section class="jk-overview-header" aria-label="Fleet overview header">
        <div>
            <div class="jk-eyebrow">Combined battery system</div>
            <h1 class="jk-overview-title">JK BMS fleet overview</h1>
            <p class="jk-overview-summary">One view of the combined battery banks: charge state, electrical flow, thermal trend, and recent operating history.</p>
        </div>
        <div class="jk-overview-header-actions">
            <div class="jk-live-state"><span class="jk-live-dot" aria-hidden="true"></span><strong>Live</strong><span>@ConnectedBanks/@TotalBanks connected</span></div>
            <a class="hvo-button" href="/devices">Device details</a>
            <a class="hvo-button" href="/charts">Full history</a>
        </div>
    </section>

    <section class="jk-fleet-summary" aria-label="Combined fleet summary">
        <div class="jk-section-heading">
            <div><div class="jk-eyebrow">Live fleet totals</div><h2>Battery system now</h2></div>
            <span class="jk-section-note">@ReportingBanks of @TotalBanks banks reporting</span>
        </div>
        <div class="jk-fleet-metric-grid">
            <article class="jk-fleet-metric jk-fleet-metric--soc">
                <span class="jk-metric-label">State of charge</span>
                <strong>@HvoFormat.Percent(AverageStateOfChargePercent)</strong>
                <small>@DisplaySocRate(Today.SocRatePercentPerHour) current SoC trend</small>
            </article>
            <article class="jk-fleet-metric jk-fleet-metric--voltage">
                <span class="jk-metric-label">Pack voltage</span>
                <strong>@HvoFormat.Voltage(AverageVoltageV)</strong>
                <small>Average bank voltage</small>
            </article>
            <article class="jk-fleet-metric jk-fleet-metric--current">
                <span class="jk-metric-label">Current into pack</span>
                <strong>@DisplayCurrent(CurrentIntoA)</strong>
                <small>Charging current</small>
            </article>
            <article class="jk-fleet-metric jk-fleet-metric--current-out">
                <span class="jk-metric-label">Current out of pack</span>
                <strong>@DisplayCurrent(CurrentOutA, false)</strong>
                <small>Discharge current</small>
            </article>
            <article class="jk-fleet-metric jk-fleet-metric--power">
                <span class="jk-metric-label">Power into pack</span>
                <strong>@DisplayPower(PowerIntoW)</strong>
                <small>Battery charge rate</small>
            </article>
            <article class="jk-fleet-metric jk-fleet-metric--power-out">
                <span class="jk-metric-label">Power out of pack</span>
                <strong>@DisplayPower(PowerOutW, false)</strong>
                <small>Battery discharge rate</small>
            </article>
            <article class="jk-fleet-metric jk-fleet-metric--forecast">
                <span class="jk-metric-label">Hours to full</span>
                <strong>@HoursToFull</strong>
                <small>@ForecastLabel</small>
            </article>
            <article class="jk-fleet-metric jk-fleet-metric--forecast-empty">
                <span class="jk-metric-label">Hours to empty</span>
                <strong>@HoursToEmpty</strong>
                <small>@ForecastLabel</small>
            </article>
        </div>
    </section>

    <section class="jk-trends-section" aria-label="Fleet trend charts">
        <div class="jk-section-heading jk-section-heading--trends">
            <div><div class="jk-eyebrow">Fleet history</div><h2>Electrical and thermal trends</h2></div>
            <div class="jk-range-selector" role="group" aria-label="Chart range">
                @foreach (var option in RangeOptions)
                {
                    <button class="hvo-button jk-range-button @(option.Hours == _rangeHours ? "hvo-button-primary" : string.Empty)"
                            type="button"
                            aria-pressed="@(option.Hours == _rangeHours)"
                            @onclick="() => SetRangeAsync(option.Hours)">@option.Label</button>
                }
            </div>
        </div>

        @if (_trendPoints.Count == 0)
        {
            <div class="jk-empty-state">No persisted fleet history is available for the selected range.</div>
        }
        else
        {
            <div class="jk-chart-grid jk-chart-grid--primary">
                <article class="jk-chart-card">
                    <div class="jk-chart-card-heading"><div><div class="jk-eyebrow">Battery level</div><h3>State of charge</h3></div><span>%</span></div>
                    <HvoChart ChartId="jk-overview-soc" Type="HvoChartType.Line" Height="330" ShowLegend="false" EnableAnimations="false" DataRevision="@_chartRevision" YAxisSuggestedMin="0" YAxisSuggestedMax="100" Labels="@TrendLabels" Datasets="@SocDatasets" />
                </article>
                <article class="jk-chart-card">
                    <div class="jk-chart-card-heading"><div><div class="jk-eyebrow">Battery flow</div><h3>Battery power</h3></div><span>+ in / - out W</span></div>
                    <HvoChart ChartId="jk-overview-power" Type="HvoChartType.Line" Height="330" ShowLegend="false" EnableAnimations="false" DataRevision="@_chartRevision" YAxisLabel="Watts" Labels="@TrendLabels" Datasets="@PowerDatasets" />
                </article>
            </div>
            <div class="jk-chart-grid jk-chart-grid--secondary">
                <article class="jk-chart-card">
                    <div class="jk-chart-card-heading"><div><div class="jk-eyebrow">Electrical</div><h3>Pack voltage</h3></div><span>V</span></div>
                    <HvoChart ChartId="jk-overview-voltage" Type="HvoChartType.Line" Height="270" ShowLegend="false" EnableAnimations="false" DataRevision="@_chartRevision" YAxisLabel="Volts" Labels="@TrendLabels" Datasets="@VoltageDatasets" />
                </article>
                <article class="jk-chart-card">
                    <div class="jk-chart-card-heading"><div><div class="jk-eyebrow">Electrical</div><h3>Pack current</h3></div><span>+ in / - out A</span></div>
                    <HvoChart ChartId="jk-overview-current" Type="HvoChartType.Line" Height="270" ShowLegend="false" EnableAnimations="false" DataRevision="@_chartRevision" YAxisLabel="Amps" Labels="@TrendLabels" Datasets="@CurrentDatasets" />
                </article>
                <article class="jk-chart-card">
                    <div class="jk-chart-card-heading"><div><div class="jk-eyebrow">Thermals</div><h3>Battery temperature</h3></div><span>°C</span></div>
                    <HvoChart ChartId="jk-overview-temperature" Type="HvoChartType.Line" Height="270" ShowLegend="false" EnableAnimations="false" DataRevision="@_chartRevision" YAxisLabel="Celsius" Labels="@TrendLabels" Datasets="@TemperatureDatasets" />
                </article>
            </div>
        }
    </section>

    <section class="jk-daily-section" aria-label="Three day fleet history">
        <div class="jk-section-heading">
            <div><div class="jk-eyebrow">Recent operating history</div><h2>Last three days</h2></div>
            <span class="jk-section-note">@DisplayTimeZoneLabel · battery-side energy</span>
        </div>
        <div class="jk-daily-table-wrap">
            <table class="jk-daily-table">
                <thead>
                    <tr><th scope="col">Day</th><th scope="col">Battery charged</th><th scope="col">Battery discharged</th><th scope="col">Net battery energy</th><th scope="col">High voltage</th><th scope="col">Low voltage</th></tr>
                </thead>
                <tbody>
                    @foreach (var day in _history.DailySummaries)
                    {
                        <tr>
                            <th scope="row">@DisplayDay(day.DayUtc)</th>
                            <td>@DisplayKwh(day.ChargeEnergyKwh)</td>
                            <td>@DisplayKwh(day.DischargeEnergyKwh)</td>
                            <td>@DisplayKwh(day.NetEnergyKwh)</td>
                            <td>@HvoFormat.Voltage(day.HighVoltageV)</td>
                            <td>@HvoFormat.Voltage(day.LowVoltageV)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
