@page "/"
@rendermode InteractiveServer
@using HVO.WebSite.Themes.Components.Format

    <div class="shell-page-stack">
        <section class="jk-hero" aria-label="Fleet overview header">
            <div>
                <div class="jk-eyebrow">Fleet Overview</div>
                <h1 class="jk-hero-title">@PageHeadingText</h1>
                <p class="jk-hero-summary">@PageSummaryText</p>
            </div>

            <div class="jk-hero-meta">
                <div class="jk-stat-chip">
                    <span>Connected banks</span>
                    <strong>@ConnectedBanks / @TotalBanks</strong>
                </div>
                <div class="jk-stat-chip">
                    <span>Fleet charge</span>
                    <strong>@HvoFormat.Percent(AverageStateOfChargePercent)</strong>
                </div>
                <div class="jk-stat-chip">
                    <span>Latest poll</span>
                    <strong>@HvoFormat.Timestamp(LatestPollAtUtc, "MMM d, HH:mm:ss")</strong>
                </div>
            </div>
        </section>

        <section class="jk-card" aria-label="Whole system snapshot">
            <div class="jk-card-head">
                <div>
                    <div class="jk-card-kicker">Fleet summary</div>
                    <h2>Combined battery picture</h2>
                </div>
                <div class="jk-summary-pill">
                    <span>Reporting</span>
                    <strong>@ReportingBanks bank(s)</strong>
                </div>
            </div>

            <div class="jk-gauge-grid">
                <div class="jk-gauge" style="@AverageSocGaugeStyle">
                    <div class="jk-gauge-inner">
                        <span>Avg SoC</span>
                        <strong>@HvoFormat.Percent(AverageStateOfChargePercent)</strong>
                    </div>
                </div>
                <div class="jk-gauge" style="@AverageVoltageGaugeStyle">
                    <div class="jk-gauge-inner">
                        <span>Avg V</span>
                        <strong>@HvoFormat.Voltage(AverageVoltageV)</strong>
                    </div>
                </div>
                <div class="jk-gauge" style="@CurrentGaugeStyle">
                    <div class="jk-gauge-inner">
                        <span>Total A</span>
                        <strong>@HvoFormat.Current(TotalCurrentA)</strong>
                    </div>
                </div>
            </div>

            <div class="jk-metric-grid">
                <div class="jk-metric">
                    <span>Average state of charge</span>
                    <strong>@HvoFormat.Percent(AverageStateOfChargePercent)</strong>
                </div>
                <div class="jk-metric">
                    <span>Average pack voltage</span>
                    <strong>@HvoFormat.Voltage(AverageVoltageV)</strong>
                </div>
                <div class="jk-metric">
                    <span>Total current</span>
                    <strong>@HvoFormat.Current(TotalCurrentA)</strong>
                </div>
                <div class="jk-metric">
                    <span>Total nominal capacity</span>
                    <strong>@HvoFormat.EnergyAh(TotalNominalCapacityAh)</strong>
                </div>
                <div class="jk-metric">
                    <span>Average delta cell</span>
                    <strong>@DisplayMillivolts(AverageDeltaCellMv)</strong>
                </div>
                <div class="jk-metric">
                    <span>Highest battery temp</span>
                    <strong>@HvoFormat.Temperature(MaxBatteryTemperatureC)</strong>
                </div>
            </div>
        </section>

        <section class="jk-card" aria-label="Fleet high and low indicators">
            <div class="jk-card-head">
                <div>
                    <div class="jk-card-kicker">Highlights</div>
                    <h2>High and low bank indicators</h2>
                </div>
            </div>

            <div class="jk-highlight-grid">
                <article class="jk-highlight-card">
                    <span class="jk-highlight-label">Highest SoC bank</span>
                    @if (HighestSocBank is null)
                    {
                        <strong>--</strong>
                        <div class="text-secondary">Waiting for readings</div>
                    }
                    else
                    {
                        <strong>@HighestSocBank.Alias</strong>
                        <div class="jk-highlight-value">@HvoFormat.Percent(HighestSocBank.LatestReading?.StateOfChargePercent)</div>
                    }
                </article>

                <article class="jk-highlight-card">
                    <span class="jk-highlight-label">Lowest SoC bank</span>
                    @if (LowestSocBank is null)
                    {
                        <strong>--</strong>
                        <div class="text-secondary">Waiting for readings</div>
                    }
                    else
                    {
                        <strong>@LowestSocBank.Alias</strong>
                        <div class="jk-highlight-value">@HvoFormat.Percent(LowestSocBank.LatestReading?.StateOfChargePercent)</div>
                    }
                </article>

                <article class="jk-highlight-card">
                    <span class="jk-highlight-label">Highest delta cell</span>
                    @if (HighestDeltaBank is null)
                    {
                        <strong>--</strong>
                        <div class="text-secondary">Waiting for readings</div>
                    }
                    else
                    {
                        <strong>@HighestDeltaBank.Alias</strong>
                        <div class="jk-highlight-value">@DisplayMillivolts(HighestDeltaBank.LatestReading?.DeltaCellVoltageMv)</div>
                    }
                </article>

                <article class="jk-highlight-card">
                    <span class="jk-highlight-label">Hottest bank</span>
                    @if (HottestBank is null)
                    {
                        <strong>--</strong>
                        <div class="text-secondary">Waiting for readings</div>
                    }
                    else
                    {
                        <strong>@HottestBank.Alias</strong>
                        <div class="jk-highlight-value">@HvoFormat.Temperature(HottestBank.LatestReading?.BatteryTemperature1C)</div>
                    }
                </article>
            </div>
        </section>

        <section class="jk-card" aria-label="Fleet bank status board">
            <div class="jk-card-head">
                <div>
                    <div class="jk-card-kicker">Status board</div>
                    <h2>At-a-glance bank grid</h2>
                </div>
                <a class="shell-nav-link" href="/devices">Open banks and config</a>
            </div>

            @if (!Poller.DeviceStates.Any())
            {
                <p class="placeholder-message">No devices configured.</p>
            }
            else
            {
                <div class="jk-ataglance-grid">
                    @foreach (var device in Poller.DeviceStates)
                    {
                        var reading = device.LatestReading;
                        <a class="jk-bank-link" href="/device/@device.Address">
                            <article class="jk-ataglance-card">
                                <div class="jk-bank-title-row jk-bank-title-row-compact">
                                    <div>
                                        <div class="jk-bank-title">@device.Alias</div>
                                        <div class="text-secondary">@BankStatusLabel(device, reading)</div>
                                    </div>
                                    <span class="jk-health-dot @BankStatusClass(device, reading)" aria-hidden="true"></span>
                                </div>

                                <div class="jk-mini-gauge-shell">
                                    <div class="jk-mini-gauge-track">
                                        <div class="jk-mini-gauge-fill" style="@MiniGaugeStyle(reading?.StateOfChargePercent)"></div>
                                    </div>
                                    <div class="jk-mini-gauge-meta">
                                        <span>Charge</span>
                                        <strong>@HvoFormat.Percent(reading?.StateOfChargePercent)</strong>
                                    </div>
                                </div>

                                <div class="jk-ataglance-stats">
                                    <div class="jk-ataglance-stat"><span>Voltage</span><strong>@HvoFormat.Voltage(reading is null ? null : reading.TotalVoltageMv / 1000.0)</strong></div>
                                    <div class="jk-ataglance-stat"><span>Current</span><strong>@HvoFormat.Current(reading is null ? null : reading.CurrentMa / 1000.0)</strong></div>
                                    <div class="jk-ataglance-stat"><span>Delta</span><strong>@DisplayMillivolts(reading?.DeltaCellVoltageMv)</strong></div>
                                    <div class="jk-ataglance-stat"><span>Temp</span><strong>@HvoFormat.Temperature(reading?.BatteryTemperature1C)</strong></div>
                                </div>

                                <div class="jk-ataglance-footer">
                                    <span class="badge @BankBadgeClass(device, reading)">@BankStatusLabel(device, reading)</span>
                                    <span class="text-secondary">@HvoFormat.Timestamp(device.LastPollAt, "MMM d, HH:mm:ss")</span>
                                </div>
                            </article>
                        </a>
                    }
                </div>
            }
        </section>

        <section class="jk-table-shell" aria-label="Fleet balance chart">
            <div class="jk-card-head jk-card">
                <div>
                    <div class="jk-card-kicker">Fleet chart</div>
                    <h2>Bank charge balance</h2>
                </div>
            </div>
            @if (!ReportingDevices.Any())
            {
                <p class="placeholder-message">Charge bars appear after the fleet reports its first readings.</p>
            }
            else
            {
                <div class="jk-balance-list">
                    @foreach (var device in ReportingDevices.OrderByDescending(d => d.LatestReading!.StateOfChargePercent))
                    {
                        <div class="jk-balance-row">
                            <div class="jk-balance-labels">
                                <a href="/device/@device.Address">@device.Alias</a>
                                <span>@HvoFormat.Percent(device.LatestReading?.StateOfChargePercent)</span>
                            </div>
                            <div class="jk-balance-track" aria-hidden="true">
                                <div class="jk-balance-fill" style="@MiniGaugeStyle(device.LatestReading?.StateOfChargePercent)"></div>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
</div>
