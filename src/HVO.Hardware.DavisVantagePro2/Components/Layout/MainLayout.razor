@inherits LayoutComponentBase

<div class="app-shell @(_navOpen ? "nav-open" : null)">
    <button class="nav-scrim" type="button" aria-label="Close navigation" @onclick="CloseDrawer"></button>

    <aside id="weather-nav" class="nav-drawer" aria-label="Weather station navigation" aria-hidden="@(!_navOpen)">
        <div class="nav-topbar">
            <div class="nav-title-block">
                <span class="nav-kicker">Navigation</span>
                <strong>Weather Station</strong>
            </div>
            <button class="nav-close" type="button" aria-label="Close navigation" @onclick="CloseDrawer">&times;</button>
        </div>

        <div class="nav-summary">
            <span class="nav-kicker">Davis Console</span>
            <p>Slide-out navigation for the Hualapai Valley Observatory weather station experience.</p>
        </div>

        <nav class="nav-groups">
            <div class="nav-group">
                <div class="nav-group-label">Dashboard</div>
                <NavLink href="/" Match="NavLinkMatch.All" class="nav-link" ActiveClass="active" @onclick="CloseDrawer">
                    <span class="nav-link-icon">D</span>
                    <span class="nav-link-copy">
                        <strong>Status Dashboard</strong>
                        <span>Live conditions and instrument summary</span>
                    </span>
                    <span class="nav-link-badge">Live</span>
                </NavLink>
                <NavLink href="/archive" class="nav-link" ActiveClass="active" @onclick="CloseDrawer">
                    <span class="nav-link-icon">A</span>
                    <span class="nav-link-copy">
                        <strong>Archive</strong>
                        <span>Stored records and historical retrieval</span>
                    </span>
                    <span class="nav-link-badge">Data</span>
                </NavLink>
            </div>

            <div class="nav-group">
                <div class="nav-group-label">Station</div>
                <NavLink href="/info" class="nav-link" ActiveClass="active" @onclick="CloseDrawer">
                    <span class="nav-link-icon">I</span>
                    <span class="nav-link-copy">
                        <strong>Station Info</strong>
                        <span>Console identity and configuration summary</span>
                    </span>
                </NavLink>
                <NavLink href="/barometer" class="nav-link" ActiveClass="active" @onclick="CloseDrawer">
                    <span class="nav-link-icon">B</span>
                    <span class="nav-link-copy">
                        <strong>Barometer</strong>
                        <span>Pressure calibration and offsets</span>
                    </span>
                </NavLink>
                <NavLink href="/clock" class="nav-link" ActiveClass="active" @onclick="CloseDrawer">
                    <span class="nav-link-icon">C</span>
                    <span class="nav-link-copy">
                        <strong>Clock</strong>
                        <span>Console time and offset controls</span>
                    </span>
                </NavLink>
                <NavLink href="/reception" class="nav-link" ActiveClass="active" @onclick="CloseDrawer">
                    <span class="nav-link-icon">R</span>
                    <span class="nav-link-copy">
                        <strong>Reception</strong>
                        <span>Signal quality and reception detail</span>
                    </span>
                </NavLink>
                <NavLink href="/transmitters" class="nav-link" ActiveClass="active" @onclick="CloseDrawer">
                    <span class="nav-link-icon">T</span>
                    <span class="nav-link-copy">
                        <strong>Transmitters</strong>
                        <span>Battery state and channel health</span>
                    </span>
                </NavLink>
            </div>

            <div class="nav-group">
                <div class="nav-group-label">Setup</div>
                <NavLink href="/settings" class="nav-link" ActiveClass="active" @onclick="CloseDrawer">
                    <span class="nav-link-icon">S</span>
                    <span class="nav-link-copy">
                        <strong>Settings</strong>
                        <span>General console and app preferences</span>
                    </span>
                </NavLink>
                <NavLink href="/calibration" class="nav-link" ActiveClass="active" @onclick="CloseDrawer">
                    <span class="nav-link-icon">K</span>
                    <span class="nav-link-copy">
                        <strong>Calibration</strong>
                        <span>Sensor and offset calibration workflows</span>
                    </span>
                </NavLink>
                <NavLink href="/rain" class="nav-link" ActiveClass="active" @onclick="CloseDrawer">
                    <span class="nav-link-icon">W</span>
                    <span class="nav-link-copy">
                        <strong>Rain Settings</strong>
                        <span>Bucket type and rainfall configuration</span>
                    </span>
                </NavLink>
            </div>
        </nav>

        <div class="nav-footer">
            <div class="pill"><span class="dot"></span>Drawer pattern under review</div>
            <div class="pill">Slide-out navigation with section pills</div>
        </div>
    </aside>

    <CascadingValue Value="this" IsFixed="true">
        <main class="admin-content">
            @Body
        </main>
    </CascadingValue>
</div>

@code {
    private bool _navOpen;

    public void ToggleDrawer()
    {
        _navOpen = !_navOpen;
        _ = InvokeAsync(StateHasChanged);
    }

    public void CloseDrawer()
    {
        _navOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }
}
