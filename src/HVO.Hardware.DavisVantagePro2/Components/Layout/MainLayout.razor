@inherits LayoutComponentBase
@using MudBlazor

<MudThemeProvider Theme="@ShellTheme" IsDarkMode="@_shellState.IsDarkMode" IsDarkModeChanged="@OnThemeModeChanged" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<CascadingValue Value="@_shellState" IsFixed="true">
<MudLayout Class="@LayoutThemeClass">
    <MudAppBar Fixed="true" Elevation="0" Dense="true" Class="shell-appbar">
        <div class="shell-frame shell-bar-content shell-header-frame">
            <div class="shell-brand-block">
                <div class="shell-brand-mark" aria-hidden="true">
                    <MudImage Src="observatory_image.jpg" Alt="" Class="shell-brand-image" />
                </div>
                <div class="shell-brand-copy">
                    <MudText Typo="Typo.h5" Class="shell-brand-text">Hualapai Valley Observatory</MudText>
                    <MudText Typo="Typo.caption" Class="shell-brand-subtitle">DAVIS WEATHER DASHBOARD</MudText>
                </div>
            </div>
            <nav class="shell-header-nav" aria-label="Primary navigation">
                <MudButton Href="/" Variant="@GetNavLinkVariant("Overview")" Color="Color.Inherit" Class="@GetNavLinkClass("Overview")">Overview</MudButton>
                <MudButton Href="/alarms" Variant="@GetNavLinkVariant("Alerts")" Color="Color.Inherit" Class="@GetNavLinkClass("Alerts")">Alerts</MudButton>
                <MudButton Href="/archive" Variant="@GetNavLinkVariant("Archive")" Color="Color.Inherit" Class="@GetNavLinkClass("Archive")">Archive</MudButton>
                <MudButton Href="/console-settings" Variant="@GetNavLinkVariant("Configuration")" Color="Color.Inherit" Class="@GetNavLinkClass("Configuration")">Configuration</MudButton>
            </nav>
            <MudSpacer />
            <div class="shell-header-actions" aria-label="Header actions">
                <MudIconButton Icon="@Icons.Material.Outlined.HelpOutline" Color="Color.Inherit" Size="Size.Medium" aria-label="Open station information summary" OnClick="OpenStationInfoDialog" />
                <MudIconButton Icon="@ThemeSelectorIcon" Color="Color.Inherit" Size="Size.Medium" aria-label="@ThemeSelectorLabel" OnClick="@ToggleTheme" />
            </div>
        </div>
    </MudAppBar>

    <MudMainContent Class="shell-main">
        <div class="shell-frame shell-content">
            @if (SiteState.IsInitialized)
            {
                @Body
            }
            else
            {
                <MudPaper Class="layout-canvas shell-page shell-loading-screen" Elevation="0" aria-label="Dashboard initialization status">
                    <div class="shell-loading-card">
                        <MudStack Class="shell-page-stack shell-loading-stack" Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="2">
                            @if (SiteState.HasBlockingInitializationFailure)
                            {
                                <MudIcon Icon="@Icons.Material.Outlined.WarningAmber" Color="Color.Warning" Size="Size.Large" />
                                <MudText Typo="Typo.h4">Dashboard initialization failed</MudText>
                                <MudText Typo="Typo.body1" Align="Align.Center">@SiteState.InitializationError</MudText>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RetryInitializationAsync">Retry initialization</MudButton>
                            }
                            else
                            {
                                <MudProgressCircular Indeterminate="true" Size="Size.Large" Color="Color.Primary" />
                                <MudText Typo="Typo.h4">Initializing Davis dashboard</MudText>
                                <MudText Typo="Typo.body1" Align="Align.Center">Loading cached console identity and one-shot station details before rendering the requested page.</MudText>
                            }
                        </MudStack>
                    </div>
                </MudPaper>
            }
        </div>
    </MudMainContent>

    <MudAppBar Bottom="true" Fixed="true" Elevation="0" Dense="true" Class="shell-appbar shell-appbar-footer">
        <div class="shell-frame shell-bar-content shell-footer-frame">
            <div class="shell-footer-layout" aria-label="Footer sections">
                <MudText Typo="Typo.caption" Class="shell-footer-slot shell-footer-slot-1">
                    @if (GetFooterIndicatorClass(_shellState.FooterSlot1.Indicator) is { } slot1IndicatorClass)
                    {
                        <span class="@slot1IndicatorClass" aria-hidden="true"></span>
                    }
                    @_shellState.FooterSlot1.Text
                </MudText>
                <MudText Typo="Typo.caption" Class="shell-footer-slot shell-footer-slot-2">@_shellState.FooterSlot2.Text</MudText>
                <MudText Typo="Typo.caption" Class="shell-footer-slot shell-footer-slot-3">@_shellState.FooterSlot3.Text</MudText>
                <MudText Typo="Typo.caption" Class="shell-footer-slot shell-footer-slot-4">@_shellState.FooterSlot4.Text</MudText>
                <MudText Typo="Typo.caption" Class="shell-footer-slot shell-footer-slot-5">
                    @if (GetFooterIndicatorClass(_shellState.FooterSlot5.Indicator) is { } slot5IndicatorClass)
                    {
                        <span class="@slot5IndicatorClass" aria-hidden="true"></span>
                    }
                    @_shellState.FooterSlot5.Text
                </MudText>
            </div>
        </div>
    </MudAppBar>

    @if (_showStationInfoDialog)
    {
        <div class="shell-info-dialog-backdrop" @onclick="CloseStationInfoDialog">
            <div class="shell-info-dialog" role="dialog" aria-modal="true" aria-labelledby="shell-info-dialog-title" @onclick:stopPropagation="true">
                <div class="shell-info-dialog-header">
                    <div>
                        <MudText Typo="Typo.overline" Class="shell-info-dialog-eyebrow">Station Summary</MudText>
                        <MudText Typo="Typo.h5" id="shell-info-dialog-title">Console identity and clock</MudText>
                    </div>
                    <MudIconButton Icon="@Icons.Material.Outlined.Close" Color="Color.Inherit" Size="Size.Small" aria-label="Close station information summary" OnClick="CloseStationInfoDialog" />
                </div>

                <div class="shell-info-dialog-grid">
                    <div class="shell-info-dialog-item"><span>Hardware</span><strong>@StationHardwareDescriptionText</strong></div>
                    <div class="shell-info-dialog-item"><span>Hardware Type</span><strong>@StationHardwareTypeText</strong></div>
                    <div class="shell-info-dialog-item"><span>Model Type</span><strong>@StationModelTypeText</strong></div>
                    <div class="shell-info-dialog-item"><span>Firmware Version</span><strong>@StationFirmwareVersionText</strong></div>
                    <div class="shell-info-dialog-item"><span>Firmware Date</span><strong>@StationFirmwareDateText</strong></div>
                    <div class="shell-info-dialog-item"><span>Console Time</span><strong class="shell-info-dialog-mono">@StationConsoleTimeText</strong></div>
                    <div class="shell-info-dialog-item"><span>Time Zone</span><strong>@SiteState.ConsoleTimeZoneLabel</strong></div>
                    <div class="shell-info-dialog-item"><span>Snapshot</span><strong>@StationSnapshotStatusText</strong></div>
                </div>

                <MudText Typo="Typo.body2" Class="shell-info-dialog-note">
                    Editable console settings stay in Configuration so the same data is not maintained in multiple places.
                </MudText>
            </div>
        </div>
    }

    <div id="blazor-error-ui" data-nosnippet>
        <div class="shell-blazor-error-card">
            <div class="shell-blazor-error-copy">
                <strong>Blazor circuit interrupted</strong>
                <span>An unhandled error has occurred. Reload to recover the dashboard session.</span>
            </div>
            <div class="shell-blazor-error-actions">
                <a href="." class="reload">Reload</a>
                <button type="button" class="dismiss" aria-label="Dismiss error message">Dismiss</button>
            </div>
        </div>
    </div>

    <div id="components-reconnect-modal" data-nosnippet></div>
</MudLayout>
</CascadingValue>
