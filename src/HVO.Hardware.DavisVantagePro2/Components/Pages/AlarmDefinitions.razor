@page "/alarms"
@page "/alarms/definitions"
@rendermode InteractiveServer

<PrototypeFrame Eyebrow="Alarms / Definitions" Title="Alarm Definitions">
    <HeaderAside>
        <button class="proto-button" type="button">Refresh</button>
        <button class="proto-button success" type="button">Save definitions</button>
        <button class="proto-button primary" type="button">Create rule</button>
    </HeaderAside>

    <ChildContent>

        <div class="proto-alarm-grid">
            <aside class="proto-sidebar-card">
                <div class="proto-section-head">
                    <div>
                        <div class="proto-eyebrow">Rule List</div>
                        <h2>Alarm Sources</h2>
                    </div>
                </div>
                <div class="proto-list-stack">
                    <div class="proto-list-item"><strong>Console thresholds</strong><span>Wind speed above 32
                        mph</span><span>Rain 15-minute total above 0.15 in</span><span>Outside temperature below 34
                        F</span></div>
                        <div class="proto-list-item"><strong>System alarms</strong><span>No packets received for 120
                            seconds</span><span>Consecutive errors above 5</span></div>
                            <div class="proto-list-item"><strong>Software-derived alarms</strong><span>Pending outbox count
                                above 500</span><span>Archive sync lag above 6 hours</span></div>
                            </div>
                        </aside>

                        <div class="proto-list-stack">
                            <section class="proto-card">
                                <div class="proto-section-head">
                                    <div>
                                        <div class="proto-eyebrow">Rule Editor</div>
                                        <h2>High Wind</h2>
                                    </div>
                                    <span class="proto-badge critical">Critical</span>
                                </div>
                                <div class="proto-form-grid">
                                    <div class="proto-field"><label class="proto-field-label">Rule type</label><select
                                        class="proto-select">
                                        <option selected>Console threshold</option>
                                        <option>System alarm</option>
                                        <option>Software-derived</option>
                                    </select></div>
                                    <div class="proto-field"><label class="proto-field-label">Source group</label><select
                                        class="proto-select">
                                        <option selected>Wind</option>
                                        <option>Rain</option>
                                        <option>Worker</option>
                                        <option>Outbox</option>
                                    </select></div>
                                    <div class="proto-field"><label class="proto-field-label">Source field</label><select
                                        class="proto-select">
                                        <option selected>Wind speed mph</option>
                                        <option>Wind gust mph</option>
                                        <option>Wind speed 10-minute mph</option>
                                    </select></div>
                                    <div class="proto-field"><label class="proto-field-label">Trigger mode</label><select
                                        class="proto-select">
                                        <option selected>Above threshold</option>
                                        <option>Below threshold</option>
                                        <option>Duration exceeded</option>
                                    </select></div>
                                    <div class="proto-field"><label class="proto-field-label">Threshold</label><input
                                        class="proto-input proto-mono" value="32" /></div>
                                        <div class="proto-field"><label class="proto-field-label">Units</label><input
                                            class="proto-input" value="mph" /></div>
                                            <div class="proto-field"><label class="proto-field-label">Clear behavior</label><select
                                                class="proto-select">
                                                <option selected>Auto clear when normal</option>
                                                <option>Manual clear</option>
                                            </select></div>
                                            <div class="proto-field"><label class="proto-field-label">Severity</label><select
                                                class="proto-select">
                                                <option>Info</option>
                                                <option>Warning</option>
                                                <option selected>Critical</option>
                                            </select></div>
                                            <div class="proto-field"><label class="proto-field-label">Destinations</label><input
                                                class="proto-input" value="Email Ops, SMS Night, Discord Hook" /></div>
                                                <div class="proto-field"><label class="proto-field-label">Reminder interval</label><input
                                                    class="proto-input proto-mono" value="20 min" /></div>
                                                </div>
                                                <div class="proto-toggle" style="margin-top: 18px;">
                                                    <span class="proto-toggle-track"></span>
                                                    <span>Enabled</span>
                                                </div>
                                            </section>

                                            <section class="proto-card">
                                                <div class="proto-section-head">
                                                    <div>
                                                        <div class="proto-eyebrow">Console-native Threshold Editor</div>
                                                        <h2>Current Console Threshold Values</h2>
                                                    </div>
                                                </div>
                                                <div class="proto-tab-row">
                                                    <span class="proto-badge success">Barometer</span>
                                                    <span class="proto-badge">Temperature</span>
                                                    <span class="proto-badge">Humidity</span>
                                                    <span class="proto-badge">Wind</span>
                                                    <span class="proto-badge">Rain/ET</span>
                                                    <span class="proto-badge">Solar/UV</span>
                                                    <span class="proto-badge">Soil/Leaf</span>
                                                </div>
                                                <div class="proto-threshold-grid" style="margin-top: 18px;">
                                                    <div class="proto-threshold-chip"><span>Wind speed</span><strong class="proto-mono">32
                                                        mph</strong></div>
                                                        <div class="proto-threshold-chip"><span>10-minute wind</span><strong class="proto-mono">28
                                                            mph</strong></div>
                                                            <div class="proto-threshold-chip"><span>Rain 15-minute</span><strong class="proto-mono">0.15
                                                                in</strong></div>
                                                                <div class="proto-threshold-chip"><span>Rain 24-hour</span><strong class="proto-mono">1.20
                                                                    in</strong></div>
                                                                    <div class="proto-threshold-chip"><span>Solar radiation</span><strong class="proto-mono">950
                                                                        W/m^2</strong></div>
                                                                        <div class="proto-threshold-chip"><span>UV index</span><strong class="proto-mono">8.0</strong>
                                                                        </div>
                                                                    </div>
                                                                    <div class="proto-action-row" style="margin-top: 18px;">
                                                                        <button class="proto-button success" type="button">Save threshold block</button>
                                                                        <button class="proto-button danger" type="button">Clear thresholds</button>
                                                                        <button class="proto-button danger" type="button">Clear active bits</button>
                                                                    </div>
                                                                </section>

                                                                <section class="proto-note-card">
                                                                    <div class="proto-section-head">
                                                                        <div>
                                                                            <div class="proto-eyebrow">Examples</div>
                                                                            <h2>Rule Examples</h2>
                                                                        </div>
                                                                    </div>
                                                                    <div class="proto-list-stack">
                                                                        <div class="proto-list-item"><strong>Console threshold</strong><span>Wind speed above 32
                                                                            mph</span></div>
                                                                            <div class="proto-list-item"><strong>Console threshold</strong><span>Rain 15-minute total above
                                                                                0.15 in</span></div>
                                                                                <div class="proto-list-item"><strong>System alarm</strong><span>No packets received for 120
                                                                                    seconds</span></div>
                                                                                    <div class="proto-list-item"><strong>Software-derived</strong><span>Pending outbox count above
                                                                                        500 for 10 minutes</span></div>
                                                                                        <div class="proto-list-item"><strong>Software-derived</strong><span>Archive sync lag above 6
                                                                                            hours</span></div>
                                                                                        </div>
                                                                                    </section>
                                                                                </div>
                                                                            </div>
                                                                        </ChildContent>
                                                                    </PrototypeFrame>