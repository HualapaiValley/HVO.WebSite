@page "/alarms/history"
@rendermode InteractiveServer

<div class="alarm-history-page">
    <div class="shell-page-stack alarm-history-stack">
        <h1 class="hvo-visually-hidden">Alarm History</h1>

        <div class="hvo-action-row">
            <div class="hvo-chip"><span>Date range</span><strong class="hvo-mono">Last 7 days</strong></div>
            <button class="hvo-button" type="button">Export</button>
        </div>

        <section class="hvo-card-shell">
            <div class="hvo-action-row">
                <div class="hvo-field"><label class="hvo-field-label">Start</label><input
                    class="hvo-control hvo-mono" type="datetime-local" value="2026-05-01T00:00" /></div>
                <div class="hvo-field"><label class="hvo-field-label">End</label><input
                    class="hvo-control hvo-mono" type="datetime-local" value="2026-05-08T23:59" /></div>
                <div class="hvo-field"><label class="hvo-field-label">State</label><select class="hvo-control">
                    <option selected>All</option>
                    <option>Open</option>
                    <option>Cleared</option>
                    <option>Acknowledged</option>
                </select></div>
                <div class="hvo-field"><label class="hvo-field-label">Severity</label><select class="hvo-control">
                    <option selected>All</option>
                    <option>Info</option>
                    <option>Warning</option>
                    <option>Critical</option>
                </select></div>
                <div class="hvo-field"><label class="hvo-field-label">Source</label><select class="hvo-control">
                    <option selected>All</option>
                    <option>Console</option>
                    <option>Station worker</option>
                    <option>Outbox</option>
                </select></div>
            </div>
        </section>

        <div class="hvo-grid">
            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">Alarm Activation History</div>
                        <h2>Events</h2>
                    </div>
                </div>
                <div class="hvo-table-wrap">
                    <table class="hvo-table">
                        <thead>
                            <tr>
                                <th>Time UTC</th>
                                <th>Alarm</th>
                                <th>Source</th>
                                <th>Severity</th>
                                <th>State</th>
                                <th>Route</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="hvo-mono">08 May 2026 - 8:11 PM UTC</td>
                                <td>High wind</td>
                                <td>ISS</td>
                                <td>Critical</td>
                                <td>Open</td>
                                <td>Email Ops</td>
                            </tr>
                            <tr>
                                <td class="hvo-mono">07 May 2026 - 4:22 AM UTC</td>
                                <td>No packets</td>
                                <td>Station worker</td>
                                <td>Warning</td>
                                <td>Cleared</td>
                                <td>SMS Night</td>
                            </tr>
                            <tr>
                                <td class="hvo-mono">07 May 2026 - 12:14 AM UTC</td>
                                <td>Outbox backlog</td>
                                <td>Forwarder</td>
                                <td>Warning</td>
                                <td>Acknowledged</td>
                                <td>Discord Hook</td>
                            </tr>
                            <tr>
                                <td class="hvo-mono">06 May 2026 - 7:48 PM UTC</td>
                                <td>Rain 15 min</td>
                                <td>Console</td>
                                <td>Warning</td>
                                <td>Cleared</td>
                                <td>Email Ops</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">Detail Drawer</div>
                        <h2>High Wind</h2>
                    </div>
                    <span class="hvo-chip hvo-chip-danger">Open</span>
                </div>
                <div class="hvo-stack">
                    <div class="hvo-list-item"><strong>Activation</strong>
                        <div class="hvo-grid"><span>Triggered at</span><span class="hvo-mono">08 May 2026 - 8:11 PM UTC</span><span>Cleared at</span><span>—</span><span>Acknowledged
                            at</span><span>—</span></div>
                    </div>
                    <div class="hvo-list-item"><strong>Rule snapshot</strong><span>Console threshold · Wind speed
                        above 32 mph · Critical · Auto clear</span></div>
                    <div class="hvo-list-item"><strong>Observed value</strong><span class="hvo-mono">37 mph at
                        channel 1 ISS</span></div>
                    <div class="hvo-list-item"><strong>Delivery attempts</strong><span>Email Ops ·
                        Sent</span><span>SMS Night · Pending reminder</span></div>
                    <div class="hvo-list-item"><strong>Related snapshot</strong><span class="hvo-mono">Loop
                        timestamp 08 May 2026 - 8:10 PM UTC · Archive timestamp 08 May 2026 - 8:00 PM UTC</span></div>
                </div>
            </section>
        </div>
    </div>
</div>
