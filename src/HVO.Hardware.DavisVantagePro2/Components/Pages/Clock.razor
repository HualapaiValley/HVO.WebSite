@page "/clock"
@rendermode InteractiveServer

<div class="clock-page">
    <div class="shell-page-stack clock-stack">
        <h1 class="hvo-visually-hidden">Clock</h1>

        <div class="hvo-action-row">
            <div class="hvo-chip"><span>Drift</span><strong class="hvo-mono">5.0 s</strong></div>
            <div class="hvo-chip"><span>Timezone</span><strong>Arizona (MST)</strong></div>
            <button class="hvo-button hvo-button-primary" type="button">Sync now</button>
        </div>

        <div class="hvo-grid">
            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">GETTIME / SETTIME</div>
                        <h2>Console Time</h2>
                    </div>
                </div>
                <div class="hvo-grid">
                    <div class="hvo-list-item"><span>Console time</span><strong class="hvo-mono">08 May 2026 - 2:34 PM</strong></div>
                    <div class="hvo-list-item"><span>Host time</span><strong class="hvo-mono">08 May 2026 - 2:34 PM</strong></div>
                    <div class="hvo-list-item"><span>Drift</span><strong class="hvo-mono">5.0 s</strong></div>
                    <div class="hvo-list-item"><span>Time zone label</span><strong>Arizona (MST)</strong></div>
                </div>
            </section>

            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">Sync Workflow</div>
                        <h2>Operator Guidance</h2>
                    </div>
                </div>
                <div class="hvo-stack">
                    <div class="hvo-list-item"><strong>Recommended trigger</strong><span>Sync after replacing console batteries or after any prolonged disconnect.</span></div>
                    <div class="hvo-list-item"><strong>Dependency</strong><span>Timezone mode and GMT offset live in the Settings page.</span></div>
                </div>
            </section>
        </div>
    </div>
</div>
