@page "/clock"
@rendermode InteractiveServer

<PrototypeFrame Eyebrow="Clock" Title="Clock">
    <HeaderAside>
        <div class="proto-pill"><span>Drift</span><strong class="proto-mono">5.0 s</strong></div>
        <div class="proto-pill"><span>Timezone</span><strong>Arizona (MST)</strong></div>
        <button class="proto-button primary" type="button">Sync now</button>
    </HeaderAside>

    <ChildContent>
        <div class="proto-grid">
            <section class="proto-card">
                <div class="proto-section-head">
                    <div>
                        <div class="proto-eyebrow">GETTIME / SETTIME</div>
                        <h2>Console Time</h2>
                    </div>
                </div>
                <div class="proto-detail-grid">
                    <div class="proto-stat"><span>Console time</span><strong class="proto-mono">08 May 2026 - 2:34 PM</strong></div>
                    <div class="proto-stat"><span>Host time</span><strong class="proto-mono">08 May 2026 - 2:34 PM</strong></div>
                    <div class="proto-stat"><span>Drift</span><strong class="proto-mono">5.0 s</strong></div>
                    <div class="proto-stat"><span>Time zone label</span><strong>Arizona (MST)</strong></div>
                </div>
            </section>

            <section class="proto-card">
                <div class="proto-section-head">
                    <div>
                        <div class="proto-eyebrow">Sync Workflow</div>
                        <h2>Operator Guidance</h2>
                    </div>
                </div>
                <div class="proto-list-stack">
                    <div class="proto-list-item"><strong>Recommended trigger</strong><span>Sync after replacing console batteries or after any prolonged disconnect.</span></div>
                    <div class="proto-list-item"><strong>Dependency</strong><span>Timezone mode and GMT offset live in the Settings page.</span></div>
                </div>
            </section>
        </div>
    </ChildContent>
</PrototypeFrame>

