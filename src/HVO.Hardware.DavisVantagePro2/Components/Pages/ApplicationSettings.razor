@page "/application-settings"
@rendermode InteractiveServer
@using HVO.Edge.Outbox

<div class="application-settings-page">
    <div class="shell-page-stack application-settings-stack">
        <h1 class="hvo-visually-hidden">Application Settings</h1>

        <div class="hvo-action-row">
            <div class="hvo-chip"><span>Environment</span><strong>Production</strong></div>
            <div class="hvo-chip"><span>Config source</span><strong>appsettings.Production.json</strong></div>
            <div class="hvo-chip"><span>Outbox settings</span><strong>Runtime (no restart)</strong></div>
        </div>

        <div class="hvo-grid">
            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">Station Worker</div>
                        <h2>Worker Configuration</h2>
                    </div>
                    <button class="hvo-button hvo-button-success" type="button">Save worker settings</button>
                </div>
                <div class="hvo-form-grid">
                    <div class="hvo-field"><label class="hvo-field-label">Host</label><input class="hvo-control"
                        value="192.168.10.44" /></div>
                    <div class="hvo-field"><label class="hvo-field-label">Port</label><input
                        class="hvo-control hvo-mono" type="number" min="1" max="65535" step="1" required value="22222" /></div>
                    <div class="hvo-field"><label class="hvo-field-label">Socket timeout (s)</label><input
                        class="hvo-control hvo-mono" type="number" min="1" max="300" step="1" required value="20" /></div>
                    <div class="hvo-field"><label class="hvo-field-label">Max consecutive errors</label><input
                        class="hvo-control hvo-mono" type="number" min="1" max="100" step="1" required value="5" /></div>
                    <div class="hvo-field"><label class="hvo-field-label">Station ID</label><input
                        class="hvo-control" value="HVO-DAVIS-01" /></div>
                </div>
            </section>

            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">Archive Catch-up</div>
                        <h2>Archive Catch-up</h2>
                    </div>
                    <button class="hvo-button hvo-button-primary" type="button">Run top-off now</button>
                </div>
                <div class="hvo-grid">
                    <div class="hvo-list-item"><span>Startup mode</span><strong>Enabled</strong></div>
                    <div class="hvo-list-item"><span>Lookback hours</span><strong class="hvo-mono">48</strong></div>
                    <div class="hvo-list-item"><span>Latest persisted</span><strong class="hvo-mono">08 May 2026 - 2:20 PM</strong></div>
                    <div class="hvo-list-item"><span>Sync lag</span><strong class="hvo-mono">00:15:00</strong></div>
                </div>
            </section>
        </div>

        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">Outbox / API Forwarder</div>
                    <h2>Outbox Configuration</h2>
                </div>
                @if (_isOverride)
                {
                    <button class="hvo-button hvo-button-warning" type="button" @onclick="ResetSettingsAsync">Reset to defaults</button>
                }
                <button class="hvo-button hvo-button-success" type="button" @onclick="SaveSettingsAsync" disabled="@(!_dirty)">Save outbox settings</button>
            </div>
            <div class="hvo-form-grid">
                <div class="hvo-field">
                    <label class="hvo-field-label">Batch size <span class="text-secondary">(1–500)</span></label>
                    <input class="hvo-control hvo-mono" type="number" min="1" max="500" step="1" required
                        @bind-value="_batchSize" @bind-value:event="oninput" />
                </div>
                <div class="hvo-field">
                    <label class="hvo-field-label">Sweep interval (s) <span class="text-secondary">(1–60)</span></label>
                    <input class="hvo-control hvo-mono" type="number" min="1" max="60" step="1" required
                        @bind-value="_sweepIntervalSeconds" @bind-value:event="oninput" />
                </div>
            </div>
            <div class="hvo-grid" style="margin-top: 18px;">
                <div class="hvo-list-item"><span>Pending count</span><strong class="hvo-mono">@Forwarder.PendingCount</strong></div>
                <div class="hvo-list-item"><span>Failed count</span><strong class="hvo-mono">@Forwarder.FailedCount</strong></div>
                <div class="hvo-list-item"><span>Last sweep</span><strong class="hvo-mono">@FormatLastSweep()</strong></div>
                @if (!string.IsNullOrWhiteSpace(_lastSaveMessage))
                {
                    <div class="hvo-list-item"><span>Status</span><strong>@_lastSaveMessage</strong></div>
                }
            </div>
        </section>

        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">Local Cache / Snapshot</div>
                    <h2>Cached Station Snapshot</h2>
                </div>
                <button class="hvo-button hvo-button-primary" type="button">Refresh cached settings</button>
            </div>
            <div class="hvo-grid" style="grid-template-columns: repeat(3, minmax(0, 1fr));">
                <div class="hvo-list-item"><span>Saved at</span><strong class="hvo-mono">08 May 2026 - 2:33 PM</strong></div>
                <div class="hvo-list-item"><span>Snapshot freshness</span><strong class="hvo-mono">1m 49s</strong></div>
                <div class="hvo-list-item"><span>Startup action</span><strong>Would run catch-up</strong></div>
            </div>
        </section>
    </div>
</div>
