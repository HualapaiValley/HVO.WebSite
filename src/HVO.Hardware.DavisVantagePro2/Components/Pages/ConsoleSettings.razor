@page "/console-settings"
@rendermode InteractiveServer

<div class="console-settings-page">
        <div class="shell-page-stack console-settings-stack">
            <h1 class="page-heading">Configuration</h1>

            <section class="hvo-card-shell console-settings-shell">
                <div class="console-settings-tab-actions">
                    <MudIconButton Icon="@Icons.Material.Outlined.Refresh" Color="Color.Inherit" Size="Size.Small" aria-label="Refresh configuration data from console" OnClick="RefreshConfigurationAsync" Disabled="@IsPageRefreshBusy" />
                </div>

                <MudTabs Class="console-settings-tabs" Rounded="true" Elevation="0" ApplyEffectsToContainer="true">
                    <MudTabPanel Text="Hardware Configuration" Class="console-settings-tab-panel">
                        <div class="hvo-stack console-settings-tab-stack">
            <section class="hvo-card-shell">
                @if (IsClockBusy)
                {
                    <div class="console-settings-busy-overlay" aria-hidden="true">
                        <div class="console-settings-spinner"></div>
                    </div>
                }
                <div class="hvo-section-head">
                    <div>
                        <h2>Clock</h2>
                    </div>
                </div>
                <fieldset class="console-settings-clock-fieldset" disabled="@IsClockSectionBusy" aria-busy="@IsClockSectionBusy">
                <div class="hvo-form-grid console-settings-time-grid">
                    <div class="hvo-field">
                        <label class="hvo-field-label">Console time</label>
                        <input class="hvo-control hvo-mono"
                               type="datetime-local"
                               step="1"
                               @bind-value="EditableConsoleTime"
                               @bind-value:format="yyyy-MM-ddTHH:mm:ss"
                               disabled="@IsClockSectionBusy"
                               aria-label="Console clock time" />
                    </div>
                    <div class="hvo-field"><label class="hvo-field-label">@ReferenceTimeLabel</label><input class="hvo-control hvo-mono" type="text" value="@ReferenceTimeText" readonly /></div>
                    <div class="hvo-field"><label class="hvo-field-label">Drift</label><input class="hvo-control hvo-mono" type="text" value="@DriftText" readonly /></div>
                </div>
                <div class="hvo-action-row console-settings-actions console-settings-clock-actions">
                    @if (!string.IsNullOrWhiteSpace(DisplayedClockStatusMessage))
                    {
                        <p class="@ClockStatusClass" role="status">@DisplayedClockStatusMessage</p>
                    }
                    <button class="hvo-button hvo-button-success" type="button" @onclick="SyncClockAsync" disabled="@IsClockSectionBusy">
                        @if (IsClockBusy)
                        {
                            <span class="console-settings-button-spinner" aria-hidden="true"></span>
                            <span>Syncing...</span>
                        }
                        else
                        {
                            <span>Sync Now</span>
                        }
                    </button>
                </div>
                </fieldset>
            </section>

            <section class="hvo-card-shell">
                @if (IsLocationSectionBusy)
                {
                    <div class="console-settings-busy-overlay" aria-hidden="true">
                        <div class="console-settings-spinner"></div>
                    </div>
                }
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">EEPROM Settings</div>
                        <h2>Location, Time Zone, And Logging</h2>
                    </div>
                </div>
                <fieldset class="console-settings-clock-fieldset" disabled="@IsLocationSectionBusy" aria-busy="@IsLocationSectionBusy">
                <div class="hvo-form-grid console-settings-location-grid">
                    <div class="hvo-field"><label class="hvo-field-label">Latitude</label><input class="hvo-control hvo-mono" type="number" min="-90" max="90" step="0.0001" required @bind="EditableLatitude" /></div>
                    <div class="hvo-field"><label class="hvo-field-label">Longitude</label><input class="hvo-control hvo-mono" type="number" min="-180" max="180" step="0.0001" required @bind="EditableLongitude" /></div>
                    <div class="hvo-field"><label class="hvo-field-label">Station location altitude (ft)</label><input class="hvo-control hvo-mono" type="number" min="0" max="20000" step="1" required @bind="EditableAltitudeFeet" /></div>
                    <div class="hvo-field"><label class="hvo-field-label">DST mode</label><select class="hvo-control" @bind="EditableDstMode"><option value="Auto">AUTO</option><option value="On">ON</option><option value="Off">OFF</option></select></div>
                    <div class="hvo-field"><label class="hvo-field-label">Time zone</label><select class="hvo-control" @bind="EditableTimeZoneCode">@if (!EditableTimeZoneCode.HasValue)
                        {
                            <option value="">Choose a time zone</option>
                        }
                        @foreach (var option in AvailableTimeZones)
                        {
                            <option value="@option.Code">@option.Label</option>
                        }</select></div>
                    <div class="hvo-field"><label class="hvo-field-label">Temperature logging</label><select class="hvo-control" @bind="EditableTemperatureLogging"><option value="Average">AVERAGE</option><option value="Last">LAST</option></select></div>
                </div>
                <div class="hvo-action-row console-settings-actions console-settings-location-actions">
                    @if (!string.IsNullOrWhiteSpace(DisplayedLocationStatusMessage))
                    {
                        <p class="@LocationStatusClass" role="status">@DisplayedLocationStatusMessage</p>
                    }
                    <button class="hvo-button hvo-button-success" type="button" @onclick="SaveLocationSettingsAsync" disabled="@IsLocationSectionBusy">
                        @if (IsLocationSettingsBusy)
                        {
                            <span class="console-settings-button-spinner" aria-hidden="true"></span>
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span>Save</span>
                        }
                    </button>
                </div>
                </fieldset>
            </section>

            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">Console Unit Settings</div>
                        <h2>Detected Console Units</h2>
                    </div>
                </div>
                <div class="console-settings-readonly-panel console-settings-units-panel">
                    <div class="hvo-form-grid console-settings-units-grid">
                        <div class="hvo-field"><label class="hvo-field-label">Barometer</label><select class="hvo-control" @bind="EditableBarometerUnits">@foreach (var option in AvailableBarometerUnits)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }</select></div>
                        <div class="hvo-field"><label class="hvo-field-label">Temperature</label><select class="hvo-control" @bind="EditableTemperatureUnits">@foreach (var option in AvailableTemperatureUnits)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }</select></div>
                        <div class="hvo-field"><label class="hvo-field-label">Rain</label><select class="hvo-control" @bind="EditableRainUnits">@foreach (var option in AvailableRainUnits)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }</select></div>
                        <div class="hvo-field"><label class="hvo-field-label">Wind</label><select class="hvo-control" @bind="EditableWindUnits">@foreach (var option in AvailableWindUnits)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }</select></div>
                    </div>
                    <div class="hvo-action-row console-settings-actions console-settings-units-actions">
                        <p class="@UnitSettingsStatusClass" role="status">@UnitSettingsStatusMessage</p>
                        <button class="hvo-button hvo-button-success" type="button" disabled>Save</button>
                    </div>
                </div>
            </section>

            <section class="hvo-card-shell">
                @if (IsRainArchiveBusy)
                {
                    <div class="console-settings-busy-overlay" aria-hidden="true">
                        <div class="console-settings-spinner"></div>
                    </div>
                }
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">Rain And Archive</div>
                        <h2>Rain And Archive Settings</h2>
                    </div>
                </div>
                <fieldset class="console-settings-clock-fieldset" disabled="@IsRainArchiveBusy" aria-busy="@IsRainArchiveBusy">
                    <div class="hvo-form-grid console-settings-rain-grid">
                        <div class="hvo-field"><label class="hvo-field-label">Archive interval</label><select class="hvo-control" @bind="EditableArchiveIntervalMinutes">@foreach (var option in AvailableArchiveIntervals)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }</select></div>
                        <div class="hvo-field"><label class="hvo-field-label">Rain bucket type</label><select class="hvo-control" @bind="EditableRainBucketType">@foreach (var option in AvailableRainBucketTypes)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }</select></div>
                        <div class="hvo-field"><label class="hvo-field-label">Rain year start month</label><select class="hvo-control" @bind="EditableRainYearStartMonth">@if (!EditableRainYearStartMonth.HasValue)
                            {
                                <option value="">Choose month</option>
                            }
                            @foreach (var option in AvailableRainYearMonths)
                            {
                                <option value="@option.Value">@option.Label</option>
                            }</select></div>
                    </div>
                    <div class="hvo-action-row console-settings-actions console-settings-rain-actions">
                        @if (!string.IsNullOrWhiteSpace(DisplayedRainArchiveStatusMessage))
                        {
                            <p class="@RainArchiveStatusClass" role="status">@DisplayedRainArchiveStatusMessage</p>
                        }
                        <button class="hvo-button hvo-button-success" type="button" @onclick="SaveRainArchiveSettingsAsync" disabled="@IsRainArchiveBusy">
                            @if (IsRainArchiveBusy)
                            {
                                <span class="console-settings-button-spinner" aria-hidden="true"></span>
                                <span>Saving...</span>
                            }
                            else
                            {
                                <span>Save</span>
                            }
                        </button>
                    </div>
                </fieldset>
            </section>

            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">Barometer</div>
                        <h2>Barometer Calibration</h2>
                    </div>
                </div>
                <div class="hvo-form-grid console-settings-barometer-grid">
                    <div class="hvo-field"><label class="hvo-field-label">Reference pressure (inHg)</label><input class="hvo-control hvo-mono" type="number" min="20" max="35" step="0.001" required value="29.991" /></div>
                    <div class="hvo-field"><label class="hvo-field-label">Barometer altitude (ft)</label><input class="hvo-control hvo-mono" type="number" min="0" max="20000" step="1" required value="3491" /></div>
                </div>
                <div class="hvo-action-row console-settings-actions">
                    <p class="console-settings-pending-status" role="status">@PendingSectionWriteMessage</p>
                    <button class="hvo-button hvo-button-success" type="button" disabled>Save</button>
                </div>
            </section>

            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">Console Actions</div>
                        <h2>Direct Actions</h2>
                    </div>
                </div>
                <div class="hvo-action-row console-settings-actions">
                    <button class="hvo-button" type="button">Lamp On</button>
                    <button class="hvo-button" type="button">Lamp Off</button>
                    <button class="hvo-button hvo-button-danger" type="button">Clear Alarm</button>
                </div>
            </section>

                        </div>
                    </MudTabPanel>

                    <MudTabPanel Text="Sensor Offsets" Class="console-settings-tab-panel">
                        <div class="hvo-stack console-settings-tab-stack">
                            <section class="hvo-card-shell">
                                <div class="hvo-section-head">
                                    <div>
                                        <div class="hvo-eyebrow">Calibration</div>
                                        <h2>Sensor Offsets</h2>
                                    </div>
                                </div>
                                <div class="console-settings-subsection">
                                    <h3>Temperature Offsets</h3>
                                    <div class="hvo-form-grid console-settings-offset-grid">
                                        @foreach (var field in TemperatureCalibrationFields)
                                        {
                                            <div class="hvo-field"><label class="hvo-field-label">@field.Label</label><input class="hvo-control hvo-mono" type="number" min="-12.8" max="12.7" step="0.1" placeholder="@field.PlaceholderValue" data-variable="@field.Variable" /></div>
                                        }
                                    </div>
                                </div>
                                <div class="console-settings-subsection">
                                    <h3>Humidity Offsets</h3>
                                    <div class="hvo-form-grid console-settings-offset-grid">
                                        @foreach (var field in HumidityCalibrationFields)
                                        {
                                            <div class="hvo-field"><label class="hvo-field-label">@field.Label</label><input class="hvo-control hvo-mono" type="number" min="-100" max="100" step="1" placeholder="@field.PlaceholderValue" data-variable="@field.Variable" /></div>
                                        }
                                    </div>
                                </div>
                                <div class="console-settings-subsection">
                                    <h3>Wind Offset</h3>
                                    <div class="hvo-form-grid console-settings-offset-grid">
                                        <div class="hvo-field"><label class="hvo-field-label">Wind direction offset (deg)</label><input class="hvo-control hvo-mono" type="number" min="-359" max="359" step="1" placeholder="0" data-variable="windDir" /></div>
                                    </div>
                                </div>
                                <div class="hvo-action-row console-settings-actions">
                                    <p class="console-settings-pending-status" role="status">@PendingSectionWriteMessage</p>
                                    <button class="hvo-button hvo-button-success" type="button" disabled>Save</button>
                                </div>
                            </section>
                        </div>
                    </MudTabPanel>

                    <MudTabPanel Text="Transmitters" Class="console-settings-tab-panel">
                        <div class="hvo-stack console-settings-tab-stack">
                            <section class="hvo-card-shell">
                                <div class="hvo-section-head">
                                    <div>
                                        <div class="hvo-eyebrow">Transmitters</div>
                                        <h2>Transmitter Configuration</h2>
                                    </div>
                                </div>
                                <div class="proto-hvo-table-wrap">
                                    <table class="hvo-table console-settings-transmitter-table">
                                        <thead>
                                            <tr>
                                                <th>Channel</th>
                                                <th>Type</th>
                                                <th>Repeater</th>
                                                <th>Extra temp sensor</th>
                                                <th>Extra humidity sensor</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var row in TransmitterRows)
                                            {
                                                <tr>
                                                    <td>@row.Channel</td>
                                                    <td>
                                                        <select class="hvo-control">
                                                            @foreach (var option in AvailableTransmitterTypes)
                                                            {
                                                                <option value="@option.Value" selected="@(option.Value == row.TypeValue)">@option.Label</option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td>
                                                        <select class="hvo-control">
                                                            @foreach (var option in AvailableRepeaterOptions)
                                                            {
                                                                <option value="@option.Value" selected="@(option.Value == row.RepeaterValue)">@option.Label</option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td>
                                                        <select class="hvo-control">
                                                            @foreach (var option in AvailableSensorIdOptions)
                                                            {
                                                                <option value="@option.Value" selected="@(option.Value == row.ExtraTempValue)">@option.Label</option>
                                                            }
                                                        </select>
                                                    </td>
                                                    <td>
                                                        <select class="hvo-control">
                                                            @foreach (var option in AvailableSensorIdOptions)
                                                            {
                                                                <option value="@option.Value" selected="@(option.Value == row.ExtraHumidityValue)">@option.Label</option>
                                                            }
                                                        </select>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <div class="hvo-form-grid console-settings-rain-grid" style="margin-top: 0.85rem;">
                                    <div class="hvo-field"><label class="hvo-field-label">Retransmit channel</label><select class="hvo-control">@foreach (var option in AvailableRetransmitChannels)
                                        {
                                            <option value="@option.Value">@option.Label</option>
                                        }</select></div>
                                </div>
                                <div class="proto-pill-row" style="margin-top: 18px;">
                                    <div class="proto-pill"><span>Heard transmitters</span><strong>1, 3, 6</strong></div>
                                </div>
                                <div class="hvo-action-row console-settings-actions">
                                    <p class="console-settings-pending-status" role="status">@PendingSectionWriteMessage</p>
                                    <button class="hvo-button hvo-button-success" type="button" disabled>Save</button>
                                </div>
                            </section>
                        </div>
                    </MudTabPanel>

                    <MudTabPanel Text="Software Configuration" Class="console-settings-tab-panel">
                        <div class="hvo-stack console-settings-tab-stack">
                    <section class="hvo-card-shell">
                        <div class="hvo-section-head">
                            <div>
                                <div class="hvo-eyebrow">Station Worker</div>
                                <h2>Worker Configuration</h2>
                            </div>
                        </div>
                        <div class="hvo-form-grid console-settings-worker-grid">
                            <div class="hvo-field"><label class="hvo-field-label">Host</label><input class="hvo-control" value="192.168.10.44" /></div>
                            <div class="hvo-field"><label class="hvo-field-label">Port</label><input class="hvo-control hvo-mono" type="number" min="1" max="65535" step="1" required value="22222" /></div>
                            <div class="hvo-field"><label class="hvo-field-label">Socket timeout (s)</label><input class="hvo-control hvo-mono" type="number" min="1" max="300" step="1" required value="20" /></div>
                            <div class="hvo-field"><label class="hvo-field-label">Max consecutive errors</label><input class="hvo-control hvo-mono" type="number" min="1" max="100" step="1" required value="5" /></div>
                            <div class="hvo-field"><label class="hvo-field-label">Station ID</label><input class="hvo-control" value="HVO-DAVIS-01" /></div>
                        </div>
                        <div class="hvo-action-row console-settings-actions">
                            <button class="hvo-button hvo-button-success" type="button">Save</button>
                        </div>
                    </section>

                    <section class="hvo-card-shell">
                        <div class="hvo-section-head">
                            <div>
                                <div class="hvo-eyebrow">Archive Catch-up</div>
                                <h2>Archive Catch-up</h2>
                            </div>
                        </div>
                        <div class="hvo-grid console-settings-catchup-grid">
                            <div class="hvo-list-item"><span>Startup mode</span><strong>Enabled</strong></div>
                            <div class="hvo-list-item"><span>Lookback hours</span><strong class="hvo-mono">48</strong></div>
                            <div class="hvo-list-item"><span>Latest persisted</span><strong class="hvo-mono">08 May 2026 - 2:20 PM</strong></div>
                            <div class="hvo-list-item"><span>Sync lag</span><strong class="hvo-mono">00:15:00</strong></div>
                        </div>
                        <div class="hvo-action-row console-settings-actions">
                            <button class="hvo-button hvo-button-primary" type="button">Run Now</button>
                        </div>
                    </section>

                    <section class="hvo-card-shell">
                        <div class="hvo-section-head">
                            <div>
                                <div class="hvo-eyebrow">Outbox / API Forwarder</div>
                                <h2>Outbox Configuration</h2>
                            </div>
                        </div>
                        <div class="hvo-form-grid console-settings-outbox-grid">
                            <div class="hvo-field"><label class="hvo-field-label">API endpoint</label><input class="hvo-control" value="https://weather-api.hvo.local/api/weather" /></div>
                            <div class="hvo-field"><label class="hvo-field-label">API key</label><input class="hvo-control" value="••••••••••••••••••••" /></div>
                            <div class="hvo-field"><label class="hvo-field-label">Batch size</label><input class="hvo-control hvo-mono" type="number" min="1" max="1000" step="1" required value="100" /></div>
                            <div class="hvo-field"><label class="hvo-field-label">Sweep interval (s)</label><input class="hvo-control hvo-mono" type="number" min="1" max="3600" step="1" required value="30" /></div>
                            <div class="hvo-field"><label class="hvo-field-label">Max retry attempts</label><input class="hvo-control hvo-mono" type="number" min="0" max="100" step="1" required value="10" /></div>
                            <div class="hvo-field"><label class="hvo-field-label">Max backoff (s)</label><input class="hvo-control hvo-mono" type="number" min="1" max="3600" step="1" required value="300" /></div>
                            <div class="hvo-field"><label class="hvo-field-label">SQLite DB path</label><input class="hvo-control" value="/var/lib/hvo/davis/outbox.db" /></div>
                        </div>
                        <div class="hvo-list-item-grid console-settings-outbox-stats">
                            <div class="hvo-list-item"><span>Pending count</span><strong class="hvo-mono">12</strong></div>
                            <div class="hvo-list-item"><span>Failed count</span><strong class="hvo-mono">0</strong></div>
                            <div class="hvo-list-item"><span>Last sweep</span><strong class="hvo-mono">08 May 2026 - 2:34 PM</strong></div>
                        </div>
                        <div class="hvo-action-row console-settings-actions">
                            <button class="hvo-button hvo-button-success" type="button">Save</button>
                        </div>
                    </section>

                    <section class="hvo-card-shell">
                        <div class="hvo-section-head">
                            <div>
                                <div class="hvo-eyebrow">Local Cache / Snapshot</div>
                                <h2>Cached Station Snapshot</h2>
                            </div>
                        </div>
                        <div class="hvo-grid console-settings-snapshot-grid">
                            <div class="hvo-list-item"><span>Saved at</span><strong class="hvo-mono">08 May 2026 - 2:33 PM</strong></div>
                            <div class="hvo-list-item"><span>Snapshot freshness</span><strong class="hvo-mono">1m 49s</strong></div>
                            <div class="hvo-list-item"><span>Startup action</span><strong>Would run catch-up</strong></div>
                        </div>
                        <div class="hvo-action-row console-settings-actions">
                            <button class="hvo-button hvo-button-primary" type="button">Refresh</button>
                        </div>
                    </section>
                        </div>
                    </MudTabPanel>
                </MudTabs>
            </section>
        </div>
</div>