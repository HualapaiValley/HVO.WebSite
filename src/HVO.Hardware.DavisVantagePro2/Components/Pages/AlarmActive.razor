@page "/alarms/active"
@rendermode InteractiveServer

<div class="alarm-active-page">
    <div class="shell-page-stack alarm-active-stack">
        <h1 class="hvo-visually-hidden">Active Alarms</h1>

        <div class="hvo-action-row">
            <div class="hvo-chip"><span>Open alarms</span><strong class="hvo-mono">2</strong></div>
            <div class="hvo-chip"><span>Critical</span><strong class="hvo-mono">1</strong></div>
            <button class="hvo-button" type="button">Refresh</button>
        </div>

        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">Open Alarms</div>
                    <h2>Current Alarm State</h2>
                </div>
            </div>
            <div class="hvo-stack">
                <div class="hvo-list-item">
                    <div class="hvo-action-row">
                        <strong>High wind</strong>
                        <span class="hvo-chip hvo-chip-danger">Critical</span>
                    </div>
                    <div class="hvo-stack">
                        <span>Source</span><span>ISS</span>
                        <span>Open since</span><span class="hvo-mono">08 May 2026 - 8:11 PM UTC</span>
                        <span>Current value</span><span class="hvo-mono">37 mph</span>
                    </div>
                    <div class="hvo-action-row">
                        <button class="hvo-button hvo-button-primary" type="button">Acknowledge</button>
                        <button class="hvo-button" type="button">View history</button>
                    </div>
                </div>

                <div class="hvo-list-item">
                    <div class="hvo-action-row">
                        <strong>No packets</strong>
                        <span class="hvo-chip hvo-chip-warning">Warning</span>
                    </div>
                    <div class="hvo-stack">
                        <span>Source</span><span>Station worker</span>
                        <span>Open since</span><span class="hvo-mono">08 May 2026 - 8:13 PM UTC</span>
                        <span>Current value</span><span class="hvo-mono">145 sec</span>
                    </div>
                    <div class="hvo-action-row">
                        <button class="hvo-button hvo-button-primary" type="button">Acknowledge</button>
                        <button class="hvo-button" type="button">Retry</button>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>
