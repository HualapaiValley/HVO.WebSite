@page "/prototype/station-info"
@rendermode InteractiveServer

<div class="station-diagnostics-page">
    <div class="shell-page-stack station-diagnostics-stack">
        <h1 class="hvo-visually-hidden">Station Info</h1>

        <div class="hvo-action-row">
            <div class="hvo-chip">
                <span>Console time</span>
                <strong class="hvo-mono">08 May 2026 - 2:34 PM</strong>
            </div>
            <div class="hvo-chip">
                <span>Last refresh</span>
                <strong class="hvo-mono">08 May 2026 - 2:35 PM</strong>
            </div>
            <button class="hvo-button hvo-button-primary" type="button">Refresh</button>
        </div>

        <div class="hvo-grid">
            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">Identity</div>
                        <h2>Hardware Profile</h2>
                    </div>
                </div>
                <div class="hvo-grid">
                    <div class="hvo-list-item"><span>Hardware name</span><strong>Vantage Vue</strong></div>
                    <div class="hvo-list-item"><span>Hardware type</span><strong>17</strong></div>
                    <div class="hvo-list-item"><span>Model type</span><strong>2</strong></div>
                </div>
                <div class="hvo-grid" style="margin-top: 18px;">
                    <div class="hvo-list-item"><span>Firmware version</span><strong>3.15</strong></div>
                    <div class="hvo-list-item"><span>Firmware date</span><strong>Mar 29 2013</strong></div>
                </div>
            </section>

            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">Clock Health</div>
                        <h2>Time Alignment</h2>
                    </div>
                </div>
                <div class="hvo-grid">
                    <div class="hvo-list-item"><span>Console time</span><strong class="hvo-mono">08 May 2026 - 2:34 PM</strong></div>
                    <div class="hvo-list-item"><span>System time</span><strong class="hvo-mono">08 May 2026 - 2:34 PM</strong></div>
                    <div class="hvo-list-item"><span>Drift</span><strong class="hvo-mono">5.0 s</strong></div>
                    <div class="hvo-list-item"><span>Time zone</span><strong>Arizona (MST)</strong></div>
                </div>
                <div class="hvo-action-row" style="margin-top: 18px;">
                    <button class="hvo-button hvo-button-primary" type="button">Sync now</button>
                    <button class="hvo-button" type="button">Open console settings</button>
                </div>
            </section>
        </div>

        <div class="hvo-grid">
            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">Reception</div>
                        <h2>Reception Stats</h2>
                    </div>
                </div>
                <div class="hvo-grid">
                    <div class="hvo-list-item"><span>Packets received</span><strong class="hvo-mono">12345</strong></div>
                    <div class="hvo-list-item"><span>Packets missed</span><strong class="hvo-mono">67</strong></div>
                    <div class="hvo-list-item"><span>Resync count</span><strong class="hvo-mono">2</strong></div>
                    <div class="hvo-list-item"><span>CRC errors</span><strong class="hvo-mono">3</strong></div>
                    <div class="hvo-list-item"><span>Longest good stretch</span><strong class="hvo-mono">12340</strong></div>
                    <div class="hvo-list-item"><span>Reception percent</span><strong class="hvo-mono">99.46%</strong></div>
                </div>
            </section>

            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">Transmitters</div>
                        <h2>Heard Channels</h2>
                    </div>
                </div>
                <div class="hvo-stack">
                    <div class="hvo-list-item">
                        <strong>Channels heard now</strong>
                        <div class="hvo-chip-row">
                            <span class="hvo-chip">1 · ISS</span>
                            <span class="hvo-chip">3 · Temp/Humidity</span>
                            <span class="hvo-chip">6 · Soil</span>
                        </div>
                    </div>
                    <div class="hvo-list-item">
                        <strong>Last refreshed</strong>
                        <span class="hvo-mono">08 May 2026 - 2:35 PM</span>
                    </div>
                    <div class="hvo-list-item">
                        <strong>Configured vs heard</strong>
                        <span>Configured 1, 3, 4, 6, 8 · Heard 1, 3, 6</span>
                    </div>
                </div>
            </section>
        </div>

        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">Barometer Service</div>
                    <h2>Barometer Data</h2>
                </div>
                <button class="hvo-button" type="button">Open barometer calibration</button>
            </div>
            <div class="hvo-grid" style="grid-template-columns: repeat(3, minmax(0, 1fr));">
                <div class="hvo-list-item"><span>Current pressure</span><strong class="hvo-mono">29.990 inHg</strong></div>
                <div class="hvo-list-item"><span>Altitude</span><strong class="hvo-mono">4500 ft</strong></div>
                <div class="hvo-list-item"><span>Dew point</span><strong class="hvo-mono">55 F</strong></div>
                <div class="hvo-list-item"><span>Virtual temp</span><strong class="hvo-mono">62 F</strong></div>
                <div class="hvo-list-item"><span>Correction factor</span><strong class="hvo-mono">2.3</strong></div>
                <div class="hvo-list-item"><span>Correction ratio</span><strong class="hvo-mono">1.003</strong></div>
                <div class="hvo-list-item"><span>Correction constant</span><strong class="hvo-mono">0.012 inHg</strong></div>
                <div class="hvo-list-item"><span>Gain</span><strong class="hvo-mono">1</strong></div>
                <div class="hvo-list-item"><span>Error offset</span><strong class="hvo-mono">0</strong></div>
            </div>
        </section>
    </div>
</div>
