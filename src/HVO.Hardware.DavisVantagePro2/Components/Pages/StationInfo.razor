@page "/info"
@rendermode InteractiveServer
@using HVO.Hardware.DavisVantagePro2.Station
@inject VantageStation Station

<h1>Station Info</h1>

@if (_loading)
{
    <p><span class="spinner"></span> Loading…</p>
}
else if (_error is not null)
{
    <div class="alert alert-error">@_error</div>
}
else if (_info is not null)
{
    <div class="data-grid">
        <span class="label">Hardware</span>        <span class="value">@_info.HardwareDescription</span>
        <span class="label">Hardware Type</span>   <span class="value">@_info.HardwareType</span>
        <span class="label">Model Type</span>      <span class="value">@_info.ModelType</span>
        <span class="label">Firmware Version</span><span class="value">@_info.FirmwareVersion</span>
        <span class="label">Firmware Date</span>   <span class="value">@_info.FirmwareDate</span>
        <span class="label">Console Time</span>    <span class="value">@_info.ConsoleTime.ToString("yyyy-MM-dd HH:mm:ss")</span>
        <span class="label">System Time</span>     <span class="value">@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</span>
        <span class="label">Drift</span>
        <span class="value">@((DateTime.Now - _info.ConsoleTime).TotalSeconds.ToString("F1")) s</span>
    </div>
}

<button class="btn btn-primary" @onclick="LoadAsync" disabled="@_loading">Refresh</button>

