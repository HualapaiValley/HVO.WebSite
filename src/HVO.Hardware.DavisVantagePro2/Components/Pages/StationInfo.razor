@page "/info"
@page "/station-info"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using HVO.Hardware.DavisVantagePro2.Station
@inject VantageStation Station

@{
    DateTime now = DateTime.Now;
}

<div class="station-info-page">
        <div class="shell-page-stack station-info-stack">
            <h1 class="hvo-visually-hidden">Station Info</h1>

            @if (SiteState.IsInitializing && Info is null)
            {
                <div class="hvo-callout hvo-callout-info">Loading station information snapshot…</div>
            }

            @if (ErrorMessage is not null)
            {
                <div class="hvo-callout hvo-callout-error station-info-callout-with-action">
                    <span>@ErrorMessage</span>
                    <button class="hvo-button" @onclick="LoadAsync" disabled="@SiteState.IsRefreshingStationInfo">Retry</button>
                </div>
            }

            <div class="info-grid">
                <section class="hvo-card-shell summary-card">
                    <div class="hvo-section-head">
                        <div>
                            <div class="hvo-eyebrow">Console Identity</div>
                            <h2>Hardware Profile</h2>
                        </div>
                        <div class="card-actions">
                            <button class="hvo-button hvo-button-primary" @onclick="LoadAsync" disabled="@SiteState.IsRefreshingStationInfo">@(SiteState.IsRefreshingStationInfo ? "Refreshing…" : "Refresh")</button>
                        </div>
                    </div>

                    <div class="summary-pills">
                        <div class="hvo-list-item">
                            <span>Hardware</span>
                            <strong>@HardwareDescriptionText</strong>
                        </div>
                        <div class="hvo-list-item">
                            <span>Model Type</span>
                            <strong>@ModelTypeText</strong>
                        </div>
                        <div class="hvo-list-item">
                            <span>Firmware</span>
                            <strong>@FirmwareVersionText</strong>
                        </div>
                    </div>
                </section>

                <section class="hvo-card-shell timing-card">
                    <div class="hvo-section-head">
                        <div>
                            <div class="hvo-eyebrow">Clock Health</div>
                            <h2>Time Alignment</h2>
                        </div>
                    </div>

                    <div class="data-pairs">
                        <div class="pair"><span>Console time</span><strong class="hvo-mono">@ConsoleTimeText</strong></div>
                        <div class="pair"><span>System time</span><strong class="hvo-mono">@now.ToString("yyyy-MM-dd HH:mm:ss")</strong></div>
                        <div class="pair"><span>Drift</span><strong class="hvo-mono">@DriftText</strong></div>
                        <div class="pair"><span>Time zone</span><strong>@Station.ConsoleTimeZoneLabel</strong></div>
                    </div>
                </section>
            </div>

            <section class="hvo-card-shell detail-card">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">Detail</div>
                        <h2>Station Fields</h2>
                    </div>
                </div>

                <div class="detail-grid">
                    <div class="detail-item"><span>Hardware</span><strong>@HardwareDescriptionText</strong></div>
                    <div class="detail-item"><span>Hardware Type</span><strong>@(Info?.HardwareType.ToString() ?? "-")</strong></div>
                    <div class="detail-item"><span>Model Type</span><strong>@ModelTypeText</strong></div>
                    <div class="detail-item"><span>Firmware Version</span><strong>@FirmwareVersionText</strong></div>
                    <div class="detail-item"><span>Firmware Date</span><strong>@FirmwareDateText</strong></div>
                    <div class="detail-item"><span>Snapshot Status</span><strong>@SnapshotStatusText</strong></div>
                </div>
            </section>
        </div>
</div>

