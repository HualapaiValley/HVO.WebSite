@page "/"
@page "/status-live"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using HVO.Hardware.DavisVantagePro2.Outbox
@using HVO.Hardware.DavisVantagePro2.Protocol.Packets
@using HVO.Hardware.DavisVantagePro2.Station
@using HVO.Hardware.DavisVantagePro2.Workers
@using HVO.WebSite.Themes.Components.Charts
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using System.Globalization
@inject VantageStation Station
@inject WeatherStationWorker Worker
@inject OutboxForwarder Forwarder

<div class="dashboard-page">
        <MudStack Class="shell-page-stack status-frame">
        <h1 class="hvo-visually-hidden">@PageHeadingText</h1>
        <article class="card card-top-span">
            <div class="card-body station-overview-grid">
                <div class="station-column station-column-primary">
                    <div class="section-head">
                        <div>
                            <h2>Station Conditions</h2>
                        </div>
                    </div>
                    <div class="hero-temp hero-temp-primary mono">@DisplayTemperature(_reading?.OutsideTemperatureF)@TemperatureUnitSuffix</div>
                    <div class="inside-pill-grid">
                        <div class="status-pill">
                            <div class="status-copy">
                                <div class="label">Inside Temperature</div>
                                <div class="value mono">@DisplayTemperature(_reading?.InsideTemperatureF)@TemperatureUnitSuffix</div>
                            </div>
                        </div>
                        <div class="status-pill">
                            <div class="status-copy">
                                <div class="label">Inside Humidity</div>
                                <div class="value mono">@DisplayWhole(_reading?.InsideHumidityPercent)%</div>
                            </div>
                        </div>
                    </div>
                    <div class="hero-stack">
                        <div>@ConditionSummary</div>
                        <div>Feels like <span class="hero-value hero-value-amber mono">@DisplayTemperature(FeelsLikeF)@TemperatureUnitSuffix</span></div>
                        <div>THSW <span class="hero-value hero-value-amber mono">@DisplayTemperature(_reading?.ThswF)@TemperatureUnitSuffix</span></div>
                        <div>Dew point <span class="hero-value hero-value-cyan mono">@DisplayTemperature(_reading?.DewPointF)@TemperatureUnitSuffix</span></div>
                        <div>Barometric trend <span class="hero-value hero-value-blue">@DisplayTrend(BarometricTrendText)</span></div>
                        <div>Solar radiation <span class="hero-value hero-value-amber mono">@DisplaySolar(_reading?.SolarRadiationWm2)</span></div>
                    </div>
                        <div class="chip-grid">
                            <div class="chip">
                                <div class="name">Humidity</div>
                                <div class="value mono">@DisplayWhole(_reading?.OutsideHumidityPercent)%</div>
                            </div>
                            <div class="chip">
                                <div class="name">Heat Index</div>
                                <div class="value mono">@DisplayTemperature(_reading?.HeatIndexF)@TemperatureUnitSuffix</div>
                            </div>
                            <div class="chip">
                                <div class="name">Wind Chill</div>
                                <div class="value mono">@DisplayTemperature(_reading?.WindChillF)@TemperatureUnitSuffix</div>
                            </div>
                        </div>
                    </div>

                    <section class="instrument station-nested-card wind-compass-card">
                        <h3>Wind Compass</h3>
                        <svg class="wind-compass-svg" viewBox="0 0 240 240" width="100%" aria-label="Wind direction compass">
                            <circle cx="120" cy="120" r="102" fill="var(--dashboard-compass-face)"
                                stroke="var(--shell-card-border)" stroke-width="2"></circle>
                            <circle cx="120" cy="120" r="84" fill="none" stroke="var(--shell-overlay-panel-border)"
                                    stroke-width="1"></circle>
                            <circle cx="120" cy="120" r="64" fill="none" stroke="var(--dashboard-compass-ring-soft)"
                                    stroke-width="1"></circle>
                            <g stroke="var(--shell-overlay-panel-border)" stroke-linecap="round">
                                <line x1="120" y1="20" x2="120" y2="36" stroke-width="2"></line>
                                <line x1="120" y1="204" x2="120" y2="220" stroke-width="2"></line>
                                <line x1="20" y1="120" x2="36" y2="120" stroke-width="2"></line>
                                <line x1="204" y1="120" x2="220" y2="120" stroke-width="2"></line>
                                <line x1="49" y1="49" x2="60" y2="60" stroke-width="1.5"></line>
                                <line x1="180" y1="180" x2="191" y2="191" stroke-width="1.5"></line>
                                <line x1="49" y1="191" x2="60" y2="180" stroke-width="1.5"></line>
                                <line x1="180" y1="60" x2="191" y2="49" stroke-width="1.5"></line>
                            </g>
                            <g fill="var(--shell-pill-text)" font-size="18" font-weight="600" text-anchor="middle">
                                <text x="120" y="54">N</text>
                                <text x="190" y="126">E</text>
                                <text x="120" y="198">S</text>
                                <text x="50" y="126">W</text>
                            </g>
                            <g transform="rotate(@WindDirectionRotation 120 120)">
                                <path d="M120 34L133 118L120 108L107 118Z" fill="var(--hvo-accent-blue)"></path>
                                <path d="M120 206L132 126L120 132L108 126Z" fill="var(--hvo-accent-amber)"></path>
                            </g>
                            <circle cx="120" cy="120" r="10" fill="var(--shell-chart-marker-fill)"></circle>
                            <circle cx="120" cy="120" r="5" fill="var(--hvo-accent-blue)"></circle>
                        </svg>
                        <footer>
                            <strong class="mono readout-compact">@WindDirectionText</strong>
                            <span class="readout-compact muted-value">@WindSummary</span>
                        </footer>
                        <div class="instrument-detail-list">
                            <div class="instrument-detail-row"><span>Average speed</span><strong
                                class="mono">@DisplayWind(_reading?.WindSpeed10MinAvgMph) @WindUnitSuffix</strong>
                            </div>
                            <div class="instrument-detail-row"><span>2-minute average</span><strong
                                class="mono">@DisplayWind(_reading?.WindSpeed2MinAvgMph) @WindUnitSuffix</strong></div>
                            <div class="instrument-detail-row"><span>10-minute gust</span><strong
                                class="mono">@DisplayWind(_reading?.WindGust10MinMph) @WindUnitSuffix</strong></div>
                            <div class="instrument-detail-row"><span>Direction spread</span><strong
                                class="mono">@WindDirectionSpreadText</strong></div>
                        </div>
                    </section>

                    <div class="side-stack station-column">
                        <section class="instrument station-pressure-panel">
                            <h3>Outside Pressure</h3>
                            <div class="hvo-barometer">
                                <div class="hvo-barometer-reading">
                                    <strong
                                        class="hvo-barometer-reading-value">@DisplayPressure(_reading?.BarometricPressureInHg)</strong>
                                    <span class="hvo-barometer-reading-label">barometer @PressureUnitSuffix</span>
                                </div>
                                <div class="hvo-barometer-scale" aria-label="Outside pressure range scale">
                                    <div class="hvo-barometer-band">
                                        <span class="hvo-barometer-marker"
                                            style="left: @PressureMarkerLeft(_reading?.BarometricPressureInHg);"></span>
                                    </div>
                                    <div class="hvo-barometer-tick-row">
                                        <span>@DisplayPressure(26.5)</span>
                                        <span>@DisplayPressure(28.5)</span>
                                        <span>@DisplayPressure(30.5)</span>
                                    </div>
                                </div>
                                <div class="hvo-barometer-meta">
                                    <div class="hvo-barometer-row"><span>24h low</span><strong>@DisplayPressure(_outsidePressure24HourLowInHg)</strong>
                                    </div>
                                    <div class="hvo-barometer-row"><span>24h high</span><strong>@DisplayPressure(_outsidePressure24HourHighInHg)</strong>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <section class="instrument station-pressure-panel">
                            <h3>Inside Pressure</h3>
                            <div class="hvo-barometer">
                                <div class="hvo-barometer-reading">
                                    <strong class="hvo-barometer-reading-value">@DisplayPressure(_reading?.PressureRawInHg)</strong>
                                    <span class="hvo-barometer-reading-label">console @PressureUnitSuffix</span>
                                </div>
                                <div class="hvo-barometer-scale" aria-label="Inside pressure range scale">
                                    <div class="hvo-barometer-band">
                                        <span class="hvo-barometer-marker"
                                            style="left: @PressureMarkerLeft(_reading?.PressureRawInHg);"></span>
                                    </div>
                                    <div class="hvo-barometer-tick-row">
                                        <span>@DisplayPressure(26.5)</span>
                                        <span>@DisplayPressure(28.5)</span>
                                        <span>@DisplayPressure(30.5)</span>
                                    </div>
                                </div>
                                <div class="hvo-barometer-meta">
                                    <div class="hvo-barometer-row"><span>24h low</span><strong>@DisplayPressure(_insidePressure24HourLowInHg)</strong>
                                    </div>
                                    <div class="hvo-barometer-row"><span>24h high</span><strong>@DisplayPressure(_insidePressure24HourHighInHg)</strong>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>
                </div>
        </article>
        <article class="card card-rain-span">
            <div class="card-body">
                <div class="metrics">
                    <div class="metric">
                        <div class="label">Rain Rate</div>
                        <div class="number metric-number metric-number-cyan mono">@DisplayRain(_reading?.RainRateInchesPerHour)</div>
                        <div class="foot">@RainRateUnitSuffix current</div>
                    </div>
                    <div class="metric">
                        <div class="label">15-Min Rain</div>
                        <div class="number metric-number metric-number-cyan mono">@DisplayRain(_reading?.Rain15MinInches)</div>
                        <div class="foot">rolling total</div>
                    </div>
                    <div class="metric">
                        <div class="label">Daily Rain</div>
                        <div class="number metric-number metric-number-cyan mono">@DisplayRain(_reading?.DailyRainInches)</div>
                        <div class="foot">since midnight</div>
                    </div>
                    <div class="metric">
                        <div class="label">Storm Rain</div>
                        <div class="number metric-number metric-number-blue mono">@DisplayRain(_reading?.StormRainInches)</div>
                        <div class="foot">active event</div>
                    </div>
                    <div class="metric">
                        <div class="label">Monthly Rain</div>
                        <div class="number metric-number metric-number-blue mono">@DisplayRain(_reading?.MonthlyRainInches)</div>
                        <div class="foot">month to date</div>
                    </div>
                    <div class="metric">
                        <div class="label">Yearly Rain</div>
                        <div class="number metric-number metric-number-blue mono">@DisplayRain(_reading?.YearlyRainInches)</div>
                        <div class="foot">year to date</div>
                    </div>
                    <div class="metric">
                        <div class="label">Daily ET</div>
                        <div class="number metric-number metric-number-amber mono">@DisplayEt(_reading?.DailyEtInches)</div>
                        <div class="foot">@RainUnitSuffix evaporative loss</div>
                    </div>
                </div>
            </div>
        </article>

        <div class="layout-grid layout-grid-history">
            <section class="column">
                <article class="card">
                    <div class="card-body">
                        <div class="section-head">
                            <div>
                                <h2>Last 24 Hours</h2>
                            </div>
                        </div>
                        <div class="history-grid">
                            <section class="plot-panel chart-panel">
                                <h3>Temperature</h3>
                                <p>Outside and inside temperatures across the last 24 hours.</p>
                                <div class="chart-key" aria-hidden="true">
                                    <span class="chart-key-item"><span class="chart-key-swatch chart-key-swatch-temperature-outside"></span>Outside</span>
                                    <span class="chart-key-item"><span class="chart-key-swatch chart-key-swatch-temperature-inside"></span>Inside</span>
                                </div>
                                <div class="status-chart">
                                    @if (HasTemperaturePlot)
                                    {
                                        <HvoChart ChartId="status-temp-chart"
                                                  Type="HvoChartType.Line"
                                                  ShowLegend="false"
                                                  Height="240"
                                                  EnableAnimations="false"
                                                  SpanGaps="false"
                                                  Labels="@_chartTimeLabels"
                                                  Datasets="@_temperatureDatasets"
                                                  DataRevision="@_chartRevision" />
                                    }
                                    else
                                    {
                                        <div class="status-chart-empty">Waiting for temperature history.</div>
                                    }
                                </div>
                                <div class="rows">
                                    <div class="row"><span>24h low</span><strong
                                        class="mono">@DisplayTemperature(_outsideTemperature24HourLowF)@TemperatureUnitSuffix</strong>
                                    </div>
                                    <div class="row"><span>24h high</span><strong
                                        class="mono">@DisplayTemperature(_outsideTemperature24HourHighF)@TemperatureUnitSuffix</strong>
                                    </div>
                                </div>
                            </section>

                            <section class="plot-panel chart-panel">
                                <h3>Wind</h3>
                                <p>2-minute average wind and 10-minute gust history for the dashboard window.</p>
                                <div class="chart-key" aria-hidden="true">
                                    <span class="chart-key-item"><span class="chart-key-swatch chart-key-swatch-wind-average"></span>2-minute average</span>
                                    <span class="chart-key-item"><span class="chart-key-swatch chart-key-swatch-wind-gust"></span>10-minute gust</span>
                                </div>
                                <div class="status-chart">
                                    @if (HasWindPlot)
                                    {
                                        <HvoChart ChartId="status-wind-chart"
                                                  Type="HvoChartType.Line"
                                                  ShowLegend="false"
                                                  Height="240"
                                                  EnableAnimations="false"
                                                  SpanGaps="false"
                                                  YAxisSuggestedMin="0"
                                                  Labels="@_chartTimeLabels"
                                                  Datasets="@_windDatasets"
                                                  DataRevision="@_chartRevision" />
                                    }
                                    else
                                    {
                                        <div class="status-chart-empty">Waiting for wind history.</div>
                                    }
                                </div>
                                <div class="rows">
                                    <div class="row"><span>2-minute average</span><strong
                                        class="mono">@DisplayWind(_reading?.WindSpeed2MinAvgMph) @WindUnitSuffix</strong></div>
                                    <div class="row"><span>10-minute gust</span><strong
                                        class="mono">@DisplayWind(_reading?.WindGust10MinMph) @WindUnitSuffix</strong></div>
                                </div>
                            </section>
                        </div>
                    </div>
                </article>

                <div class="summary-grid summary-grid-standalone">
                    <section class="plot-panel solar-card chart-panel">
                        <h3>Solar Radiation</h3>
                        <p>Solar output and daylight peak profile over the last 24 hours.</p>
                        <div class="status-chart status-chart-compact">
                            @if (HasSolarPlot)
                            {
                                <HvoChart ChartId="status-solar-chart"
                                          Type="HvoChartType.Line"
                                          ShowLegend="false"
                                          Height="220"
                                          EnableAnimations="false"
                                          SpanGaps="false"
                                          YAxisSuggestedMin="0"
                                          Labels="@_chartTimeLabels"
                                          Datasets="@_solarDatasets"
                                          DataRevision="@_chartRevision" />
                            }
                            else
                            {
                                <div class="status-chart-empty">Waiting for solar history.</div>
                            }
                        </div>
                        <div class="rows">
                            <div class="row"><span>Current solar</span><strong
                                class="mono">@DisplaySolar(_reading?.SolarRadiationWm2)</strong></div>
                            <div class="row"><span>Peak solar today</span><strong
                                class="mono">@DisplaySolar(_todayPeakSolarWm2)</strong></div>
                            <div class="row"><span>Current UV index</span><strong
                                class="mono">@DisplayUv(_reading?.UvIndex)</strong></div>
                        </div>
                    </section>

                    <section class="plot-panel solar-card astronomy-card">
                        <h3>Astronomical Info</h3>
                        <p>Sun and moon altitude today. Filled arc = above horizon.</p>
                        <div class="status-chart status-chart-compact astro-chart">
                            @if (HasAstronomicalPlot)
                            {
                                <HvoChart ChartId="status-astro-chart"
                                          Type="HvoChartType.Line"
                                          ShowLegend="false"
                                          Height="200"
                                          EnableAnimations="false"
                                          SpanGaps="false"
                                          YAxisSuggestedMin="0"
                                          YAxisSuggestedMax="105"
                                          Labels="@_astronomicalLabels"
                                          Datasets="@_astronomicalDatasets"
                                          DataRevision="@_chartRevision" />
                            }
                            else
                            {
                                <div class="status-chart-empty">Waiting for astronomical data.</div>
                            }
                        </div>

                        <div class="rows">
                            <div class="row"><span>Sunrise</span><strong class="mono">@FormatDisplayTime(_reading?.SunriseDisplay)</strong></div>
                            <div class="row"><span>Sunset</span><strong  class="mono">@FormatDisplayTime(_reading?.SunsetDisplay)</strong></div>
                            <div class="row"><span>Moonrise</span><strong class="mono">@MoonriseText</strong></div>
                            <div class="row"><span>Moonset</span><strong  class="mono">@MoonsetText</strong></div>
                            <div class="row">
                                <span>Moon phase</span>
                                <strong><span class="astro-moon-emoji" aria-hidden="true">@MoonPhaseIcon</span> @MoonPhaseText</strong>
                            </div>
                            <div class="row"><span>Illumination</span><strong class="mono">@IlluminationText</strong></div>
                        </div>
                    </section>
                </div>
            </section>
        </div>
        </MudStack>
</div>
