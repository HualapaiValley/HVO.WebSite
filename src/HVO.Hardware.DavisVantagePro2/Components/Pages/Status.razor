@page "/"
@rendermode InteractiveServer
@using HVO.Hardware.DavisVantagePro2.Outbox
@using HVO.Hardware.DavisVantagePro2.Protocol.Packets
@using HVO.Hardware.DavisVantagePro2.Station
@using HVO.Hardware.DavisVantagePro2.Workers
@inject VantageStation Station
@inject WeatherStationWorker Worker
@inject OutboxForwarder Forwarder

<h1>Station Status</h1>

@if (_reading is not null)
{
    <h2>Current Conditions</h2>
    <div class="data-grid">
        <span class="label">Updated</span>
        <span class="value">@(ToConsoleTime(Worker.LastReadingAt) ?? "—")</span>

        <span class="label">Outside Temp</span>
        <span class="value">@F(_reading.OutsideTemperatureF) °F</span>

        <span class="label">Outside Humidity</span>
        <span class="value">@F0(_reading.OutsideHumidityPercent) %</span>

        <span class="label">Dew Point</span>
        <span class="value">@F(_reading.DewPointF) °F</span>

        <span class="label">Heat Index</span>
        <span class="value">@F(_reading.HeatIndexF) °F</span>

        <span class="label">Wind Chill</span>
        <span class="value">@F(_reading.WindChillF) °F</span>

        <span class="label">Inside Temp</span>
        <span class="value">@F(_reading.InsideTemperatureF) °F</span>

        <span class="label">Inside Humidity</span>
        <span class="value">@F0(_reading.InsideHumidityPercent) %</span>

        <span class="label">Barometer</span>
        <span class="value">@(_reading.BarometricPressureInHg is not null ? $"{_reading.BarometricPressureInHg:F3} inHg" : "—")</span>

        <span class="label">Wind Speed</span>
        <span class="value">@F0(_reading.WindSpeedMph) mph @@ @F0(_reading.WindDirectionDegrees)°</span>

        <span class="label">Wind Gust (10m)</span>
        <span class="value">@F0(_reading.WindGust10MinMph) mph @@ @F0(_reading.WindGust10MinDirectionDegrees)°</span>

        <span class="label">Rain Rate</span>
        <span class="value">@(_reading.RainRateInchesPerHour?.ToString("F2") ?? "—") in/hr</span>

        <span class="label">Daily Rain</span>
        <span class="value">@(_reading.DailyRainInches?.ToString("F2") ?? "—") in</span>

        <span class="label">Solar Radiation</span>
        <span class="value">@(_reading.SolarRadiationWm2 is not null ? $"{_reading.SolarRadiationWm2} W/m²" : "—")</span>

        <span class="label">UV Index</span>
        <span class="value">@(_reading.UvIndex?.ToString("F1") ?? "—")</span>

        <span class="label">Daily ET</span>
        <span class="value">@(_reading.DailyEtInches?.ToString("F3") ?? "—") in</span>

        <span class="label">Monthly Rain</span>
        <span class="value">@(_reading.MonthlyRainInches?.ToString("F2") ?? "—") in</span>

        <span class="label">Yearly Rain</span>
        <span class="value">@(_reading.YearlyRainInches?.ToString("F2") ?? "—") in</span>

        <span class="label">Console Battery</span>
        <span class="value">@(_reading.ConsoleBatteryVoltage?.ToString("F2") ?? "—") V</span>

        <span class="label">Transmitter Battery</span>
        @if (_reading.TransmitterBatteryStatus is not null)
        {
            var lowChannels = _reading.TransmitterLowBatteryChannels;
            <span class="value">@(lowChannels.Count == 0 ? "OK" : $"Low: ch {string.Join(", ", lowChannels)}")</span>
        }
        else
        {
            <span class="value">—</span>
        }

        <span class="label">Forecast</span>
        <span class="value">@(_reading.ForecastString ?? "—")</span>

        <span class="label">Sunrise</span>
        <span class="value">@(_reading.SunriseDisplay ?? "—")</span>

        <span class="label">Sunset</span>
        <span class="value">@(_reading.SunsetDisplay ?? "—")</span>
    </div>
}
else
{
    <p>No data yet. Worker may be connecting.</p>
}

<h2>Outbox</h2>
<div class="data-grid">
    <span class="label">Pending records</span>
    <span class="value">@Forwarder.PendingCount</span>

    <span class="label">Dead-lettered records</span>
    <span class="value" style="@(Forwarder.FailedCount > 0 ? "color:#f38ba8" : "")">@Forwarder.FailedCount</span>

    <span class="label">Last sent</span>
    <span class="value">@(ToConsoleTime(Forwarder.LastSentAt) ?? "—")</span>

    <span class="label">Last batch size</span>
    <span class="value">@Forwarder.LastBatchCount</span>

    <span class="label">Last forward error</span>
    <span class="value" style="color:#f38ba8">@(Forwarder.LastError ?? "none")</span>
</div>

<h2>Worker Health</h2>
<div class="data-grid">
    <span class="label">Connected</span>
    <span class="value">@(Station.IsConnected ? "Yes" : "No")</span>

    <span class="label">Consecutive errors</span>
    <span class="value">@Worker.ConsecutiveErrors</span>

    <span class="label">Last error</span>
    <span class="value" style="color:#f38ba8">@(Worker.LastError ?? "none")</span>
</div>

