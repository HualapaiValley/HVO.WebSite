@page "/calibration"
@rendermode InteractiveServer

<div class="calibration-page">
    <div class="shell-page-stack calibration-stack">
        <h1 class="hvo-visually-hidden">Calibration</h1>

        <div class="hvo-action-row">
            <div class="hvo-chip"><span>Save status</span><strong>Ready</strong></div>
            <div class="hvo-chip"><span>Last snapshot</span><strong class="hvo-mono">08 May 2026 - 2:35 PM</strong></div>
            <button class="hvo-button hvo-button-success" type="button">Save calibration changes</button>
        </div>

        <div class="hvo-grid">
            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">Temperature Offsets</div>
                        <h2>Primary Temperature Calibration</h2>
                    </div>
                </div>
                <div class="hvo-form-grid">
                    <div class="hvo-field"><label class="hvo-field-label">Inside temp offset</label><input
                        class="hvo-control hvo-mono" type="number" min="-20" max="20" step="0.1" required value="-0.5" /></div>
                    <div class="hvo-field"><label class="hvo-field-label">Outside temp offset</label><input
                        class="hvo-control hvo-mono" type="number" min="-20" max="20" step="0.1" required value="0.8" /></div>
                    <div class="hvo-field"><label class="hvo-field-label">Extra temp 1</label><input
                        class="hvo-control hvo-mono" type="number" min="-20" max="20" step="0.1" required value="0.0" /></div>
                    <div class="hvo-field"><label class="hvo-field-label">Extra temp 2</label><input
                        class="hvo-control hvo-mono" type="number" min="-20" max="20" step="0.1" required value="0.2" /></div>
                    <div class="hvo-field"><label class="hvo-field-label">Soil temp 1</label><input
                        class="hvo-control hvo-mono" type="number" min="-20" max="20" step="0.1" required value="-0.3" /></div>
                    <div class="hvo-field"><label class="hvo-field-label">Leaf temp 1</label><input
                        class="hvo-control hvo-mono" type="number" min="-20" max="20" step="0.1" required value="0.0" /></div>
                </div>
            </section>

            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">Humidity Offsets</div>
                        <h2>Humidity Calibration</h2>
                    </div>
                </div>
                <div class="hvo-form-grid">
                    <div class="hvo-field"><label class="hvo-field-label">Inside humidity offset</label><input
                        class="hvo-control hvo-mono" type="number" min="-100" max="100" step="1" required value="-4" /></div>
                    <div class="hvo-field"><label class="hvo-field-label">Outside humidity offset</label><input
                        class="hvo-control hvo-mono" type="number" min="-100" max="100" step="1" required value="6" /></div>
                    <div class="hvo-field"><label class="hvo-field-label">Extra humidity 1</label><input
                        class="hvo-control hvo-mono" type="number" min="-100" max="100" step="1" required value="0" /></div>
                    <div class="hvo-field"><label class="hvo-field-label">Extra humidity 2</label><input
                        class="hvo-control hvo-mono" type="number" min="-100" max="100" step="1" required value="1" /></div>
                </div>
            </section>
        </div>

        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">Wind Direction</div>
                    <h2>Directional Offset</h2>
                </div>
                <button class="hvo-button hvo-button-primary" type="button">Apply offset</button>
            </div>
            <div class="hvo-form-grid">
                <div class="hvo-field"><label class="hvo-field-label">Wind direction offset</label><input
                    class="hvo-control hvo-mono" type="number" min="0" max="359" step="1" required value="45" /></div>
                <div class="hvo-field"><label class="hvo-field-label">Reference note</label><input
                    class="hvo-control" value="Aligned to dome mast true north" /></div>
            </div>
        </section>
    </div>
</div>
