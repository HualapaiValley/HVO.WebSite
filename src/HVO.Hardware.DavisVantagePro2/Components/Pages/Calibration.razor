@page "/calibration"
@rendermode InteractiveServer

<PrototypeFrame Eyebrow="Calibration" Title="Calibration">
    <HeaderAside>
        <div class="proto-pill"><span>Save status</span><strong>Ready</strong></div>
        <div class="proto-pill"><span>Last snapshot</span><strong class="proto-mono">08 May 2026 - 2:35 PM</strong></div>
        <button class="proto-button success" type="button">Save calibration changes</button>
    </HeaderAside>

    <ChildContent>
        <div class="proto-grid">
            <section class="proto-card">
                <div class="proto-section-head">
                    <div>
                        <div class="proto-eyebrow">Temperature Offsets</div>
                        <h2>Primary Temperature Calibration</h2>
                    </div>
                </div>
                <div class="proto-form-grid">
                    <div class="proto-field"><label class="proto-field-label">Inside temp offset</label><input
                        class="proto-input proto-mono" type="number" min="-20" max="20" step="0.1" required value="-0.5" /></div>
                        <div class="proto-field"><label class="proto-field-label">Outside temp offset</label><input
                            class="proto-input proto-mono" type="number" min="-20" max="20" step="0.1" required value="0.8" /></div>
                            <div class="proto-field"><label class="proto-field-label">Extra temp 1</label><input
                                class="proto-input proto-mono" type="number" min="-20" max="20" step="0.1" required value="0.0" /></div>
                                <div class="proto-field"><label class="proto-field-label">Extra temp 2</label><input
                                    class="proto-input proto-mono" type="number" min="-20" max="20" step="0.1" required value="0.2" /></div>
                                    <div class="proto-field"><label class="proto-field-label">Soil temp 1</label><input
                                        class="proto-input proto-mono" type="number" min="-20" max="20" step="0.1" required value="-0.3" /></div>
                                        <div class="proto-field"><label class="proto-field-label">Leaf temp 1</label><input
                                            class="proto-input proto-mono" type="number" min="-20" max="20" step="0.1" required value="0.0" /></div>
                                        </div>
                                    </section>

                                    <section class="proto-card">
                                        <div class="proto-section-head">
                                            <div>
                                                <div class="proto-eyebrow">Humidity Offsets</div>
                                                <h2>Humidity Calibration</h2>
                                            </div>
                                        </div>
                                        <div class="proto-form-grid">
                                            <div class="proto-field"><label class="proto-field-label">Inside humidity offset</label><input
                                                class="proto-input proto-mono" type="number" min="-100" max="100" step="1" required value="-4" /></div>
                                                <div class="proto-field"><label class="proto-field-label">Outside humidity offset</label><input
                                                    class="proto-input proto-mono" type="number" min="-100" max="100" step="1" required value="6" /></div>
                                                    <div class="proto-field"><label class="proto-field-label">Extra humidity 1</label><input
                                                        class="proto-input proto-mono" type="number" min="-100" max="100" step="1" required value="0" /></div>
                                                        <div class="proto-field"><label class="proto-field-label">Extra humidity 2</label><input
                                                            class="proto-input proto-mono" type="number" min="-100" max="100" step="1" required value="1" /></div>
                                                        </div>
                                                    </section>
                                                </div>

                                                <section class="proto-card">
                                                    <div class="proto-section-head">
                                                        <div>
                                                            <div class="proto-eyebrow">Wind Direction</div>
                                                            <h2>Directional Offset</h2>
                                                        </div>
                                                        <button class="proto-button primary" type="button">Apply offset</button>
                                                    </div>
                                                    <div class="proto-form-grid">
                                                        <div class="proto-field"><label class="proto-field-label">Wind direction offset</label><input
                                                            class="proto-input proto-mono" type="number" min="0" max="359" step="1" required value="45" /></div>
                                                            <div class="proto-field"><label class="proto-field-label">Reference note</label><input
                                                                class="proto-input" value="Aligned to dome mast true north" /></div>
                                                            </div>
                                                        </section>
                                                    </ChildContent>
                                                </PrototypeFrame>

