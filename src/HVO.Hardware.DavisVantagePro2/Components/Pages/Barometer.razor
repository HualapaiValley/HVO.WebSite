@page "/barometer"
@rendermode InteractiveServer

<div class="barometer-page">
    <div class="shell-page-stack barometer-stack">
        <h1 class="hvo-visually-hidden">Barometer</h1>

        <div class="hvo-action-row">
            <div class="hvo-chip"><span>Service snapshot</span><strong class="hvo-mono">08 May 2026 - 2:35 PM</strong></div>
            <div class="hvo-chip"><span>Current pressure</span><strong class="hvo-mono">29.990 inHg</strong></div>
            <button class="hvo-button hvo-button-success" type="button">Write calibration</button>
        </div>

        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">BARDATA</div>
                    <h2>Current Service Values</h2>
                </div>
            </div>
            <div class="hvo-grid" style="grid-template-columns: repeat(3, minmax(0, 1fr));">
                <div class="hvo-list-item"><span>Current pressure</span><strong class="hvo-mono">29.990 inHg</strong></div>
                <div class="hvo-list-item"><span>Altitude</span><strong class="hvo-mono">3491 ft</strong></div>
                <div class="hvo-list-item"><span>Dew point</span><strong class="hvo-mono">55 F</strong></div>
                <div class="hvo-list-item"><span>Virtual temperature</span><strong class="hvo-mono">62 F</strong></div>
                <div class="hvo-list-item"><span>Correction factor</span><strong class="hvo-mono">2.3</strong></div>
                <div class="hvo-list-item"><span>Correction ratio</span><strong class="hvo-mono">1.003</strong></div>
                <div class="hvo-list-item"><span>Correction constant</span><strong class="hvo-mono">0.012 inHg</strong></div>
                <div class="hvo-list-item"><span>Gain</span><strong class="hvo-mono">1</strong></div>
                <div class="hvo-list-item"><span>Error offset</span><strong class="hvo-mono">0</strong></div>
            </div>
        </section>

        <div class="hvo-grid">
            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">BAR=</div>
                        <h2>Reference Inputs</h2>
                    </div>
                </div>
                <div class="hvo-form-grid">
                    <div class="hvo-field"><label class="hvo-field-label">Reference pressure (inHg)</label><input class="hvo-control hvo-mono" type="number" min="20" max="35" step="0.001" required value="29.991" /></div>
                    <div class="hvo-field"><label class="hvo-field-label">Altitude (ft)</label><input class="hvo-control hvo-mono" type="number" min="0" max="20000" step="1" required value="3491" /></div>
                </div>
            </section>

            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">Related Views</div>
                        <h2>Workflow Links</h2>
                    </div>
                </div>
                <div class="hvo-stack">
                    <div class="hvo-list-item"><strong>Station Info</strong><span>Review barometer service data in the read-only diagnostics page.</span></div>
                    <div class="hvo-list-item"><strong>Calibration</strong><span>Use sensor calibration for temperature and humidity offsets separately from pressure service inputs.</span></div>
                </div>
            </section>
        </div>
    </div>
</div>
