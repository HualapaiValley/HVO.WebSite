@page "/barometer"
@rendermode InteractiveServer

<PrototypeFrame Eyebrow="Barometer" Title="Barometer">
    <HeaderAside>
        <div class="proto-pill"><span>Service snapshot</span><strong class="proto-mono">08 May 2026 - 2:35 PM</strong></div>
        <div class="proto-pill"><span>Current pressure</span><strong class="proto-mono">29.990 inHg</strong></div>
        <button class="proto-button success" type="button">Write calibration</button>
    </HeaderAside>

    <ChildContent>
        <section class="proto-card">
            <div class="proto-section-head">
                <div>
                    <div class="proto-eyebrow">BARDATA</div>
                    <h2>Current Service Values</h2>
                </div>
            </div>
            <div class="proto-three-column">
                <div class="proto-stat"><span>Current pressure</span><strong class="proto-mono">29.990 inHg</strong></div>
                <div class="proto-stat"><span>Altitude</span><strong class="proto-mono">3491 ft</strong></div>
                <div class="proto-stat"><span>Dew point</span><strong class="proto-mono">55 F</strong></div>
                <div class="proto-stat"><span>Virtual temperature</span><strong class="proto-mono">62 F</strong></div>
                <div class="proto-stat"><span>Correction factor</span><strong class="proto-mono">2.3</strong></div>
                <div class="proto-stat"><span>Correction ratio</span><strong class="proto-mono">1.003</strong></div>
                <div class="proto-stat"><span>Correction constant</span><strong class="proto-mono">0.012 inHg</strong></div>
                <div class="proto-stat"><span>Gain</span><strong class="proto-mono">1</strong></div>
                <div class="proto-stat"><span>Error offset</span><strong class="proto-mono">0</strong></div>
            </div>
        </section>

        <div class="proto-grid">
            <section class="proto-card">
                <div class="proto-section-head">
                    <div>
                        <div class="proto-eyebrow">BAR=</div>
                        <h2>Reference Inputs</h2>
                    </div>
                </div>
                <div class="proto-form-grid">
                    <div class="proto-field"><label class="proto-field-label">Reference pressure (inHg)</label><input class="proto-input proto-mono" type="number" min="20" max="35" step="0.001" required value="29.991" /></div>
                    <div class="proto-field"><label class="proto-field-label">Altitude (ft)</label><input class="proto-input proto-mono" type="number" min="0" max="20000" step="1" required value="3491" /></div>
                </div>
            </section>

            <section class="proto-card">
                <div class="proto-section-head">
                    <div>
                        <div class="proto-eyebrow">Related Views</div>
                        <h2>Workflow Links</h2>
                    </div>
                </div>
                <div class="proto-list-stack">
                    <div class="proto-list-item"><strong>Station Info</strong><span>Review barometer service data in the read-only diagnostics page.</span></div>
                    <div class="proto-list-item"><strong>Calibration</strong><span>Use sensor calibration for temperature and humidity offsets separately from pressure service inputs.</span></div>
                </div>
            </section>
        </div>
    </ChildContent>
</PrototypeFrame>

