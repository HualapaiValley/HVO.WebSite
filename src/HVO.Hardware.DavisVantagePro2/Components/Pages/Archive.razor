@page "/archive"
@page "/archive-browser"
@rendermode InteractiveServer
@using HVO.Hardware.DavisVantagePro2.Station
@inject VantageStation Station

<div class="archive-page">
        <div class="shell-page-stack archive-stack">
            <h1 class="page-heading">Archive And History</h1>

            @if (_msg is not null)
            {
                <div class="@(_isError ? "hvo-callout hvo-callout-error" : "hvo-callout hvo-callout-success")">@_msg</div>
            }

            <div class="archive-grid">
                <section class="hvo-card-shell summary-card">
                    <div class="hvo-section-head">
                        <div>
                            <div class="hvo-eyebrow">Archive Console</div>
                            <h2>Archive Status</h2>
                        </div>
                    </div>

                    <div class="summary-pills">
                        <div class="hvo-list-item">
                            <span>Archive interval</span>
                            <strong class="hvo-mono">@_interval min</strong>
                        </div>
                        <div class="hvo-list-item">
                            <span>Loaded records</span>
                            <strong class="hvo-mono">@(_historyRecords?.Count ?? 0)</strong>
                        </div>
                        <div class="hvo-list-item">
                            <span>Console time zone</span>
                            <strong>@Station.ConsoleTimeZoneLabel</strong>
                        </div>
                    </div>
                </section>

                <section class="hvo-card-shell settings-card">
                    <div class="hvo-section-head">
                        <div>
                            <div class="hvo-eyebrow">Configuration</div>
                            <h2>Archive Interval</h2>
                        </div>
                    </div>

                    <div class="hvo-stack">
                        <label class="hvo-field-label" for="archive-interval">Interval (minutes)</label>
                        <div class="hvo-action-row">
                            <select class="hvo-control" id="archive-interval" @bind="_interval">
                                <option value="1">1 min</option>
                                <option value="5">5 min</option>
                                <option value="10">10 min</option>
                                <option value="15">15 min</option>
                                <option value="30">30 min</option>
                                <option value="60">60 min</option>
                                <option value="120">120 min</option>
                            </select>
                            <button class="hvo-button hvo-button-primary" @onclick="SaveIntervalAsync">Set Interval</button>
                        </div>
                    </div>
                </section>

                <section class="hvo-card-shell danger-card">
                    <div class="hvo-section-head">
                        <div>
                            <div class="hvo-eyebrow">Danger Zone</div>
                            <h2>Clear Archive Memory</h2>
                        </div>
                    </div>

                    <p class="danger-copy">This permanently erases all archived data on the console. This cannot be undone.</p>

                    @if (!_confirmClear)
                    {
                        <button class="hvo-button hvo-button-danger" @onclick="() => _confirmClear = true">Clear Archive…</button>
                    }
                    else
                    {
                        <div class="confirm-box">
                            <p>Are you absolutely sure?</p>
                            <div class="hvo-action-row">
                                <button class="hvo-button hvo-button-danger" @onclick="ClearAsync">Yes, clear all archive data</button>
                                <button class="hvo-button" @onclick="() => _confirmClear = false">Cancel</button>
                            </div>
                        </div>
                    }
                </section>
            </div>

            <section class="hvo-card-shell history-card">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">Historical Pull</div>
                        <h2>Archive History</h2>
                    </div>
                </div>

                <div class="history-toolbar">
                    <div class="hvo-stack">
                        <label class="hvo-field-label" for="archive-since">Since</label>
                        <input class="hvo-control" id="archive-since" type="datetime-local" value="@_since.ToString("yyyy-MM-ddTHH:mm")"
                               @onchange="OnSinceChanged" />
                    </div>

                    <div class="hvo-action-row">
                        <button class="hvo-button hvo-button-primary" @onclick="LoadHistoryAsync" disabled="@_historyLoading">
                            @if (_historyLoading)
                            {
                                <span>Loading…</span>
                            }
                            else
                            {
                                <span>Load</span>
                            }
                        </button>
                        <button class="hvo-button" @onclick='() => { _since = DateTime.Now.AddDays(-1); }'
                                disabled="@_historyLoading">Last 24 h</button>
                    </div>
                </div>

                @if (_historyLoading)
                {
                    <div class="hvo-callout hvo-callout-info">Fetching archive records from console…</div>
                }
                else if (_historyError is not null)
                {
                    <div class="hvo-callout hvo-callout-error">@_historyError</div>
                }
                else if (_historyRecords is not null)
                {
                    <div class="history-summary">
                        <span>@_historyRecords.Count record@(_historyRecords.Count == 1 ? "" : "s") loaded since @_historySince.ToString("yyyy-MM-dd HH:mm")</span>
                        @if (_hasMore)
                        {
                            <span>More records are available.</span>
                        }
                    </div>

                    @if (_historyRecords.Count == 0)
                    {
                        <div class="hvo-callout hvo-callout-info">No records found for the selected time range.</div>
                    }
                    else
                    {
                        <div class="hvo-table-wrap">
                            <table class="hvo-table">
                                <thead>
                                    <tr>
                                        <th>Date / Time<br /><small>@Station.ConsoleTimeZoneLabel</small></th>
                                        <th>Outside Temp °F<br /><small>avg / high / low</small></th>
                                        <th>Inside Temp °F</th>
                                        <th>Outside Humidity %</th>
                                        <th>Inside Humidity %</th>
                                        <th>Pressure inHg</th>
                                        <th>Wind Speed mph</th>
                                        <th>Wind Gust mph</th>
                                        <th>Rain in</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var r in PagedRecords)
                                    {
                                        <tr>
                                            <td>@r.DateTimeLocal.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td>
                                                @Fmt(r.OutsideTemperatureF) /
                                                @Fmt(r.HighOutsideTemperatureF) /
                                                @Fmt(r.LowOutsideTemperatureF)
                                            </td>
                                            <td>@Fmt(r.InsideTemperatureF)</td>
                                            <td>@Fmt(r.OutsideHumidityPercent)</td>
                                            <td>@Fmt(r.InsideHumidityPercent)</td>
                                            <td>@Fmt(r.BarometricPressureInHg, "F3")</td>
                                            <td>@Fmt(r.WindSpeedMph)</td>
                                            <td>@Fmt(r.WindGustMph)</td>
                                            <td>@Fmt(r.RainInches, "F2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (TotalPages > 1 || _hasMore)
                        {
                            <div class="hvo-action-row pagination-bar">
                                @if (TotalPages > 1)
                                {
                                    <div class="hvo-action-row">
                                        <button class="hvo-button" @onclick='() => _displayPage = 1' disabled="@(_displayPage == 1)">«</button>
                                        <button class="hvo-button" @onclick='() => _displayPage--' disabled="@(_displayPage == 1)">‹</button>
                                        <span class="page-state">
                                            Page @_displayPage of @TotalPages
                                            (@((_displayPage - 1) * PageSize + 1)–@(Math.Min(_displayPage * PageSize, _historyRecords.Count)) of @_historyRecords.Count)
                                        </span>
                                        <button class="hvo-button" @onclick='() => _displayPage++' disabled="@(_displayPage >= TotalPages)">›</button>
                                        <button class="hvo-button" @onclick='() => _displayPage = TotalPages' disabled="@(_displayPage >= TotalPages)">»</button>
                                    </div>
                                }

                                @if (_hasMore)
                                {
                                    <button class="hvo-button hvo-button-primary push-right" @onclick="LoadMoreAsync" disabled="@_historyLoading">Load more from console…</button>
                                }
                            </div>
                        }
                    }
                }
            </section>
        </div>
</div>

