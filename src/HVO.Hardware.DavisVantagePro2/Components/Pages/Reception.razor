@page "/reception"
@rendermode InteractiveServer

<div class="reception-page">
    <div class="shell-page-stack reception-stack">
        <h1 class="hvo-visually-hidden">Reception</h1>

        <div class="hvo-action-row">
            <div class="hvo-chip"><span>Reception</span><strong class="hvo-mono">99.46%</strong></div>
            <div class="hvo-chip"><span>Last refresh</span><strong class="hvo-mono">08 May 2026 - 2:35 PM</strong></div>
            <button class="hvo-button hvo-button-primary" type="button">Refresh stats</button>
        </div>

        <div class="hvo-grid">
            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">RXCHECK</div>
                        <h2>Packet Health</h2>
                    </div>
                </div>
                <div class="hvo-grid">
                    <div class="hvo-list-item"><span>Packets received</span><strong class="hvo-mono">12345</strong></div>
                    <div class="hvo-list-item"><span>Packets missed</span><strong class="hvo-mono">67</strong></div>
                    <div class="hvo-list-item"><span>Reception percent</span><strong class="hvo-mono">99.46%</strong></div>
                    <div class="hvo-list-item"><span>Resync count</span><strong class="hvo-mono">2</strong></div>
                    <div class="hvo-list-item"><span>CRC errors</span><strong class="hvo-mono">3</strong></div>
                    <div class="hvo-list-item"><span>Longest good stretch</span><strong class="hvo-mono">12340</strong></div>
                </div>
            </section>

            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">Operator Notes</div>
                        <h2>Interpretation</h2>
                    </div>
                </div>
                <div class="hvo-stack">
                    <div class="hvo-list-item"><strong>Primary issue window</strong><span
                        class="hvo-mono">07 May 2026 - 4:18 AM to 4:22 AM UTC</span></div>
                    <div class="hvo-list-item"><strong>Most likely source</strong><span>Transient console/network
                        interruption</span></div>
                    <div class="hvo-list-item"><strong>Recommended action</strong><span>Review no-packets alarm
                        history and compare with outbox lag.</span></div>
                </div>
            </section>
        </div>

        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">Heard Transmitters</div>
                    <h2>Radio Snapshot</h2>
                </div>
            </div>
            <div class="hvo-table-wrap">
                <table class="hvo-table">
                    <thead>
                        <tr>
                            <th>Channel</th>
                            <th>Configured</th>
                            <th>Heard now</th>
                            <th>Type</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>1</td>
                            <td>Yes</td>
                            <td>Yes</td>
                            <td>ISS</td>
                            <td>Primary outdoor suite healthy</td>
                        </tr>
                        <tr>
                            <td>3</td>
                            <td>Yes</td>
                            <td>Yes</td>
                            <td>Temp/Humidity</td>
                            <td>Repeater B in use</td>
                        </tr>
                        <tr>
                            <td>4</td>
                            <td>Yes</td>
                            <td>No</td>
                            <td>Leaf</td>
                            <td>Configured but not heard</td>
                        </tr>
                        <tr>
                            <td>6</td>
                            <td>Yes</td>
                            <td>Yes</td>
                            <td>Soil</td>
                            <td>Intermittent overnight dropouts</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>
