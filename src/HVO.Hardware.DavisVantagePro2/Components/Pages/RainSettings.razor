@page "/rain"
@page "/rain-settings"
@rendermode InteractiveServer

<PrototypeFrame Eyebrow="Rain Settings" Title="Rain Settings">
    <HeaderAside>
        <div class="proto-pill"><span>Rain bucket</span><strong>0.01 in</strong></div>
        <div class="proto-pill"><span>Rain year start</span><strong>July</strong></div>
        <button class="proto-button success" type="button">Save rain settings</button>
    </HeaderAside>

    <ChildContent>
        <div class="proto-grid">
            <section class="proto-card">
                <div class="proto-section-head">
                    <div>
                        <div class="proto-eyebrow">Rain Configuration</div>
                        <h2>Bucket And Year</h2>
                    </div>
                </div>
                <div class="proto-form-grid">
                    <div class="proto-field"><label class="proto-field-label">Bucket type</label><select class="proto-select"><option selected>0.01 in</option><option>0.2 mm</option><option>0.1 mm</option></select></div>
                    <div class="proto-field"><label class="proto-field-label">Rain year start</label><select class="proto-select"><option>January</option><option>April</option><option selected>July</option><option>October</option></select></div>
                </div>
            </section>

            <section class="proto-card">
                <div class="proto-section-head">
                    <div>
                        <div class="proto-eyebrow">Archive</div>
                        <h2>Archive Interval</h2>
                    </div>
                </div>
                <div class="proto-form-grid">
                    <div class="proto-field"><label class="proto-field-label">Archive interval</label><select class="proto-select"><option>1 minute</option><option>5 minutes</option><option selected>15 minutes</option><option>30 minutes</option><option>60 minutes</option></select></div>
                </div>
            </section>
        </div>

        <section class="proto-card">
            <div class="proto-section-head">
                <div>
                    <div class="proto-eyebrow">Danger Zone</div>
                    <h2>Archive Memory</h2>
                </div>
                <button class="proto-button danger" type="button">Clear archive</button>
            </div>
            <p class="proto-muted">This clears historical records from the console archive. Treat it as a destructive maintenance action, separate from routine rainfall configuration changes.</p>
        </section>
    </ChildContent>
</PrototypeFrame>

