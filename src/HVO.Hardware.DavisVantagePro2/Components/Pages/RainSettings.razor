@page "/rain"
@page "/rain-settings"
@rendermode InteractiveServer

<div class="rain-settings-page">
    <div class="shell-page-stack rain-settings-stack">
        <h1 class="hvo-visually-hidden">Rain Settings</h1>

        <div class="hvo-action-row">
            <div class="hvo-chip"><span>Rain bucket</span><strong>0.01 in</strong></div>
            <div class="hvo-chip"><span>Rain year start</span><strong>July</strong></div>
            <button class="hvo-button hvo-button-success" type="button">Save rain settings</button>
        </div>

        <div class="hvo-grid">
            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">Rain Configuration</div>
                        <h2>Bucket And Year</h2>
                    </div>
                </div>
                <div class="hvo-form-grid">
                    <div class="hvo-field"><label class="hvo-field-label">Bucket type</label><select class="hvo-control"><option selected>0.01 in</option><option>0.2 mm</option><option>0.1 mm</option></select></div>
                    <div class="hvo-field"><label class="hvo-field-label">Rain year start</label><select class="hvo-control"><option>January</option><option>April</option><option selected>July</option><option>October</option></select></div>
                </div>
            </section>

            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">Archive</div>
                        <h2>Archive Interval</h2>
                    </div>
                </div>
                <div class="hvo-form-grid">
                    <div class="hvo-field"><label class="hvo-field-label">Archive interval</label><select class="hvo-control"><option>1 minute</option><option>5 minutes</option><option selected>15 minutes</option><option>30 minutes</option><option>60 minutes</option></select></div>
                </div>
            </section>
        </div>

        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">Danger Zone</div>
                    <h2>Archive Memory</h2>
                </div>
                <button class="hvo-button hvo-button-danger" type="button">Clear archive</button>
            </div>
            <p style="color: var(--shell-pill-text);">This clears historical records from the console archive. Treat it as a destructive maintenance action, separate from routine rainfall configuration changes.</p>
        </section>
    </div>
</div>
