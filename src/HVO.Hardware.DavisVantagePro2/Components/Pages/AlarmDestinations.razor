@page "/alarms/destinations"
@rendermode InteractiveServer

<div class="alarm-destinations-page">
    <div class="shell-page-stack alarm-destinations-stack">
        <h1 class="hvo-visually-hidden">Alarm Destinations</h1>

        <div class="hvo-action-row">
            <button class="hvo-button hvo-button-primary" type="button">Create destination</button>
            <button class="hvo-button" type="button">Test delivery</button>
            <button class="hvo-button hvo-button-success" type="button">Save changes</button>
        </div>

        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">Destination Grid</div>
                    <h2>Configured Destinations</h2>
                </div>
            </div>
            <div class="hvo-table-wrap">
                <table class="hvo-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Type</th>
                            <th>Address / Target</th>
                            <th>Enabled</th>
                            <th>Last test</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Email Ops</td>
                            <td>Email</td>
                            <td>ops@example.com</td>
                            <td>Yes</td>
                            <td>Success</td>
                        </tr>
                        <tr>
                            <td>SMS Night</td>
                            <td>SMS</td>
                            <td>+1-555-0109</td>
                            <td>Yes</td>
                            <td>Not tested</td>
                        </tr>
                        <tr>
                            <td>Discord Hook</td>
                            <td>Webhook</td>
                            <td>https://hooks.example/discord/hvo</td>
                            <td>Yes</td>
                            <td>Success</td>
                        </tr>
                        <tr>
                            <td>Console Lamp</td>
                            <td>Console action</td>
                            <td>Lamp toggle</td>
                            <td>Yes</td>
                            <td>N/A</td>
                        </tr>
                        <tr>
                            <td>Console Sound?</td>
                            <td>Console action</td>
                            <td>Unsupported / unknown</td>
                            <td>No</td>
                            <td>N/A</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">Destination Editor</div>
                    <h2>Email Ops</h2>
                </div>
            </div>
            <div class="hvo-form-grid">
                <div class="hvo-field"><label class="hvo-field-label">Type</label><select class="hvo-control">
                    <option selected>Email</option>
                    <option>SMS</option>
                    <option>Webhook</option>
                    <option>Console action</option>
                </select></div>
                <div class="hvo-field"><label class="hvo-field-label">Display name</label><input class="hvo-control"
                    value="Email Ops" /></div>
                <div class="hvo-field"><label class="hvo-field-label">Address / endpoint</label><input
                    class="hvo-control" value="ops@example.com" /></div>
                <div class="hvo-field"><label class="hvo-field-label">Credential or secret ref</label><input
                    class="hvo-control" value="kv://observatory/alerts/email-ops" /></div>
                <div class="hvo-field"><label class="hvo-field-label">Quiet hours</label><input class="hvo-control"
                    value="22:00-05:00 local" /></div>
                <div class="hvo-field"><label class="hvo-field-label">Escalation</label><input class="hvo-control"
                    value="Critical -> SMS Night after 5 min" /></div>
            </div>
            <div class="hvo-toggle" style="margin-top: 18px;">
                <span class="hvo-toggle-track"></span>
                <span>Enabled</span>
            </div>
            <div class="hvo-action-row" style="margin-top: 18px;">
                <button class="hvo-button hvo-button-success" type="button">Save destination</button>
                <button class="hvo-button hvo-button-primary" type="button">Send test</button>
            </div>
        </section>
    </div>
</div>
