@page "/dashboard-prototype"
@rendermode InteractiveServer

<div class="dashboard-prototype-page">
    <div class="shell-page-stack dashboard-prototype-stack">
        <h1 class="hvo-visually-hidden">Hualapai Valley Observatory</h1>

        <div class="hvo-action-row">
            <div class="hvo-chip"><span>Station</span><strong>Online</strong></div>
            <div class="hvo-chip"><span>Location</span><strong>Hualapai Valley, AZ</strong></div>
            <div class="hvo-chip"><span>Observed</span><strong class="hvo-mono">08 May 2026 - 2:35 PM</strong></div>
        </div>

        <div class="hvo-grid">
            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">Current Conditions</div>
                        <h2>Outside Temperature</h2>
                    </div>
                    <span class="hvo-chip hvo-chip-success">Forecast: Clearing and cooler tonight</span>
                </div>
                <div class="dashboard-prototype-hero-value hvo-mono">72.4 F</div>
                <div class="dashboard-prototype-hero-support">
                    <span>Feels like <strong class="hvo-mono">74.0 F</strong></span>
                    <span>Dew point <strong class="hvo-mono">55.0 F</strong></span>
                    <span>Trend <strong>Steady</strong></span>
                </div>
                <div class="hvo-grid" style="margin-top: 18px;">
                    <div class="hvo-list-item"><span>Outside humidity</span><strong class="hvo-mono">34%</strong></div>
                    <div class="hvo-list-item"><span>Heat index</span><strong class="hvo-mono">74.0 F</strong></div>
                    <div class="hvo-list-item"><span>Wind chill</span><strong class="hvo-mono">72.0 F</strong></div>
                </div>
            </section>

            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">Astronomical</div>
                        <h2>Sun And Moon</h2>
                    </div>
                </div>
                <div class="hvo-grid">
                    <div class="hvo-list-item"><span>Sunrise</span><strong class="hvo-mono">05:34</strong></div>
                    <div class="hvo-list-item"><span>Sunset</span><strong class="hvo-mono">19:14</strong></div>
                    <div class="hvo-list-item"><span>Moonrise</span><strong class="hvo-mono">16:51</strong></div>
                    <div class="hvo-list-item"><span>Moonset</span><strong class="hvo-mono">03:42</strong></div>
                    <div class="hvo-list-item"><span>Moon phase</span><strong>Waxing gibbous</strong></div>
                    <div class="hvo-list-item"><span>Illumination</span><strong class="hvo-mono">68%</strong></div>
                </div>
            </section>
        </div>

        <div class="hvo-grid">
            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">Wind</div>
                        <h2>Primary Instruments</h2>
                    </div>
                </div>
                <div class="hvo-grid" style="grid-template-columns: repeat(3, minmax(0, 1fr));">
                    <div class="hvo-list-item"><span>Direction</span><strong>SW 228 deg</strong></div>
                    <div class="hvo-list-item"><span>Instant speed</span><strong class="hvo-mono">12 mph</strong></div>
                    <div class="hvo-list-item"><span>10-minute average</span><strong class="hvo-mono">11 mph</strong></div>
                    <div class="hvo-list-item"><span>10-minute gust</span><strong class="hvo-mono">18 mph</strong></div>
                    <div class="hvo-list-item"><span>2-minute average</span><strong class="hvo-mono">11 mph</strong></div>
                    <div class="hvo-list-item"><span>Spread</span><strong>210-244 deg</strong></div>
                </div>
            </section>

            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">Pressure</div>
                        <h2>Barometer</h2>
                    </div>
                </div>
                <div class="hvo-grid">
                    <div class="hvo-list-item"><span>Corrected pressure</span><strong class="hvo-mono">29.87 inHg</strong></div>
                    <div class="hvo-list-item"><span>Raw station pressure</span><strong class="hvo-mono">25.94 inHg</strong></div>
                    <div class="hvo-list-item"><span>24h low</span><strong class="hvo-mono">29.81 inHg</strong></div>
                    <div class="hvo-list-item"><span>24h high</span><strong class="hvo-mono">29.96 inHg</strong></div>
                </div>
            </section>
        </div>

        <div class="hvo-grid">
            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">Rain / ET</div>
                        <h2>Weather Totals</h2>
                    </div>
                </div>
                <div class="hvo-grid" style="grid-template-columns: repeat(3, minmax(0, 1fr));">
                    <div class="hvo-list-item"><span>Rain rate</span><strong class="hvo-mono">0.00 in/hr</strong></div>
                    <div class="hvo-list-item"><span>Rain 15 min</span><strong class="hvo-mono">0.00 in</strong></div>
                    <div class="hvo-list-item"><span>Rain 24h</span><strong class="hvo-mono">0.12 in</strong></div>
                    <div class="hvo-list-item"><span>Daily rain</span><strong class="hvo-mono">0.00 in</strong></div>
                    <div class="hvo-list-item"><span>Monthly rain</span><strong class="hvo-mono">0.88 in</strong></div>
                    <div class="hvo-list-item"><span>Yearly rain</span><strong class="hvo-mono">3.14 in</strong></div>
                    <div class="hvo-list-item"><span>Daily ET</span><strong class="hvo-mono">0.133 in</strong></div>
                    <div class="hvo-list-item"><span>Monthly ET</span><strong class="hvo-mono">2.41 in</strong></div>
                    <div class="hvo-list-item"><span>Storm start</span><strong class="hvo-mono">02 May 2026</strong></div>
                </div>
            </section>

            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">Solar / UV</div>
                        <h2>Radiation</h2>
                    </div>
                </div>
                <div class="hvo-grid">
                    <div class="hvo-list-item"><span>Solar radiation</span><strong class="hvo-mono">642 W/m^2</strong></div>
                    <div class="hvo-list-item"><span>UV index</span><strong class="hvo-mono">4.2</strong></div>
                    <div class="hvo-list-item"><span>Peak solar today</span><strong class="hvo-mono">951 W/m^2</strong></div>
                </div>
            </section>
        </div>

        <div class="hvo-grid">
            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">Inside Conditions</div>
                        <h2>Console Environment</h2>
                    </div>
                </div>
                <div class="hvo-grid">
                    <div class="hvo-list-item"><span>Inside temperature</span><strong class="hvo-mono">70.1 F</strong></div>
                    <div class="hvo-list-item"><span>Inside humidity</span><strong class="hvo-mono">39%</strong></div>
                    <div class="hvo-list-item"><span>Console battery</span><strong class="hvo-mono">4.9 V</strong></div>
                    <div class="hvo-list-item"><span>Archive interval</span><strong class="hvo-mono">15 min</strong></div>
                </div>
            </section>

            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">Application</div>
                        <h2>Worker And Outbox</h2>
                    </div>
                </div>
                <div class="hvo-grid">
                    <div class="hvo-list-item"><span>Worker state</span><strong>Loop active</strong></div>
                    <div class="hvo-list-item"><span>Last reading UTC</span><strong class="hvo-mono">08 May 2026 - 9:35 PM UTC</strong></div>
                    <div class="hvo-list-item"><span>Pending outbox</span><strong class="hvo-mono">12</strong></div>
                    <div class="hvo-list-item"><span>Transmitter battery summary</span><strong>All normal</strong></div>
                </div>
            </section>
        </div>
    </div>
</div>
