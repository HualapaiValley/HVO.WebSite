@page "/dashboard-prototype"
@rendermode InteractiveServer

<PrototypeFrame Eyebrow="Weather Station Dashboard" Title="Hualapai Valley Observatory">
    <HeaderAside>
        <div class="proto-pill"><span>Station</span><strong>Online</strong></div>
        <div class="proto-pill"><span>Location</span><strong>Hualapai Valley, AZ</strong></div>
        <div class="proto-pill"><span>Observed</span><strong class="proto-mono">08 May 2026 - 2:35 PM</strong></div>
    </HeaderAside>

    <ChildContent>
        <div class="proto-grid">
            <section class="proto-card proto-hero-card">
                <div class="proto-section-head">
                    <div>
                        <div class="proto-eyebrow">Current Conditions</div>
                        <h2>Outside Temperature</h2>
                    </div>
                    <span class="proto-badge success">Forecast: Clearing and cooler tonight</span>
                </div>
                <div class="proto-hero-value proto-mono">72.4 F</div>
                <div class="proto-hero-support">
                    <span>Feels like <strong class="proto-mono">74.0 F</strong></span>
                    <span>Dew point <strong class="proto-mono">55.0 F</strong></span>
                    <span>Trend <strong>Steady</strong></span>
                </div>
                <div class="proto-stat-grid" style="margin-top: 18px;">
                    <div class="proto-stat"><span>Outside humidity</span><strong class="proto-mono">34%</strong></div>
                    <div class="proto-stat"><span>Heat index</span><strong class="proto-mono">74.0 F</strong></div>
                    <div class="proto-stat"><span>Wind chill</span><strong class="proto-mono">72.0 F</strong></div>
                </div>
            </section>

            <section class="proto-card">
                <div class="proto-section-head">
                    <div>
                        <div class="proto-eyebrow">Astronomical</div>
                        <h2>Sun And Moon</h2>
                    </div>
                </div>
                <div class="proto-detail-grid">
                    <div class="proto-stat"><span>Sunrise</span><strong class="proto-mono">05:34</strong></div>
                    <div class="proto-stat"><span>Sunset</span><strong class="proto-mono">19:14</strong></div>
                    <div class="proto-stat"><span>Moonrise</span><strong class="proto-mono">16:51</strong></div>
                    <div class="proto-stat"><span>Moonset</span><strong class="proto-mono">03:42</strong></div>
                    <div class="proto-stat"><span>Moon phase</span><strong>Waxing gibbous</strong></div>
                    <div class="proto-stat"><span>Illumination</span><strong class="proto-mono">68%</strong></div>
                </div>
            </section>
        </div>

        <div class="proto-grid">
            <section class="proto-card">
                <div class="proto-section-head">
                    <div>
                        <div class="proto-eyebrow">Wind</div>
                        <h2>Primary Instruments</h2>
                    </div>
                </div>
                <div class="proto-three-column">
                    <div class="proto-stat"><span>Direction</span><strong>SW 228 deg</strong></div>
                    <div class="proto-stat"><span>Instant speed</span><strong class="proto-mono">12 mph</strong></div>
                    <div class="proto-stat"><span>10-minute average</span><strong class="proto-mono">11 mph</strong>
                    </div>
                    <div class="proto-stat"><span>10-minute gust</span><strong class="proto-mono">18 mph</strong></div>
                    <div class="proto-stat"><span>2-minute average</span><strong class="proto-mono">11 mph</strong>
                    </div>
                    <div class="proto-stat"><span>Spread</span><strong>210-244 deg</strong></div>
                </div>
            </section>

            <section class="proto-card">
                <div class="proto-section-head">
                    <div>
                        <div class="proto-eyebrow">Pressure</div>
                        <h2>Barometer</h2>
                    </div>
                </div>
                <div class="proto-stat-grid">
                    <div class="proto-stat"><span>Corrected pressure</span><strong class="proto-mono">29.87
                        inHg</strong></div>
                        <div class="proto-stat"><span>Raw station pressure</span><strong class="proto-mono">25.94
                            inHg</strong></div>
                            <div class="proto-stat"><span>24h low</span><strong class="proto-mono">29.81 inHg</strong></div>
                            <div class="proto-stat"><span>24h high</span><strong class="proto-mono">29.96 inHg</strong></div>
                        </div>
                    </section>
                </div>

                <div class="proto-grid">
                    <section class="proto-card">
                        <div class="proto-section-head">
                            <div>
                                <div class="proto-eyebrow">Rain / ET</div>
                                <h2>Weather Totals</h2>
                            </div>
                        </div>
                        <div class="proto-three-column">
                            <div class="proto-stat"><span>Rain rate</span><strong class="proto-mono">0.00 in/hr</strong></div>
                            <div class="proto-stat"><span>Rain 15 min</span><strong class="proto-mono">0.00 in</strong></div>
                            <div class="proto-stat"><span>Rain 24h</span><strong class="proto-mono">0.12 in</strong></div>
                            <div class="proto-stat"><span>Daily rain</span><strong class="proto-mono">0.00 in</strong></div>
                            <div class="proto-stat"><span>Monthly rain</span><strong class="proto-mono">0.88 in</strong></div>
                            <div class="proto-stat"><span>Yearly rain</span><strong class="proto-mono">3.14 in</strong></div>
                            <div class="proto-stat"><span>Daily ET</span><strong class="proto-mono">0.133 in</strong></div>
                            <div class="proto-stat"><span>Monthly ET</span><strong class="proto-mono">2.41 in</strong></div>
                            <div class="proto-stat"><span>Storm start</span><strong class="proto-mono">02 May 2026</strong></div>
                        </div>
                    </section>

                    <section class="proto-card">
                        <div class="proto-section-head">
                            <div>
                                <div class="proto-eyebrow">Solar / UV</div>
                                <h2>Radiation</h2>
                            </div>
                        </div>
                        <div class="proto-stat-grid">
                            <div class="proto-stat"><span>Solar radiation</span><strong class="proto-mono">642 W/m^2</strong>
                            </div>
                            <div class="proto-stat"><span>UV index</span><strong class="proto-mono">4.2</strong></div>
                            <div class="proto-stat"><span>Peak solar today</span><strong class="proto-mono">951 W/m^2</strong>
                            </div>
                        </div>
                    </section>
                </div>

                <div class="proto-grid">
                    <section class="proto-card">
                        <div class="proto-section-head">
                            <div>
                                <div class="proto-eyebrow">Inside Conditions</div>
                                <h2>Console Environment</h2>
                            </div>
                        </div>
                        <div class="proto-stat-grid">
                            <div class="proto-stat"><span>Inside temperature</span><strong class="proto-mono">70.1 F</strong>
                            </div>
                            <div class="proto-stat"><span>Inside humidity</span><strong class="proto-mono">39%</strong></div>
                            <div class="proto-stat"><span>Console battery</span><strong class="proto-mono">4.9 V</strong></div>
                            <div class="proto-stat"><span>Archive interval</span><strong class="proto-mono">15 min</strong>
                            </div>
                        </div>
                    </section>

                    <section class="proto-card">
                        <div class="proto-section-head">
                            <div>
                                <div class="proto-eyebrow">Application</div>
                                <h2>Worker And Outbox</h2>
                            </div>
                        </div>
                        <div class="proto-stat-grid">
                            <div class="proto-stat"><span>Worker state</span><strong>Loop active</strong></div>
                            <div class="proto-stat"><span>Last reading UTC</span><strong class="proto-mono">08 May 2026 - 9:35 PM UTC</strong></div>
                                <div class="proto-stat"><span>Pending outbox</span><strong class="proto-mono">12</strong></div>
                                <div class="proto-stat"><span>Transmitter battery summary</span><strong>All normal</strong></div>
                            </div>
                        </section>
                    </div>
                </ChildContent>
            </PrototypeFrame>