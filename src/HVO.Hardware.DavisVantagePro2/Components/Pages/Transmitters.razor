@page "/transmitters"
@rendermode InteractiveServer

<div class="transmitters-page">
    <div class="shell-page-stack transmitters-stack">
        <h1 class="hvo-visually-hidden">Transmitters</h1>

        <div class="hvo-action-row">
            <div class="hvo-chip"><span>Configured channels</span><strong class="hvo-mono">4</strong></div>
            <div class="hvo-chip"><span>Heard now</span><strong>1, 3, 6</strong></div>
            <button class="hvo-button hvo-button-success" type="button">Save transmitter changes</button>
        </div>

        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">Channel Grid</div>
                    <h2>Configured Transmitters</h2>
                </div>
            </div>
            <div class="hvo-table-wrap">
                <table class="hvo-table">
                    <thead>
                        <tr>
                            <th>Channel</th>
                            <th>Type</th>
                            <th>Repeater</th>
                            <th>Active</th>
                            <th>Retransmit</th>
                            <th>Temp sensor</th>
                            <th>Humidity sensor</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>1</td>
                            <td>ISS</td>
                            <td>None</td>
                            <td>Yes</td>
                            <td>No</td>
                            <td>—</td>
                            <td>—</td>
                        </tr>
                        <tr>
                            <td>3</td>
                            <td>Temp/Humidity</td>
                            <td>B</td>
                            <td>Yes</td>
                            <td>No</td>
                            <td>2</td>
                            <td>3</td>
                        </tr>
                        <tr>
                            <td>6</td>
                            <td>Soil</td>
                            <td>None</td>
                            <td>Yes</td>
                            <td>Yes</td>
                            <td>—</td>
                            <td>—</td>
                        </tr>
                        <tr>
                            <td>8</td>
                            <td>None</td>
                            <td>None</td>
                            <td>No</td>
                            <td>No</td>
                            <td>—</td>
                            <td>—</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <div class="hvo-grid">
            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">Channel Editor</div>
                        <h2>Channel 3</h2>
                    </div>
                </div>
                <div class="hvo-form-grid">
                    <div class="hvo-field"><label class="hvo-field-label">Type</label><select class="hvo-control">
                        <option>ISS</option>
                        <option selected>Temp/Humidity</option>
                        <option>Soil</option>
                        <option>None</option>
                    </select></div>
                    <div class="hvo-field"><label class="hvo-field-label">Repeater</label><select class="hvo-control">
                        <option>None</option>
                        <option selected>B</option>
                        <option>A</option>
                        <option>C</option>
                    </select></div>
                    <div class="hvo-field"><label class="hvo-field-label">Active</label><select class="hvo-control">
                        <option selected>Yes</option>
                        <option>No</option>
                    </select></div>
                    <div class="hvo-field"><label class="hvo-field-label">Retransmit</label><select class="hvo-control">
                        <option selected>No</option>
                        <option>Yes</option>
                    </select></div>
                    <div class="hvo-field"><label class="hvo-field-label">Extra temp sensor</label><input
                        class="hvo-control hvo-mono" type="number" min="1" max="8" step="1" value="2" /></div>
                    <div class="hvo-field"><label class="hvo-field-label">Extra humidity sensor</label><input
                        class="hvo-control hvo-mono" type="number" min="1" max="8" step="1" value="3" /></div>
                </div>
            </section>

            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">Heard Summary</div>
                        <h2>Reception Snapshot</h2>
                    </div>
                </div>
                <div class="hvo-stack">
                    <div class="hvo-list-item"><strong>Heard channels</strong><span>1 · ISS</span><span>3 ·
                        Temp/Humidity</span><span>6 · Soil</span></div>
                    <div class="hvo-list-item"><strong>Configured but quiet</strong><span>4, 8</span></div>
                    <div class="hvo-list-item"><strong>Last refreshed</strong><span class="hvo-mono">08 May 2026 - 2:35 PM</span></div>
                </div>
            </section>
        </div>
    </div>
</div>
