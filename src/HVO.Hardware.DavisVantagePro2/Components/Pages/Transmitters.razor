@page "/transmitters"
@rendermode InteractiveServer

<PrototypeFrame Eyebrow="Transmitters" Title="Transmitters">
    <HeaderAside>
        <div class="proto-pill"><span>Configured channels</span><strong class="proto-mono">4</strong></div>
        <div class="proto-pill"><span>Heard now</span><strong>1, 3, 6</strong></div>
        <button class="proto-button success" type="button">Save transmitter changes</button>
    </HeaderAside>

    <ChildContent>
        <section class="proto-card">
            <div class="proto-section-head">
                <div>
                    <div class="proto-eyebrow">Channel Grid</div>
                    <h2>Configured Transmitters</h2>
                </div>
            </div>
            <div class="proto-table-wrap">
                <table class="proto-table">
                    <thead>
                        <tr>
                            <th>Channel</th>
                            <th>Type</th>
                            <th>Repeater</th>
                            <th>Active</th>
                            <th>Retransmit</th>
                            <th>Temp sensor</th>
                            <th>Humidity sensor</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>1</td>
                            <td>ISS</td>
                            <td>None</td>
                            <td>Yes</td>
                            <td>No</td>
                            <td>—</td>
                            <td>—</td>
                        </tr>
                        <tr>
                            <td>3</td>
                            <td>Temp/Humidity</td>
                            <td>B</td>
                            <td>Yes</td>
                            <td>No</td>
                            <td>2</td>
                            <td>3</td>
                        </tr>
                        <tr>
                            <td>6</td>
                            <td>Soil</td>
                            <td>None</td>
                            <td>Yes</td>
                            <td>Yes</td>
                            <td>—</td>
                            <td>—</td>
                        </tr>
                        <tr>
                            <td>8</td>
                            <td>None</td>
                            <td>None</td>
                            <td>No</td>
                            <td>No</td>
                            <td>—</td>
                            <td>—</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <div class="proto-grid">
            <section class="proto-card">
                <div class="proto-section-head">
                    <div>
                        <div class="proto-eyebrow">Channel Editor</div>
                        <h2>Channel 3</h2>
                    </div>
                </div>
                <div class="proto-form-grid">
                    <div class="proto-field"><label class="proto-field-label">Type</label><select class="proto-select">
                        <option>ISS</option>
                        <option selected>Temp/Humidity</option>
                        <option>Soil</option>
                        <option>None</option>
                    </select></div>
                    <div class="proto-field"><label class="proto-field-label">Repeater</label><select
                        class="proto-select">
                        <option>None</option>
                        <option selected>B</option>
                        <option>A</option>
                        <option>C</option>
                    </select></div>
                    <div class="proto-field"><label class="proto-field-label">Active</label><select
                        class="proto-select">
                        <option selected>Yes</option>
                        <option>No</option>
                    </select></div>
                    <div class="proto-field"><label class="proto-field-label">Retransmit</label><select
                        class="proto-select">
                        <option selected>No</option>
                        <option>Yes</option>
                    </select></div>
                    <div class="proto-field"><label class="proto-field-label">Extra temp sensor</label><input
                        class="proto-input proto-mono" type="number" min="1" max="8" step="1" value="2" /></div>
                        <div class="proto-field"><label class="proto-field-label">Extra humidity sensor</label><input
                            class="proto-input proto-mono" type="number" min="1" max="8" step="1" value="3" /></div>
                        </div>
                    </section>

                    <section class="proto-card">
                        <div class="proto-section-head">
                            <div>
                                <div class="proto-eyebrow">Heard Summary</div>
                                <h2>Reception Snapshot</h2>
                            </div>
                        </div>
                        <div class="proto-list-stack">
                            <div class="proto-list-item"><strong>Heard channels</strong><span>1 · ISS</span><span>3 ·
                                Temp/Humidity</span><span>6 · Soil</span></div>
                                <div class="proto-list-item"><strong>Configured but quiet</strong><span>4, 8</span></div>
                                <div class="proto-list-item"><strong>Last refreshed</strong><span class="proto-mono">08 May 2026 - 2:35 PM</span></div>
                                </div>
                            </section>
                        </div>
                    </ChildContent>
                </PrototypeFrame>

