{
  "SmartShunt": {
    "Address": "",
    "Adapter": "hci0",
    "SourceId": "smartshunt-main",
    "DeviceId": "smartshunt-lifepo4",
    "DisplayTimeZoneId": "America/Phoenix",
    "PublicOnly": true,
    "EnablePrivateEnrichment": false,
    "SampleIntervalSeconds": 5,
    "SnapshotIntervalSeconds": 15,
    "PublicKeepAliveIntervalSeconds": 10,
    "PrivateRefreshIntervalSeconds": 900,
    "HistoryCapacity": 240,
    "ConnectionTimeoutSeconds": 20,
    "SampleStaleAfterSeconds": 60,
    "OutboxPendingWarningCount": 10,
    "OutboxFailedCriticalCount": 1,
    "LowBatteryWarningPercent": 30,
    "CriticalBatteryPercent": 15
  },
  "Outbox": {
    "ApiEndpoint": "",
    "ApiKey": "",
    "MaxRetryAttempts": 10,
    "MaxBackoffSeconds": 300,
    "SweepIntervalSeconds": 5,
    "BatchSize": 50,
    "DbPath": "",
    "SentRetentionDays": 7,
    "FailedRetentionDays": 30,
    "PendingWarningCount": 10,
    "FailedCriticalCount": 1
  },
  "Diagnostics": {
    "ExposeDetailedEndpoints": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
