<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HVO.Hardware.VictronSmartShunt</RootNamespace>
    <AssemblyName>HVO.Hardware.VictronSmartShunt</AssemblyName>
    <UserSecretsId>hvo-hardware-victron-smartshunt</UserSecretsId>
    <!-- NU1903: GHSA-xrw6-gwf8-vvr9 — transitive from Linux.Bluetooth; accepted localhost-only D-Bus risk until upstream updates Tmds.DBus. -->
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Linux.Bluetooth" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HVO.Edge.Contracts\HVO.Edge.Contracts.csproj" />
    <ProjectReference Include="..\HVO.Edge.HomeAssistant.Mqtt\HVO.Edge.HomeAssistant.Mqtt.csproj" />
    <ProjectReference Include="..\HVO.Edge.Hosting\HVO.Edge.Hosting.csproj" />
    <ProjectReference Include="..\HVO.Edge.Outbox\HVO.Edge.Outbox.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HVO.Hardware.VictronSmartShunt.Tests" />
  </ItemGroup>
</Project>
