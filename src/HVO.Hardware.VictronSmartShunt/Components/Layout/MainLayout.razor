@inherits LayoutComponentBase

<HvoGatewayLayout Subtitle="VICTRON SMARTSHUNT DASHBOARD"
                  FooterSlot1="@_footer1"
                  FooterSlot2="@_footer2"
                  FooterSlot3="@_footer3"
                  FooterSlot4="@_footer4"
                  FooterSlot5="@_footer5"
                  IsDarkMode="@_shellState.IsDarkMode"
                  IsDarkModeChanged="@OnThemeModeChanged">
    <NavItems>
        <MudButton Href="/" Variant="@GetNavLinkVariant("Overview")" Color="Color.Inherit" Class="@GetNavLinkClass("Overview")">Overview</MudButton>
        <MudButton Href="/telemetry" Variant="@GetNavLinkVariant("Telemetry")" Color="Color.Inherit" Class="@GetNavLinkClass("Telemetry")">Telemetry</MudButton>
    </NavItems>
    <AppBarActions>
        <MudIconButton Icon="@ThemeSelectorIcon" Color="Color.Inherit" Size="Size.Medium" aria-label="@ThemeSelectorLabel" OnClick="ToggleTheme" />
    </AppBarActions>
    <Body>@Body</Body>
</HvoGatewayLayout>
