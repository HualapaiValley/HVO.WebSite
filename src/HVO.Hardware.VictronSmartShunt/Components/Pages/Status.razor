@page "/"
@inherits SmartShuntPageBase

<PageTitle>SmartShunt Overview</PageTitle>

<MudPaper Class="layout-canvas shell-page" Elevation="0" aria-label="SmartShunt overview content area">
    <MudStack Class="shell-page-stack smartshunt-page-stack">
        <section class="smartshunt-hero" aria-label="Overview header">
            <div class="smartshunt-hero-copy">
                <MudText Typo="Typo.overline" Class="smartshunt-eyebrow">Battery Monitor Overview</MudText>
                <MudText Typo="Typo.h3" Class="smartshunt-hero-title">@PageHeadingText</MudText>
                <MudText Typo="Typo.body1" Class="smartshunt-hero-summary">@PageSummaryText</MudText>
            </div>
            <div class="smartshunt-hero-meta">
                <div class="smartshunt-stat-chip">
                    <span>Last sample</span>
                    <strong>@FormatTimestamp(Worker.LastSnapshotAt)</strong>
                </div>
                <div class="smartshunt-stat-chip">
                    <span>Gateway</span>
                    <strong>@HealthLabel</strong>
                </div>
                <div class="smartshunt-stat-chip">
                    <span>Data path</span>
                    <strong>@(LatestSnapshot?.DataPath ?? "waiting")</strong>
                </div>
            </div>
        </section>

        <div class="smartshunt-grid smartshunt-grid-overview">
            <MudPaper Class="smartshunt-card smartshunt-card-primary" Elevation="0">
                <div class="smartshunt-card-head">
                    <div>
                        <MudText Typo="Typo.overline" Class="smartshunt-card-kicker">Live battery</MudText>
                        <MudText Typo="Typo.h5">Primary telemetry</MudText>
                    </div>
                    <span class="smartshunt-badge @TelemetryModeBadgeClass">@ModeSummary</span>
                </div>

                <div class="smartshunt-gauge-grid" aria-label="Primary battery gauges">
                    <div class="smartshunt-gauge-tile">
                        <div class="smartshunt-gauge" style="@SocGaugeStyle">
                            <div class="smartshunt-gauge-inner">
                                <span>SoC</span>
                                <strong>@FormatPercent(LatestSnapshot?.StateOfChargePercent)</strong>
                            </div>
                        </div>
                    </div>
                    <div class="smartshunt-gauge-tile">
                        <div class="smartshunt-gauge" style="@VoltageGaugeStyle">
                            <div class="smartshunt-gauge-inner">
                                <span>Voltage</span>
                                <strong>@FormatVolts(LatestSnapshot?.VoltageV)</strong>
                            </div>
                        </div>
                    </div>
                    <div class="smartshunt-gauge-tile">
                        <div class="smartshunt-gauge" style="@PowerGaugeStyle">
                            <div class="smartshunt-gauge-inner">
                                <span>Power</span>
                                <strong>@FormatWatts(LatestSnapshot?.PowerW)</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="smartshunt-metric-grid">
                    <div class="smartshunt-metric-tile">
                        <span>State of charge</span>
                        <strong>@FormatPercent(LatestSnapshot?.StateOfChargePercent)</strong>
                    </div>
                    <div class="smartshunt-metric-tile">
                        <span>Voltage</span>
                        <strong>@FormatVolts(LatestSnapshot?.VoltageV)</strong>
                    </div>
                    <div class="smartshunt-metric-tile">
                        <span>Current</span>
                        <strong>@CurrentDisplay</strong>
                    </div>
                    <div class="smartshunt-metric-tile">
                        <span>Power</span>
                        <strong>@FormatWatts(LatestSnapshot?.PowerW)</strong>
                    </div>
                    <div class="smartshunt-metric-tile">
                        <span>Consumed Ah</span>
                        <strong>@FormatAh(LatestSnapshot?.ConsumedAh)</strong>
                    </div>
                    <div class="smartshunt-metric-tile">
                        <span>Remaining time</span>
                        <strong>@RenderField(LatestSnapshot?.RemainingMinutes, FormatMinutes, isPrivateField: false)</strong>
                    </div>
                </div>
            </MudPaper>

            <MudPaper Class="smartshunt-card" Elevation="0">
                <div class="smartshunt-card-head">
                    <div>
                        <MudText Typo="Typo.overline" Class="smartshunt-card-kicker">Gateway state</MudText>
                        <MudText Typo="Typo.h5">Collector runtime</MudText>
                    </div>
                </div>

                <dl class="smartshunt-detail-list">
                    <div><dt>Address</dt><dd>@DisplayAddress</dd></div>
                    <div><dt>Adapter</dt><dd>@Options.Adapter</dd></div>
                    <div><dt>Source ID</dt><dd>@Options.SourceId</dd></div>
                    <div><dt>Device ID</dt><dd>@Options.DeviceId</dd></div>
                    <div><dt>Public session</dt><dd>@FormatBool(LatestSnapshot?.PublicSessionActive)</dd></div>
                    <div><dt>Private enrichment</dt><dd>@PrivateEnrichmentStateText</dd></div>
                    <div><dt>Last error</dt><dd>@(Worker.LastError ?? "None")</dd></div>
                    <div><dt>Status endpoint</dt><dd>/status</dd></div>
                </dl>
            </MudPaper>

            <MudPaper Class="smartshunt-card" Elevation="0">
                <div class="smartshunt-card-head">
                    <div>
                        <MudText Typo="Typo.overline" Class="smartshunt-card-kicker">Optional live fields</MudText>
                        <MudText Typo="Typo.h5">Device-reported extras</MudText>
                    </div>
                </div>

                <dl class="smartshunt-detail-list">
                    <div><dt>Starter voltage</dt><dd>@RenderField(LatestSnapshot?.StarterVoltageV, FormatVolts)</dd></div>
                    <div><dt>Temperature</dt><dd>@RenderField(LatestSnapshot?.TemperatureC, FormatTemperature)</dd></div>
                    <div><dt>Remaining time</dt><dd>@RenderField(LatestSnapshot?.RemainingMinutes, FormatMinutes)</dd></div>
                    <div><dt>Current coarse</dt><dd>@RenderField(LatestSnapshot?.CurrentCoarseA, FormatAmps, isPrivateField: true)</dd></div>
                    <div><dt>Charge status coarse</dt><dd>@RenderField(LatestSnapshot?.ChargeStatusCoarsePercent, FormatPercent, isPrivateField: true)</dd></div>
                    <div><dt>Streaming counter</dt><dd>@RenderField(LatestSnapshot?.StreamingCounter, FormatCount, isPrivateField: true)</dd></div>
                </dl>
            </MudPaper>

            <MudPaper Class="smartshunt-card" Elevation="0">
                <div class="smartshunt-card-head">
                    <div>
                        <MudText Typo="Typo.overline" Class="smartshunt-card-kicker">Outbox</MudText>
                        <MudText Typo="Typo.h5">Forwarding health</MudText>
                    </div>
                </div>

                <dl class="smartshunt-detail-list">
                    <div><dt>Pending</dt><dd>@Forwarder.PendingCount</dd></div>
                    <div><dt>Failed</dt><dd>@Forwarder.FailedCount</dd></div>
                    <div><dt>Last sent</dt><dd>@FormatTimestamp(Forwarder.LastSentAt)</dd></div>
                    <div><dt>Last batch</dt><dd>@Forwarder.LastBatchCount</dd></div>
                </dl>
            </MudPaper>
        </div>

        <MudPaper Class="smartshunt-card smartshunt-card-note" Elevation="0">
            <div class="smartshunt-card-head">
                <div>
                    <MudText Typo="Typo.overline" Class="smartshunt-card-kicker">Field visibility</MudText>
                    <MudText Typo="Typo.h5">Why some values are blank</MudText>
                </div>
            </div>

            <div class="smartshunt-note-grid">
                <div>
                    <span class="smartshunt-inline-badge smartshunt-inline-badge-warning">Private disabled</span>
                    <p>Private-enrichment fields are intentionally unavailable while `PublicOnly=true` or `EnablePrivateEnrichment=false`.</p>
                </div>
                <div>
                    <span class="smartshunt-inline-badge smartshunt-inline-badge-neutral">Not reported</span>
                    <p>Some optional public fields such as starter voltage, temperature, or remaining time are not present on every device/session.</p>
                </div>
                <div>
                    <span class="smartshunt-inline-badge smartshunt-inline-badge-success">Live</span>
                    <p>Battery SoC, voltage, current, power, and consumed amp-hours are the current production baseline.</p>
                </div>
            </div>
        </MudPaper>

        @if (Health.Alerts.Count > 0)
        {
            <MudPaper Class="smartshunt-card" Elevation="0">
                <div class="smartshunt-card-head">
                    <div>
                        <MudText Typo="Typo.overline" Class="smartshunt-card-kicker">Health alerts</MudText>
                        <MudText Typo="Typo.h5">Gateway warnings</MudText>
                    </div>
                </div>
                @foreach (var alert in Health.Alerts)
                {
                    <MudAlert Severity="@MapSeverity(alert.Severity)" Dense="true" Class="mb-2">@alert.Message</MudAlert>
                }
            </MudPaper>
        }
    </MudStack>
</MudPaper>
