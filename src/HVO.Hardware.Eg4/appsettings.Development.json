{
  "Edge": {
    "Paths": {
      "ConfigurationFile": "/tmp/hvo-eg4/config/gateway.json",
      "ConfigDirectory": "/tmp/hvo-eg4/config",
      "DataDirectory": "/tmp/hvo-eg4/data",
      "SecretsDirectory": "/tmp/hvo-eg4/secrets"
    },
    "Runtime": {
      "ServiceName": "hvo-eg4",
      "GatewayId": "eg4",
      "GatewayType": "eg4-direct",
      "Domain": "Power",
      "SourceId": "eg4-fleet",
      "SiteId": "hvo",
      "DiagnosticsApiKeySecret": "diagnostics-api-key"
    }
  },
  "Eg4": {
    "SimulationEnabled": true,
    "CentralIngestEndpoint": "http://127.0.0.1:5000/",
    "AllowInsecureCentralIngest": true,
    "Devices": [
      {
        "Type": "Inverter6500Ex",
        "SourceId": "eg4-sim-inverter-a",
        "DeviceId": "sim-inverter-a",
        "Alias": "Simulator Inverter A",
        "Port": "/dev/hvo/sim-eg4-inverter-a",
        "UnitId": 0
      },
      {
        "Type": "Inverter6500Ex",
        "SourceId": "eg4-sim-inverter-b",
        "DeviceId": "sim-inverter-b",
        "Alias": "Simulator Inverter B",
        "Port": "/dev/hvo/sim-eg4-inverter-b",
        "UnitId": 0
      }
    ]
  },
  "Outbox": {
    "DatabasePath": "/tmp/hvo-eg4/data/outbox.db"
  },
  "HomeAssistant": {
    "Mqtt": {
      "Enabled": false
    }
  }
}
