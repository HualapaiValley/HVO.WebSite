{
  "Eg4": {
    "DefaultPollIntervalSeconds": 60,
    "DisplayTimeZoneId": "America/Phoenix",
    "SimulationEnabled": false,
    "Devices": []
  },
  "Outbox": {
    "ApiEndpoint": "https://localhost:5001/api/v1/power/readings",
    "ApiKey": "",
    "MaxRetryAttempts": 10,
    "MaxBackoffSeconds": 300,
    "SweepIntervalSeconds": 5,
    "BatchSize": 50,
    "DbPath": "",
    "SentRetentionDays": 7,
    "FailedRetentionDays": 30,
    "PendingWarningCount": 10,
    "FailedCriticalCount": 1
  },
  "Telemetry": {
    "ServiceName": "hvo-eg4",
    "ServiceVersion": "1.0.0",
    "Environment": "Production",
    "ActivitySources": [
      "HVO.Enterprise.Telemetry",
      "HVO.Edge"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
