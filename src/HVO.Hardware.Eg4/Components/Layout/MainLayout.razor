@inherits LayoutComponentBase

<HvoGatewayLayout Subtitle="EG4 BATTERY GATEWAY"
                  FooterSlot1="@_footer1"
                  FooterSlot2="@_footer2"
                  FooterSlot3="@_footer3"
                  FooterSlot4="@_footer4"
                  FooterSlot5="@_footer5"
                  IsDarkMode="@_shellState.IsDarkMode"
                  IsDarkModeChanged="OnThemeModeChanged">
    <NavItems>
        <MudButton Href="/" Variant="Variant.Filled" Color="Color.Inherit" Class="shell-nav-link shell-nav-link-current" aria-current="page">Overview</MudButton>
        <MudButton Href="/#devices" Variant="Variant.Text" Color="Color.Inherit" Class="shell-nav-link">Devices</MudButton>
        <MudButton Href="/#outbox" Variant="Variant.Text" Color="Color.Inherit" Class="shell-nav-link">Outbox</MudButton>
    </NavItems>
    <AppBarActions>
        <MudIconButton Icon="@ThemeSelectorIcon" Color="Color.Inherit" Size="Size.Medium" aria-label="@ThemeSelectorLabel" OnClick="ToggleTheme" />
    </AppBarActions>
    <Body>@Body</Body>
</HvoGatewayLayout>
