@page "/"

<PageTitle>Home</PageTitle>

<MudPaper Class="layout-canvas shell-page" Elevation="0">
    <MudStack Class="shell-page-stack" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="4" Style="min-height:60vh;">
        <MudText Typo="Typo.overline" Color="Color.Info" Class="hvo-eyebrow">Hualapai Valley Observatory</MudText>
        <MudText Typo="Typo.h2" Color="Color.Primary">Home</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary" Align="Align.Center">Current observatory power telemetry, assembled from the live edge gateways.</MudText>

        <AuthorizeView Policy="PowerStatusView">
            <Authorized>
                <PowerStatusCard />
            </Authorized>
            <NotAuthorized>
                <div class="hvo-card" style="max-width:42rem;text-align:center;">
                    <div class="hvo-eyebrow">Power System</div>
                    <div class="hvo-card-title">Live Power Snapshot</div>
                    <MudText Typo="Typo.body2">Sign in with observatory access to view the live power-system card.</MudText>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </MudStack>
</MudPaper>
