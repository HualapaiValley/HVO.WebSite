<section class="power-status-card" aria-labelledby="power-status-heading">
    <div class="power-status-card__header">
        <div>
            <p class="power-status-card__eyebrow">Power System</p>
            <h2 id="power-status-heading">Live Power Snapshot</h2>
        </div>
        <span class="power-status-card__state">@_viewModel.SnapshotState</span>
    </div>

    <div class="power-status-card__grid">
        <article class="power-metric power-metric--solar">
            <span>PV</span>
            <strong>@_viewModel.PvPower</strong>
        </article>
        <article class="power-metric power-metric--load">
            <span>Load</span>
            <strong>@_viewModel.LoadPower</strong>
        </article>
        <article class="power-metric power-metric--battery">
            <span>Battery</span>
            <strong>@_viewModel.BatteryPower</strong>
            <small>@_viewModel.BatteryFlow</small>
        </article>
        <article class="power-metric power-metric--grid">
            <span>Grid</span>
            <strong>@_viewModel.GridPower</strong>
            <small>@_viewModel.GridFlow</small>
        </article>
    </div>

    <div class="power-status-card__footer">
        <span>Battery SOC <strong>@_viewModel.BatteryStateOfCharge</strong></span>
        <span>Battery source <strong>@_viewModel.BatterySource</strong></span>
        <span>Battery banks <strong>@_viewModel.BatteryBankCount</strong></span>
        <span>Bank freshness <strong>@_viewModel.BatteryFreshnessState</strong></span>
        <span>BMS alarms <strong>@_viewModel.BatteryAlarmState</strong></span>
        <span>Mode <strong>@_viewModel.InverterMode</strong></span>
        <span>@_viewModel.ObservedAt</span>
    </div>

    @if (_viewModel.BatteryBanks.Count > 0)
    {
        <div class="power-bank-grid" aria-label="JK BMS battery banks">
            @foreach (var bank in _viewModel.BatteryBanks)
            {
                <article class="power-bank power-bank--@bank.FreshnessStatus @(bank.IsAlarmed ? "power-bank--alarm" : null)" aria-labelledby="@bank.HeadingId">
                    <div class="power-bank__header">
                        <h3 id="@bank.HeadingId">@bank.BankId</h3>
                        <span>@bank.AlarmState</span>
                    </div>
                    <dl>
                        <div><dt>SOC</dt><dd>@bank.StateOfCharge</dd></div>
                        <div><dt>Voltage</dt><dd>@bank.Voltage</dd></div>
                        <div><dt>Current</dt><dd>@bank.Current</dd></div>
                        <div><dt>Cell delta</dt><dd>@bank.DeltaCellVoltage</dd></div>
                        <div><dt>Seen</dt><dd>@bank.Seen</dd></div>
                    </dl>
                </article>
            }
        </div>
    }

    <section class="power-inventory" aria-labelledby="power-inventory-heading">
        <div class="power-bank__header">
            <h3 id="power-inventory-heading">SolarAssistant Inventory</h3>
            <span>@_inventoryConfiguration.State</span>
        </div>
        <dl>
            <div><dt>Devices</dt><dd>@_inventoryConfiguration.DeviceSummary</dd></div>
            <div><dt>Configuration</dt><dd>@_inventoryConfiguration.ConfigurationSummary</dd></div>
            <div><dt>Command inventory</dt><dd>@_inventoryConfiguration.CommandCapabilitySummary</dd></div>
        </dl>
        @if (_inventoryConfiguration.Devices.Count > 0)
        {
            <p>Known devices: @string.Join(", ", _inventoryConfiguration.Devices)</p>
        }
        @if (_inventoryConfiguration.Settings.Count > 0)
        {
            <p>Settings: @string.Join(", ", _inventoryConfiguration.Settings)</p>
        }
    </section>

    <section class="power-inventory power-solarassistant-detail" aria-labelledby="power-solarassistant-detail-heading">
        <div class="power-bank__header">
            <h3 id="power-solarassistant-detail-heading">SolarAssistant Detail</h3>
            <span>@_solarAssistantDetail.State</span>
        </div>
        <dl>
            <div><dt>Energy</dt><dd>@_solarAssistantDetail.EnergySummary</dd></div>
            <div><dt>Counter health</dt><dd>@_solarAssistantDetail.EnergyResetState</dd></div>
            <div><dt>PV strings</dt><dd>@_solarAssistantDetail.PvStringSummary</dd></div>
            <div><dt>Inverter load</dt><dd>@_solarAssistantDetail.InverterLoadSummary</dd></div>
            <div><dt>Inverter battery</dt><dd>@_solarAssistantDetail.InverterBatterySummary</dd></div>
            <div><dt>Temperature</dt><dd>@_solarAssistantDetail.TemperatureSummary</dd></div>
            <div><dt>Status values</dt><dd>@_solarAssistantDetail.StatusSummary</dd></div>
        </dl>
        @if (_solarAssistantDetail.EnergyCounters.Count > 0)
        {
            <p>Energy counters: @string.Join(", ", _solarAssistantDetail.EnergyCounters)</p>
        }
        @if (_solarAssistantDetail.PvStrings.Count > 0)
        {
            <div class="power-pv-string-grid" aria-label="SolarAssistant PV string diagnostics">
                @foreach (var pvString in _solarAssistantDetail.PvStrings)
                {
                    <article>
                        <strong>String @pvString.StringId</strong>
                        <span>@pvString.Power</span>
                        <span>@pvString.Voltage</span>
                        <span>@pvString.Current</span>
                    </article>
                }
            </div>
        }
        @if (_solarAssistantDetail.Statuses.Count > 0)
        {
            <p>Status: @string.Join(", ", _solarAssistantDetail.Statuses)</p>
        }
        @if (!string.IsNullOrWhiteSpace(_solarAssistantDetail.GatewayUrl))
        {
            <p><a href="@_solarAssistantDetail.GatewayUrl" target="_blank" rel="noopener noreferrer">Open local SolarAssistant gateway diagnostics</a></p>
        }
    </section>
</section>
