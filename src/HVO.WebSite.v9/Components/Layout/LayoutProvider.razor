@inherits LayoutComponentBase

@if (_isAdmin)
{
    <HvoAdminLayout @bind-IsDarkMode="_isDarkMode" Body="Body">
        <SidebarItems>
            <MudNavLink Href="/admin">Dashboard</MudNavLink>
            <MudNavLink Href="/admin" Disabled="true">Users</MudNavLink>
            <MudNavLink Href="/admin" Disabled="true">Settings</MudNavLink>
            <MudNavLink Href="/admin" Disabled="true">Logs</MudNavLink>
            <MudDivider Class="my-2" />
            <MudNavLink Href="/">Back to Site</MudNavLink>
        </SidebarItems>
        <AppBarActions><ShellActions @bind-IsDarkMode="_isDarkMode" /></AppBarActions>
    </HvoAdminLayout>
}
else
{
    <HvoPublicLayout @bind-IsDarkMode="_isDarkMode" Body="Body">
        <NavItems><MudButton Href="/" Variant="Variant.Text" Color="Color.Inherit" Class="shell-nav-link">Home</MudButton></NavItems>
        <AuthSection><ShellActions @bind-IsDarkMode="_isDarkMode" /></AuthSection>
    </HvoPublicLayout>
}
