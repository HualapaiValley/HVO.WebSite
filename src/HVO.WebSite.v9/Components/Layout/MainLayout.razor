@inherits LayoutComponentBase

<div class="app-frame">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4 shadow-sm app-navbar">
            <div class="container">
                <a class="navbar-brand" href="/">
                    <i class="fas fa-home"></i> Hualapai Valley Observatory
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="/">
                                <i class="bi bi-house-door"></i> Home
                            </a>
                        </li>
                        <AuthorizeView>
                            <Authorized>
                                <AuthorizeView Roles="Admin" Context="adminContext">
                                    <Authorized>
                                        <li class="nav-item">
                                            <a class="nav-link" href="/admin">
                                                <i class="bi bi-gear"></i> Admin
                                            </a>
                                        </li>
                                    </Authorized>
                                </AuthorizeView>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-person-circle"></i> @context.User.Identity?.Name
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <a class="dropdown-item" href="MicrosoftIdentity/Account/SignOut">
                                                <i class="bi bi-box-arrow-right"></i> Sign out
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            </Authorized>
                            <NotAuthorized>
                                <li class="nav-item">
                                    <a class="nav-link" href="MicrosoftIdentity/Account/SignIn">
                                        <i class="bi bi-person"></i> Sign in
                                    </a>
                                </li>
                            </NotAuthorized>
                        </AuthorizeView>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="app-main container-fluid">
        <div class="row">
            <div class="col-12">
                @Body
            </div>
        </div>
    </main>

    <MainLayoutFooter />
</div>
