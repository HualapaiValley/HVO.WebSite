@page "/inventory"
@inject SolarAssistantSnapshotWorker SnapshotWorker

<PageTitle>SolarAssistant REST Inventory</PageTitle>

<MudPaper Class="layout-canvas shell-page" Elevation="0" aria-label="SolarAssistant REST inventory content area">
    <MudStack Class="shell-page-stack solar-dashboard">
        <section class="solar-hero-card" aria-label="REST inventory summary">
            <div class="solar-hero-copy">
                <MudText Typo="Typo.overline" Class="solar-eyebrow">REST Metric Inventory</MudText>
                <MudText Typo="Typo.h3" Class="solar-hero-title">SolarAssistant REST Topics</MudText>
                <div class="solar-hero-number">@MetricCountText</div>
                <MudText Typo="Typo.body2" Class="solar-muted">Read-only discovery from the latest SolarAssistant REST metrics snapshot.</MudText>
            </div>

            <div class="solar-hero-panel" aria-label="REST inventory metadata">
                <DetailRow Label="Last inventory" Value="@FormatTimestamp(Inventory?.RecordedAtUtc)" />
                <DetailRow Label="Raw metrics" Value="@((Inventory?.MetricCount ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))" />
                <DetailRow Label="Topics" Value="@((Inventory?.Topics.Count ?? 0).ToString(System.Globalization.CultureInfo.InvariantCulture))" />
                <DetailRow Label="Groups" Value="@FormatCounts(Inventory?.GroupCounts)" />
                <DetailRow Label="Units" Value="@FormatCounts(Inventory?.UnitCounts)" />
            </div>
        </section>

        <MudPaper Class="solar-card" Elevation="0">
            <CardHead Eyebrow="Discovery" Title="REST Topics" />
            <div class="solar-detail-list solar-detail-list-wide">
                <DetailRow Label="DB candidates" Value="@ClassificationCount(SolarAssistantMetricClassification.DbCandidate).ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                <DetailRow Label="Review" Value="@ClassificationCount(SolarAssistantMetricClassification.Review).ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                <DetailRow Label="Local only" Value="@ClassificationCount(SolarAssistantMetricClassification.LocalOnly).ToString(System.Globalization.CultureInfo.InvariantCulture)" />
            </div>

            @if (Inventory is null)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="solar-alert">Waiting for the first REST inventory snapshot.</MudAlert>
            }
            else
            {
                <div class="solar-topic-list" aria-label="Discovered SolarAssistant REST topics">
                    @foreach (var topic in Inventory.Topics)
                    {
                        <div class="solar-topic-row solar-topic-row-expanded">
                            <span>@topic.Topic</span>
                            <small>@FormatTopicMetadata(topic)</small>
                            <strong>@topic.Classification</strong>
                        </div>
                    }
                </div>
            }
        </MudPaper>
    </MudStack>
</MudPaper>
