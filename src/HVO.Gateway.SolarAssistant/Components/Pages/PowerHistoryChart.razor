<div class="hvo-card">
    <div class="hvo-card-head" style="display:flex;align-items:center;justify-content:space-between;">
        <div>
            <MudText Typo="Typo.overline" Class="hvo-eyebrow">@Eyebrow</MudText>
            <MudText Typo="Typo.h6">@Title</MudText>
        </div>
        <strong class="hvo-mono">@FormatWatts(LatestValue)</strong>
    </div>

    @if (HasData)
    {
        <HvoChart @ref="_chartRef"
                  ChartId="@($"phc-{Title.GetHashCode():x}")"
                  Type="HvoChartType.Line"
                  Height="200"
                  ShowLegend="false"
                  EnableAnimations="false"
                  Labels="@_labels"
                  Datasets="@_datasets" />
    }
    else
    {
        <div class="hvo-state-empty" style="min-height:120px;">
            <MudText Typo="Typo.caption">Waiting for history data</MudText>
        </div>
    }

    <div style="display:flex;justify-content:space-between;padding:0.5rem 0;font-size:0.75rem;color:var(--shell-pill-text);">
        <span>@HistorySummary</span>
        <span>@RangeSummary</span>
    </div>
</div>

@code {
    private HvoChart? _chartRef;

    [Parameter] public string Eyebrow { get; set; } = "History";
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string LineClass { get; set; } = "solar-history-line-cyan";
    [Parameter] public IReadOnlyList<PowerSnapshotHistoryPoint> Points { get; set; } = [];
    [Parameter] public Func<PowerSnapshotHistoryPoint, double?> ValueSelector { get; set; } = _ => null;

    private bool HasData => Points.Any(p => ValueSelector(p).HasValue);

    private double? LatestValue => Points.Select(ValueSelector).LastOrDefault(v => v.HasValue);

    private string HistorySummary => Points.Count == 0 ? "No samples" : $"{Points.Count} samples";

    private string RangeSummary
    {
        get
        {
            var values = Points.Select(ValueSelector).Where(v => v.HasValue).Select(v => v!.Value).ToArray();
            return values.Length == 0 ? "--" : $"{FormatWatts(values.Min())} to {FormatWatts(values.Max())}";
        }
    }

    private string[] _labels
    {
        get
        {
            return Points
                .Where(p => ValueSelector(p).HasValue)
                .Select(p => p.RecordedAtUtc.ToLocalTime().ToString("HH:mm"))
                .ToArray();
        }
    }

    private List<HvoChartDataset> _datasets
    {
        get
        {
            var filtered = Points
                .Where(p => ValueSelector(p).HasValue)
                .Select(p => (double?)ValueSelector(p)!.Value)
                .ToArray();

            var borderColor = LineClass switch
            {
                "solar-history-line-amber" => "#ffcf66",
                "solar-history-line-blue" => "#6da5ff",
                "solar-history-line-green" => "#57d38d",
                _ => "#83e4ff"
            };

            return new()
            {
                new HvoChartDataset(Title, filtered,
                    BorderColor: borderColor, BackgroundColor: "rgba(131,228,255,0.08)", Fill: true, BorderWidth: 2)
            };
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_chartRef is not null)
            await _chartRef.RefreshAsync();
    }

    private static string FormatWatts(double? value) => HvoFormat.Power(value);
}
