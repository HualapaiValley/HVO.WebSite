@page "/mqtt-inventory"
@inject SolarAssistantMqttDiscoveryWorker MqttWorker

<PageTitle>SolarAssistant MQTT Inventory</PageTitle>

    <MudStack Class="shell-page-stack solar-dashboard">
        <section class="solar-hero-card" aria-label="MQTT inventory summary">
            <div class="solar-hero-copy">
                <MudText Typo="Typo.overline" Class="solar-eyebrow">MQTT Discovery</MudText>
                <MudText Typo="Typo.h3" Class="solar-hero-title">Home Assistant Entities</MudText>
                <div class="solar-hero-number">@Inventory.EntityCount.ToString(System.Globalization.CultureInfo.InvariantCulture)</div>
                <MudText Typo="Typo.body2" Class="solar-muted">Read-only MQTT discovery and state metadata from SolarAssistant.</MudText>
            </div>

            <div class="solar-hero-panel" aria-label="MQTT inventory metadata">
                <DetailRow Label="Connection" Value="@Inventory.ConnectionState" />
                <DetailRow Label="Last message" Value="@FormatTimestamp(Inventory.LastMessageAtUtc)" />
                <DetailRow Label="State topics" Value="@Inventory.StateTopicCount.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                <DetailRow Label="Command topics" Value="@Inventory.CommandTopicCount.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                <DetailRow Label="Devices" Value="@FormatDevices(Inventory.Devices)" />
            </div>
        </section>

        <MudPaper Class="solar-card" Elevation="0">
            <CardHead Eyebrow="Discovery" Title="MQTT Entities" />
            <div class="solar-detail-list solar-detail-list-wide">
                <DetailRow Label="Components" Value="@FormatCounts(Inventory.ComponentCounts)" />
                <DetailRow Label="Device classes" Value="@FormatCounts(Inventory.DeviceClassCounts)" />
                <DetailRow Label="Units" Value="@FormatCounts(Inventory.UnitCounts)" />
            </div>

            @if (!string.IsNullOrWhiteSpace(Inventory.LastError))
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="solar-alert">@Inventory.LastError</MudAlert>
            }

            <div class="solar-topic-list" aria-label="Discovered SolarAssistant MQTT entities">
                @foreach (var entity in Inventory.Entities)
                {
                    <div class="solar-topic-row solar-topic-row-expanded">
                        <span>@entity.Name</span>
                        <small>@(entity.StateTopic ?? entity.DiscoveryTopic)</small>
                        <strong>@entity.Classification</strong>
                    </div>
                }
            </div>
        </MudPaper>

        <MudPaper Class="solar-card" Elevation="0">
            <CardHead Eyebrow="State" Title="MQTT State Topics" />
            <div class="solar-topic-list" aria-label="Observed SolarAssistant MQTT state topics">
                @foreach (var state in Inventory.States)
                {
                    <div class="solar-topic-row solar-topic-row-expanded">
                        <span>@state.Topic</span>
                        <small>@FormatTimestamp(state.LastSeenAtUtc) - @state.PayloadKind - @state.PayloadLength bytes</small>
                        <strong>@state.MessageCount.ToString(System.Globalization.CultureInfo.InvariantCulture)</strong>
                    </div>
                }
            </div>
        </MudPaper>
    </MudStack>
