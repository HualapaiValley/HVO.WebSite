<div class="solar-card-head">
    <div>
        <MudText Typo="Typo.overline" Class="solar-eyebrow">@Eyebrow</MudText>
        <MudText Typo="Typo.h5" Class="solar-card-title">@Title</MudText>
    </div>
    @if (!string.IsNullOrWhiteSpace(LinkHref) && !string.IsNullOrWhiteSpace(LinkText))
    {
        <MudButton Href="@LinkHref" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="solar-card-link">@LinkText</MudButton>
    }
</div>
