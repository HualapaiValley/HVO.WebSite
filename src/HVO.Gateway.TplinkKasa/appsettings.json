{
  "KasaGateway": {
    "GatewayId": "hvo-tplink-kasa",
    "ApiKey": "",
    "DefaultPort": 9999,
    "SocketTimeoutSeconds": 3,
    "PollIntervalSeconds": 5,
    "MaxPollConcurrency": 8,
    "DashboardRefreshSeconds": 5,
    "DisplayTimeZoneId": "America/Phoenix",
    "DeviceRegistryPath": "kasa-devices.json",
    "RequireIdentityValidation": true,
    "MaxScanHosts": 256,
    "MaxScanConcurrency": 64,
    "Networks": [
      {
        "Name": "Observatory Lan 1",
        "Cidr": "192.168.1.0/24",
        "DiscoveryEnabled": true
      },
      {
        "Name": "Home Lan 1",
        "Cidr": "192.168.2.0/24",
        "DiscoveryEnabled": true
      },
      {
        "Name": "Home Lan 2",
        "Cidr": "192.168.9.0/24",
        "DiscoveryEnabled": true
      }
    ],
    "Devices": []
  },
  "Outbox": {
    "ApiEndpoint": "",
    "ApiKey": "",
    "MaxRetryAttempts": 10,
    "MaxBackoffSeconds": 300,
    "SweepIntervalSeconds": 5,
    "BatchSize": 50,
    "SentRetentionDays": 1,
    "FailedRetentionDays": 30,
    "PendingWarningCount": 10,
    "FailedCriticalCount": 1,
    "DbPath": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
