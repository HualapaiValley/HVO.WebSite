@page "/settings"
@rendermode InteractiveServer
@inject KasaAdminService AdminService
@inject KasaGatewayState GatewayState
@inject IOptions<KasaGatewayOptions> GatewayOptions
@inject KasaOutboxForwarder OutboxForwarder
@inject IHttpClientFactory HttpClientFactory

    <MudStack Spacing="3" Class="shell-page-stack kasa-page">
        <section class="kasa-page-header">
            <div>
                <MudText Typo="Typo.overline" Class="kasa-eyebrow">Admin</MudText>
                <MudText Typo="Typo.h3" Class="kasa-title">Device Settings</MudText>
                <MudText Typo="Typo.body2" Class="kasa-muted">Scan configured networks and manage the devices that power
                    dashboard and polling state.</MudText>
                </div>
            </section>

            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <MudAlert Severity="@(_messageIsError ? Severity.Error : Severity.Success)" Dense="true">@_message</MudAlert>
            }

            <MudTabs Rounded="true" Elevation="0" Class="kasa-tabs">
                <MudTabPanel Text="Device Setup" Icon="@Icons.Material.Outlined.DevicesOther">
                    <div class="kasa-tab-panel">
                        <div class="kasa-admin-grid">
                            <MudPaper Class="kasa-panel" Elevation="0">
                                <MudText Typo="Typo.h5">Scan Network</MudText>
                                <MudStack Spacing="2">
                                    @if (ScanBusyState.IsBusy && !string.IsNullOrWhiteSpace(ScanBusyState.Message))
                                    {
                                        <MudAlert Severity="Severity.Info" Dense="true">@ScanBusyState.Message</MudAlert>
                                    }
                                    <MudSelect T="string" Label="Configured network" @bind-Value="_selectedNetwork"
                                               Disabled="@ScanBusyState.IsBusy">
                                        @foreach (var network in _networks)
                                        {
                                            <MudSelectItem T="string" Value="@network.Name">@network.Name (@network.Cidr)
                                            </MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                               StartIcon="@Icons.Material.Outlined.TravelExplore" Disabled="@ScanBusyState.IsBusy"
                                               OnClick="ScanAsync">Scan</MudButton>
                                </MudStack>
                            </MudPaper>

                            <MudPaper Class="kasa-panel" Elevation="0">
                                <MudText Typo="Typo.h5">Add Device</MudText>
                                <MudStack Spacing="2">
                                    @if (DirectAddBusyState.IsBusy &&
                                            !string.IsNullOrWhiteSpace(DirectAddBusyState.Message))
                                    {
                                        <MudAlert Severity="Severity.Info" Dense="true">@DirectAddBusyState.Message</MudAlert>
                                    }
                                    <MudText Typo="Typo.body2" Class="kasa-muted">Use direct add when you already know the
                                        device host or MAC. Discovered devices are configured separately from scan results
                                        below.</MudText>
                                        <MudTextField Label="IP or host" @bind-Value="_hostToAdd" Variant="Variant.Outlined"
                                                      Disabled="@DirectAddBusyState.IsBusy" />
                                        <MudTextField Label="Display name override" @bind-Value="_displayNameToAdd"
                                                      Variant="Variant.Outlined" Disabled="@DirectAddBusyState.IsBusy" />
                                        <MudTextField Label="Group" @bind-Value="_groupNameToAdd" Variant="Variant.Outlined"
                                                      Disabled="@DirectAddBusyState.IsBusy" />
                                        <MudSwitch T="bool" @bind-Value="_isFavoriteToAdd" Color="Color.Warning"
                                                   Disabled="@DirectAddBusyState.IsBusy">Favorite</MudSwitch>
                                        <MudButton Variant="Variant.Filled" Color="Color.Success"
                                                   StartIcon="@Icons.Material.Outlined.Add" Disabled="@DirectAddBusyState.IsBusy"
                                                   OnClick="AddByHostAsync">Add by IP</MudButton>
                                        <MudDivider />
                                        <MudTextField Label="MAC address" @bind-Value="_macToAdd" Variant="Variant.Outlined"
                                                      Disabled="@DirectAddBusyState.IsBusy" />
                                        <MudButton Variant="Variant.Outlined" Color="Color.Success"
                                                   StartIcon="@Icons.Material.Outlined.AddLink" Disabled="@DirectAddBusyState.IsBusy"
                                                   OnClick="AddByMacAsync">Find by MAC</MudButton>
                                    </MudStack>
                                </MudPaper>
                            </div>

                            <MudPaper Class="kasa-panel" Elevation="0">
                                <div class="kasa-section-heading">
                                    <MudText Typo="Typo.h5">Scan Results</MudText>
                                    <MudText Typo="Typo.caption" Class="kasa-muted">@_scanResults.Count discovered device(s)
                                    </MudText>
                                </div>
                                <MudTable Items="_scanResults" Dense="true" Hover="true">
                                    <HeaderContent>
                                        <MudTh>Name</MudTh>
                                        <MudTh>Host</MudTh>
                                        <MudTh>Model</MudTh>
                                        <MudTh>Type</MudTh>
                                        <MudTh>Features</MudTh>
                                        <MudTh></MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@FormatDeviceName(context)</MudTd>
                                        <MudTd>@context.Host</MudTd>
                                        <MudTd>@(context.SystemInfo?.Model ?? "Unknown")</MudTd>
                                        <MudTd>@(context.Profile?.DeviceKind.ToString() ?? "Unknown")</MudTd>
                                        <MudTd>@FormatCapabilities(context.Profile)</MudTd>
                                        <MudTd>
                                            <MudButton Size="Size.Small"
                                                       Variant="@(IsSelectedScanResult(context) ? Variant.Outlined : Variant.Filled)"
                                                       Color="Color.Primary" Disabled="@IsDiscoveredDeviceSectionBusy"
                                                       OnClick="() => SelectScanResult(context)">@(IsSelectedScanResult(context) ?
                                                               "Selected" : "Configure")</MudButton>
                                            </MudTd>
                                        </RowTemplate>
                                    </MudTable>
                                </MudPaper>

                                <MudPaper Class="kasa-panel" Elevation="0">
                                    <MudText Typo="Typo.h5">Discovered Device Metadata</MudText>
                                    @if (DiscoveredDeviceBusyState.IsBusy &&
                                            !string.IsNullOrWhiteSpace(DiscoveredDeviceBusyState.Message))
                                    {
                                        <MudAlert Severity="Severity.Info" Dense="true">@DiscoveredDeviceBusyState.Message</MudAlert>
                                    }
                                    @if (_selectedScanResult is null)
                                    {
                                        <MudText Typo="Typo.body2" Class="kasa-muted">Choose a device from scan results to assign a
                                            dashboard display name, group, and favorite state before adding it.</MudText>
                                    }
                                    else
                                    {
                                        <MudStack Spacing="2">
                                            <div class="kasa-config-grid">
                                                <div><span>Name</span><strong>@FormatDeviceName(_selectedScanResult)</strong></div>
                                                <div><span>Host</span><strong>@_selectedScanResult.Host</strong></div>
                                                <div><span>Model</span><strong>@(_selectedScanResult.SystemInfo?.Model ?? "Unknown")</strong></div>
                                                <div><span>Type</span><strong>@(_selectedScanResult.Profile?.DeviceKind.ToString() ?? "Unknown")</strong></div>
                                            </div>
                                            <MudTextField Label="Display name override" @bind-Value="_scanDisplayName"
                                                          Variant="Variant.Outlined" Disabled="@IsDiscoveredDeviceSectionBusy" />
                                            <MudTextField Label="Group" @bind-Value="_scanGroupName" Variant="Variant.Outlined"
                                                          Disabled="@IsDiscoveredDeviceSectionBusy" />
                                            <MudSwitch T="bool" @bind-Value="_scanIsFavorite" Color="Color.Warning"
                                                       Disabled="@IsDiscoveredDeviceSectionBusy">Favorite</MudSwitch>
                                            <MudStack Row="true" Spacing="1">
                                                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                                           Disabled="@IsDiscoveredDeviceSectionBusy"
                                                           OnClick="ConfigureSelectedScanResultAsync">Add discovered device</MudButton>
                                                <MudButton Variant="Variant.Text" Color="Color.Inherit"
                                                           Disabled="@IsDiscoveredDeviceSectionBusy" OnClick="ClearSelectedScanResult">Clear</MudButton>
                                            </MudStack>
                                        </MudStack>
                                    }
                                </MudPaper>

                                            <MudPaper Class="kasa-panel" Elevation="0">
                                                <div class="kasa-section-heading">
                                                    <MudText Typo="Typo.h5">Configured Devices</MudText>
                                                    <MudText Typo="Typo.caption" Class="kasa-muted">@_devices.Count device(s)</MudText>
                                                </div>
                                                <MudTable Items="_devices" Dense="true" Hover="true">
                                                    <HeaderContent>
                                                        <MudTh>Name</MudTh>
                                                        <MudTh>Group</MudTh>
                                                        <MudTh>Favorite</MudTh>
                                                        <MudTh>Host</MudTh>
                                                        <MudTh>Type</MudTh>
                                                        <MudTh>Features</MudTh>
                                                        <MudTh>Status</MudTh>
                                                        <MudTh></MudTh>
                                                    </HeaderContent>
                                                    <RowTemplate>
                                                        <MudTd>@GetConfiguredDisplayName(context)</MudTd>
                                                        <MudTd>@GetConfiguredGroupName(context)</MudTd>
                                                        <MudTd>@(GetConfiguredIsFavorite(context) ? "Yes" : "No")</MudTd>
                                                        <MudTd>@context.Host</MudTd>
                                                        <MudTd>@context.DeviceKind</MudTd>
                                                        <MudTd>@string.Join(", ", context.Capabilities.Take(4))</MudTd>
                                                        <MudTd>@(context.IsOnline ? "Online" : "Offline")</MudTd>
                                                        <MudTd>
                                                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                                                       Disabled="@ConfiguredDeviceBusyState.IsBusy" OnClick="() => StartEdit(context)">
                                                                Edit</MudButton>
                                                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                                                                           Disabled="@ConfiguredDeviceBusyState.IsBusy"
                                                                           OnClick="() => RemoveAsync(context.SourceId)">Remove</MudButton>
                                                            </MudTd>
                                                        </RowTemplate>
                                                    </MudTable>
                                                </MudPaper>

                                                <MudPaper Class="kasa-panel" Elevation="0">
                                                    <MudText Typo="Typo.h5">Configured Device Metadata</MudText>
                                                    @if (ConfiguredDeviceBusyState.IsBusy &&
                                                            !string.IsNullOrWhiteSpace(ConfiguredDeviceBusyState.Message))
                                                    {
                                                        <MudAlert Severity="Severity.Info" Dense="true">@ConfiguredDeviceBusyState.Message</MudAlert>
                                                    }
                                                    @if (string.IsNullOrWhiteSpace(_selectedDeviceSourceId))
                                                    {
                                                        <MudText Typo="Typo.body2" Class="kasa-muted">Select a configured device to edit its dashboard
                                                            display name, group, and favorite state.</MudText>
                                                    }
                                                    else
                                                    {
                                                        <MudStack Spacing="2">
                                                            <MudText Typo="Typo.caption" Class="kasa-muted">Editing @_selectedDeviceSourceId</MudText>
                                                            <MudTextField Label="Display name override" @bind-Value="_editDisplayName"
                                                                          Variant="Variant.Outlined" Disabled="@ConfiguredDeviceBusyState.IsBusy" />
                                                            <MudTextField Label="Group" @bind-Value="_editGroupName" Variant="Variant.Outlined"
                                                                          Disabled="@ConfiguredDeviceBusyState.IsBusy" />
                                                            <MudSwitch T="bool" @bind-Value="_editIsFavorite" Color="Color.Warning"
                                                                       Disabled="@ConfiguredDeviceBusyState.IsBusy">Favorite</MudSwitch>
                                                            <MudStack Row="true" Spacing="1">
                                                                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                                                           Disabled="@ConfiguredDeviceBusyState.IsBusy" OnClick="SaveMetadataAsync">Save</MudButton>
                                                                <MudButton Variant="Variant.Text" Color="Color.Inherit"
                                                                           Disabled="@ConfiguredDeviceBusyState.IsBusy" OnClick="ClearEdit">Clear</MudButton>
                                                            </MudStack>
                                                        </MudStack>
                                                    }
                                                </MudPaper>
                                                </div>
                                            </MudTabPanel>

                                            <MudTabPanel Text="Configuration" Icon="@Icons.Material.Outlined.Tune">
                                                <div class="kasa-tab-panel">
                                                    <MudPaper Class="kasa-panel" Elevation="0">
                                                        <MudText Typo="Typo.h5">Gateway Options</MudText>
                                                        <div class="kasa-config-grid">
                                                            <div><span>Gateway ID</span><strong>@Options.GatewayId</strong></div>
                                                            <div><span>Default Port</span><strong>@Options.DefaultPort</strong></div>
                                                            <div><span>Socket Timeout</span><strong>@Options.SocketTimeoutSeconds s</strong></div>
                                                            <div><span>Poll Interval</span><strong>@Options.PollIntervalSeconds s</strong></div>
                                                            <div><span>Poll Concurrency</span><strong>@Options.MaxPollConcurrency</strong></div>
                                                            <div><span>Dashboard Refresh</span><strong>@Options.DashboardRefreshSeconds s</strong></div>
                                                            <div><span>Display Time Zone</span><strong>@Options.DisplayTimeZoneId</strong></div>
                                                            <div><span>Registry Path</span><strong>@Options.DeviceRegistryPath</strong></div>
                                                            <div><span>Identity Validation</span><strong>@(Options.RequireIdentityValidation ?
                                                                                  "Required" : "Disabled")</strong></div>
                                                                <div><span>Max Scan Hosts</span><strong>@Options.MaxScanHosts</strong></div>
                                                                <div><span>Max Scan Concurrency</span><strong>@Options.MaxScanConcurrency</strong></div>
                                                            </div>
                                                        </MudPaper>

                                                        <MudPaper Class="kasa-panel" Elevation="0">
                                                            <div class="kasa-section-heading">
                                                                <MudText Typo="Typo.h5">Allowed Networks</MudText>
                                                                <MudText Typo="Typo.caption" Class="kasa-muted">@Options.Networks.Count configured subnet(s)
                                                                </MudText>
                                                            </div>
                                                            <MudTable Items="Options.Networks" Dense="true" Hover="true">
                                                                <HeaderContent>
                                                                    <MudTh>Name</MudTh>
                                                                    <MudTh>CIDR</MudTh>
                                                                    <MudTh>Discovery</MudTh>
                                                                </HeaderContent>
                                                                <RowTemplate>
                                                                    <MudTd>@context.Name</MudTd>
                                                                    <MudTd>@context.Cidr</MudTd>
                                                                    <MudTd>@(context.DiscoveryEnabled ? "Enabled" : "Disabled")</MudTd>
                                                                </RowTemplate>
                                                            </MudTable>
                                                        </MudPaper>

                                                        <MudPaper Class="kasa-panel" Elevation="0">
                                                            <div class="kasa-section-heading">
                                                                <MudText Typo="Typo.h5">Seed Devices</MudText>
                                                                <MudText Typo="Typo.caption" Class="kasa-muted">@Options.Devices.Count appsettings device(s)
                                                                </MudText>
                                                            </div>
                                                            <MudTable Items="Options.Devices" Dense="true" Hover="true">
                                                                <HeaderContent>
                                                                    <MudTh>Name</MudTh>
                                                                    <MudTh>Group</MudTh>
                                                                    <MudTh>Favorite</MudTh>
                                                                    <MudTh>Source ID</MudTh>
                                                                    <MudTh>Host</MudTh>
                                                                    <MudTh>Network</MudTh>
                                                                    <MudTh>Display TZ</MudTh>
                                                                    <MudTh>Type</MudTh>
                                                                    <MudTh>Enabled</MudTh>
                                                                </HeaderContent>
                                                                <RowTemplate>
                                                                    <MudTd>@(context.DisplayName ?? "-")</MudTd>
                                                                    <MudTd>@(context.GroupName ?? "-")</MudTd>
                                                                    <MudTd>@(context.IsFavorite ? "Yes" : "No")</MudTd>
                                                                    <MudTd>@context.EffectiveSourceId</MudTd>
                                                                    <MudTd>@context.Host</MudTd>
                                                                    <MudTd>@(context.NetworkName ?? "-")</MudTd>
                                                                    <MudTd>@(context.DisplayTimeZoneId ?? Options.DisplayTimeZoneId)</MudTd>
                                                                    <MudTd>@context.DeviceKind</MudTd>
                                                                    <MudTd>@(context.Enabled ? "Yes" : "No")</MudTd>
                                                                </RowTemplate>
                                                            </MudTable>
                                                        </MudPaper>
                                                    </div>
                                                </MudTabPanel>
                                                <MudTabPanel Text="Outbox Forwarder" Icon="@Icons.Material.Outlined.Send">
                                                    <div class="kasa-tab-panel">
                                                        <MudPaper Class="kasa-panel" Elevation="0" Style="max-width:600px;">
                                                            <div style="display:flex;justify-content:space-between;align-items:center;">
                                                                <div>
                                                                    <MudText Typo="Typo.h5">Forwarder Configuration</MudText>
                                                                    <MudText Typo="Typo.body2" Class="kasa-muted">Tune batch size and sweep interval at runtime.</MudText>
                                                                </div>
                                                                <div style="display:flex;gap:8px;">
                                                                    @if (_outboxOverride)
                                                                    {
                                                                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" OnClick="ResetOutboxSettingsAsync">Reset defaults</MudButton>
                                                                    }
                                                                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" Disabled="@(!_outboxDirty)" OnClick="SaveOutboxSettingsAsync">Apply</MudButton>
                                                                </div>
                                                            </div>
                                                            <div class="solar-detail-list" style="margin-top:16px;">
                                                                <div class="solar-detail-row"><span>Pending</span><strong>@OutboxForwarder.PendingCount.ToString(System.Globalization.CultureInfo.InvariantCulture)</strong></div>
                                                                <div class="solar-detail-row"><span>Failed</span><strong>@OutboxForwarder.FailedCount.ToString(System.Globalization.CultureInfo.InvariantCulture)</strong></div>
                                                                <div class="solar-detail-row"><span>Last batch</span><strong>@OutboxForwarder.LastBatchCount.ToString(System.Globalization.CultureInfo.InvariantCulture)</strong></div>
                                                                <div class="solar-detail-row"><span>Last error</span><strong title="@OutboxForwarder.LastError">@(OutboxForwarder.LastError ?? "None")</strong></div>
                                                            </div>
                                                            <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:16px;">
                                                                <MudTextField Label="Batch size (1-500)" Variant="Variant.Outlined" T="int"
                                                                    @bind-Value="@_outboxBatchSize" @bind-Value:after="() => _outboxDirty = true" />
                                                                <MudTextField Label="Sweep interval s (1-60)" Variant="Variant.Outlined" T="int"
                                                                    @bind-Value="@_outboxSweepIntervalSeconds" @bind-Value:after="() => _outboxDirty = true" />
                                                            </div>
                                                            @if (!string.IsNullOrWhiteSpace(_outboxStatusMessage))
                                                            {
                                                                <MudText Typo="Typo.body2" Color="Color.Secondary" Style="margin-top:12px;">@_outboxStatusMessage</MudText>
                                                            }
                                                        </MudPaper>
                                                    </div>
                                                </MudTabPanel>
                                            </MudTabs>
                                        </MudStack>

@code {
    private IReadOnlyList<KasaNetworkConfig> _networks = [];
    private IReadOnlyList<KasaDeviceStatus> _devices = [];
    private IReadOnlyDictionary<string, KasaInventoryDevice> _configuredDevices = new Dictionary<string,
KasaInventoryDevice>(StringComparer.OrdinalIgnoreCase);
    private IReadOnlyList<KasaProbeResult> _scanResults = [];
    private string? _selectedNetwork;
    private string? _hostToAdd;
    private string? _macToAdd;
    private string? _displayNameToAdd;
    private string? _groupNameToAdd;
    private bool _isFavoriteToAdd;
    private KasaProbeResult? _selectedScanResult;
    private string? _scanDisplayName;
    private string? _scanGroupName;
    private bool _scanIsFavorite;
    private string? _selectedDeviceSourceId;
    private string? _editDisplayName;
    private string? _editGroupName;
    private bool _editIsFavorite;
    private string? _message;
    private bool _messageIsError;
    private BusyState ScanBusyState { get; } = new();
    private BusyState DirectAddBusyState { get; } = new();
    private BusyState DiscoveredDeviceBusyState { get; } = new();
    private BusyState ConfiguredDeviceBusyState { get; } = new();

    private bool IsDiscoveredDeviceSectionBusy => ScanBusyState.IsBusy || DiscoveredDeviceBusyState.IsBusy;

    private KasaGatewayOptions Options => GatewayOptions.Value;

    protected override async Task OnInitializedAsync()
    {
        _networks = AdminService.GetNetworks();
        _selectedNetwork = _networks.FirstOrDefault()?.Name;
        await RefreshDevicesAsync();
    }

    private async Task ScanAsync()
    {
        await RunBusyAsync(ScanBusyState, "Scanning the selected network...", async token =>
        {
            _scanResults = await AdminService.ScanNetworkAsync(_selectedNetwork ?? string.Empty, token);
            if (_selectedScanResult is not null && !_scanResults.Any(IsSameProbeResultToSelected))
            {
                ClearSelectedScanResult();
            }

            SetMessage($"Scan found {_scanResults.Count} device(s).", isError: false);
        });
    }

    private async Task AddByHostAsync()
    {
        await RunBusyAsync(DirectAddBusyState, "Adding device by host...", async token =>
        {
            var result = await AdminService.AddByHostAsync(_hostToAdd ?? string.Empty, _selectedNetwork, _displayNameToAdd,
_groupNameToAdd, _isFavoriteToAdd, token);
            SetMessage(result.Message, !result.Success);
            if (result.Success)
            {
                ClearDirectAdd();
            }

            await RefreshDevicesAsync();
        });
    }

    private async Task AddByMacAsync()
    {
        await RunBusyAsync(DirectAddBusyState, "Searching for device by MAC address...", async token =>
        {
            var result = await AdminService.AddByMacAsync(_macToAdd ?? string.Empty, _selectedNetwork ?? string.Empty,
_displayNameToAdd, _groupNameToAdd, _isFavoriteToAdd, token);
            SetMessage(result.Message, !result.Success);
            if (result.Success)
            {
                ClearDirectAdd();
            }

            await RefreshDevicesAsync();
        });
    }

    private async Task ConfigureSelectedScanResultAsync()
    {
        if (_selectedScanResult is null)
        {
            return;
        }

        await RunBusyAsync(DiscoveredDeviceBusyState, "Configuring discovered device...", async token =>
        {
            var result = await AdminService.AddProbeResultAsync(_selectedScanResult, _selectedNetwork, _scanDisplayName,
_scanGroupName, _scanIsFavorite, token);
            SetMessage(result.Message, !result.Success);
            if (result.Success)
            {
                ClearSelectedScanResult();
            }

            await RefreshDevicesAsync();
        });
    }

    private void SelectScanResult(KasaProbeResult probeResult)
    {
        if (IsSelectedScanResult(probeResult))
        {
            return;
        }

        _selectedScanResult = probeResult;
        _scanDisplayName = null;
        _scanGroupName = null;
        _scanIsFavorite = false;
    }

    private void ClearSelectedScanResult()
    {
        _selectedScanResult = null;
        _scanDisplayName = null;
        _scanGroupName = null;
        _scanIsFavorite = false;
    }

    private void ClearDirectAdd()
    {
        _hostToAdd = null;
        _macToAdd = null;
        _displayNameToAdd = null;
        _groupNameToAdd = null;
        _isFavoriteToAdd = false;
    }

    private void StartEdit(KasaDeviceStatus device)
    {
        _selectedDeviceSourceId = device.SourceId;
        _editDisplayName = device.DisplayName;
        _editGroupName = device.GroupName;
        _editIsFavorite = device.IsFavorite;
    }

    private void ClearEdit()
    {
        _selectedDeviceSourceId = null;
        _editDisplayName = null;
        _editGroupName = null;
        _editIsFavorite = false;
    }

    private async Task SaveMetadataAsync()
    {
        await RunBusyAsync(ConfiguredDeviceBusyState, "Saving device metadata...", async token =>
        {
            var result = await AdminService.UpdateDeviceConfigurationAsync(_selectedDeviceSourceId ?? string.Empty,
_editDisplayName, _editGroupName, _editIsFavorite, token);
            SetMessage(result.Message, !result.Success);
            if (result.Success)
            {
                ClearEdit();
            }

            await RefreshDevicesAsync();
        });
    }

    private async Task RemoveAsync(string? sourceId)
    {
        await RunBusyAsync(ConfiguredDeviceBusyState, "Removing configured device...", async token =>
        {
            var result = await AdminService.RemoveAsync(sourceId ?? string.Empty, token);
            SetMessage(result.Message, !result.Success);
            if (result.Success && string.Equals(_selectedDeviceSourceId, sourceId, StringComparison.OrdinalIgnoreCase))
            {
                ClearEdit();
            }

            await RefreshDevicesAsync();
        });
    }

    private async Task RefreshDevicesAsync()
    {
        var statusTask = GatewayState.GetStatusAsync();
        var inventoryTask = GatewayState.GetInventoryAsync();
        await Task.WhenAll(statusTask, inventoryTask);

        var status = await statusTask;
        var inventory = await inventoryTask;

        _devices = status.Devices;
        _configuredDevices = inventory.Devices
            .Where(device => !string.IsNullOrWhiteSpace(device.SourceId))
            .ToDictionary(device => device.SourceId!, StringComparer.OrdinalIgnoreCase);
    }

    private async Task RunBusyCoreAsync(BusyState busyState, string busyMessage, Func<CancellationToken, Task> operation)
    {
        busyState.IsBusy = true;
        busyState.Message = busyMessage;
        await InvokeAsync(StateHasChanged);
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromMinutes(2));
            await operation(cts.Token);
        }
        finally
        {
            busyState.IsBusy = false;
            busyState.Message = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RunBusyAsync(BusyState busyState, string busyMessage, Func<CancellationToken, Task> operation, bool
captureErrors = true)
    {
        try
        {
            await RunBusyCoreAsync(busyState, busyMessage, operation);
        }
        catch (Exception ex) when (captureErrors)
        {
            SetMessage(ex.Message, isError: true);
        }
    }

    private void SetMessage(string message, bool isError)
    {
        _message = message;
        _messageIsError = isError;
    }

    private bool IsSelectedScanResult(KasaProbeResult probeResult) =>
        _selectedScanResult is not null && IsSameProbeResult(_selectedScanResult, probeResult);

    private bool IsSameProbeResultToSelected(KasaProbeResult probeResult) =>
        _selectedScanResult is not null && IsSameProbeResult(_selectedScanResult, probeResult);

    private static bool IsSameProbeResult(KasaProbeResult left, KasaProbeResult right) =>
        string.Equals(left.Host, right.Host, StringComparison.OrdinalIgnoreCase)
        && left.Port == right.Port;

    private static string FormatCapabilities(KasaDeviceProfile? profile) =>
        profile is null ? "Unknown" : string.Join(", ", profile.Capabilities.OrderBy(capability =>
capability.ToString()).Take(4));

    private static string FormatDeviceName(KasaProbeResult probeResult) =>
        string.IsNullOrWhiteSpace(probeResult.SystemInfo?.Alias) ? "Unnamed device" : probeResult.SystemInfo.Alias;

    private KasaInventoryDevice? GetConfiguredDevice(string? sourceId)
    {
        if (string.IsNullOrWhiteSpace(sourceId))
        {
            return null;
        }

        return _configuredDevices.TryGetValue(sourceId, out var device) ? device : null;
    }

    private string GetConfiguredDisplayName(KasaDeviceStatus device) =>
        GetConfiguredDevice(device.SourceId)?.DisplayName
        ?? device.DisplayName
        ?? device.SourceId
        ?? "Unnamed device";

    private string GetConfiguredGroupName(KasaDeviceStatus device) =>
        GetConfiguredDevice(device.SourceId)?.GroupName ?? "-";

    private bool GetConfiguredIsFavorite(KasaDeviceStatus device) =>
        GetConfiguredDevice(device.SourceId)?.IsFavorite ?? device.IsFavorite;

    private sealed class BusyState
    {
        public bool IsBusy { get; set; }

        public string? Message { get; set; }
    }

    private int _outboxBatchSize = 50;
    private int _outboxSweepIntervalSeconds = 5;
    private bool _outboxDirty;
    private bool _outboxOverride;
    private string? _outboxStatusMessage;

    private async Task SaveOutboxSettingsAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient();
            client.DefaultRequestHeaders.Add("X-Api-Key", GatewayOptions.Value.ApiKey);
            var response = await client.PutAsJsonAsync("/diagnostics/outbox/settings",
                new { batchSize = _outboxBatchSize, sweepIntervalSeconds = _outboxSweepIntervalSeconds });

            if (response.IsSuccessStatusCode)
            {
                _outboxOverride = true;
                _outboxStatusMessage = $"Override active: batch={_outboxBatchSize}, sweep={_outboxSweepIntervalSeconds}s";
                _outboxDirty = false;
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                _outboxStatusMessage = $"Failed: {error}";
            }
        }
        catch (Exception ex)
        {
            _outboxStatusMessage = $"Error: {ex.Message}";
        }
    }

    private async Task ResetOutboxSettingsAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient();
            client.DefaultRequestHeaders.Add("X-Api-Key", GatewayOptions.Value.ApiKey);
            var response = await client.PutAsJsonAsync("/diagnostics/outbox/settings",
                new { reset = true });

            if (response.IsSuccessStatusCode)
            {
                _outboxBatchSize = 50;
                _outboxSweepIntervalSeconds = 5;
                _outboxOverride = false;
                _outboxDirty = false;
                _outboxStatusMessage = "Reset to configured defaults.";
            }
        }
        catch (Exception ex)
        {
            _outboxStatusMessage = $"Reset error: {ex.Message}";
        }
    }
}
