@namespace HVO.Gateway.TplinkKasa.Components
@implements IDisposable
@inject KasaDeviceCommandService CommandService
@inject KasaDeviceInteractionState InteractionState
@inject ILogger<KasaOutletRow> Logger

<div class="kasa-outlet-row @(BottomControls is null ? null : "kasa-outlet-row-stacked")">
    <div class="kasa-outlet-row-main @(HideIdentity ? "kasa-outlet-row-main-no-identity" : null)">
        @if (!HideIdentity)
        {
            <div>
                <MudText Typo="Typo.body2">@GetOutletTitle()</MudText>
                @if (GetOutletSubtitle() is { Length: > 0 } subtitle)
                {
                    <MudText Typo="Typo.caption" Class="kasa-muted">@subtitle</MudText>
                }
            </div>
        }
        <div class="kasa-outlet-meta @(HideIdentity ? "kasa-outlet-meta-no-identity" : null)">
            @if (ShowEnergy && ShouldShowOutletEnergy())
            {
                <MudText Typo="Typo.caption" Class="kasa-muted">@KasaCardText.FormatOutletEnergy(Outlet.Energy!)</MudText>
            }
            @if (InlineControls is not null)
            {
                <div class="kasa-outlet-inline-control">
                    @InlineControls
                </div>
            }
            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="@GetOutletColor()"
                       Disabled="@IsBusyOrUnavailable" StartIcon="@Icons.Material.Outlined.PowerSettingsNew"
                       OnClick="ToggleAsync">@GetOutletStateText()</MudButton>
            @if (!string.IsNullOrWhiteSpace(_message))
            {
                <MudText Typo="Typo.caption" Class="@MessageClass">@_message</MudText>
            }
        </div>
    </div>
    @if (BottomControls is not null)
    {
        <div class="kasa-port-slider-row">
            @BottomControls
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public KasaDeviceStatus Device { get; set; } = null!;

    [Parameter, EditorRequired]
    public KasaOutletStatus Outlet { get; set; } = null!;

    [Parameter]
    public bool ShowEnergy { get; set; }

    [Parameter]
    public bool HideIdentity { get; set; }

    [Parameter]
    public bool UseOutletIndex { get; set; } = true;

    [Parameter]
    public KasaOutletCommandMode CommandMode { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    [Parameter]
    public RenderFragment? InlineControls { get; set; }

    [Parameter]
    public RenderFragment? BottomControls { get; set; }

    private bool _busy;
    private string? _message;
    private bool _lastSuccess;
    private string? _outletSubtitle;
    private bool? _optimisticIsOn;
    private DateTimeOffset? _optimisticObservedAtUtc;
    private IDisposable? _interaction;

    private bool? DisplayedIsOn => _optimisticIsOn ?? Outlet.IsOn;

    private KasaCommandCapability RequiredCommandCapability => CommandMode == KasaOutletCommandMode.LightState
        ? KasaCommandCapability.LightColor
        : KasaCommandCapability.SwitchPower;

    private bool IsBusyOrUnavailable => _busy || !Device.IsOnline || DisplayedIsOn is null ||
string.IsNullOrWhiteSpace(Device.SourceId) || !Device.CommandCapabilities.Contains(RequiredCommandCapability);

    private string MessageClass => _lastSuccess ? "kasa-muted" : "kasa-error-text";

    protected override void OnParametersSet()
    {
        _outletSubtitle = GetOutletSubtitleCore();

        if (_optimisticIsOn is null)
        {
            return;
        }

        if (Device.ObservedAtUtc == _optimisticObservedAtUtc)
        {
            return;
        }

        _optimisticIsOn = null;
        _optimisticObservedAtUtc = null;
    }

    private Color GetOutletColor() =>
        DisplayedIsOn is null ? Color.Default : DisplayedIsOn.Value ? Color.Success : Color.Default;

    private string GetOutletStateText() =>
        DisplayedIsOn is null ? "Unknown" : DisplayedIsOn.Value ? "On" : "Off";

    private string GetOutletTitle()
    {
        if (Device.Outlets.Count > 1
            && Outlet.Index is not null
            && !string.IsNullOrWhiteSpace(Device.DisplayName)
            && !string.IsNullOrWhiteSpace(Outlet.DisplayName)
            && string.Equals(Outlet.DisplayName.Trim(), Device.DisplayName.Trim(), StringComparison.OrdinalIgnoreCase))
        {
            return KasaCardText.FormatOutletId(Outlet);
        }

        return KasaCardText.FormatOutletName(Outlet);
    }

    private string? GetOutletSubtitle() => _outletSubtitle;

    private bool ShouldShowOutletEnergy()
    {
        if (Outlet.Energy is null)
        {
            return false;
        }

        if (Outlet.Energy.EnergyKWh is not null)
        {
            return true;
        }

        return Math.Abs(Outlet.Energy.PowerW ?? 0d) > 0.05d;
    }

    private string? GetOutletSubtitleCore()
    {
        if (Device.Outlets.Count > 1
            && Outlet.Index is not null
            && !string.IsNullOrWhiteSpace(Device.DisplayName)
            && !string.IsNullOrWhiteSpace(Outlet.DisplayName)
            && string.Equals(Outlet.DisplayName.Trim(), Device.DisplayName.Trim(), StringComparison.OrdinalIgnoreCase))
        {
            return null;
        }

        return KasaCardText.FormatOutletId(Outlet);
    }

    private async Task ToggleAsync()
    {
        if (IsBusyOrUnavailable || Device.SourceId is not { Length: > 0 } sourceId || Outlet.IsOn is null)
        {
            return;
        }

        var targetIsOn = !DisplayedIsOn!.Value;
        _busy = true;
        _message = null;
        _interaction ??= InteractionState.TryBegin(Device.SourceId);
        KasaAdminOperationResult? result = null;
        try
        {
            result = CommandMode == KasaOutletCommandMode.LightState
                ? await CommandService.SetLightAsync(sourceId, KasaOutletCommandFactory.BuildLightCommand(Device, targetIsOn), CancellationToken.None)
                : await CommandService.SetPowerAsync(sourceId, targetIsOn, UseOutletIndex ? Outlet.Index : null,
CancellationToken.None);
            _lastSuccess = result.Success;
            _message = result.Success ? null : result.Message;
            if (result.Success)
            {
                _optimisticIsOn = targetIsOn;
                _optimisticObservedAtUtc = Device.ObservedAtUtc;
                EndInteraction();
                _ = NotifyChangedSafelyAsync();
            }
            else
            {
                _optimisticIsOn = null;
                _optimisticObservedAtUtc = null;
            }
        }
        finally
        {
            _busy = false;
            if (result?.Success != true)
            {
                EndInteraction();
            }
        }
    }

    private void EndInteraction()
    {
        _interaction?.Dispose();
        _interaction = null;
    }

    private async Task NotifyChangedSafelyAsync()
    {
        try
        {
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "TP-Link/Kasa outlet refresh callback failed for {SourceId}.", Device.SourceId);
        }
    }

    public void Dispose() => EndInteraction();
}
