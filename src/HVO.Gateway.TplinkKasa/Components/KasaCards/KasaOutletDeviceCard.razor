@namespace HVO.Gateway.TplinkKasa.Components

<div class="kasa-card-body">
    <div class="kasa-outlet-list" aria-label="Device outlets">
        @foreach (var outlet in Device.Outlets.OrderBy(outlet => outlet.Index ?? int.MaxValue).ThenBy(outlet => outlet.DisplayName))
        {
            <KasaOutletRow Device="Device" Outlet="outlet" ShowEnergy="true" OnChanged="OnChanged" />
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public KasaDeviceStatus Device { get; set; } = null!;

    [Parameter]
    public EventCallback OnChanged { get; set; }
}
