@namespace HVO.Gateway.TplinkKasa.Components
@implements IDisposable
@inject KasaDeviceCommandService CommandService
@inject KasaDeviceInteractionState InteractionState

<div class="kasa-card-body">
    <div class="kasa-outlet-list" aria-label="Device outlets">
        @foreach (var outlet in Outlets)
        {
            <KasaOutletRow Device="Device" Outlet="outlet" UseOutletIndex="false" HideIdentity="@ShouldHideOutletIdentity(outlet)" OnChanged="OnChanged">
                <InlineControls>
                    <MudSlider T="int" Value="_brightness" ValueChanged="OnBrightnessSliderChanged" Immediate="true" Min="0" Max="100" Disabled="@BrightnessBusyOrUnavailable" Color="Color.Primary" Class="kasa-port-slider" @onpointerdown="BeginInteraction" @onfocusin="BeginInteraction" @onmouseup="CommitBrightnessAsync" @ontouchend="CommitBrightnessAsync" @onkeyup="CommitBrightnessAsync" />
                    <MudText Typo="Typo.caption" Class="kasa-port-slider-value">@_brightness%</MudText>
                </InlineControls>
            </KasaOutletRow>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <MudText Typo="Typo.caption" Class="@MessageClass">@_message</MudText>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public KasaDeviceStatus Device { get; set; } = null!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private int _brightness = 50;
    private bool _busy;
    private string? _message;
    private bool _lastSuccess;
    private int _lastAppliedBrightness = 50;
    private IDisposable? _interaction;

    private IEnumerable<KasaOutletStatus> Outlets => Device.Outlets.Count > 0
        ? Device.Outlets.OrderBy(outlet => outlet.Index ?? int.MaxValue).ThenBy(outlet => outlet.DisplayName)
        : [new KasaOutletStatus(1, Device.DisplayName, Device.IsOn, null, Device.Energy)];

    private bool ShouldHideOutletIdentity(KasaOutletStatus outlet) => Device.Outlets.Count <= 1;

    protected override void OnParametersSet()
    {
        if (_busy || IsInteracting)
        {
            return;
        }

        var deviceBrightness = Math.Clamp(Device.Light?.Brightness ?? Device.DeviceInfo?.Dimmer?.Parameters?.MinThreshold ?? _lastAppliedBrightness, 1, 100);
        _lastAppliedBrightness = deviceBrightness;
        _brightness = Device.IsOn == false ? _lastAppliedBrightness : deviceBrightness;
    }

    private bool BrightnessBusyOrUnavailable => _busy || !Device.IsOnline || string.IsNullOrWhiteSpace(Device.SourceId) || !Device.CommandCapabilities.Contains(KasaCommandCapability.DimLevel);

    private string MessageClass => _lastSuccess ? "kasa-muted" : "kasa-error-text";

    private bool IsInteracting => _interaction is not null;

    private void BeginInteraction()
    {
        _interaction ??= InteractionState.TryBegin(Device.SourceId);
    }

    private void EndInteraction()
    {
        _interaction?.Dispose();
        _interaction = null;
    }

    private void OnBrightnessSliderChanged(int value)
    {
        BeginInteraction();
        _brightness = Math.Clamp(value, 0, 100);
    }

    private async Task CommitBrightnessAsync()
    {
        var brightness = Math.Clamp(_brightness, 0, 100);

        if (BrightnessBusyOrUnavailable || Device.SourceId is not { Length: > 0 } sourceId)
        {
            EndInteraction();
            return;
        }

        if (brightness == 0)
        {
            _brightness = _lastAppliedBrightness;
            await RunCommandAsync(() => CommandService.SetPowerAsync(sourceId, false, null, CancellationToken.None));
            return;
        }

        if (brightness == _lastAppliedBrightness && Device.IsOn == true)
        {
            EndInteraction();
            return;
        }

        _lastAppliedBrightness = brightness;
        await RunCommandAsync(() => brightness == 0
            ? CommandService.SetPowerAsync(sourceId, false, null, CancellationToken.None)
            : CommandService.SetDimmerBrightnessAsync(sourceId, brightness, CancellationToken.None));
    }

    private async Task RunCommandAsync(Func<Task<KasaAdminOperationResult>> command)
    {
        _busy = true;
        _message = null;
        KasaAdminOperationResult? result = null;
        try
        {
            result = await command();
            _lastSuccess = result.Success;
            _message = result.Success ? null : result.Message;
            if (result.Success)
            {
                EndInteraction();
                await OnChanged.InvokeAsync();
            }
        }
        finally
        {
            _busy = false;
            if (result?.Success != true)
            {
                EndInteraction();
            }
        }
    }

    public void Dispose() => EndInteraction();
}
