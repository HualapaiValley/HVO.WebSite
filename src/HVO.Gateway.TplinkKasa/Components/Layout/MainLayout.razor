@inherits LayoutComponentBase
@implements IDisposable
@using System.Globalization
@using HVO.WebSite.Themes.Components.Format
@using HVO.WebSite.Themes.Components.Layout
@inject IOptions<KasaGatewayOptions> GatewayOptions
@inject KasaDisplayTimeZoneResolver DisplayTimeZoneResolver
@inject KasaGatewayState GatewayState

<HvoGatewayLayout Subtitle="TP-LINK/KASA LOCAL GATEWAY"
                  FooterSlot1="@_footer1"
                  FooterSlot2="@_footer2"
                  FooterSlot3="@_footer3"
                  FooterSlot4="@_footer4"
                  FooterSlot5="@_footer5"
                  IsDarkMode="@_shellState.IsDarkMode"
                  IsDarkModeChanged="OnThemeModeChanged">
    <NavItems>
        <MudButton Href="/" Variant="@GetNavVariant("")" Color="Color.Inherit" Class="@GetNavClass("")">Overview</MudButton>
        <MudButton Href="/settings" Variant="@GetNavVariant("settings")" Color="Color.Inherit" Class="@GetNavClass("settings")">Configuration</MudButton>
    </NavItems>
    <AppBarActions>
        <MudIconButton Icon="@Icons.Material.Outlined.HelpOutline" Color="Color.Inherit" Size="Size.Medium"
                       aria-label="Open Kasa gateway information" OnClick="OpenInfoDialog" />
        <MudIconButton Icon="@ThemeSelectorIcon" Color="Color.Inherit" Size="Size.Medium"
                       aria-label="@ThemeSelectorLabel" OnClick="ToggleTheme" />
    </AppBarActions>
    <Body>@Body</Body>
</HvoGatewayLayout>

@if (_showInfoDialog)
{
    <div class="shell-info-dialog-backdrop" @onclick="CloseInfoDialog">
        <div class="shell-info-dialog" role="dialog" aria-modal="true" aria-labelledby="kasa-info-dialog-title"
             @onclick:stopPropagation="true">
            <div class="shell-info-dialog-header">
                <div>
                    <MudText Typo="Typo.overline" Class="shell-info-dialog-eyebrow">Gateway Summary</MudText>
                    <MudText Typo="Typo.h5" id="kasa-info-dialog-title">TP-Link/Kasa local gateway</MudText>
                </div>
                <MudIconButton Icon="@Icons.Material.Outlined.Close" Color="Color.Inherit" Size="Size.Small"
                               aria-label="Close gateway information" OnClick="CloseInfoDialog" />
            </div>
            <div class="shell-info-dialog-grid">
                <div class="shell-info-dialog-item"><span>Gateway ID</span><strong>@GatewayOptions.Value.GatewayId</strong></div>
                <div class="shell-info-dialog-item"><span>Poll Interval</span><strong>@GatewayOptions.Value.PollIntervalSeconds seconds</strong></div>
                <div class="shell-info-dialog-item"><span>Poll Concurrency</span><strong>@GatewayOptions.Value.MaxPollConcurrency devices</strong></div>
                <div class="shell-info-dialog-item"><span>Display Time Zone</span><strong>@DisplayTimeZoneResolver.GetLabel()</strong></div>
                <div class="shell-info-dialog-item"><span>Registry</span><strong>@GatewayOptions.Value.DeviceRegistryPath</strong></div>
                <div class="shell-info-dialog-item"><span>Networks</span><strong>@GatewayOptions.Value.Networks.Count configured</strong></div>
                <div class="shell-info-dialog-item"><span>Configured Devices</span><strong>@GatewayOptions.Value.Devices.Count seeded</strong></div>
            </div>
        </div>
    </div>
}

@code {
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private readonly ShellLayoutState _shellState = new();
    private readonly PeriodicTimer _clockTimer = new(TimeSpan.FromSeconds(1));
    private readonly CancellationTokenSource _clockCts = new();
    private bool _showInfoDialog;
    private KasaGatewayStatusResponse? _footerStatus;
    private DateTimeOffset _nextFooterStatusRefreshAtUtc;

    private ShellFooterItem _footer1 = new("Polling active", ShellFooterIndicator.Online);
    private ShellFooterItem _footer2 = new("TP-Link/Kasa");
    private ShellFooterItem _footer3 = new("");
    private ShellFooterItem _footer4 = new("Devices: loading");
    private ShellFooterItem _footer5 = new("Gateway healthy", ShellFooterIndicator.Online);

    private string ThemeSelectorIcon => _shellState.IsDarkMode
        ? Icons.Material.Outlined.DarkMode
        : Icons.Material.Outlined.LightMode;

    private string ThemeSelectorLabel => _shellState.IsDarkMode ? "Switch to light theme" : "Switch to dark theme";

    private string FooterDeviceSummary => _footerStatus is null
        ? "Devices: loading"
        : $"Devices: {_footerStatus.OnlineDeviceCount} online - {Math.Max(0, _footerStatus.ConfiguredDeviceCount - _footerStatus.OnlineDeviceCount)} offline";

    protected override void OnInitialized()
    {
        _footer3 = new ShellFooterItem(
            DisplayTimeZoneResolver.ConvertFromUtc(DateTimeOffset.UtcNow)
                .ToString("dd MMM yyyy - h:mm:ss tt", CultureInfo.InvariantCulture));
        _ = RefreshClockAsync(_clockCts.Token);
    }

    public void Dispose()
    {
        _clockCts.Cancel();
        _clockCts.Dispose();
        _clockTimer.Dispose();
    }

    private async Task RefreshClockAsync(CancellationToken cancellationToken)
    {
        try
        {
            var now = DateTimeOffset.UtcNow;
            UpdateFooterTime(now);
            await RefreshFooterStatusAsync(now).ConfigureAwait(false);
            await InvokeAsync(StateHasChanged);

            while (await _clockTimer.WaitForNextTickAsync(cancellationToken))
            {
                now = DateTimeOffset.UtcNow;
                UpdateFooterTime(now);
                if (now >= _nextFooterStatusRefreshAtUtc)
                {
                    await RefreshFooterStatusAsync(now).ConfigureAwait(false);
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private void UpdateFooterTime(DateTimeOffset now)
    {
        _footer3 = new ShellFooterItem(
            DisplayTimeZoneResolver.ConvertFromUtc(now).ToString("dd MMM yyyy - h:mm:ss tt",
                CultureInfo.InvariantCulture));
    }

    private async Task RefreshFooterStatusAsync(DateTimeOffset now)
    {
        _footerStatus = await GatewayState.GetStatusAsync().ConfigureAwait(false);
        _footer4 = new ShellFooterItem(FooterDeviceSummary);
        var refreshSeconds = Math.Max(1, GatewayOptions.Value.DashboardRefreshSeconds);
        _nextFooterStatusRefreshAtUtc = now.AddSeconds(refreshSeconds);
    }

    private void OnThemeModeChanged(bool useDarkMode)
    {
        _shellState.SetTheme(useDarkMode);
    }

    private void ToggleTheme()
    {
        _shellState.ToggleTheme();
    }

    private void OpenInfoDialog() => _showInfoDialog = true;
    private void CloseInfoDialog() => _showInfoDialog = false;

    private Variant GetNavVariant(string relativePath)
    {
        var current = Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/');
        return string.Equals(current, relativePath, StringComparison.OrdinalIgnoreCase)
            ? Variant.Filled
            : Variant.Text;
    }

    private string GetNavClass(string relativePath)
    {
        var current = Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/');
        return string.Equals(current, relativePath, StringComparison.OrdinalIgnoreCase)
            ? "shell-nav-link shell-nav-link-current"
            : "shell-nav-link";
    }
}
