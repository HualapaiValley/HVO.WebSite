@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@inject IWebHostEnvironment Environment

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=1280, initial-scale=1.0" />
    <title>TP-Link/Kasa Gateway</title>
    <base href="/" />
    <link rel="stylesheet" href="_content/HVO.WebSite.Themes/css/themes/hvo-dark.css" />
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    <link rel="stylesheet" href='@($"app.css?v={AppCssVersion}")' />
    <link rel="stylesheet" href="_content/HVO.WebSite.Themes/css/themes/hvo-shared-shell.css" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>

</html>

@code {
    private string AppCssVersion
    {
        get
        {
            var fileInfo = Environment.WebRootFileProvider.GetFileInfo("app.css");
            return !fileInfo.Exists || fileInfo.LastModified == DateTimeOffset.MinValue
                ? "0"
                : fileInfo.LastModified.ToUnixTimeMilliseconds().ToString(CultureInfo.InvariantCulture);
        }
    }
}