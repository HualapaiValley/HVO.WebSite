@using HVO.WebSite.Themes.Components.Charts
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

<div style="height: @($"{Height}px"); position: relative;">
    <canvas id="@ChartId"></canvas>
</div>

@code {
    [Parameter, EditorRequired] public string ChartId { get; set; } = default!;

    [Parameter] public HvoChartType Type { get; set; } = HvoChartType.Line;

    [Parameter, EditorRequired] public IReadOnlyList<HvoChartDataset> Datasets { get; set; } = Array.Empty<HvoChartDataset>();

    [Parameter] public IReadOnlyList<string>? Labels { get; set; }

    [Parameter] public bool ShowLegend { get; set; } = true;

    [Parameter] public bool EnableAnimations { get; set; }

    [Parameter] public int Height { get; set; } = 300;

    [Parameter] public string? Title { get; set; }

    [Parameter] public string? XAxisLabel { get; set; }

    [Parameter] public string? YAxisLabel { get; set; }

    /// <summary>
    /// Increment to trigger a chart refresh when Datasets/Labels change.
    /// </summary>
    [Parameter] public int DataRevision { get; set; }

    /// <summary>
    /// When false (default) null data values render as visible gaps/breaks in the line.
    /// Set true to draw the line straight across null values.
    /// </summary>
    [Parameter] public bool SpanGaps { get; set; } = false;

    /// <summary>
    /// Bezier tension for line charts (0 = angular, 0.3 = smooth). Applied to all datasets
    /// unless the dataset provides its own <see cref="HvoChartDataset.Tension"/>.
    /// </summary>
    [Parameter] public double Tension { get; set; } = 0.3;

    /// <summary>Optional lower-bound hint for the y-axis (uses Chart.js suggestedMin).</summary>
    [Parameter] public double? YAxisSuggestedMin { get; set; }

    /// <summary>Optional upper-bound hint for the y-axis (uses Chart.js suggestedMax).</summary>
    [Parameter] public double? YAxisSuggestedMax { get; set; }

    private int _renderedRevision = -1;

    private string TypeJs => Type switch
    {
        HvoChartType.Line => "line",
        HvoChartType.Bar => "bar",
        HvoChartType.Doughnut => "doughnut",
        HvoChartType.PolarArea => "polarArea",
        HvoChartType.Bubble => "bubble",
        _ => "line"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || _renderedRevision != DataRevision)
        {
            _renderedRevision = DataRevision;
            try
            {
                await RenderChartAsync();
            }
            catch (Exception)
            {
                // JS interop errors must not kill the Blazor circuit.
                // The chart canvas will stay blank; the rest of the page keeps working.
            }
        }
    }

    public async Task RefreshAsync()
    {
        _renderedRevision = DataRevision;
        try
        {
            await RenderChartAsync();
        }
        catch (Exception) { }
    }

    private async Task RenderChartAsync()
    {
        var config = new
        {
            type = TypeJs,
            data = new
            {
                labels = Labels ?? Array.Empty<string>(),
                datasets = Datasets.Select(d => new
                {
                    label = d.Label,
                    data = d.Data.Select(v => v.HasValue ? (object?)v.Value : null).ToArray(),
                    spanGaps = SpanGaps,
                    tension = d.Tension ?? Tension,
                    borderColor = d.BorderColor ?? "var(--shell-chart-label-color)",
                    backgroundColor = d.BackgroundColor ?? "var(--shell-chart-marker-fill)",
                    borderWidth = d.BorderWidth,
                    pointRadius = d.PointRadius,
                    fill = d.Fill
                })
            },
            options = new
            {
                responsive = true,
                maintainAspectRatio = false,
                animation = EnableAnimations ? (object?)null : false,
                plugins = new
                {
                    legend = new { display = ShowLegend },
                    title = Title is not null ? new { display = true, text = Title } : null
                },
                scales = Type is HvoChartType.Doughnut or HvoChartType.PolarArea ? null : new
                {
                    x = new
                    {
                        title = XAxisLabel is not null ? new { display = true, text = XAxisLabel } : (object?)null,
                        ticks = new { maxTicksLimit = 7, autoSkip = true, maxRotation = 0 }
                    },
                    y = new
                    {
                        title = YAxisLabel is not null ? new { display = true, text = YAxisLabel } : (object?)null,
                        suggestedMin = YAxisSuggestedMin,
                        suggestedMax = YAxisSuggestedMax
                    }
                }
            }
        };

        await JSRuntime.InvokeVoidAsync("hvoChart.render", ChartId, config);
    }
}
