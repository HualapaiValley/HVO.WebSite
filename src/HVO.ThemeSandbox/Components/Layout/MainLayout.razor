@inherits LayoutComponentBase
@using HVO.WebSite.Themes.Components.Layout

<HvoPublicLayout BrandTitle="HVO Theme Sandbox"
                  BrandSubtitle="UI STANDARDS REFERENCE"
                  IsDarkMode="@_isDarkMode"
                  IsDarkModeChanged="@OnDarkModeChanged">
    <NavItems>
        <MudButton Href="/" Variant="Variant.Text" Color="Color.Inherit" Class="shell-nav-link">Sandbox</MudButton>
    </NavItems>
    <AuthSection>
        <MudIconButton Icon="@ThemeIcon" Color="Color.Inherit" Size="Size.Medium"
                       aria-label="@ThemeLabel" OnClick="@ToggleTheme" />
    </AuthSection>
    <Body>
        @Body
    </Body>
</HvoPublicLayout>

@code {
    private bool _isDarkMode = true;

    private string ThemeIcon => _isDarkMode
        ? Icons.Material.Outlined.DarkMode
        : Icons.Material.Outlined.LightMode;

    private string ThemeLabel => _isDarkMode ? "Switch to light theme" : "Switch to dark theme";

    private void ToggleTheme() => _isDarkMode = !_isDarkMode;

    private void OnDarkModeChanged(bool isDark) => _isDarkMode = isDark;
}
