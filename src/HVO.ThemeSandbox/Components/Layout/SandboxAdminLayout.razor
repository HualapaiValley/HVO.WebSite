@inherits LayoutComponentBase

<HvoAdminLayout IsDarkMode="@_isDarkMode"
                IsDarkModeChanged="@OnDarkModeChanged">
    <SidebarItems>
        <MudNavLink Href="/">Gateway Demo</MudNavLink>
        <MudNavLink Href="/public-layout">Public Layout</MudNavLink>
        <MudNavLink Href="/admin-layout">Dashboard</MudNavLink>
        <MudNavLink Href="/theme-showcase">Theme Showcase</MudNavLink>
        <MudNavLink Href="/controls">UI Controls</MudNavLink>
        <MudDivider Class="my-2" />
        <MudNavLink Href="/admin-layout" Disabled="true">Users</MudNavLink>
        <MudNavLink Href="/admin-layout" Disabled="true">Settings</MudNavLink>
        <MudNavLink Href="/admin-layout" Disabled="true">Logs</MudNavLink>
        <MudNavLink Href="/admin-layout" Disabled="true">Backups</MudNavLink>
    </SidebarItems>
    <AppBarActions>
        <MudIconButton Icon="@ThemeIcon"
                       Color="Color.Inherit"
                       Size="Size.Medium"
                       aria-label="@ThemeLabel"
                       OnClick="@ToggleTheme" />
    </AppBarActions>
    <Body>@Body</Body>
</HvoAdminLayout>

@code {
    private bool _isDarkMode = true;

    private string ThemeIcon => _isDarkMode
        ? Icons.Material.Outlined.DarkMode
        : Icons.Material.Outlined.LightMode;

    private string ThemeLabel => _isDarkMode ? "Switch to light theme" : "Switch to dark theme";

    private void ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
    }

    private void OnDarkModeChanged(bool isDark)
    {
        _isDarkMode = isDark;
    }
}
