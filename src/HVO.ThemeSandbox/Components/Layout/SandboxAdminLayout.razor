@inherits LayoutComponentBase

<HvoAdminLayout IsDarkMode="@_isDarkMode"
                IsDarkModeChanged="@OnDarkModeChanged">
    <SidebarItems>
        <MudText Typo="Typo.overline" Class="pa-2">Dashboards</MudText>
        <MudNavLink Href="/dashboard">Dashboard</MudNavLink>
        <MudNavLink Href="/admin-layout">Admin Panel</MudNavLink>
        <MudDivider Class="my-2" />
        <MudText Typo="Typo.overline" Class="pa-2">Standards</MudText>
        <MudNavLink Href="/controls">UI Controls</MudNavLink>
        <MudNavLink Href="/palette">Color Palette</MudNavLink>
        <MudNavLink Href="/states">State Patterns</MudNavLink>
        <MudNavLink Href="/responsive">Breakpoints</MudNavLink>
        <MudDivider Class="my-2" />
        <MudText Typo="Typo.overline" Class="pa-2">Theming</MudText>
        <MudNavLink Href="/theme-showcase">Theme Showcase</MudNavLink>
    </SidebarItems>
    <AppBarActions>
        <MudIconButton Icon="@ThemeIcon"
                       Color="Color.Inherit"
                       Size="Size.Medium"
                       aria-label="@ThemeLabel"
                       OnClick="@ToggleTheme" />
    </AppBarActions>
    <Body>@Body</Body>
</HvoAdminLayout>

@code {
    private bool _isDarkMode = true;

    private string ThemeIcon => _isDarkMode
        ? Icons.Material.Outlined.DarkMode
        : Icons.Material.Outlined.LightMode;

    private string ThemeLabel => _isDarkMode ? "Switch to light theme" : "Switch to dark theme";

    private void ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
    }

    private void OnDarkModeChanged(bool isDark)
    {
        _isDarkMode = isDark;
    }
}
