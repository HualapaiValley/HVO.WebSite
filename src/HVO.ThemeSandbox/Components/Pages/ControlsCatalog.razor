@page "/controls"
@using System.Globalization
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudPaper Class="layout-canvas shell-page" Elevation="0">
    <MudStack Class="shell-page-stack" Spacing="4">
        <div>
            <MudText Typo="Typo.h3">UI Controls Catalog</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">Canonical reference for every MudBlazor control used in HVO.WebSite — shown inside cards as they appear in production</MudText>
        </div>

        <MudTabs Rounded="true" Elevation="0" Position="Position.Top" Outlined="true">
            @* ═══════════ Inputs ═══════════ *@
            <MudTabPanel Text="Inputs" Icon="@Icons.Material.Outlined.Edit">
                <MudStack Spacing="3" Class="pa-4">
                    <div class="hvo-card">
                        <div class="hvo-card-title">Text & Numeric Fields</div>
                        <MudGrid>
                            <MudItem xs="12" md="4">
                                <MudTextField T="string" Label="Text" Variant="Variant.Outlined" @bind-Value="_sText" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField T="string" Label="Email" Variant="Variant.Outlined" @bind-Value="_sEmail" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField T="string" Label="Password" Variant="Variant.Outlined" @bind-Value="_sPassword" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField T="int" Label="Integer" Variant="Variant.Outlined" @bind-Value="_iValue" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField T="double" Label="Decimal" Variant="Variant.Outlined" @bind-Value="_dValue" HelperText="Double precision" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField T="string" Label="Multiline" Variant="Variant.Outlined" Lines="3" @bind-Value="_sMulti" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField T="string" Label="Disabled input" Variant="Variant.Outlined" Disabled="true" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField T="string" Label="Read-only input" Variant="Variant.Outlined" ReadOnly="true" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTextField T="string" Label="With Icon" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" />
                            </MudItem>
                        </MudGrid>
                    </div>

                    <div class="hvo-card">
                        <div class="hvo-card-title">Pickers</div>
                        <MudGrid>
                            <MudItem xs="12" md="4">
                                <MudDatePicker Label="Date" @bind-Date="_selectedDate" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudTimePicker Label="Time" @bind-Time="_selectedTime" Variant="Variant.Outlined" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudColorPicker Label="Color" @bind-Text="_selectedColor" Variant="Variant.Outlined" />
                            </MudItem>
                        </MudGrid>
                    </div>

                    <div class="hvo-card">
                        <div class="hvo-card-title">Selection Controls</div>
                        <MudGrid>
                            <MudItem xs="12" md="6">
                                <MudSelect T="string" Label="Select" Variant="Variant.Outlined" @bind-Value="_selVal">
                                    <MudSelectItem T="string" Value="@("alpha")">Alpha</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("beta")">Beta</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("gamma")">Gamma</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <MudAutocomplete T="string" Label="Autocomplete" Variant="Variant.Outlined"
                                                 SearchFunc="@SearchAsync" @bind-Value="_autoVal" />
                            </MudItem>
                        </MudGrid>
                    </div>

                    <div class="hvo-card">
                        <div class="hvo-card-title">Toggles, Radio & Rating</div>
                        <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudSwitch T="bool" Label="Switch" Color="Color.Success" @bind-Value="_sw1" />
                            <MudSwitch T="bool" Label="Disabled" Color="Color.Secondary" Disabled="true" Value="true" />
                            <MudCheckBox T="bool" Label="Checkbox" Color="Color.Primary" @bind-Value="_cb1" />
                            <MudCheckBox T="bool" Label="Checked" Color="Color.Tertiary" Value="true" />
                            <MudDivider Vertical="true" FlexItem="true" />
                            <MudRadioGroup T="string" @bind-Value="_radioVal">
                                <MudStack Row="true" Spacing="2">
                                    <MudRadio T="string" Value="@("low")" Color="Color.Success">Low</MudRadio>
                                    <MudRadio T="string" Value="@("med")" Color="Color.Warning">Medium</MudRadio>
                                    <MudRadio T="string" Value="@("high")" Color="Color.Error">High</MudRadio>
                                </MudStack>
                            </MudRadioGroup>
                            <MudDivider Vertical="true" FlexItem="true" />
                            <MudRating @bind-SelectedValue="_rating" />
                            <MudText Typo="Typo.caption">@_rating / 5</MudText>
                        </MudStack>
                    </div>

                    <div class="hvo-card">
                        <div class="hvo-card-title">Slider</div>
                        <MudStack Spacing="1">
                            <MudSlider T="int" Min="0" Max="100" @bind-Value="_sliderVal" Color="Color.Primary" />
                            <MudText Typo="Typo.caption" Align="Align.Center">@_sliderVal%</MudText>
                        </MudStack>
                    </div>
                </MudStack>
            </MudTabPanel>

            @* ═══════════ Actions ═══════════ *@
            <MudTabPanel Text="Actions" Icon="@Icons.Material.Outlined.TouchApp">
                <MudStack Spacing="3" Class="pa-4">
                    <div class="hvo-card">
                        <div class="hvo-card-title">Filled Buttons</div>
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary">Primary</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Secondary">Secondary</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Success">Success</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Warning">Warning</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Error">Danger</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Info">Info</MudButton>
                            <MudButton Variant="Variant.Filled" Disabled="true">Disabled</MudButton>
                        </MudStack>
                    </div>

                    <div class="hvo-card">
                        <div class="hvo-card-title">Outlined & Text Buttons</div>
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary">Primary</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary">Secondary</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Success">Success</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning">Warning</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Error">Danger</MudButton>
                        </MudStack>
                        <MudDivider Class="my-2" />
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudButton Variant="Variant.Text" Color="Color.Primary">Primary</MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Secondary">Secondary</MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Error">Danger</MudButton>
                        </MudStack>
                    </div>

                    <div class="hvo-card">
                        <div class="hvo-card-title">Button Sizes</div>
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small">Small</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium">Medium</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large">Large</MudButton>
                        </MudStack>
                    </div>

                    <div class="hvo-card">
                        <div class="hvo-card-title">With Icons & Icon Buttons</div>
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add">Add</MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Delete">Delete</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Outlined.Save">Save</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Warning" EndIcon="@Icons.Material.Outlined.Refresh">Refresh</MudButton>
                            <MudIconButton Icon="@Icons.Material.Outlined.Settings" Color="Color.Primary" aria-label="Settings" />
                            <MudIconButton Icon="@Icons.Material.Outlined.Favorite" Color="Color.Error" aria-label="Favorite" />
                            <MudIconButton Icon="@Icons.Material.Outlined.Share" Color="Color.Secondary" aria-label="Share" />
                        </MudStack>
                    </div>

                    <div class="hvo-card">
                        <div class="hvo-card-title">FAB, Tooltips & Menu</div>
                        <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" Size="Size.Small" />
                            <MudFab Color="Color.Secondary" StartIcon="@Icons.Material.Outlined.Edit" Size="Size.Medium" />
                            <MudFab Color="Color.Success" StartIcon="@Icons.Material.Outlined.Check" Size="Size.Large" />
                            <MudDivider Vertical="true" FlexItem="true" />
                            <MudTooltip Text="This is a tooltip">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary">Hover me</MudButton>
                            </MudTooltip>
                            <MudTooltip Text="Right placement" Placement="Placement.Right">
                                <MudIconButton Icon="@Icons.Material.Outlined.Info" Color="Color.Primary" aria-label="Info" />
                            </MudTooltip>
                            <MudDivider Vertical="true" FlexItem="true" />
                            <MudMenu Label="Open Menu" Variant="Variant.Filled" Color="Color.Primary"
                                     StartIcon="@Icons.Material.Outlined.Menu">
                                <MudMenuItem>Dashboard</MudMenuItem>
                                <MudMenuItem>Settings</MudMenuItem>
                                <MudDivider />
                                <MudMenuItem Disabled="true">Disabled</MudMenuItem>
                                <MudMenuItem>Logout</MudMenuItem>
                            </MudMenu>
                        </MudStack>
                    </div>
                </MudStack>
            </MudTabPanel>

            @* ═══════════ Display ═══════════ *@
            <MudTabPanel Text="Display" Icon="@Icons.Material.Outlined.Dashboard">
                <MudStack Spacing="3" Class="pa-4">
                    <div class="hvo-card">
                        <div class="hvo-card-title">Typography Scale</div>
                        <MudText Typo="Typo.h1">h1 — Heading One</MudText>
                        <MudText Typo="Typo.h2">h2 — Heading Two</MudText>
                        <MudText Typo="Typo.h3">h3 — Heading Three</MudText>
                        <MudText Typo="Typo.h4">h4 — Heading Four</MudText>
                        <MudText Typo="Typo.h5">h5 — Heading Five</MudText>
                        <MudText Typo="Typo.h6">h6 — Heading Six</MudText>
                        <MudText Typo="Typo.subtitle1">subtitle1 — Subtitle One</MudText>
                        <MudText Typo="Typo.subtitle2">subtitle2 — Subtitle Two</MudText>
                        <MudText Typo="Typo.body1">body1 — Body text. Lorem ipsum dolor sit amet, consectetur adipiscing elit.</MudText>
                        <MudText Typo="Typo.body2">body2 — Smaller body text. Sed do eiusmod tempor incididunt ut labore.</MudText>
                        <MudText Typo="Typo.caption">caption — Caption text for labels and metadata</MudText>
                        <MudText Typo="Typo.overline">overline — OVERLINE ALL CAPS TEXT</MudText>
                    </div>

                    <div class="hvo-card">
                        <div class="hvo-card-title">Text Colors</div>
                        <MudStack Row="true" Spacing="3" Wrap="Wrap.Wrap">
                            <MudText Color="Color.Primary">Primary</MudText>
                            <MudText Color="Color.Secondary">Secondary</MudText>
                            <MudText Color="Color.Success">Success</MudText>
                            <MudText Color="Color.Warning">Warning</MudText>
                            <MudText Color="Color.Error">Error</MudText>
                            <MudText Color="Color.Info">Info</MudText>
                            <MudText Color="Color.Tertiary">Tertiary</MudText>
                        </MudStack>
                    </div>

                    <div class="hvo-card">
                        <div class="hvo-card-title">Chips</div>
                        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small">Primary</MudChip>
                            <MudChip T="string" Color="Color.Secondary" Size="Size.Small">Secondary</MudChip>
                            <MudChip T="string" Color="Color.Success" Size="Size.Small">Success</MudChip>
                            <MudChip T="string" Color="Color.Warning" Size="Size.Small">Warning</MudChip>
                            <MudChip T="string" Color="Color.Error" Size="Size.Small">Error</MudChip>
                            <MudChip T="string" Color="Color.Info" Size="Size.Small">Info</MudChip>
                            <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small">Outlined</MudChip>
                        </MudStack>
                    </div>

                    <div class="hvo-card">
                        <div class="hvo-card-title">Badges & Avatars</div>
                        <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudBadge Content="3" Color="Color.Error">
                                <MudIconButton Icon="@Icons.Material.Outlined.Notifications" Color="Color.Inherit" aria-label="Notifications" />
                            </MudBadge>
                            <MudBadge Content="12" Color="Color.Primary" Overlap="true">
                                <MudIconButton Icon="@Icons.Material.Outlined.Email" Color="Color.Inherit" aria-label="Email" />
                            </MudBadge>
                            <MudBadge Dot="true" Color="Color.Success">
                                <MudAvatar Color="Color.Primary">RS</MudAvatar>
                            </MudBadge>
                            <MudDivider Vertical="true" FlexItem="true" />
                            <MudAvatar Color="Color.Primary" Size="Size.Small">AB</MudAvatar>
                            <MudAvatar Color="Color.Secondary" Size="Size.Medium">CD</MudAvatar>
                            <MudAvatar Color="Color.Success" Size="Size.Large">EF</MudAvatar>
                            <MudAvatar Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Medium">GH</MudAvatar>
                            <MudAvatar Color="Color.Warning" Size="Size.Medium">
                                <MudIcon Icon="@Icons.Material.Outlined.Person" />
                            </MudAvatar>
                        </MudStack>
                    </div>

                    <div class="hvo-card">
                        <div class="hvo-card-title">Links & Breadcrumbs</div>
                        <MudStack Spacing="2">
                            <MudLink Href="/">Homepage Link</MudLink>
                            <MudLink Href="/controls" Typo="Typo.body2" Color="Color.Secondary">Secondary Link</MudLink>
                            <MudBreadcrumbs Items="@(new List<BreadcrumbItem> { new("Home", "/"), new("Controls", "/controls"), new("Current Page", null, true) })" />
                        </MudStack>
                    </div>
                </MudStack>
            </MudTabPanel>

            @* ═══════════ Feedback ═══════════ *@
            <MudTabPanel Text="Feedback" Icon="@Icons.Material.Outlined.Feedback">
                <MudStack Spacing="3" Class="pa-4">
                    <div class="hvo-card">
                        <div class="hvo-card-title">Alerts</div>
                        <MudAlert Severity="Severity.Normal" Dense="true">Normal — informational message</MudAlert>
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">Info — helpful information</MudAlert>
                        <MudAlert Severity="Severity.Success" Dense="true" Class="mt-2">Success — operation completed</MudAlert>
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">Warning — proceed with caution</MudAlert>
                        <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">Error — something went wrong</MudAlert>
                    </div>

                    <div class="hvo-card">
                        <div class="hvo-card-title">Progress Indicators</div>
                        <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center">
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                            <MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Secondary" />
                            <MudProgressCircular Indeterminate="true" Size="Size.Large" Color="Color.Success" />
                        </MudStack>
                    </div>

                    <div class="hvo-card">
                        <div class="hvo-card-title">Skeleton Loaders</div>
                        <MudStack Spacing="2">
                            <MudSkeleton SkeletonType="SkeletonType.Text" />
                            <MudSkeleton SkeletonType="SkeletonType.Circle" Width="40px" Height="40px" />
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="80px" />
                        </MudStack>
                    </div>

                    <div class="hvo-card">
                        <div class="hvo-card-title">Overlay</div>
                        <MudPaper Elevation="0" Class="pa-4" Style="position:relative;height:120px;">
                            <MudText>Content behind overlay</MudText>
                            <MudOverlay Visible="true" DarkBackground="true" Absolute="true">
                                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="height:100%;">
                                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                                    <MudText Color="Color.Info">Loading...</MudText>
                                </MudStack>
                            </MudOverlay>
                        </MudPaper>
                    </div>

                    <div class="hvo-card">
                        <div class="hvo-card-title">Dialog</div>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">Modal dialogs for confirmations, forms, and detailed views.</MudText>
                        <MudStack Row="true" Spacing="2">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.OpenInNew"
                                       OnClick="@OpenDialog">Open Dialog</MudButton>
                        </MudStack>
                        @if (!string.IsNullOrWhiteSpace(_dialogResult))
                        {
                            <MudAlert Severity="Severity.Success" Dense="true" Class="mt-2">Dialog result: <strong>@_dialogResult</strong></MudAlert>
                        }
                    </div>

                    <div class="hvo-card">
                        <div class="hvo-card-title">Snackbar Toasts</div>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">Non-blocking notifications that appear at the bottom of the screen.</MudText>
                        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Snackbar.Add("Default notification", Severity.Normal))">Normal</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="@(() => Snackbar.Add("Information message", Severity.Info))">Info</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="@(() => Snackbar.Add("Operation completed successfully", Severity.Success))">Success</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="@(() => Snackbar.Add("Proceed with caution", Severity.Warning))">Warning</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="@(() => Snackbar.Add("Something went wrong", Severity.Error))">Error</MudButton>
                        </MudStack>
                    </div>
                </MudStack>
            </MudTabPanel>

            @* ═══════════ Containers ═══════════ *@
            <MudTabPanel Text="Containers" Icon="@Icons.Material.Outlined.Widgets">
                <MudStack Spacing="3" Class="pa-4">
                    <div class="hvo-card">
                        <div class="hvo-card-title">MudCard Variants</div>
                        <MudGrid>
                            <MudItem xs="12" md="4">
                                <MudCard Elevation="4">
                                    <MudCardHeader>
                                        <CardHeaderContent>
                                            <MudText Typo="Typo.h6">Standard Card</MudText>
                                        </CardHeaderContent>
                                        <CardHeaderActions>
                                            <MudIconButton Icon="@Icons.Material.Outlined.MoreVert" Color="Color.Inherit" aria-label="More" />
                                        </CardHeaderActions>
                                    </MudCardHeader>
                                    <MudCardContent>
                                        <MudText>Card content with header and actions.</MudText>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudCard Elevation="2">
                                    <MudImage Src="_content/HVO.WebSite.Themes/images/observatory-background.jpg"
                                              Alt="Observatory" Style="height:100px;object-fit:cover;" />
                                    <MudCardContent>
                                        <MudText Typo="Typo.h6">Media Card</MudText>
                                        <MudText Typo="Typo.body2" Color="Color.Secondary">Card with header image</MudText>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudCard Elevation="2">
                                    <MudCardContent>
                                        <MudText Typo="Typo.body2">Simple content card without header.</MudText>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        </MudGrid>
                    </div>

                    <div class="hvo-card">
                        <div class="hvo-card-title">Expansion Panels</div>
                        <MudExpansionPanels>
                            <MudExpansionPanel Text="Panel One — Overview">
                                <MudText>Expansion panels are great for progressive disclosure of information.</MudText>
                            </MudExpansionPanel>
                            <MudExpansionPanel Text="Panel Two — Details">
                                <MudStack Spacing="2">
                                    <MudText>Additional details visible when expanded.</MudText>
                                    <MudTextField T="string" Label="Setting" Variant="Variant.Outlined" />
                                </MudStack>
                            </MudExpansionPanel>
                            <MudExpansionPanel Text="Panel Three — Disabled" Disabled="true">
                                <MudText>This panel is disabled.</MudText>
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    </div>

                    <div class="hvo-card">
                        <div class="hvo-card-title">Timeline</div>
                        <MudTimeline TimelineOrientation="TimelineOrientation.Vertical">
                            <MudTimelineItem>
                                <ItemContent>
                                    <MudText Typo="Typo.subtitle2">Deployed v2.4.0</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">2026-06-14 10:00</MudText>
                                </ItemContent>
                            </MudTimelineItem>
                            <MudTimelineItem>
                                <ItemContent>
                                    <MudText Typo="Typo.subtitle2">Config updated</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">2026-06-13 14:30</MudText>
                                </ItemContent>
                            </MudTimelineItem>
                            <MudTimelineItem>
                                <ItemContent>
                                    <MudText Typo="Typo.subtitle2">System reboot</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">2026-06-12 03:00</MudText>
                                </ItemContent>
                            </MudTimelineItem>
                        </MudTimeline>
                    </div>
                </MudStack>
            </MudTabPanel>

            @* ═══════════ Icons ═══════════ *@
            <MudTabPanel Text="Icons" Icon="@Icons.Material.Outlined.EmojiSymbols">
                <MudStack Spacing="3" Class="pa-4">
                    <div class="hvo-card">
                        <div class="hvo-card-title">Icon Sizes</div>
                        <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@Icons.Material.Outlined.Star" Size="Size.Small" />
                            <MudIcon Icon="@Icons.Material.Outlined.Star" Size="Size.Medium" />
                            <MudIcon Icon="@Icons.Material.Outlined.Star" Size="Size.Large" />
                        </MudStack>
                    </div>

                    <div class="hvo-card">
                        <div class="hvo-card-title">Common Icons (30 items)</div>
                        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                            @foreach (var (name, icon) in _commonIcons)
                            {
                                <MudTooltip Text="@name">
