@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Sample Dialog</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText>This is a sample MudDialog. Dialogs are used for confirmations, forms, or detailed views.</MudText>
            <MudTextField T="string" Label="Enter something" Variant="Variant.Outlined" @bind-Value="_input" />
            @if (!string.IsNullOrWhiteSpace(_input))
            {
                <MudAlert Severity="Severity.Info" Dense="true">You typed: <strong>@_input</strong></MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Confirm">Confirm</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    private string? _input;

    private void Cancel() => MudDialog.Cancel();
    private void Confirm() => MudDialog.Close(DialogResult.Ok(_input ?? "accepted"));
}
