@page "/dashboard"

<MudPaper Class="layout-canvas shell-page" Elevation="0">
    <MudStack Class="shell-page-stack" Spacing="4">
        <div>
            <MudText Typo="Typo.h3">Dashboard Template</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">Composite layout showing cards, metrics, chart, status chips, and form controls together</MudText>
        </div>

        @* ── Status Overview Row ── *@
        <MudGrid>
            <MudItem xs="12" sm="6" lg="3">
                <div class="hvo-card">
                    <div class="hvo-eyebrow">Observatory</div>
                    <div class="hvo-card-title">Online</div>
                    <div class="hvo-metric">
                        <span class="hvo-metric-label">Uptime</span>
                        <span class="hvo-metric-value hvo-mono">47d 12h</span>
                    </div>
                    <div class="hvo-metric">
                        <span class="hvo-metric-label">Last check</span>
                        <span class="hvo-metric-value hvo-mono">12s ago</span>
                    </div>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" lg="3">
                <div class="hvo-card hvo-card-primary">
                    <div class="hvo-eyebrow">Weather</div>
                    <div class="hvo-card-title">22.5 &deg;C</div>
                    <div class="hvo-metric">
                        <span class="hvo-metric-label">Wind</span>
                        <span class="hvo-metric-value hvo-mono">18.7 km/h</span>
                    </div>
                    <div class="hvo-metric">
                        <span class="hvo-metric-label">Pressure</span>
                        <span class="hvo-metric-value hvo-mono">1013.2 hPa</span>
                    </div>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" lg="3">
                <div class="hvo-card">
                    <div class="hvo-eyebrow">Power</div>
                    <div class="hvo-card-title">2.4 kW</div>
                    <div class="hvo-metric">
                        <span class="hvo-metric-label">Battery</span>
                        <span class="hvo-metric-value hvo-mono">78%</span>
                    </div>
                    <div class="hvo-metric">
                        <span class="hvo-metric-label">Today</span>
                        <span class="hvo-metric-value hvo-mono">12.5 kWh</span>
                    </div>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" lg="3">
                <div class="hvo-card hvo-card-note">
                    <div class="hvo-eyebrow">Storage</div>
                    <div class="hvo-card-title">64% Used</div>
                    <div class="hvo-metric">
                        <span class="hvo-metric-label">Archive</span>
                        <span class="hvo-metric-value hvo-mono">142 GB</span>
                    </div>
                    <div class="hvo-metric">
                        <span class="hvo-metric-label">Logs</span>
                        <span class="hvo-metric-value hvo-mono">8 GB</span>
                    </div>
                </div>
            </MudItem>
        </MudGrid>

        @* ── Health Status Chips ── *@
        <div class="hvo-card">
            <div class="hvo-card-title">System Health</div>
            <div class="hvo-chip-row">
                <span class="hvo-chip hvo-chip-online">Live Loop Active</span>
                <span class="hvo-chip hvo-chip-online">Station Connected</span>
                <span class="hvo-chip hvo-chip-online">API Sync Healthy</span>
                <span class="hvo-chip hvo-chip-warning">Outbox Pending (2)</span>
                <span class="hvo-chip hvo-chip-online">BLE Controller OK</span>
                <span class="hvo-chip hvo-chip-error">MCP2210 Warning</span>
            </div>
        </div>

        @* ── Chart + Gauge Row ── *@
        <MudGrid>
            <MudItem xs="12" lg="8">
                <div class="hvo-card">
                    <div class="hvo-card-title">Temperature History</div>
                    <HvoChart ChartId="dashboard-chart"
                              Type="HvoChartType.Line"
                              Title="24-Hour Temperature"
                              XAxisLabel="Hour"
                              YAxisLabel="&deg;C"
                              ShowLegend="true"
                              Height="280"
                              EnableAnimations="false"
                              Labels="@_chartLabels"
                              Datasets="@_chartDatasets" />
                </div>
            </MudItem>
            <MudItem xs="12" lg="4">
                <div class="hvo-card">
                    <div class="hvo-card-title">Battery State</div>
                    <div style="display:flex;flex-direction:column;align-items:center;gap:1rem;">
                        <div class="hvo-ring-gauge" style="--hvo-ring-level:78%;--hvo-ring-color:var(--hvo-accent-success);">
                            <span class="hvo-ring-gauge-value">78%</span>
                        </div>
                        <div style="width:100%;">
                            <div class="hvo-metric">
                                <span class="hvo-metric-label">Voltage</span>
                                <span class="hvo-metric-value hvo-mono">52.1 V</span>
                            </div>
                            <div class="hvo-metric">
                                <span class="hvo-metric-label">Current</span>
                                <span class="hvo-metric-value hvo-mono">2.4 A</span>
                            </div>
                            <div class="hvo-metric">
                                <span class="hvo-metric-label">Temperature</span>
                                <span class="hvo-metric-value hvo-mono">28 &deg;C</span>
                            </div>
                            <div class="hvo-metric">
                                <span class="hvo-metric-label">Cycles</span>
                                <span class="hvo-metric-value hvo-mono">1,423</span>
                            </div>
                            <div class="hvo-metric">
                                <span class="hvo-metric-label">Health</span>
                                <span class="hvo-metric-value hvo-mono">Good</span>
                            </div>
                        </div>
                    </div>
                </div>
            </MudItem>
        </MudGrid>

        @* ── Recent Events + Quick Actions ── *@
        <MudGrid>
            <MudItem xs="12" lg="7">
                <div class="hvo-card">
                    <div class="hvo-card-title">Recent Events</div>
                    <div class="hvo-metric">
                        <span class="hvo-metric-label">2026-06-14 12:30</span>
                        <span class="hvo-metric-value">Snapshot captured &mdash; 42 metrics</span>
                    </div>
                    <div class="hvo-metric">
                        <span class="hvo-metric-label">2026-06-14 12:25</span>
                        <span class="hvo-metric-value">Outbox forwarded &mdash; 3 items</span>
                    </div>
                    <div class="hvo-metric">
                        <span class="hvo-metric-label">2026-06-14 12:00</span>
                        <span class="hvo-metric-value">Scheduled poll completed</span>
                    </div>
                    <div class="hvo-metric">
                        <span class="hvo-metric-label">2026-06-14 11:55</span>
                        <span class="hvo-metric-value hvo-mono">BLE reconnected &mdash; Bank 1A</span>
                    </div>
                </div>
            </MudItem>
            <MudItem xs="12" lg="5">
                <div class="hvo-card">
                    <div class="hvo-card-title">Quick Actions</div>
                    <MudStack Spacing="2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                   StartIcon="@Icons.Material.Outlined.Refresh">Refresh All Devices</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true"
                                   StartIcon="@Icons.Material.Outlined.Download">Export Data</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" FullWidth="true"
                                   StartIcon="@Icons.Material.Outlined.RestartAlt">Restart Gateway</MudButton>
                    </MudStack>
                </div>
            </MudItem>
        </MudGrid>
    </MudStack>
</MudPaper>

@code {
    private static readonly string[] _chartLabels = { "00", "02", "04", "06", "08", "10", "12", "14", "16", "18", "20", "22" };

    private static readonly List<HvoChartDataset> _chartDatasets = new()
    {
        new("Outdoor", new double?[] { 15.2, 14.1, 13.0, 12.5, 14.8, 18.2, 22.1, 25.0, 24.3, 20.1, 17.5, 16.0 },
            BorderColor: "#69d3ff", BackgroundColor: "rgba(105,211,255,0.08)", Fill: true, BorderWidth: 2.5),
        new("Indoor", new double?[] { 21.0, 20.8, 20.5, 20.3, 20.5, 21.0, 21.5, 22.0, 22.3, 22.1, 21.5, 21.2 },
            BorderColor: "#ffb86c", BackgroundColor: "rgba(255,184,108,0.08)", Fill: true, BorderWidth: 2.5),
    };
}
