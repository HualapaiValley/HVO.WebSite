<MudCard Elevation="2" Class="pa-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">Shared CSS — hvo-card / hvo-metric / hvo-eyebrow</MudText>
            <MudText Typo="Typo.caption" Class="hvo-eyebrow">Themed classes from hvo-components.css</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <MudGrid>
            <MudItem xs="12" md="6">
                <div class="hvo-card">
                    <div class="hvo-card-title">Default Card</div>
                    <div class="hvo-metric">
                        <span class="hvo-metric-label">Status</span>
                        <span class="hvo-metric-value">Active</span>
                    </div>
                    <div class="hvo-metric">
                        <span class="hvo-metric-label">Uptime</span>
                        <span class="hvo-metric-value hvo-mono">12d 4h 32m</span>
                    </div>
                </div>
            </MudItem>
            <MudItem xs="12" md="6">
                <div class="hvo-card hvo-card-primary">
                    <div class="hvo-card-title">Primary Card</div>
                    <div class="hvo-metric">
                        <span class="hvo-metric-label">Priority</span>
                        <span class="hvo-metric-value">High</span>
                    </div>
                    <div class="hvo-metric">
                        <span class="hvo-metric-label">Alerts</span>
                        <span class="hvo-metric-value hvo-mono">3</span>
                    </div>
                </div>
            </MudItem>
            <MudItem xs="12" md="6">
                <div class="hvo-card hvo-card-note">
                    <div class="hvo-card-title">Note Card</div>
                    <div class="hvo-metric">
                        <span class="hvo-metric-label">Message</span>
                        <span class="hvo-metric-value">No issues detected</span>
                    </div>
                </div>
            </MudItem>
            <MudItem xs="12" md="6">
                <div class="hvo-card">
                    <div class="hvo-eyebrow">Observatory Status</div>
                    <div class="hvo-card-title">Weather Conditions</div>
                    <div class="hvo-metric">
                        <span class="hvo-metric-label">Sky</span>
                        <span class="hvo-metric-value">Clear</span>
                    </div>
                    <div class="hvo-metric">
                        <span class="hvo-metric-label">Seeing</span>
                        <span class="hvo-metric-value">Excellent</span>
                    </div>
                    <div class="hvo-metric">
                        <span class="hvo-metric-label">Wind</span>
                        <span class="hvo-metric-value hvo-mono">4.2 km/h</span>
                    </div>
                </div>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>
