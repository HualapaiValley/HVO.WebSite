@page "/"
@rendermode InteractiveServer

<div class="sandbox-page">
    <div class="shell-page-stack sandbox-stack">
        <h1 class="page-heading">HVO Theme Sandbox</h1>

        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">Getting Started</div>
                    <h2>Theme Component Primitives</h2>
                </div>
            </div>
            <p style="color: var(--shell-pill-text); margin: 0;">
                All visual primitives live in <code>hvo-components.css</code> under <code>HVO.WebSite.Themes</code>.
                Every component below uses <code>hvo-*</code> classes exclusively.
            </p>
        </section>

        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">Buttons</div>
                    <h2>hvo-button variants</h2>
                </div>
            </div>
            <div class="hvo-action-row">
                <button class="hvo-button" type="button">Default</button>
                <button class="hvo-button hvo-button-primary" type="button">Primary</button>
                <button class="hvo-button hvo-button-success" type="button">Success</button>
                <button class="hvo-button hvo-button-danger" type="button">Danger</button>
                <button class="hvo-button" type="button" disabled>Disabled</button>
            </div>
        </section>

        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">Form Controls</div>
                    <h2>hvo-control inputs</h2>
                </div>
            </div>
            <div class="hvo-grid">
                <div class="hvo-field">
                    <label class="hvo-field-label">Text input</label>
                    <input class="hvo-control" type="text" placeholder="Enter text..." value="Sample text" />
                </div>
                <div class="hvo-field">
                    <label class="hvo-field-label">Number input</label>
                    <input class="hvo-control hvo-mono" type="number" value="42" />
                </div>
                <div class="hvo-field">
                    <label class="hvo-field-label">Select dropdown</label>
                    <select class="hvo-control">
                        <option>Option Alpha</option>
                        <option selected>Option Beta</option>
                        <option>Option Gamma</option>
                    </select>
                </div>
                <div class="hvo-field">
                    <label class="hvo-field-label">Datetime picker</label>
                    <input class="hvo-control" type="datetime-local" value="2026-06-15T12:00" />
                </div>
            </div>
        </section>

        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">Chips &amp; Badges</div>
                    <h2>hvo-chip states</h2>
                </div>
            </div>
            <div class="hvo-chip-row">
                <span class="hvo-chip">Default</span>
                <span class="hvo-chip hvo-chip-success">Success</span>
                <span class="hvo-chip hvo-chip-warning">Warning</span>
                <span class="hvo-chip hvo-chip-danger">Danger</span>
                <span class="hvo-chip hvo-chip-online">Online</span>
                <span class="hvo-chip hvo-chip-error">Error</span>
            </div>
        </section>

        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">Callouts</div>
                    <h2>hvo-callout messages</h2>
                </div>
            </div>
            <div class="hvo-stack">
                <div class="hvo-callout hvo-callout-success">Success: operation completed successfully.</div>
                <div class="hvo-callout hvo-callout-error">Error: an unexpected failure occurred.</div>
                <div class="hvo-callout hvo-callout-info">Info: this is an informational message.</div>
                <div class="hvo-callout">Default: neutral status message.</div>
            </div>
        </section>

        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">List Items</div>
                    <h2>hvo-list-item stat tiles</h2>
                </div>
            </div>
            <div class="hvo-grid">
                <div class="hvo-list-item">
                    <span>Temperature</span>
                    <strong class="hvo-mono">72.4 F</strong>
                </div>
                <div class="hvo-list-item">
                    <span>Humidity</span>
                    <strong class="hvo-mono">34%</strong>
                </div>
                <div class="hvo-list-item">
                    <span>Pressure</span>
                    <strong class="hvo-mono">29.99 inHg</strong>
                </div>
                <div class="hvo-list-item">
                    <span>Wind Speed</span>
                    <strong class="hvo-mono">12 mph</strong>
                </div>
            </div>
        </section>

        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">Data Table</div>
                    <h2>hvo-table</h2>
                </div>
            </div>
            <div class="hvo-table-wrap">
                <table class="hvo-table">
                    <thead>
                        <tr>
                            <th>Timestamp</th>
                            <th>Value</th>
                            <th>Unit</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="hvo-mono">2026-06-15 12:00</td>
                            <td class="hvo-mono">72.4</td>
                            <td>F</td>
                            <td><span class="hvo-chip hvo-chip-success">Normal</span></td>
                        </tr>
                        <tr>
                            <td class="hvo-mono">2026-06-15 11:55</td>
                            <td class="hvo-mono">71.8</td>
                            <td>F</td>
                            <td><span class="hvo-chip hvo-chip-success">Normal</span></td>
                        </tr>
                        <tr>
                            <td class="hvo-mono">2026-06-15 11:50</td>
                            <td class="hvo-mono">95.2</td>
                            <td>F</td>
                            <td><span class="hvo-chip hvo-chip-warning">Elevated</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">Card Variants</div>
                    <h2>hvo-card-shell sizes</h2>
                </div>
            </div>
            <div class="hvo-stack">
                <div class="hvo-card-shell">
                    <div class="hvo-section-head">
                        <div>
                            <div class="hvo-eyebrow">Standard</div>
                            <h2>Default card (24px radius, 1.25rem padding)</h2>
                        </div>
                    </div>
                </div>
                <div class="hvo-card-shell hvo-card-large">
                    <div class="hvo-section-head">
                        <div>
                            <div class="hvo-eyebrow">Large</div>
                            <h2>Large card (30px radius, 1.5rem padding)</h2>
                        </div>
                    </div>
                </div>
                <div class="hvo-card-shell hvo-card-primary">
                    <div class="hvo-section-head">
                        <div>
                            <div class="hvo-eyebrow">Primary</div>
                            <h2>Primary card (left-accent border)</h2>
                        </div>
                    </div>
                </div>
                <div class="hvo-card-shell hvo-card-note">
                    <div class="hvo-section-head">
                        <div>
                            <div class="hvo-eyebrow">Note</div>
                            <h2>Note card (panel background)</h2>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">Toggle</div>
                    <h2>hvo-toggle</h2>
                </div>
            </div>
            <div class="hvo-toggle">
                <span class="hvo-toggle-track"></span>
                <span>Feature enabled</span>
            </div>
        </section>

        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">States</div>
                    <h2>hvo-state-empty / hvo-state-error</h2>
                </div>
            </div>
            <div class="hvo-grid">
                <div class="hvo-state-empty">No data available.</div>
                <div class="hvo-state-error">Failed to load data.</div>
            </div>
        </section>

        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">Ring Gauge</div>
                    <h2>hvo-ring-gauge</h2>
                </div>
            </div>
            <div class="hvo-gauge-grid">
                <div class="hvo-ring-gauge" style="--hvo-ring-level: 85%; --hvo-ring-color: #57d38d;">
                    <div class="hvo-ring-gauge-value">85%</div>
                </div>
                <div class="hvo-ring-gauge" style="--hvo-ring-level: 42%; --hvo-ring-color: #ffcf66;">
                    <div class="hvo-ring-gauge-value">42%</div>
                </div>
                <div class="hvo-ring-gauge" style="--hvo-ring-level: 12%; --hvo-ring-color: #ff7f7f;">
                    <div class="hvo-ring-gauge-value">12%</div>
                </div>
            </div>
        </section>

        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">Cell Grid</div>
                    <h2>hvo-cell-grid / hvo-cell-tile</h2>
                </div>
            </div>
            <div class="hvo-cell-grid">
                <div class="hvo-cell-tile"><span class="hvo-cell-num">1</span><span class="hvo-cell-v">3.21</span></div>
                <div class="hvo-cell-tile hvo-cell-tile-high"><span class="hvo-cell-num">2</span><span class="hvo-cell-v">4.18</span></div>
                <div class="hvo-cell-tile hvo-cell-tile-low"><span class="hvo-cell-num">3</span><span class="hvo-cell-v">2.95</span></div>
                <div class="hvo-cell-tile"><span class="hvo-cell-num">4</span><span class="hvo-cell-v">3.33</span></div>
                <div class="hvo-cell-tile"><span class="hvo-cell-num">5</span><span class="hvo-cell-v">3.40</span></div>
                <div class="hvo-cell-tile"><span class="hvo-cell-num">6</span><span class="hvo-cell-v">3.12</span></div>
                <div class="hvo-cell-tile"><span class="hvo-cell-num">7</span><span class="hvo-cell-v">3.08</span></div>
                <div class="hvo-cell-tile hvo-cell-tile-high"><span class="hvo-cell-num">8</span><span class="hvo-cell-v">4.21</span></div>
            </div>
        </section>
    </div>
</div>
