@page "/instruments"
@rendermode InteractiveServer

<div class="id-page">
    <div class="shell-page-stack id-stack">
        <h1 class="sr-only">Instrument &amp; Chart Standards</h1>

        <!-- ═══════════════════════════════════════════════════════════
             WIND COMPASS SVG
        ═══════════════════════════════════════════════════════════ -->
        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">Custom SVG — Wind Compass</div>
                    <h2>Compass Directions</h2>
                </div>
            </div>
            <p class="id-caption">
                Hand-drawn inline SVG using <code>--demo-compass-*</code> CSS tokens.
                Rotate the needle group with <code>transform="rotate(deg 120 120)"</code>.
                Used at full card width on the Davis overview.
            </p>
            <div class="id-compass-grid">
                @foreach (var (label, deg, speedText) in new (string, int, string)[]
                {
                    ("N — 0°", 0, "12 mph"),
                    ("NE — 45°", 45, "18 mph"),
                    ("S — 180°", 180, "6 mph"),
                    ("SW — 225°", 225, "22 mph"),
                    ("W — 270°", 270, "8 mph"),
                    ("NW — 315°", 315, "14 mph"),
                })
                {
                    <div class="id-compass-item">
                        <svg class="id-compass-svg" viewBox="0 0 240 240" aria-label="Wind compass @label">
                            <circle cx="120" cy="120" r="102" fill="var(--demo-compass-face)"
                                    stroke="var(--shell-card-border)" stroke-width="2"/>
                            <circle cx="120" cy="120" r="84" fill="none"
                                    stroke="var(--shell-overlay-panel-border)" stroke-width="1"/>
                            <circle cx="120" cy="120" r="64" fill="none"
                                    stroke="var(--demo-compass-ring-soft)" stroke-width="1"/>
                            <g stroke="var(--shell-overlay-panel-border)" stroke-linecap="round">
                                <line x1="120" y1="20" x2="120" y2="36" stroke-width="2"/>
                                <line x1="120" y1="204" x2="120" y2="220" stroke-width="2"/>
                                <line x1="20" y1="120" x2="36" y2="120" stroke-width="2"/>
                                <line x1="204" y1="120" x2="220" y2="120" stroke-width="2"/>
                                <line x1="49" y1="49" x2="60" y2="60" stroke-width="1.5"/>
                                <line x1="180" y1="180" x2="191" y2="191" stroke-width="1.5"/>
                                <line x1="49" y1="191" x2="60" y2="180" stroke-width="1.5"/>
                                <line x1="180" y1="60" x2="191" y2="49" stroke-width="1.5"/>
                            </g>
                            <g fill="var(--shell-pill-text)" font-size="18" font-weight="600" text-anchor="middle">
                                <text x="120" y="54">N</text>
                                <text x="190" y="126">E</text>
                                <text x="120" y="198">S</text>
                                <text x="50" y="126">W</text>
                            </g>
                            <g transform="rotate(@deg 120 120)">
                                <path d="M120 34L133 118L120 108L107 118Z" fill="#6da5ff"/>
                                <path d="M120 206L132 126L120 132L108 126Z" fill="#ffcf66"/>
                            </g>
                            <circle cx="120" cy="120" r="10" fill="var(--shell-chart-marker-fill)"/>
                            <circle cx="120" cy="120" r="5" fill="#6da5ff"/>
                        </svg>
                        <div class="id-compass-label hvo-eyebrow">@label</div>
                        <div class="id-compass-speed hvo-mono">@speedText</div>
                    </div>
                }
            </div>
        </section>

        <!-- ═══════════════════════════════════════════════════════════
             PRESSURE GAUGE (BAROMETER)
        ═══════════════════════════════════════════════════════════ -->
        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">Custom Element — Pressure Gauge</div>
                    <h2>Barometer Scale</h2>
                </div>
            </div>
            <p class="id-caption">
                Horizontal scale band with a circular marker positioned by
                <code>left: @("{markerPercent}%")</code>. Used for both outside and inside pressure
                on the Davis overview. Classes: <code>hvo-barometer</code>, <code>hvo-barometer-band</code>,
                <code>hvo-barometer-marker</code>.
            </p>
            <div class="id-barometer-grid">
                @foreach (var (label, inHg, low, high) in new (string, double, double, double)[]
                {
                    ("Very Low — 29.20 inHg", 29.20, 29.05, 29.42),
                    ("Normal — 29.92 inHg",   29.92, 29.78, 30.10),
                    ("High Pressure — 30.42 inHg", 30.42, 30.18, 30.55),
                })
                {
                    double pct = Math.Clamp((inHg - 26.5) / (30.5 - 26.5) * 100.0, 0, 100);
                    <div>
                        <p class="id-gauge-label hvo-eyebrow">@label</p>
                        <div class="hvo-barometer">
                            <div class="hvo-barometer-reading">
                                <span class="hvo-barometer-reading-value">@inHg.ToString("F2")</span>
                                <span class="hvo-barometer-reading-label">inHg barometer</span>
                            </div>
                            <div class="hvo-barometer-scale">
                                <div class="hvo-barometer-band">
                                    <span class="hvo-barometer-marker" style="left: @pct.ToString("F1")%;"></span>
                                </div>
                                <div class="hvo-barometer-tick-row">
                                    <span>26.50</span><span>28.50</span><span>30.50</span>
                                </div>
                            </div>
                            <div class="hvo-barometer-meta">
                                <div class="hvo-barometer-row"><span>24h low</span><strong>@low.ToString("F2")</strong></div>
                                <div class="hvo-barometer-row"><span>24h high</span><strong>@high.ToString("F2")</strong></div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>

        <!-- ═══════════════════════════════════════════════════════════
             CELESTIAL ALTITUDE CHART (HvoChart — replaces SVG arc)
        ═══════════════════════════════════════════════════════════ -->
        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">HvoChart — Astronomical</div>
                    <h2>Sun &amp; Moon Altitude Curve</h2>
                </div>
            </div>
            <p class="id-caption">
                Sinusoidal altitude approximation from rise/set times. Null = below horizon (no line drawn, <code>SpanGaps=false</code>).
                Sun: <span style="color:var(--hvo-accent-amber);">&#9679;</span> <code>#ffcf66</code> with <code>PointRadius=8</code> "now" marker.
                Moon: <span style="color:var(--hvo-series-6);">&#9679;</span> <code>#c8d8ee</code> with <code>PointRadius=7</code> "now" marker.
                Used on the Davis Status page — <code>BuildAstronomicalChartData()</code> in <code>Status.razor.cs</code>.
            </p>
            <HvoChart ChartId="id-astro-curve"
                      Type="HvoChartType.Line"
                      YAxisLabel="alt °"
                      ShowLegend="true"
                      Height="220"
                      EnableAnimations="false"
                      SpanGaps="false"
                      YAxisSuggestedMin="0"
                      YAxisSuggestedMax="75"
                      Labels="@_astroLabels"
                      Datasets="@_astroDatasets" />
            <div class="id-astro-stats hvo-grid">
                <div class="hvo-stack">
                    <div class="hvo-list-item"><span>Sunrise</span><strong class="hvo-mono">6:02 AM</strong></div>
                    <div class="hvo-list-item"><span>Solar noon</span><strong class="hvo-mono">12:54 PM</strong></div>
                    <div class="hvo-list-item"><span>Sunset</span><strong class="hvo-mono">7:48 PM</strong></div>
                </div>
                <div class="hvo-stack">
                    <div class="hvo-list-item"><span>Moonrise</span><strong class="hvo-mono">9:14 PM</strong></div>
                    <div class="hvo-list-item"><span>Moon phase</span><strong>&#127762; Waxing Gibbous 78%</strong></div>
                    <div class="hvo-list-item"><span>Moonset</span><strong class="hvo-mono">5:41 AM</strong></div>
                </div>
            </div>
        </section>

        <!-- ═══════════════════════════════════════════════════════════
             CHARTS — FULL WIDTH
        ═══════════════════════════════════════════════════════════ -->
        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">HvoChart — Full Width</div>
                    <h2>Multi-Series Filled Line (Temperature Pattern)</h2>
                </div>
            </div>
            <p class="id-caption">
                <code>Fill=true</code> · <code>Tension=0.35</code> · <code>SpanGaps=false</code> so the null
                gap at <code>04:00</code> breaks the line. Use for outdoor vs indoor readings.
            </p>
            <HvoChart ChartId="id-temp-full"
                      Type="HvoChartType.Line"
                      YAxisLabel="°F"
                      ShowLegend="true"
                      Height="280"
                      EnableAnimations="false"
                      SpanGaps="false"
                      Labels="@_h24"
                      Datasets="@_tempDatasets" />
        </section>

        <!-- ═══════════════════════════════════════════════════════════
             CHARTS — HALF WIDTH SIDE BY SIDE
        ═══════════════════════════════════════════════════════════ -->
        <div class="id-half-grid">
            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">HvoChart — Half Width</div>
                        <h2>Dual-Series No Fill (Wind)</h2>
                    </div>
                </div>
                <p class="id-caption">
                    No fill · <code>YAxisSuggestedMin=0</code> · null gaps show station offline periods.
                </p>
                <HvoChart ChartId="id-wind-half"
                          Type="HvoChartType.Line"
                          YAxisLabel="mph"
                          ShowLegend="true"
                          Height="240"
                          EnableAnimations="false"
                          SpanGaps="false"
                          YAxisSuggestedMin="0"
                          Labels="@_h24"
                          Datasets="@_windDatasets" />
            </section>

            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">HvoChart — Half Width</div>
                        <h2>Single-Series Filled (Solar)</h2>
                    </div>
                </div>
                <p class="id-caption">
                    Single series · <code>Fill=true</code> · <code>YAxisSuggestedMin=0</code> ·
                    gap in the middle = cloud/offline period.
                </p>
                <HvoChart ChartId="id-solar-half"
                          Type="HvoChartType.Line"
                          YAxisLabel="W/m²"
                          ShowLegend="false"
                          Height="240"
                          EnableAnimations="false"
                          SpanGaps="false"
                          YAxisSuggestedMin="0"
                          Labels="@_h24"
                          Datasets="@_solarDatasets" />
            </section>
        </div>

        <!-- ═══════════════════════════════════════════════════════════
             CHARTS — THIRD WIDTH THREE UP
        ═══════════════════════════════════════════════════════════ -->
        <div class="id-third-grid">
            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">1/3 Width — Bar</div>
                        <h2>Rain Accumulation</h2>
                    </div>
                </div>
                <HvoChart ChartId="id-rain-third"
                          Type="HvoChartType.Bar"
                          YAxisLabel="in"
                          ShowLegend="false"
                          Height="220"
                          EnableAnimations="false"
                          YAxisSuggestedMin="0"
                          Labels="@_h12"
                          Datasets="@_rainDatasets" />
            </section>

            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">1/3 Width — Single Dense</div>
                        <h2>UV Index</h2>
                    </div>
                </div>
                <HvoChart ChartId="id-uv-third"
                          Type="HvoChartType.Line"
                          YAxisLabel="UV"
                          ShowLegend="false"
                          Height="220"
                          EnableAnimations="false"
                          YAxisSuggestedMin="0"
                          YAxisSuggestedMax="12"
                          Labels="@_h12"
                          Datasets="@_uvDatasets" />
            </section>

            <section class="hvo-card-shell">
                <div class="hvo-section-head">
                    <div>
                        <div class="hvo-eyebrow">1/3 Width — Sparse</div>
                        <h2>Humidity (With Gaps)</h2>
                    </div>
                </div>
                <HvoChart ChartId="id-hum-third"
                          Type="HvoChartType.Line"
                          YAxisLabel="%"
                          ShowLegend="false"
                          Height="220"
                          EnableAnimations="false"
                          SpanGaps="false"
                          YAxisSuggestedMin="0"
                          YAxisSuggestedMax="100"
                          Labels="@_h12"
                          Datasets="@_humDatasets" />
            </section>
        </div>

        <!-- ═══════════════════════════════════════════════════════════
             NULL / GAP REFERENCE
        ═══════════════════════════════════════════════════════════ -->
        <section class="hvo-card-shell hvo-card-note">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">Standards Reference</div>
                    <h2>Null Data Point &amp; Offline Gap Rules</h2>
                </div>
            </div>
            <div class="hvo-grid">
                <div class="hvo-stack">
                    <div class="hvo-list-item"><strong>Station offline</strong><span>No packets from console for an extended period — null the bucket</span></div>
                    <div class="hvo-list-item"><strong>Sensor fault</strong><span>Out-of-range or error value returned by sensor</span></div>
                    <div class="hvo-list-item"><strong>Empty bucket</strong><span>30-min grid slot has no persisted history sample</span></div>
                </div>
                <div class="hvo-stack">
                    <div class="hvo-list-item"><strong>SpanGaps="false"</strong><span>Default — null breaks the line, shows exactly when data was missing</span></div>
                    <div class="hvo-list-item"><strong>SpanGaps="true"</strong><span>Line connects across nulls — use only when gaps are cosmetic noise</span></div>
                    <div class="hvo-list-item"><strong>Tension="0.3"</strong><span>Default smooth. Use 0 for angular, 0.4+ for very smooth curves</span></div>
                </div>
            </div>
        </section>
    </div>
</div>

@code {
    // ── 24-label grid (every 2 h) ────────────────────────────────
    private static readonly string[] _h24 =
        ["00:00","02:00","04:00","06:00","08:00","10:00",
         "12:00","14:00","16:00","18:00","20:00","22:00"];

    // ── 12-label grid (every 2 h, half-day) ─────────────────────
    private static readonly string[] _h12 =
        ["00:00","02:00","04:00","06:00","08:00","10:00",
         "12:00","14:00","16:00","18:00","20:00","22:00"];

    // ── Astronomical altitude demo (sinusoidal approximation) ────
    // X-axis: every 2 h over 24 h (12 labels, 00:00–22:00).
    // Sunrise ~6 AM (slot 3), sunset ~8 PM (slot 10).  Null = below horizon.
    // Moonrise ~9 PM previous night; sets ~5 AM.  Moon above horizon slots 0-2 and 10-11.
    // "Now" = 14:00 (slot 7) for sun;  02:00 (slot 1) for moon.
    // Separate single-point datasets carry the "now" marker (PointRadius 8/7).
    private static readonly string[] _astroLabels =
        ["00:00","02:00","04:00","06:00","08:00","10:00",
         "12:00","14:00","16:00","18:00","20:00","22:00"];

    private static readonly HvoChartDataset[] _astroDatasets =
    [
        // Sun altitude line — PointRadius 0; null outside sunrise-sunset
        new("Sun alt °",
            new double?[] { null, null, null, 4, 30, 54, 63, 52, 34, 10, null, null },
            "#ffcf66", "rgba(255,207,102,0.10)", BorderWidth: 2, PointRadius: 0,
            Fill: true, Tension: 0.4),
        // Sun "now" marker — single non-null point at slot 7 (14:00)
        new("Sun now",
            new double?[] { null, null, null, null, null, null, null, 52, null, null, null, null },
            "#ffcf66", "#ffcf66", BorderWidth: 2, PointRadius: 8,
            Fill: false, Tension: 0),
        // Moon altitude line — PointRadius 0; above horizon midnight-4 AM and 10-11 PM
        new("Moon alt °",
            new double?[] { 38, 42, 22, null, null, null, null, null, null, null, 5, 28 },
            "#9fb8d4", null, BorderWidth: 1.5, PointRadius: 0,
            Fill: false, Tension: 0.4),
        // Moon "now" marker — single non-null point at slot 1 (02:00)
        new("Moon now",
            new double?[] { null, 42, null, null, null, null, null, null, null, null, null, null },
            "#9fb8d4", "#9fb8d4", BorderWidth: 2, PointRadius: 7,
            Fill: false, Tension: 0),
    ];

    // ── Temperature — dual-series filled, one null gap ───────────
    private static readonly HvoChartDataset[] _tempDatasets =
    [
        new("Outside °F", new double?[] { 58.2, 55.1, null, 51.5, 54.8, 62.2, 72.1, 80.0, 79.3, 73.1, 66.5, 62.0 },
            "#69d3ff", "rgba(105,211,255,0.15)", Fill: true, Tension: 0.35),
        new("Inside °F",  new double?[] { 68.0, 67.8, null, 67.3, 67.5, 68.0, 69.5, 71.0, 71.3, 71.1, 70.5, 69.2 },
            "#ffb86c", "rgba(255,184,108,0.12)", Fill: true, Tension: 0.35),
    ];

    // ── Wind — dual-series, no fill, null gaps ───────────────────
    private static readonly HvoChartDataset[] _windDatasets =
    [
        new("2-min avg mph", new double?[] { 8, 6, null, null, 12, 15, 22, null, 18, 14, 10, 9 },
            "#7ae0ff", Tension: 0.3),
        new("10-min gust mph", new double?[] { 14, 11, null, null, 18, 24, 31, null, 26, 22, 16, 13 },
            "#ff9f5a", Tension: 0.3),
    ];

    // ── Solar — single series filled, null gap ───────────────────
    private static readonly HvoChartDataset[] _solarDatasets =
    [
        new("Solar W/m²", new double?[] { 0, 0, 0, 42, 280, null, null, 850, 720, 310, 60, 0 },
            "#ffd166", "rgba(255,209,102,0.18)", Fill: true, Tension: 0.3),
    ];

    // ── Rain — bar chart ─────────────────────────────────────────
    private static readonly HvoChartDataset[] _rainDatasets =
    [
        new("Rain in", new double?[] { 0, 0, 0, 0, 0.05, 0.12, 0.08, 0, 0, 0.02, 0, 0 },
            "#83e4ff", "rgba(131,228,255,0.35)", Fill: true),
    ];

    // ── UV — single dense ────────────────────────────────────────
    private static readonly HvoChartDataset[] _uvDatasets =
    [
        new("UV Index", new double?[] { 0, 0, 0, 0.2, 2.1, 5.4, 8.2, 9.0, 7.6, 4.1, 1.2, 0 },
            "#ffcf66", "rgba(255,207,102,0.15)", Fill: true, Tension: 0.35),
    ];

    // ── Humidity — sparse ────────────────────────────────────────
    private static readonly HvoChartDataset[] _humDatasets =
    [
        new("Humidity %", new double?[] { 72, 74, null, null, 68, 62, 55, null, 48, 52, 60, 66 },
            "#57d38d", "rgba(87,211,141,0.15)", Fill: true, Tension: 0.3),
    ];
}
