@page "/states"

<MudPaper Class="layout-canvas shell-page" Elevation="0">
    <MudStack Class="shell-page-stack" Spacing="4">
        <div>
            <MudText Typo="Typo.h3">State Patterns</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">Empty, loading, error, and null-value states — consistent patterns for all apps</MudText>
        </div>

        @* ── Empty States ── *@
        <div class="hvo-card">
            <div class="hvo-card-title">Empty States</div>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Used when a list, table, or chart has no data yet.</MudText>
            <div class="hvo-state-demo">
                <div class="hvo-state-empty">
                    <MudIcon Icon="@Icons.Material.Outlined.Inbox" Size="Size.Large" />
                    <MudText Typo="Typo.subtitle2">No devices found</MudText>
                    <MudText Typo="Typo.caption">Scanned networks have returned no discoverable Kasa devices.</MudText>
                </div>
                <div class="hvo-state-empty">
                    <MudIcon Icon="@Icons.Material.Outlined.ShowChart" Size="Size.Large" />
                    <MudText Typo="Typo.subtitle2">No data available</MudText>
                    <MudText Typo="Typo.caption">The chart will populate once telemetry samples are received.</MudText>
                </div>
                <div class="hvo-state-empty">
                    <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Size="Size.Large" />
                    <MudText Typo="Typo.subtitle2">No results</MudText>
                    <MudText Typo="Typo.caption">Try adjusting your search or filter criteria.</MudText>
                </div>
            </div>
        </div>

        @* ── Loading States ── *@
        <div class="hvo-card">
            <div class="hvo-card-title">Loading States</div>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Shown during data fetching or initialization.</MudText>
            <div class="hvo-state-demo">
                <div style="display:flex;flex-direction:column;align-items:center;gap:1rem;padding:2rem;">
                    <MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary" />
                    <MudText Typo="Typo.subtitle2">Loading devices&hellip;</MudText>
                </div>
                <div style="display:flex;flex-direction:column;align-items:center;gap:1rem;padding:2rem;">
                    <MudSkeleton SkeletonType="SkeletonType.Text" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" />
                    <MudSkeleton SkeletonType="SkeletonType.Text" />
                    <MudText Typo="Typo.caption">Content placeholder</MudText>
                </div>
                <div style="display:flex;align-items:center;justify-content:center;gap:0.75rem;padding:1.5rem;">
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Secondary" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Refreshing data&hellip;</MudText>
                </div>
            </div>
        </div>

        @* ── Error States ── *@
        <div class="hvo-card">
            <div class="hvo-card-title">Error States</div>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Shown when an operation fails or data cannot be loaded.</MudText>
            <MudStack Spacing="2">
                <div class="hvo-state-error">
                    <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" />
                    <MudText Typo="Typo.subtitle2">Failed to connect</MudText>
                    <MudText Typo="Typo.caption">The device at 192.168.1.50 is not responding. Check power and network.</MudText>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Refresh">Retry</MudButton>
                </div>
                <div class="hvo-state-error">
                    <MudIcon Icon="@Icons.Material.Outlined.CloudOff" />
                    <MudText Typo="Typo.subtitle2">API sync failed</MudText>
                    <MudText Typo="Typo.caption">The outbox has 3 pending items that could not be forwarded. Retrying in 30 seconds.</MudText>
                </div>
            </MudStack>
        </div>

        @* ── Null Value Display ── *@
        <div class="hvo-card">
            <div class="hvo-card-title">Null / Missing Value Display</div>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Consistent &ldquo;&mdash;&rdquo; for unavailable data via HvoFormat.</MudText>
            <MudGrid>
                <MudItem xs="6" md="3">
                    <div class="hvo-metric">
                        <span class="hvo-metric-label">Temperature</span>
                        <span class="hvo-metric-value hvo-mono">@HvoFormat.Temperature(null)</span>
                    </div>
                </MudItem>
                <MudItem xs="6" md="3">
                    <div class="hvo-metric">
                        <span class="hvo-metric-label">Current</span>
                        <span class="hvo-metric-value hvo-mono">@HvoFormat.Current(null)</span>
                    </div>
                </MudItem>
                <MudItem xs="6" md="3">
                    <div class="hvo-metric">
                        <span class="hvo-metric-label">Percent</span>
                        <span class="hvo-metric-value hvo-mono">@HvoFormat.Percent(null)</span>
                    </div>
                </MudItem>
                <MudItem xs="6" md="3">
                    <div class="hvo-metric">
                        <span class="hvo-metric-label">Duration</span>
                        <span class="hvo-metric-value hvo-mono">@HvoFormat.Duration(null)</span>
                    </div>
                </MudItem>
            </MudGrid>
        </div>

        @* ── Success State ── *@
        <div class="hvo-card">
            <div class="hvo-card-title">Success Feedback</div>
            <MudStack Spacing="2">
                <MudAlert Severity="Severity.Success" Dense="true">Device added successfully. Discovered at 192.168.1.50.</MudAlert>
                <MudAlert Severity="Severity.Success" Dense="true">Configuration saved. Changes will take effect on next poll cycle.</MudAlert>
                <MudAlert Severity="Severity.Success" Dense="true">Backup completed. 128 MB written to archive.</MudAlert>
            </MudStack>
        </div>

        @* ── Warning State ── *@
        <div class="hvo-card">
            <div class="hvo-card-title">Warning / Degraded State</div>
            <MudStack Spacing="2">
                <MudAlert Severity="Severity.Warning" Dense="true">Connection degraded. Response time exceeds 2 seconds.</MudAlert>
                <MudAlert Severity="Severity.Warning" Dense="true">Disk usage at 85%. Consider expanding storage.</MudAlert>
                <MudAlert Severity="Severity.Warning" Dense="true">Certificate expires in 14 days. Schedule renewal.</MudAlert>
            </MudStack>
        </div>
    </MudStack>
</MudPaper>
