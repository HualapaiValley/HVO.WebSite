    // ── Text & overlay ─────────────────────────────────────────────────────────
    private static readonly Swatch[] _textSwatches =
    [
        new("--shell-pill-text",         "#bfd0e9",  "#35506f"),
        new("--shell-pill-hover-text",   "#f8fbff",  "#173251"),
        new("--shell-pill-active-text",  "#10233f",  "#f8fbff"),
