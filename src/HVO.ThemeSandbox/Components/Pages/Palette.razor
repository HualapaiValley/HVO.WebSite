        new("--hvo-accent-blue",    "#6da5ff", "Links · hero"),
        new("--hvo-accent-cyan",    "#83e4ff", "Highlights"),
        new("--hvo-accent-amber",   "#ffcf66", "Warm · sun"),
        new("--hvo-accent-success", "#57d38d", "Online · positive"),
        new("--hvo-accent-danger",  "#ff7f7f", "Offline · alarm"),
    ];

    // ── Shell surface ──────────────────────────────────────────────────────────
    private static readonly Swatch[] _surfaceSwatches =
    [
        new("--shell-card-background",    "rgba(31,41,55,.92)",    "rgba(244,248,252,.56)"),
        new("--shell-card-foreground",    "#f9fafb",               "#10233f"),
        new("--shell-card-border",        "rgba(155,180,220,.34)", "rgba(128,151,185,.46)"),
        new("--shell-card-inner-border",  "rgba(255,255,255,.06)", "rgba(255,255,255,.72)"),
        new("--shell-overlay-panel",      "rgba(8,18,30,.44)",     "rgba(255,255,255,.58)"),
        new("--shell-overlay-panel-border","rgba(126,157,196,.18)","rgba(128,151,185,.24)"),
        new("--shell-page-text",          "#ebf5ff",               "#10233f"),
        new("--shell-brand-title",        "#f8fbff",               "#183250"),
        new("--shell-brand-subtitle",     "#7387a7",               "#56708f"),
