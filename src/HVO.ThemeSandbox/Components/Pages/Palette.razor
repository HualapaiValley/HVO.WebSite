@page "/palette"

<MudPaper Class="layout-canvas shell-page" Elevation="0">
    <MudStack Class="shell-page-stack" Spacing="4">
        <div>
            <MudText Typo="Typo.h3">Color Palette Reference</MudText>
            <MudText Typo="Typo.body1" Color="Color.Secondary">
                All HVO palette variables — data series, accent, shell surface and text tokens.
                Left half of each swatch = dark theme · Right half = light theme.
            </MudText>
        </div>

        <!-- ── DATA SERIES ── -->
        <div class="hvo-card">
            <div class="hvo-card-title">Data Series — <span class="hvo-mono" style="font-size:.8em;">--hvo-series-1…8</span></div>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                Fixed palette for chart datasets. Assign in numeric order when adding new series.
                C# chart colors must use hex literals; the CSS variable provides the canonical value.
            </MudText>
            <MudGrid>
                @foreach (var s in _seriesSwatches)
                {
                    var tc = ContrastClass(s.Hex);
                    <MudItem xs="6" sm="3">
                        <div class="hvo-palette-swatch" style="background:@s.Hex;">
                            <div class="hvo-palette-label @tc hvo-mono">@s.Var</div>
                            <div class="hvo-palette-values">
                                <span class="@tc">@s.Hex</span>
                                <span class="@tc" style="font-style:italic;">@s.Use</span>
                            </div>
                        </div>
                    </MudItem>
                }
            </MudGrid>
        </div>

        <!-- ── ACCENT COLORS ── -->
        <div class="hvo-card">
            <div class="hvo-card-title">Accent Colors — <span class="hvo-mono" style="font-size:.8em;">--hvo-accent-*</span></div>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                Semantic tokens for UI elements — hero readouts, barometer markers, status indicators.
                Use <code>var(--hvo-accent-*)</code> in CSS; resolve to hex in C# when canvas interop is needed.
            </MudText>
            <MudGrid>
                @foreach (var a in _accentSwatches)
                {
                    var tc = ContrastClass(a.Hex);
                    <MudItem xs="6" sm="@(12 / _accentSwatches.Length)">
                        <div class="hvo-palette-swatch" style="background:@a.Hex;">
                            <div class="hvo-palette-label @tc hvo-mono">@a.Var</div>
                            <div class="hvo-palette-values">
                                <span class="@tc">@a.Hex</span>
                                <span class="@tc" style="font-style:italic;">@a.Use</span>
                            </div>
                        </div>
                    </MudItem>
                }
            </MudGrid>
        </div>

        <!-- ── STATUS CHIPS ── -->
        <div class="hvo-card">
            <div class="hvo-card-title">Status Chips — <span class="hvo-mono" style="font-size:.8em;">hvo-chip + modifier</span></div>
            <div class="hvo-pill-demo">
                <span class="hvo-chip">Default</span>
                <span class="hvo-chip hvo-chip-success">success</span>
                <span class="hvo-chip hvo-chip-online">online</span>
                <span class="hvo-chip hvo-chip-warning">warning</span>
                <span class="hvo-chip hvo-chip-danger">danger</span>
                <span class="hvo-chip hvo-chip-error">error</span>
            </div>
        </div>

        <!-- ── SURFACE COLORS ── -->
        <div class="hvo-card">
            <div class="hvo-card-title">Shell Surface Colors — <span class="hvo-mono" style="font-size:.8em;">--shell-card-*, --shell-overlay-*</span></div>
            <MudGrid>
                @foreach (var swatch in _surfaceSwatches)
                {
                    <MudItem xs="12" md="4">
                        <div class="hvo-palette-swatch" style="background:@swatch.Dark" title="@swatch.Name">
                            <div class="hvo-palette-light-half" style="background:@swatch.Light"></div>
                            <div class="hvo-palette-label hvo-mono">@swatch.Name</div>
                            <div class="hvo-palette-values">
                                <span class="hvo-palette-dark">D: @swatch.Dark</span>
                                <span class="hvo-palette-light">L: @swatch.Light</span>
                            </div>
                        </div>
                    </MudItem>
                }
            </MudGrid>
        </div>

        <!-- ── TEXT & OVERLAY ── -->
        <div class="hvo-card">
            <div class="hvo-card-title">Text &amp; Overlay Colors — <span class="hvo-mono" style="font-size:.8em;">--shell-pill-*, --shell-overlay-*</span></div>
            <MudGrid>
                @foreach (var swatch in _textSwatches)
                {
                    <MudItem xs="12" md="3">
                        <div class="hvo-palette-swatch" style="background:@swatch.Dark" title="@swatch.Name">
                            <div class="hvo-palette-light-half" style="background:@swatch.Light"></div>
                            <div class="hvo-palette-label hvo-mono">@swatch.Name</div>
                            <div class="hvo-palette-values">
                                <span class="hvo-palette-dark">D: @swatch.Dark</span>
                                <span class="hvo-palette-light">L: @swatch.Light</span>
                            </div>
                        </div>
                    </MudItem>
                }
            </MudGrid>
        </div>

        <!-- ── PILL STATES ── -->
        <div class="hvo-card">
            <div class="hvo-card-title">Pill / Navigation States — <span class="hvo-mono" style="font-size:.8em;">--shell-pill-*</span></div>
            <div class="hvo-pill-demo">
                <div class="shell-nav-link" style="background:var(--shell-pill-background);color:var(--shell-pill-text);border-color:var(--shell-pill-border);">Default</div>
                <div class="shell-nav-link" style="background:var(--shell-pill-hover-background);color:var(--shell-pill-hover-text);border-color:var(--shell-pill-hover-border);">Hover</div>
                <div class="shell-nav-link shell-nav-link-current">Active</div>
            </div>
            <MudGrid Class="mt-3">
                @foreach (var swatch in _pillSwatches)
                {
                    <MudItem xs="12" md="4">
                        <div class="hvo-palette-swatch" style="background:@swatch.Dark" title="@swatch.Name">
                            <div class="hvo-palette-light-half" style="background:@swatch.Light"></div>
                            <div class="hvo-palette-label hvo-mono">@swatch.Name</div>
                            <div class="hvo-palette-values">
                                <span class="hvo-palette-dark">D: @swatch.Dark</span>
                                <span class="hvo-palette-light">L: @swatch.Light</span>
                            </div>
                        </div>
                    </MudItem>
                }
            </MudGrid>
        </div>

        <!-- ── CHART INFRA ── -->
        <div class="hvo-card">
            <div class="hvo-card-title">Chart Infrastructure — <span class="hvo-mono" style="font-size:.8em;">--shell-chart-*</span></div>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                Applied automatically by <code>hvo-chart.js</code>. Do not override per-chart.
            </MudText>
            <MudGrid>
                @foreach (var swatch in _chartSwatches)
                {
                    <MudItem xs="12" md="4">
                        <div class="hvo-palette-swatch" style="background:@swatch.Dark" title="@swatch.Name">
                            <div class="hvo-palette-light-half" style="background:@swatch.Light"></div>
                            <div class="hvo-palette-label hvo-mono">@swatch.Name</div>
                            <div class="hvo-palette-values">
                                <span class="hvo-palette-dark">D: @swatch.Dark</span>
                                <span class="hvo-palette-light">L: @swatch.Light</span>
                            </div>
                        </div>
                    </MudItem>
                }
            </MudGrid>
        </div>

        <!-- ── DIMENSIONS ── -->
        <div class="hvo-card">
            <div class="hvo-card-title">Dimensional Tokens</div>
            <MudGrid>
                @foreach (var dim in _dimensions)
                {
                    <MudItem xs="12" md="4">
                        <div class="hvo-metric">
                            <span class="hvo-metric-label hvo-mono">@dim.Name</span>
                            <span class="hvo-metric-value hvo-mono">@dim.Value</span>
                        </div>
                    </MudItem>
                }
            </MudGrid>
        </div>
    </MudStack>
</MudPaper>

@code {
    private sealed record SeriesSwatch(string Var, string Hex, string Use);
    private sealed record Swatch(string Name, string Dark, string Light);

    /// <summary>
    /// Returns a CSS class that provides readable text contrast against the given hex color.
    /// Uses WCAG relative luminance (ITU-R BT.709 coefficients).
    /// Threshold 0.40: above → dark text on light bg; at/below → light text on dark bg.
    /// </summary>
    private static string ContrastClass(string hex)
    {
        if (hex.Length == 7 && hex[0] == '#')
        {
            try
            {
                int r = Convert.ToInt32(hex[1..3], 16);
                int g = Convert.ToInt32(hex[3..5], 16);
                int b = Convert.ToInt32(hex[5..7], 16);

                static double Lin(double c)
                {
                    c /= 255.0;
                    return c <= 0.04045 ? c / 12.92 : Math.Pow((c + 0.055) / 1.055, 2.4);
                }

                double luminance = 0.2126 * Lin(r) + 0.7152 * Lin(g) + 0.0722 * Lin(b);
                // WCAG break-even: black and white text give equal contrast ratio at L=0.179
                return luminance > 0.179 ? "hvo-palette-on-light" : "hvo-palette-on-dark";
            }
            catch { }
        }
        return "hvo-palette-on-dark";
    }

    // ── Data series ────────────────────────────────────────────────────────────
    private static readonly SeriesSwatch[] _seriesSwatches =
    [
        new("--hvo-series-1", "#69d3ff", "Temp outside · wind avg"),
        new("--hvo-series-2", "#ffb86c", "Temp inside · secondary"),
        new("--hvo-series-3", "#ffd166", "Solar · sun arc fill"),
        new("--hvo-series-4", "#57d38d", "Success · positive"),
        new("--hvo-series-5", "#ff9f5a", "Alert · wind gust"),
        new("--hvo-series-6", "#9fb8d4", "Moon arc · muted"),
        new("--hvo-series-7", "#7ae0ff", "Bright cyan · alt blue"),
        new("--hvo-series-8", "#f38ba8", "Danger · alarm"),
    ];

    // ── Accent colors ──────────────────────────────────────────────────────────
    private static readonly SeriesSwatch[] _accentSwatches =
