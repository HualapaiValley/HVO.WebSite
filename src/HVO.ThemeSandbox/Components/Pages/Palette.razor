@page "/palette"
@rendermode InteractiveServer

<div class="palette-page">
    <div class="shell-page-stack palette-stack">
        <h1 class="sr-only">HVO Color Palette Reference</h1>

        <!-- ── HVO Data Series ───────────────────────────────────────────── -->
        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">HVO Visualization Palette</div>
                    <h2>Data Series Colors</h2>
                </div>
            </div>
            <p class="palette-note">
                Assign these in numeric order for new chart datasets.
                Hex literals required for <code>HvoChartDataset</code> (canvas 2D cannot resolve CSS variables).
                Each variable is defined in <code>hvo-shared-shell.css</code>.
            </p>
            <div class="palette-series-grid">
                @foreach (var s in _series)
                {
                    <div class="palette-series-item">
                        <div class="palette-series-swatch" style="background: @s.Hex;"></div>
                        <div class="palette-series-name hvo-mono">@s.Var</div>
                        <div class="palette-series-hex hvo-mono">@s.Hex</div>
                        <div class="palette-series-use">@s.Use</div>
                    </div>
                }
            </div>
        </section>

        <!-- ── HVO Accent Colors ──────────────────────────────────────────── -->
        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">HVO Visualization Palette</div>
                    <h2>Accent Colors</h2>
                </div>
            </div>
            <p class="palette-note">Use for UI elements — hero readouts, indicators, barometer. Defined in <code>hvo-shared-shell.css</code>.</p>
            <div class="palette-accent-grid">
                @foreach (var a in _accents)
                {
                    <div class="palette-accent-item">
                        <div class="palette-accent-swatch" style="background: @a.Hex;"></div>
                        <div class="palette-accent-name hvo-mono">@a.Var</div>
                        <div class="palette-accent-hex hvo-mono">@a.Hex</div>
                        <div class="palette-accent-use">@a.Use</div>
                        <div class="palette-accent-sample" style="color: @a.Hex;">Sample text</div>
                    </div>
                }
            </div>
        </section>

        <!-- ── Chip / Status Colors ───────────────────────────────────────── -->
        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">hvo-components.css</div>
                    <h2>Status Chip Colors</h2>
                </div>
            </div>
            <p class="palette-note">Use <code>hvo-chip</code> + modifier for status indicators. Backgrounds are semi-transparent color-mix tokens.</p>
            <div class="hvo-chip-row" style="gap: 10px; flex-wrap: wrap;">
                <span class="hvo-chip">Default</span>
                <span class="hvo-chip hvo-chip-success">hvo-chip-success</span>
                <span class="hvo-chip hvo-chip-online">hvo-chip-online</span>
                <span class="hvo-chip hvo-chip-warning">hvo-chip-warning</span>
                <span class="hvo-chip hvo-chip-danger">hvo-chip-danger</span>
                <span class="hvo-chip hvo-chip-error">hvo-chip-error</span>
            </div>
        </section>

        <!-- ── Shell Surface Colors ───────────────────────────────────────── -->
        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">hvo-shared-shell.css — :root</div>
                    <h2>Shell Surface Variables</h2>
                </div>
            </div>
            <p class="palette-note">Light/dark values shown side-by-side. Left half = dark theme, right half = light theme.</p>
            <div class="palette-var-grid">
                @foreach (var sw in _surfaceSwatches)
                {
                    <div class="palette-var-item">
                        <div class="palette-var-swatch-wrap">
                            <div class="palette-var-swatch-dark"  style="background: @sw.Dark;"></div>
                            <div class="palette-var-swatch-light" style="background: @sw.Light;"></div>
                        </div>
                        <div class="palette-var-name hvo-mono">@sw.Name</div>
                        <div class="palette-var-value hvo-mono">D: @sw.Dark</div>
                        <div class="palette-var-value hvo-mono">L: @sw.Light</div>
                    </div>
                }
            </div>
        </section>

        <!-- ── Shell Text & Overlay Colors ───────────────────────────────── -->
        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">hvo-shared-shell.css — :root</div>
                    <h2>Text &amp; Overlay Variables</h2>
                </div>
            </div>
            <div class="palette-var-grid">
                @foreach (var sw in _textSwatches)
                {
                    <div class="palette-var-item">
                        <div class="palette-var-swatch-wrap">
                            <div class="palette-var-swatch-dark"  style="background: @sw.Dark;"></div>
                            <div class="palette-var-swatch-light" style="background: @sw.Light;"></div>
                        </div>
                        <div class="palette-var-name hvo-mono">@sw.Name</div>
                        <div class="palette-var-value hvo-mono">D: @sw.Dark</div>
                        <div class="palette-var-value hvo-mono">L: @sw.Light</div>
                    </div>
                }
            </div>
        </section>

        <!-- ── Pill / Nav States ─────────────────────────────────────────── -->
        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">Shell navigation tokens</div>
                    <h2>Pill / Nav States</h2>
                </div>
            </div>
            <div class="palette-pill-demo">
                <span class="shell-nav-link">Default</span>
                <span class="shell-nav-link" style="background:var(--shell-pill-hover-background);color:var(--shell-pill-hover-text);border-color:var(--shell-pill-hover-border);">Hover</span>
                <span class="shell-nav-link shell-nav-link-current">Active</span>
            </div>
            <div class="palette-var-grid" style="margin-top: 1rem;">
                @foreach (var sw in _pillSwatches)
                {
                    <div class="palette-var-item">
                        <div class="palette-var-swatch-wrap">
                            <div class="palette-var-swatch-dark"  style="background: @sw.Dark;"></div>
                            <div class="palette-var-swatch-light" style="background: @sw.Light;"></div>
                        </div>
                        <div class="palette-var-name hvo-mono">@sw.Name</div>
                        <div class="palette-var-value hvo-mono">D: @sw.Dark</div>
                        <div class="palette-var-value hvo-mono">L: @sw.Light</div>
                    </div>
                }
            </div>
        </section>

        <!-- ── Chart Infra Colors ─────────────────────────────────────────── -->
        <section class="hvo-card-shell">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">hvo-shared-shell.css — chart infrastructure</div>
                    <h2>Chart Grid &amp; Axis Variables</h2>
                </div>
            </div>
            <p class="palette-note">Applied automatically by <code>hvo-chart.js</code> — do not override per-chart. These are read from CSS at render time.</p>
            <div class="palette-var-grid">
                @foreach (var sw in _chartSwatches)
                {
                    <div class="palette-var-item">
                        <div class="palette-var-swatch-wrap">
                            <div class="palette-var-swatch-dark"  style="background: @sw.Dark;"></div>
                            <div class="palette-var-swatch-light" style="background: @sw.Light;"></div>
                        </div>
                        <div class="palette-var-name hvo-mono">@sw.Name</div>
                        <div class="palette-var-value hvo-mono">D: @sw.Dark</div>
                        <div class="palette-var-value hvo-mono">L: @sw.Light</div>
                    </div>
                }
            </div>
        </section>

        <!-- ── Dimensional Tokens ─────────────────────────────────────────── -->
        <section class="hvo-card-shell hvo-card-note">
            <div class="hvo-section-head">
                <div>
                    <div class="hvo-eyebrow">Layout tokens</div>
                    <h2>Dimensional Variables</h2>
                </div>
            </div>
            <div class="hvo-grid">
                @foreach (var d in _dimensions)
                {
                    <div class="hvo-list-item">
                        <span class="hvo-mono" style="font-size: 0.74rem;">@d.Name</span>
                        <strong class="hvo-mono">@d.Value</strong>
                    </div>
                }
            </div>
        </section>

    </div>
</div>

@code {
    private sealed record ColorEntry(string Var, string Hex, string Use);
    private sealed record Swatch(string Name, string Dark, string Light);

    // ── Data series ─────────────────────────────────────────────────────────
    private static readonly ColorEntry[] _series =
    [
        new("--hvo-series-1", "#69d3ff", "Primary blue — temperature outside, wind average"),
        new("--hvo-series-2", "#ffb86c", "Warm amber — temperature inside, secondary"),
        new("--hvo-series-3", "#ffd166", "Solar yellow — solar radiation, sun arc fill"),
        new("--hvo-series-4", "#57d38d", "Success green — positive / healthy values"),
        new("--hvo-series-5", "#ff9f5a", "Alert orange — wind gust, caution"),
        new("--hvo-series-6", "#9fb8d4", "Muted silver — moon arc, secondary muted"),
