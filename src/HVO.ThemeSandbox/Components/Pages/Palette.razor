    // ── Chart infra ────────────────────────────────────────────────────────────
    private static readonly Swatch[] _chartSwatches =
    [
        new("--shell-chart-grid-color",       "rgba(126,157,196,.12)", "rgba(103,132,171,.14)"),
        new("--shell-chart-axis-color",       "rgba(126,157,196,.18)", "rgba(128,151,185,.24)"),
