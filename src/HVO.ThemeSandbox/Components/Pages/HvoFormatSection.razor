<MudCard Elevation="2" Class="pa-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">HvoFormat — Unit System Demo</MudText>
            <MudText Typo="Typo.caption" Class="hvo-eyebrow">@(_useImperial ? "Imperial" : "Metric") Units</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudTooltip Text="@(_useImperial ? "Switch to Metric" : "Switch to Imperial")">
                <MudIconButton Icon="@Icons.Material.Outlined.SwapHoriz"
                               Color="Color.Primary"
                               OnClick="@ToggleUnits"
                               aria-label="Toggle unit system" />
            </MudTooltip>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        <div class="hvo-metric">
            <span class="hvo-metric-label">Timestamp</span>
            <span class="hvo-metric-value hvo-mono">@HvoFormat.Timestamp(DateTime.UtcNow)</span>
        </div>
        <div class="hvo-metric">
            <span class="hvo-metric-label">Footer Timestamp</span>
            <span class="hvo-metric-value hvo-mono">@HvoFormat.FooterTimestamp(DateTime.UtcNow)</span>
        </div>
        <div class="hvo-metric">
            <span class="hvo-metric-label">Temperature</span>
            <span class="hvo-metric-value hvo-mono">@HvoFormat.Temperature(22.5, _unitSystem)</span>
        </div>
        <div class="hvo-metric">
            <span class="hvo-metric-label">Temperature (null)</span>
            <span class="hvo-metric-value hvo-mono">@HvoFormat.Temperature(null, _unitSystem)</span>
        </div>
        <div class="hvo-metric">
            <span class="hvo-metric-label">Speed</span>
            <span class="hvo-metric-value hvo-mono">@HvoFormat.Speed(5.2, _unitSystem)</span>
        </div>
        <div class="hvo-metric">
            <span class="hvo-metric-label">Pressure</span>
            <span class="hvo-metric-value hvo-mono">@HvoFormat.PressureInHg(29.92, _unitSystem)</span>
        </div>
        <div class="hvo-metric">
            <span class="hvo-metric-label">Voltage</span>
            <span class="hvo-metric-value hvo-mono">@HvoFormat.Voltage(13.45)</span>
        </div>
        <div class="hvo-metric">
            <span class="hvo-metric-label">Voltage (1 dec)</span>
            <span class="hvo-metric-value hvo-mono">@HvoFormat.Voltage(13.45, 1)</span>
        </div>
        <div class="hvo-metric">
            <span class="hvo-metric-label">Current</span>
            <span class="hvo-metric-value hvo-mono">@HvoFormat.Current(2.75)</span>
        </div>
        <div class="hvo-metric">
            <span class="hvo-metric-label">Current (null)</span>
            <span class="hvo-metric-value hvo-mono">@HvoFormat.Current(null)</span>
        </div>
        <div class="hvo-metric">
            <span class="hvo-metric-label">Power</span>
            <span class="hvo-metric-value hvo-mono">@HvoFormat.Power(350.8)</span>
        </div>
        <div class="hvo-metric">
            <span class="hvo-metric-label">Energy</span>
            <span class="hvo-metric-value hvo-mono">@HvoFormat.EnergyAh(125.5)</span>
        </div>
        <div class="hvo-metric">
            <span class="hvo-metric-label">Rain</span>
            <span class="hvo-metric-value hvo-mono">@HvoFormat.Rain(0.25)</span>
        </div>
        <div class="hvo-metric">
            <span class="hvo-metric-label">Percent</span>
            <span class="hvo-metric-value hvo-mono">@HvoFormat.Percent(78.3)</span>
        </div>
        <div class="hvo-metric">
            <span class="hvo-metric-label">Percent (null)</span>
            <span class="hvo-metric-value hvo-mono">@HvoFormat.Percent(null)</span>
        </div>
        <div class="hvo-metric">
            <span class="hvo-metric-label">Duration</span>
            <span class="hvo-metric-value hvo-mono">@HvoFormat.Duration(TimeSpan.FromHours(2.5))</span>
        </div>
    </MudCardContent>
</MudCard>

@code {
    private UnitSystem _unitSystem = UnitSystem.Metric;
    private bool _useImperial => _unitSystem == UnitSystem.Imperial;

    private void ToggleUnits()
    {
        _unitSystem = _useImperial ? UnitSystem.Metric : UnitSystem.Imperial;
    }
}
