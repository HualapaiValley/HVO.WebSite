<MudCard Elevation="2" Class="pa-4">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">HvoChart — Time-Series Demo</MudText>
            <MudText Typo="Typo.caption" Class="hvo-eyebrow">Chart.js with dynamic CSS var theming</MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        <HvoChart ChartId="sandbox-chart"
                  Type="HvoChartType.Line"
                  Title="Sample Temperature Data"
                  XAxisLabel="Hour"
                  YAxisLabel="Temperature (°C)"
                  ShowLegend="true"
                  Height="320"
                  EnableAnimations="false"
                  Labels="@_labels"
                  Datasets="@_datasets" />
    </MudCardContent>
</MudCard>

@code {
    private static readonly string[] _labels = { "00:00", "02:00", "04:00", "06:00", "08:00", "10:00", "12:00", "14:00", "16:00", "18:00", "20:00", "22:00" };

    private static readonly List<HvoChartDataset> _datasets = new()
    {
        new("Outdoor Temp",
            new double[] { 15.2, 14.1, 13.0, 12.5, 14.8, 18.2, 22.1, 25.0, 24.3, 20.1, 17.5, 16.0 },
            BorderColor: "#6da5ff",
            BackgroundColor: "rgba(109,165,255,0.1)",
            Fill: true,
            BorderWidth: 2.5),
        new("Indoor Temp",
            new double[] { 21.0, 20.8, 20.5, 20.3, 20.5, 21.0, 21.5, 22.0, 22.3, 22.1, 21.5, 21.2 },
            BorderColor: "#57bca6",
            BackgroundColor: "rgba(87,188,166,0.1)",
            Fill: true,
            BorderWidth: 2.5)
    };
}
