## Build outputs — must be excluded so dotnet restore inside the container
## is not overwritten by the host's obj/bin directories
**/bin/
**/obj/

## Runtime data files (logs, outbox databases, WAL/SHM files)
**/logs/
**/*.log
**/*.db
**/*.db-wal
**/*.db-shm

## Secrets and local config
.env
*.env
.env.*
.env-handoff/
**/secrets/
**/secrets.yaml
**/.storage/

## Git
.git/
.gitignore

## Dev container
.devcontainer/

## Test projects
tests/
TestResults/
**/TestResults/
**/*.dmp

## Agent dependencies
.opencode/node_modules/

## IDE
.vs/
.vscode/
.idea/

## OS
.DS_Store
