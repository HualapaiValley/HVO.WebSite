<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <!-- Provisioned HA restarts and protocol simulator suites need a longer bounded session. -->
    <TestSessionTimeout>900000</TestSessionTimeout>
  </RunConfiguration>
  <MSTest>
    <!-- A required integration fixture being unavailable must not become a passing skip. -->
    <MapInconclusiveToFailed>true</MapInconclusiveToFailed>
  </MSTest>
</RunSettings>
