# HVO Website — Caddy reverse proxy
#
# Terminates TLS with a self-signed certificate so that the Entra OIDC
# redirect URI can use https://. The hvo-website container runs plain HTTP
# internally; Caddy adds X-Forwarded-Proto: https so ASP.NET Core builds
# the correct redirect URI for the OIDC flow.
#
# Access the site at: https://192.168.0.20

{
	# Disable automatic HTTPS so auto_https does not add a conflicting TLS
	# policy on top of the explicit "tls internal" directive below.
	auto_https off
}

:443 {
	tls internal

	reverse_proxy hvo-website:8080 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
	}
}

:80 {
	redir https://{host}{uri} permanent
}
