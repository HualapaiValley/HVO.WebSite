{
  "name": "HVO.WebSite Dev Container",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "16gb"
  },
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0"
    },
    "ghcr.io/devcontainers/features/git:1": {
      "ppa": true,
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "installDirectlyFromGitHubRelease": true,
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "installOhMyZsh": true,
      "configureZshAsDefaultShell": true,
      "username": "vscode",
      "userUid": "automatic",
      "userGid": "automatic",
      "upgradePackages": false
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-dotnettools.vscode-dotnet-runtime",
        "ms-dotnettools.blazorwasm-companion",
        "ms-mssql.mssql",
        "ms-mssql.sql-database-projects-vscode",
        "ms-playwright.playwright",
        "ms-azuretools.vscode-docker",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "github.vscode-github-actions"
      ],
      "settings": {
        "dotnet.defaultSolution": "HVO.WebSite.sln",
        "dotnet.completion.showCompletionItemsFromUnimportedNamespaces": true,
        "omnisharp.enableRoslynAnalyzers": true,
        "omnisharp.enableEditorConfigSupport": true,
        "omnisharp.enableImportCompletion": true,
        "csharp.semanticHighlighting.enabled": true,
        "editor.formatOnSave": true,
        "editor.formatOnType": true,
        "editor.codeActionsOnSave": {
          "source.fixAll": "explicit",
          "source.organizeImports": "explicit"
        },
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "/bin/zsh"
          },
          "bash": {
            "path": "/bin/bash"
          }
        }
      }
    }
  },
  // Non-secret env vars available in the running container environment
  "containerEnv": {
    "ASPNETCORE_ENVIRONMENT": "Development",
    "DOTNET_ENVIRONMENT": "Development"
  },
  // Host-sourced vars injected by VS Code from /etc/environment on hvo-dev-host
  // Secrets (AZURE_*, ConnectionStrings__*, etc.) come from .env via post-create.sh
  "remoteEnv": {
    // A classic PAT with `repo` + `workflow` scopes.
    // Set GH_PAT in /etc/environment on hvo-dev-host so VS Code Server picks it up.
    "GH_PAT": "${localEnv:GH_PAT}",
    // Git identity — set in /etc/environment on hvo-dev-host
    "GIT_AUTHOR_NAME": "${localEnv:GIT_AUTHOR_NAME}",
    "GIT_AUTHOR_EMAIL": "${localEnv:GIT_AUTHOR_EMAIL}",
    "GIT_COMMITTER_NAME": "${localEnv:GIT_COMMITTER_NAME}",
    "GIT_COMMITTER_EMAIL": "${localEnv:GIT_COMMITTER_EMAIL}",
    // Required for automatic opencode web startup. Set on the host to protect the web UI.
    "OPENCODE_SERVER_PASSWORD": "${localEnv:OPENCODE_SERVER_PASSWORD}",
    // Optional: override the devcontainer default bind host used by start-opencode-web.sh.
    "OPENCODE_WEB_HOST": "${localEnv:OPENCODE_WEB_HOST}"
  },
  "forwardPorts": [
    4096,
    5000,
    5001,
    5100,
    5136,
    7151,
    8080
  ],
  "portsAttributes": {
    "4096": {
      "label": "OpenCode Web",
      "onAutoForward": "notify"
    },
    "5000": {
      "onAutoForward": "silent",
      "elevateIfNeeded": true
    },
    "5001": {
      "onAutoForward": "silent",
      "elevateIfNeeded": true
    },
    "5136": {
      "onAutoForward": "silent",
      "elevateIfNeeded": true
    },
    "7151": {
      "onAutoForward": "silent",
      "elevateIfNeeded": true
    },
    "5100": {
      "onAutoForward": "silent",
      "elevateIfNeeded": true
    },
    "8080": {
      "onAutoForward": "silent",
      "elevateIfNeeded": true
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "silent"
  },
  "initializeCommand": "mkdir -p \"$HOME/.microsoft/usersecrets\"",
  "runArgs": [
    "--network=host",
    // Bluetooth: allow HCI socket access and raw network operations
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW",
    // Bluetooth: share the host D-Bus system socket so the container can use the host BlueZ daemon
    "--volume=/run/dbus/system_bus_socket:/run/dbus/system_bus_socket",
    // Bluetooth: the docker-default AppArmor profile blocks all D-Bus socket access,
    // which prevents Tmds.DBus / InTheHand.BluetoothLE from reaching the host BlueZ daemon.
    // Removing the AppArmor confinement restores D-Bus access while still keeping the
    // Linux capability and network-namespace constraints above.
    "--security-opt=apparmor=unconfined",
    // Bluetooth: on modern Linux/BlueZ 5 there is no /dev/hci0 device node — the adapter
    // is accessed via AF_BLUETOOTH sockets. With --network=host above, the container
    // inherits the host's full network stack (including HCI sockets) so no --device flag
    // is needed. The caps and D-Bus socket mount below are sufficient.
  ],
  "mounts": [
    {
      "type": "volume",
      "source": "x509stores",
      "target": "/home/vscode/.dotnet/corefx/cryptography/x509stores"
    },
    {
      "source": "hvo-website-usersecrets",
      "type": "volume",
      "target": "/home/vscode/.microsoft/usersecrets"
    }
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/start-opencode-web.sh",
  "postAttachCommand": "bash .devcontainer/post-attach.sh",
  "remoteUser": "vscode"
}
